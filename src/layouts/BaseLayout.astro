---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExploreMore from '../components/ExploreMore.astro';
import '../styles/global.css';

const {
  title = 'Buy Better Finds',
  description = 'Find it. Compare it. Buy better.',
  image = '',
  imageAlt = 'Buy Better Finds'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://buybetterfinds.com');
const siteName = 'Buy Better Finds';
const isHome = Astro.url.pathname === '/';
const pageTitle = title || siteName;
const socialImage = image
  ? new URL(image, 'https://buybetterfinds.com').toString()
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#10233f" />
    <meta name="impact-site-verification" content="fcc4dd8c-c08e-4d6b-a21f-06dd1124114e" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta name="author" content="Buy Better Finds" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': isHome ? 'WebSite' : 'WebPage',
      name: pageTitle,
      description,
      url: canonical.toString(),
      publisher: { '@type': 'Organization', name: siteName, url: 'https://buybetterfinds.com/' }
    })} />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <ExploreMore />
    <Footer />
  </body>
</html>
