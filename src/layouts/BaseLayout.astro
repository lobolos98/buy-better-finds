---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExploreMore from '../components/ExploreMore.astro';
import '../styles/global.css';

const {
  title = 'Buy Better Finds',
  description = 'Find it. Compare it. Buy better.',
  image = '',
  imageAlt = 'Buy Better Finds',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://buybetterfinds.com');
const siteName = 'Buy Better Finds';
const isHome = Astro.url.pathname === '/';
const pageTitle = title || siteName;
const homeStructuredData = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://buybetterfinds.com/#organization', name: 'Buy Better Finds', alternateName: 'BuyBetterFinds', url: 'https://buybetterfinds.com/', description: 'Independent product recommendations, comparisons and buying guides.', sameAs: ['https://www.instagram.com/buybetterfinds/'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://buybetterfinds.com/#website', name: 'Buy Better Finds', alternateName: 'BuyBetterFinds', url: 'https://buybetterfinds.com/', description: 'Product recommendations, comparisons and buying guides from Buy Better Finds.', publisher: { '@id': 'https://buybetterfinds.com/#organization' }, inLanguage: 'en-US' },
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': 'https://buybetterfinds.com/#webpage', url: 'https://buybetterfinds.com/', name: 'Buy Better Finds | Product Reviews, Comparisons & Buying Guides', description: 'Buy Better Finds helps you discover worthwhile products, compare features and tradeoffs, and shop smarter with practical buying guides and curated recommendations.', isPartOf: { '@id': 'https://buybetterfinds.com/#website' }, about: { '@id': 'https://buybetterfinds.com/#organization' }, inLanguage: 'en-US' }
];
const socialImage = image
  ? new URL(image, 'https://buybetterfinds.com').toString()
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta name="theme-color" content="#10233f" />
    <meta name="impact-site-verification" content="fcc4dd8c-c08e-4d6b-a21f-06dd1124114e" />
    <meta name="p:domain_verify" content="4797bf64556a741f92722785ea02a94d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta name="author" content="Buy Better Finds" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const url = new URL(window.location.href);
        if (url.searchParams.get('utm_source')?.toLowerCase() === 'chatgpt.com') {
          url.searchParams.delete('utm_source');
          const query = url.searchParams.toString();
          const cleanUrl = url.pathname + (query ? '?' + query : '') + url.hash;
          window.history.replaceState(window.history.state, '', cleanUrl);
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(isHome ? homeStructuredData : { '@context': 'https://schema.org', '@type': 'WebPage', name: pageTitle, description, url: canonical.toString(), isPartOf: { '@id': 'https://buybetterfinds.com/#website' }, publisher: { '@id': 'https://buybetterfinds.com/#organization' } })} />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <ExploreMore />
    <Footer />
  </body>
</html>
