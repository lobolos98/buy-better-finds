---
import BaseLayout from './BaseLayout.astro';
const {title, description, image, imageAlt, category='SHOPPING ADVICE', readingTime='5 MIN READ', dek, related=[]} = Astro.props;
---
<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt}>
  <div class="journal-page">
    <div class="journal-topline"><a href="/blog/">THE FINDS EDIT</a><span>{category}</span></div>
    <article class="journal-article">
      <header class="story-header">
        <a class="back-link" href="/blog/">← Back to The Finds Edit</a>
        <p class="story-category">THE FINDS EDIT <span>•</span> {category}</p>
        <h1>{title.replace(/ \|.*$/, '')}</h1>
        <p class="story-dek">{dek}</p>
        <div class="byline"><span class="byline-mark">BBF</span><span>THE FINDS EDIT <small>Practical ideas for shopping smarter</small></span><span class="read-time">{readingTime}</span></div>
      </header>
      {image && <figure class="hero-photo"><img src={image} alt={imageAlt || title} fetchpriority="high" /><figcaption><slot name="caption" /></figcaption></figure>}
      <div class="story-layout">
        <aside class="story-aside"><p>IN THIS STORY</p><slot name="contents" /><div class="aside-note">THE FINDS EDIT<span>Ideas first. Smarter shopping always.</span></div></aside>
        <div class="story-body">
          <p class="affiliate-brief">This article may contain affiliate links. We may earn a commission from qualifying purchases.</p>
          <slot />
          <p class="affiliate-note"><strong>Affiliate disclosure:</strong> As an Amazon Associate, Buy Better Finds earns from qualifying purchases. Product availability and prices can change, so check the current listing before buying.</p>
          {related.length > 0 && <section class="related-stories" aria-label="Related articles"><p class="section-kicker">KEEP EXPLORING</p><h2>You Might Also Like</h2><div class="related-grid">{related.map((item) => <a href={item.href} class="related-link">{item.title} <span aria-hidden="true">↗</span></a>)}</div></section>}
          <a class="back-bottom" href="/blog/">← More from The Finds Edit</a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
<style>

  .journal-page{background:#fbf8f2;color:#2b3035;min-height:400px;--ink:#142b45;--red:#c8102e;--muted:#6a7074;--line:#e5ded2}
  .journal-topline{display:flex;justify-content:space-between;align-items:center;padding:13px max(22px,calc((100% - 1160px)/2));background:#142b45;color:#fff;font-size:.65rem;font-weight:800;letter-spacing:.16em}
  .journal-topline a{color:#fff;text-decoration:none}
  .story-header{max-width:900px;margin:0 auto;padding:37px 24px 24px}
  .back-link{display:inline-block;color:#59636c;text-decoration:none;font-size:.78rem;font-weight:700;margin-bottom:28px}
  .story-category,.section-kicker{color:var(--red);font-size:.67rem;letter-spacing:.16em;font-weight:800;margin:0 0 14px}
  .story-category span{padding:0 5px}
  .story-header h1{font-family:Georgia,'Times New Roman',serif;font-weight:500;color:var(--ink);font-size:clamp(2.5rem,6vw,4.7rem);line-height:1.02;letter-spacing:-.055em;margin:0 0 20px;max-width:850px}
  .story-dek{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65;color:#596168;max-width:760px;margin:0 0 25px}
  .byline{display:flex;align-items:center;gap:12px;border-top:1px solid var(--line);padding-top:16px;color:var(--ink);font-size:.68rem;font-weight:800;letter-spacing:.08em}
  .byline-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--ink);color:#fff;font-family:Georgia,serif;letter-spacing:-.05em}
  .byline small{display:block;color:#77736c;font-size:.65rem;letter-spacing:0;font-weight:500;margin-top:4px}
  .read-time{margin-left:auto;color:#77736c;font-size:.63rem}
  .hero-photo{width:min(1120px,calc(100% - 44px));margin:0 auto 46px}
  .hero-photo img{display:block;width:100%;height:clamp(260px,47vw,560px);object-fit:cover;background:#e8dfd2}
  .hero-photo figcaption{font-size:.72rem;color:#77736c;padding-top:9px}
  .story-layout{display:grid;grid-template-columns:190px minmax(0,700px);gap:clamp(25px,5vw,70px);width:min(960px,calc(100% - 44px));margin:0 auto 70px;align-items:start}
  .story-aside{position:sticky;top:105px;padding-top:7px}
  .story-aside>p{font-size:.62rem;letter-spacing:.15em;font-weight:800;color:#77736c;margin:0 0 12px}
  .story-aside>a{display:block;border-top:1px solid var(--line);padding:10px 0;color:var(--ink);font-size:.76rem;text-decoration:none;line-height:1.4}
  .story-aside>a:hover,.back-bottom:hover{color:var(--red)}
  .aside-note{margin-top:28px;padding-top:14px;border-top:2px solid var(--red);font-size:.65rem;font-weight:800;letter-spacing:.13em;color:var(--ink);line-height:1.6}
  .aside-note span{display:block;font-size:.73rem;letter-spacing:0;font-weight:400;color:#77736c;margin-top:6px}
  .story-body{font-family:Georgia,'Times New Roman',serif;font-size:1.08rem;line-height:1.9;color:#3e464b}
  .story-body>p{margin:0 0 23px}
  .story-body h2{font-family:Georgia,'Times New Roman',serif;color:var(--ink);font-size:clamp(1.65rem,3vw,2.15rem);font-weight:500;line-height:1.2;letter-spacing:-.035em;margin:39px 0 13px}
  .affiliate-brief{font-family:Arial,Helvetica,sans-serif;font-size:.76rem;line-height:1.6;color:#77736c;margin-bottom:20px}
  .affiliate-note{font-family:Arial,Helvetica,sans-serif;font-size:.78rem;line-height:1.7;background:#f0e9df;border-left:3px solid var(--red);padding:15px 17px}
  .tip-card{margin:27px 0;padding:20px 22px;background:#e9edf0;border-left:3px solid var(--ink)}
  .tip-card span{font-family:Arial,Helvetica,sans-serif;font-size:.62rem;font-weight:800;letter-spacing:.15em;color:var(--red)}
  .tip-card p{margin:8px 0 0;font-size:1rem;line-height:1.7;color:var(--ink)}
  .shop-card{margin:38px 0 26px;padding:25px;background:#eae3d8}
  .shop-card h2{margin:0 0 10px;font-size:1.9rem}
  .shop-card>p:not(.section-kicker){font-size:.96rem;line-height:1.7;margin:0 0 18px}
  .shop-card>a{display:inline-flex;justify-content:space-between;gap:22px;padding:13px 16px;background:var(--red);font-family:Arial,Helvetica,sans-serif;color:#fff;text-decoration:none;font-size:.75rem;font-weight:800}
  .closing-note{color:#6a7074;font-size:.96rem}
  .back-bottom{display:inline-block;margin-top:8px;color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:.78rem;font-weight:800;text-decoration:none;border-bottom:1px solid var(--red);padding-bottom:6px}
  @media(max-width:700px){.journal-topline{padding:12px 17px}.story-header{padding:26px 18px 20px}.story-header h1{font-size:2.7rem}.hero-photo{width:100%;margin-bottom:30px}.hero-photo img{height:300px}.hero-photo figcaption{padding:8px 17px}.story-layout{grid-template-columns:1fr;width:calc(100% - 36px);gap:22px}.story-aside{position:static;display:flex;flex-wrap:wrap;gap:0 14px;padding:0 0 12px;border-bottom:1px solid var(--line)}.story-aside>p{width:100%;margin-bottom:8px}.story-aside>a{border-top:0;padding:5px 0;font-size:.7rem}.aside-note{display:none}.story-body{font-size:1.02rem}.shop-card{padding:20px}.shop-card h2{font-size:1.65rem}}

  .affiliate-brief{font-family:Arial,Helvetica,sans-serif;font-size:.76rem;line-height:1.6;color:#77736c;margin-bottom:20px}
  .related-stories{border-top:1px solid var(--line);padding-top:25px;margin:30px 0}
  .related-stories h2{margin:0 0 18px;font-size:1.7rem}
  .related-grid{display:grid;gap:10px}
  .related-link{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);font-family:Arial,Helvetica,sans-serif;color:var(--ink);font-size:.88rem;font-weight:700;text-decoration:none;line-height:1.4}
  .related-link:hover{color:var(--red)}
</style>