---
import { getRecommendation } from '../data/recommendations.js';

const { product } = Astro.props;
const exactDealAmazonUrl = 'https://www.amazon.com/dp/B0C6XJNKP8/ref=cm_sw_r_as_gl_apa_gl_i_TT11G26RB9T7ADWVK57N?linkCode=ml1&tag=buybetterfi06-20&linkId=e9bec15ede862289c17773f1aff94a3f&gaOptInStatus=true';
const exactSeesiiAmazonUrl = 'https://www.amazon.com/dp/B0CS3FF4RF?tag=buybetterfi06-20';
const directAmazonBySlug = {
  'seesii-electric-car-jack': 'https://www.amazon.com/dp/B0CS3FF4RF?tag=buybetterfi06-20',
  'craftsman-10-in-rasp-file': 'https://www.amazon.com/dp/B09KP1N4HX?tag=buybetterfi06-20',
  'metabo-hpt-reciprocating-saw': 'https://www.amazon.com/dp/B08TX47KRJ?tag=buybetterfi06-20',
  'montolit-flash-line-3': 'https://www.amazon.com/dp/B08NPPD7NK?tag=buybetterfi06-20',
  'kaiweets-kws-114-wire-stripper': 'https://www.amazon.com/dp/B097SZ1F7W?tag=buybetterfi06-20',
  'worx-bladerunner-portable-table-saw': 'https://www.amazon.com/dp/B071P6GZN5?tag=buybetterfi06-20',
  'skil-brushless-flip-drill': 'https://www.amazon.com/dp/B0DHWPM278?tag=buybetterfi06-20',
  'dremel-4300-rotary-tool': 'https://www.amazon.com/dp/B01M1SJNVU?tag=buybetterfi06-20'
};
const directAmazonUrl = directAmazonBySlug[product.slug];
const amazonUrl = directAmazonUrl ?? (product.amazonAsin === 'B0C6XJNKP8'
  ? exactDealAmazonUrl
  : (product.amazonAsin === 'B0F2J118F4' || product.amazonAsin === 'B0CS3FF4RF')
    ? exactSeesiiAmazonUrl
    : (product.amazonUrl
    ?? (product.amazonAsin
      ? `https://www.amazon.com/dp/${product.amazonAsin}?tag=buybetterfi06-20`
      : product.url || `https://www.amazon.com/s?k=${encodeURIComponent(product.name)}`)));
const productImage = product.amazonImage || product.image;
const fallbackImage = product.imageFallback || (product.manufacturerImage && product.manufacturerImage !== productImage ? product.manufacturerImage : null);
const recommendation = getRecommendation(product);
const score = Number.isFinite(Number(recommendation?.score)) ? Number(recommendation.score).toFixed(1) : '—';
---
<article class="card product-card">
  <a class="product-image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>
    {productImage && <img src={productImage} alt={product.imageAlt || product.name} loading="lazy" width="800" height="600" onerror="if(this.dataset.fallback){this.style.display='none'; const fallback=this.nextElementSibling; if(fallback) fallback.style.display='flex';} else if(this.dataset.fallbackUrl){this.dataset.fallback='1'; this.src=this.dataset.fallbackUrl;}" data-fallback-url={fallbackImage || undefined} referrerpolicy="no-referrer" />}
    {fallbackImage && <span class="image-fallback" aria-hidden="true">
      <img class="fallback-real-image" src={fallbackImage} alt="" width="400" height="400" />
    </span>}
    <span class="pick-badge">BUY BETTER FIND</span>
  </a>

  <div class="product-meta">
    <div class="tag">{product.category}</div>
    <div class="score-mini" aria-label={`Buy Better Finds Score ${score} out of 10`}><small>Buy Better Score</small><strong>{score}<span>/10</span></strong></div>
  </div>

  <h3>{product.name}</h3>
  <p class="best-for"><strong>Best for:</strong> {product.bestFor}</p>
  <p>{product.why}</p>
  <div class="tradeoff"><strong>Watch:</strong> {product.watch}</div>
  <p class="price"><strong>{product.price}</strong></p>

  <div class="product-card-actions">
    <a class="shop-btn secondary-shop" href={`/products/${product.slug}/`}>See our take →</a>
    <a class="shop-btn amazon-shop" href={amazonUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a>
  </div>
</article>

<style>
.product-card{overflow:hidden;display:flex;flex-direction:column}
.product-image{position:relative;display:block;aspect-ratio:4/3;margin:-1px -1px 18px;background:#f3f5f8;overflow:hidden;border-radius:18px 18px 0 0}
.product-image img{width:100%;height:100%;display:block;object-fit:contain;padding:24px;transition:transform .25s ease}
.product-image:hover img{transform:scale(1.04)}
.pick-badge{position:absolute;top:12px;left:12px;padding:6px 9px;border-radius:999px;background:#0f172a;color:#fff;font-size:9px;font-weight:900;letter-spacing:.1em}
.image-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#f3f5f8}
.fallback-real-image{width:150px!important;height:150px!important;padding:16px!important;object-fit:contain;border-radius:50%;background:#fff;box-shadow:0 8px 24px rgba(15,23,42,.12)}
.product-image img + .image-fallback{display:none}.product-image img[style*="display: none"] + .image-fallback{display:flex}
.product-meta{display:flex;align-items:center;justify-content:space-between;gap:12px}
.score-mini{display:flex;flex-direction:column;align-items:flex-end;gap:1px;padding:5px 8px;border-radius:8px;background:#f1f5f9}
.score-mini small{font-size:8px;font-weight:800;line-height:1;color:#64748b;text-transform:uppercase;letter-spacing:.04em}.score-mini strong{font-size:15px;line-height:1.1;color:#111827}
.score-mini strong span{font-size:9px;color:#64748b;margin-left:2px}
.product-card h3{margin-top:9px}
.product-card p{line-height:1.6}
.best-for{font-size:13px;color:#475569}
.best-for strong{color:#111827}
.tradeoff{margin:4px 0 8px;padding-top:10px;border-top:1px solid #e2e8f0;color:#64748b;font-size:12px;line-height:1.5}
.tradeoff strong{color:#c8102e}
.price{margin-top:auto}
.product-card-actions{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.shop-btn{display:inline-flex;align-items:center;justify-content:center;align-self:stretch;padding:13px 18px;border-radius:6px;color:#fff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;transition:background .2s ease,transform .2s ease}
.shop-btn:hover{transform:translateY(-1px)}
.secondary-shop{background:#2366a8}
.secondary-shop:hover{background:#1d578f}
.amazon-shop{background:#c8102e}
.amazon-shop:hover{background:#a80d27}
</style>
