---
import BaseLayout from '../layouts/BaseLayout.astro';

const {
  brandName,
  brandLogo = '',
  brandUrl,
  title,
  description,
  heroImage,
  heroAlt,
  intro,
  affiliateFor,
  offers = [],
  couponBanner = null,
  couponBanners = [],
  categories = [],
  products = [],
  highlights = [],
  faqs = [],
  related = [],
  lastVerified = '',
  storefrontIntro = 'Browse the brand’s products, compare categories and open the exact item at the retailer.',
  productSearchPlaceholder = 'Search products...',
  allProductsUrl = brandUrl
} = Astro.props;

const productCategories = [...new Set(products.map((product) => product.category))];
const promotionBanners = couponBanners.length ? couponBanners : couponBanner ? [couponBanner] : [];
const pageUrl = `https://buybetterfinds.com/brands/${brandName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': pageUrl + '#webpage',
    name: title,
    description,
    url: pageUrl,
    isPartOf: { '@id': 'https://buybetterfinds.com/#website' },
    publisher: { '@id': 'https://buybetterfinds.com/#organization' },
    about: { '@id': pageUrl + '#brand' },
    mainEntity: { '@id': pageUrl + '#brand' },
    inLanguage: 'en-US'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Brand',
    '@id': pageUrl + '#brand',
    name: brandName,
    url: brandUrl,
    description: intro
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buybetterfinds.com/' },
      { '@type': 'ListItem', position: 2, name: brandName, item: pageUrl }
    ]
  }
];
---
<BaseLayout title={title} description={description} image={heroImage} imageAlt={heroAlt} structuredData={structuredData}>
  <main class="brand-spotlight">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>{brandName}</span></nav>
    <header class="brand-hero">
      <div class="hero-copy">
        {brandLogo && <div class="brand-logo-wrap"><img class="brand-logo" src={brandLogo} alt={`${brandName} logo`} /></div>}
        <p class="eyebrow">BUY BETTER FINDS · BRAND SPOTLIGHT</p>
        <p class="kicker">A closer look at {brandName}</p>
        <h1>{brandName}: Brand Guide, Product Picks &amp; Current Offers</h1>
        <p class="hero-intro">{intro}</p>
        <div class="hero-actions">
          <a class="button button-red" href={affiliateFor(brandUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer">Shop {brandName} ↗</a>
          <a class="button button-light" href="#offers">See current offers</a>
        </div>
        <p class="disclosure">Buy Better Finds may earn a commission from qualifying purchases made through affiliate links on this page, at no additional cost to you.</p>
      </div>
      <a class="hero-photo" href={affiliateFor(brandUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer">
        <img src={heroImage} alt={heroAlt} fetchpriority="high" />
        <span>Explore the {brandName} store ↗</span>
      </a>
    </header>

    <nav class="quick-nav" aria-label={brandName + ' guide sections'}>
      <a href="#offers">Coupons &amp; offers</a><a href="#categories">Shop categories</a><a href="#storefront">Featured products</a><a href="#about">About the brand</a><a href="#buying-guide">Before you buy</a><a href="#faq">FAQs</a>
    </nav>

    <section id="offers" class="offer-section">
      <div class="section-heading">
        <p class="eyebrow red">COUPONS &amp; PROMOTIONS</p>
        <h2>Current {brandName} offers</h2>
        <p>Offers can change. Check the retailer's current checkout and terms before placing an order.</p>
      </div>
      <div class="offer-grid">
        {promotionBanners.map((banner) => <a class="coupon-banner" href={banner.url} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={banner.alt || 'View current brand promotion'}>
          <img src={banner.image} alt={banner.alt || 'Current brand promotion'} loading="lazy" decoding="async" />
        </a>)}
        {offers.map((offer) => <article class:list={['offer-card', offer.featured && 'offer-featured']}>
          <span class="offer-type">{offer.type}</span>
          <h3>{offer.title}</h3>
          <p>{offer.details}</p>
          {offer.code && <div class="coupon-code"><span>CODE</span><strong>{offer.code}</strong></div>}
          <small>{offer.terms}</small>
          <a href={affiliateFor(offer.url || brandUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer">{offer.button || 'Shop this offer'} ↗</a>
        </article>)}
      </div>
      {lastVerified && <p class="verified-note">Offer details last checked: {lastVerified}. Confirm eligibility and final pricing at checkout.</p>}
    </section>

    <section id="storefront" class="storefront-section">
      <div class="section-heading"><p class="eyebrow red">THE MINI STOREFRONT</p><h2>Shop individual {brandName} products</h2><p>{storefrontIntro}</p></div>
      <div class="store-controls" aria-label={`Filter ${brandName} products`}>
        <label class="store-search"><span>Search products</span><input id="brand-product-search" type="search" placeholder="{productSearchPlaceholder}" /></label>
        <label><span>Product type</span><select id="brand-category-filter"><option value="all">All products</option>{productCategories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <label><span>Sort by</span><select id="brand-product-sort"><option value="featured">Featured</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="name">Name: A to Z</option></select></label>
      </div>
      <p class="store-count" id="brand-product-count" aria-live="polite">{products.length} products shown</p>
      <div class="product-grid" id="brand-product-grid">
        {products.map((product) => <article class="product-card" data-category={product.category} data-name={product.name.toLowerCase()} data-description={product.description.toLowerCase()} data-price={product.priceValue}>
          <a class="product-image" href={affiliateFor(product.url)} target="_blank" rel="sponsored nofollow noopener noreferrer"><img src={product.image} alt={product.alt} loading="lazy" decoding="async" /></a>
          <div class="product-copy">
            <span class="product-type">{product.category}</span><h3>{product.name}</h3><p>{product.description}</p>
            <div class="product-price">{product.price}</div>
            {product.priceNote && <small class="price-note">{product.priceNote}</small>}
            <a class="product-link" href={affiliateFor(product.url)} target="_blank" rel="sponsored nofollow noopener noreferrer">View product at {brandName} ↗</a>
          </div>
        </article>)}
      </div>
      <p class="no-products" id="brand-no-products" hidden>No products match that search. Try another keyword or choose “All products.”</p>
      <div class="store-footer"><p>Prices and availability can change. Listed prices were checked on {lastVerified || 'the date shown above'} and may differ at checkout.</p><a class="all-products" href={affiliateFor(allProductsUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer">Browse all {brandName} products ↗</a></div>
    </section>


    <section id="categories" class="category-section">
      <div class="section-heading centered"><p class="eyebrow red">SHOP BY CATEGORY</p><h2>Find the right {brandName} product type</h2><p>Start with the kind of product you need, then compare individual models and included features.</p></div>
      <div class="category-grid">
        {categories.map((category, index) => <a class="category-card" href={affiliateFor(category.url)} target="_blank" rel="sponsored nofollow noopener noreferrer">
          <img src={category.image} alt={category.alt} loading="lazy" decoding="async" />
          <span class="category-index">{String(index + 1).padStart(2, '0')} / {category.label}</span>
          <h3>{category.title}</h3><p>{category.description}</p><b>Explore category ↗</b>
        </a>)}
      </div>
    </section>

    <section id="about" class="about-section">
      <div><p class="eyebrow red">THE BRAND AT A GLANCE</p><h2>About {brandName}</h2></div>
      <div><p>{intro}</p><p>Buy Better Finds organizes the brand's product range into practical shopping categories and highlights details worth checking before purchase. Product claims and specifications should always be confirmed on the exact product listing.</p></div>
    </section>

    <section id="buying-guide" class="buying-section">
      <div class="section-heading"><p class="eyebrow red">SMARTER SHOPPING</p><h2>What to compare before you buy</h2></div>
      <div class="highlight-grid">{highlights.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    </section>

    <section id="faq" class="faq-section">
      <p class="eyebrow red">GOOD TO KNOW</p><h2>{brandName} frequently asked questions</h2>
      {faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}
    </section>

    {related.length > 0 && <section class="related-section"><h2>More from Buy Better Finds</h2><div>{related.map((item) => <a href={item.url}>{item.title} ↗</a>)}</div></section>}
    <p class="fine-print">Affiliate disclosure: Buy Better Finds may receive a commission from qualifying purchases made through sponsored links on this page, at no additional cost to you. This guide is based on publicly available product and retailer information; it does not claim hands-on testing unless explicitly stated.</p>
  </main>
</BaseLayout>

<script>
  const productGrid = document.querySelector('#brand-product-grid');
  if (productGrid) {
    const cards = Array.from(productGrid.querySelectorAll('.product-card'));
    const search = document.querySelector('#brand-product-search');
    const category = document.querySelector('#brand-category-filter');
    const sort = document.querySelector('#brand-product-sort');
    const count = document.querySelector('#brand-product-count');
    const empty = document.querySelector('#brand-no-products');
    const filterProducts = () => {
      const term = (search?.value || '').trim().toLowerCase();
      const selectedCategory = category?.value || 'all';
      const visible = cards.filter((card) => {
        const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
        const matchesTerm = !term || (card.dataset.name + ' ' + card.dataset.description).includes(term);
        card.hidden = !(matchesCategory && matchesTerm);
        return !card.hidden;
      });
      const mode = sort?.value || 'featured';
      visible.sort((a,b) => {
        if (mode === 'price-low') return Number(a.dataset.price) - Number(b.dataset.price);
        if (mode === 'price-high') return Number(b.dataset.price) - Number(a.dataset.price);
        if (mode === 'name') return a.dataset.name.localeCompare(b.dataset.name);
        return cards.indexOf(a) - cards.indexOf(b);
      }).forEach((card) => productGrid.appendChild(card));
      if (count) count.textContent = visible.length + (visible.length === 1 ? ' product shown' : ' products shown');
      if (empty) empty.hidden = visible.length !== 0;
    };
    search?.addEventListener('input',filterProducts);
    category?.addEventListener('change',filterProducts);
    sort?.addEventListener('change',filterProducts);
  }
</script>

<style>
.brand-logo-wrap{display:inline-flex;align-items:center;justify-content:center;background:#fff;border-radius:8px;padding:10px 16px;margin:0 0 16px;max-width:260px}.brand-logo{display:block;width:100%;max-height:112px;object-fit:contain}
.brand-spotlight{--navy:#142b45;--red:#c8102e;--ink:#1f2937;--muted:#596579;max-width:1200px;margin:auto;padding:18px 22px 64px;color:var(--ink)}
.breadcrumbs{display:flex;gap:9px;font-size:.78rem;color:#64748b;margin:4px 0 18px}.breadcrumbs a{color:var(--navy);text-decoration:none}
.brand-hero{display:grid;grid-template-columns:1.08fr .92fr;gap:28px;align-items:center;padding:clamp(18px,2.5vw,28px);background:linear-gradient(120deg,#142b45,#294866 68%,#49627b);color:#fff;border-bottom:6px solid var(--red)}
.eyebrow{margin:0 0 12px;font-size:.68rem;font-weight:900;letter-spacing:.15em;color:#e5aab5}.eyebrow.red{color:var(--red)}.kicker{margin:0 0 12px;color:#f4dfe3;font-weight:750}
.brand-hero h1{margin:0 0 18px;color:#fff;font:600 clamp(1.8rem,3vw,2.8rem)/1.04 Georgia,serif;letter-spacing:-.035em}.hero-intro{font-size:.88rem;line-height:1.5;color:#edf2f7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:.45rem 0}
.hero-actions{display:flex;flex-wrap:wrap;gap:9px;margin:13px 0 8px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 17px;text-decoration:none;font-size:.84rem;font-weight:850}.button-red{background:var(--red);color:#fff}.button-light{background:#fff;color:var(--navy)}.disclosure{font-size:.65rem;line-height:1.35;color:#dbe5ef;margin:7px 0 0}
.hero-photo{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-width:0;padding:18px;background:#fff;color:var(--navy);text-decoration:none;font-size:.8rem;font-weight:850}.hero-photo img{display:block;width:100%;height:155px;object-fit:contain}
.quick-nav{display:flex;flex-wrap:wrap;gap:9px;padding:18px 0 22px;border-bottom:1px solid #e5e7eb}.quick-nav a{padding:9px 12px;border:1px solid #dbe2ea;border-radius:999px;color:var(--navy);font-size:.76rem;font-weight:750;text-decoration:none}.quick-nav a:hover{border-color:var(--red);color:var(--red)}
section{scroll-margin-top:100px}.section-heading{max-width:760px;margin-bottom:23px}.section-heading.centered{text-align:center;margin:0 auto 25px}.section-heading h2,.about-section h2,.faq-section h2,.related-section h2{margin:0 0 11px;color:var(--navy);font:600 clamp(1.85rem,3.5vw,2.8rem)/1.08 Georgia,serif}.section-heading>p:last-child{margin:0;color:var(--muted);line-height:1.65}
.coupon-banner{display:flex;align-items:center;justify-content:center;min-width:0;min-height:220px;margin:0;padding:13px;background:#fff;border:1px solid #e5dfe0;border-radius:8px;overflow:hidden}.coupon-banner img{display:block;width:100%;height:100%;max-height:180px;object-fit:contain}.offer-section{margin:18px 0 8px;padding:clamp(16px,2.5vw,24px);background:#fff7f5;border:1px solid #f0d7d8;border-top:5px solid var(--red)}.offer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.offer-card{display:flex;flex-direction:column;align-items:flex-start;min-width:0;padding:13px;background:#fff;border:1px solid #e5dfe0;border-radius:8px}.offer-card.offer-featured{border:2px solid var(--red)}.offer-type{font-size:.64rem;font-weight:900;letter-spacing:.12em;color:var(--red)}.offer-card h3{margin:7px 0 5px;color:var(--navy);font:600 1.35rem/1.15 Georgia,serif}.offer-card p{margin:0 0 8px;line-height:1.55;color:var(--muted);font-size:.88rem}.offer-card small{margin:8px 0 14px;color:#64748b;line-height:1.5}.coupon-code{display:flex;align-items:center;gap:10px;padding:8px 11px;background:#f8fafc;border:1px dashed #c8102e}.coupon-code span{font-size:.58rem;font-weight:900;letter-spacing:.12em;color:#64748b}.coupon-code strong{font-size:1.05rem;letter-spacing:.08em;color:var(--red)}.offer-card>a{margin-top:auto;color:var(--red);font-size:.82rem;font-weight:850;text-decoration:none}.verified-note{margin:15px 0 0;font-size:.72rem;color:#64748b}
.category-section,.storefront-section,.buying-section{padding:24px 0 8px}.category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.category-card{display:flex;flex-direction:column;min-width:0;padding:14px;border:1px solid #e1e6ed;background:#fff;text-decoration:none;color:var(--ink)}.category-card img{width:100%;height:190px;object-fit:contain;background:#f7f8fa}.category-index{margin:15px 0 7px;color:var(--red);font-size:.63rem;font-weight:900;letter-spacing:.12em}.category-card h3,.product-card h3{margin:0 0 7px;color:var(--navy);font:600 1.25rem/1.2 Georgia,serif}.category-card p,.product-card p{margin:0 0 14px;color:var(--muted);font-size:.87rem;line-height:1.6}.category-card b{margin-top:auto;color:var(--red);font-size:.8rem}
.store-controls{display:grid;grid-template-columns:minmax(220px,1.6fr) repeat(2,minmax(160px,.8fr));gap:12px;padding:17px;margin:0 0 10px;background:#f3f6f9;border:1px solid #dce4ec}
.store-controls label{display:flex;flex-direction:column;gap:6px;color:var(--navy);font-size:.72rem;font-weight:850}
.store-controls input,.store-controls select{width:100%;min-height:43px;padding:0 12px;border:1px solid #cbd5e1;border-radius:0;background:#fff;color:#1f2937;font:inherit;font-weight:500}
.store-count{margin:0 0 14px;color:#64748b;font-size:.76rem}
.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.product-card[hidden]{display:none}
.product-price{margin:0 0 4px;color:var(--navy);font-size:1.05rem;font-weight:900}
.price-note{color:#64748b;font-size:.68rem;line-height:1.4}
.product-copy .product-link{display:inline-flex;margin-top:12px;padding:11px 13px;background:var(--red);color:#fff;text-decoration:none;font-size:.76rem;font-weight:900}
.no-products{padding:25px;background:#f3f6f9;color:#526176;text-align:center}
.store-footer{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:18px}
.store-footer p{margin:0;color:#64748b;font-size:.72rem;line-height:1.5}.product-card{display:flex;flex-direction:column;min-width:0;border:1px solid #e1e6ed;background:#fff}.product-image{display:flex;align-items:center;justify-content:center;height:165px;padding:14px;background:#f7f8fa}.product-image img{width:100%;height:100%;object-fit:contain}.product-copy{display:flex;flex-direction:column;align-items:flex-start;flex:1;padding:12px}.product-type{margin-bottom:8px;color:var(--red);font-size:.63rem;font-weight:900;letter-spacing:.12em}.product-copy a{margin-top:auto;padding-top:12px;color:var(--red);font-size:.8rem;font-weight:850;text-decoration:none}.all-products{display:inline-flex;margin-top:22px;padding:13px 18px;background:var(--navy);color:#fff;text-decoration:none;font-weight:850;font-size:.82rem}
.about-section{display:grid;grid-template-columns:.75fr 1.25fr;gap:30px;margin:48px 0;padding:clamp(22px,4vw,36px);background:#f3f6f9;border-left:5px solid var(--red)}.about-section p{margin:0 0 13px;line-height:1.75;color:#475569}.about-section p:last-child{margin-bottom:0}
.highlight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.highlight-grid article{padding:19px;border:1px solid #e1e6ed;background:#fff}.highlight-grid article>span{color:var(--red);font-size:.68rem;font-weight:900;letter-spacing:.1em}.highlight-grid h3{margin:12px 0 7px;color:var(--navy);font:600 1.15rem Georgia,serif}.highlight-grid p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.65}
.faq-section{margin:45px 0 20px;padding:clamp(22px,4vw,36px);background:#f3f6f9;border-top:4px solid var(--red)}.faq-section article+article{margin-top:17px;padding-top:17px;border-top:1px solid #d8e0e8}.faq-section h3{margin:0 0 7px;color:var(--navy);font-size:1rem}.faq-section article p{margin:0;color:#526176;line-height:1.7;font-size:.9rem}
.related-section{margin:35px 0}.related-section>div{display:flex;flex-wrap:wrap;gap:12px}.related-section a{color:var(--red);font-weight:800;font-size:.85rem;text-decoration:none}.fine-print{margin-top:30px;padding-top:17px;border-top:1px solid #e5e7eb;color:#64748b;font-size:.72rem;line-height:1.65}
