@media(max-width:850px){.store-controls{grid-template-columns:1fr 1fr}.store-search{grid-column:1/-1}.store-footer{align-items:flex-start;flex-direction:column}.brand-hero{grid-template-columns:1fr}.hero-photo img{height:150px}.category-grid,.product-grid,.offer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.about-section{grid-template-columns:1fr}.highlight-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.product-image{height:145px}.store-controls{grid-template-columns:1fr}.store-search{grid-column:auto}.brand-spotlight{padding:12px 13px 42px}.brand-hero{padding:18px 15px}.brand-hero h1{font-size:2rem}.hero-photo img{height:135px}.quick-nav{gap:7px}.quick-nav a{font-size:.7rem;padding:8px 10px}.category-grid,.offer-grid,.highlight-grid{grid-template-columns:1fr}.category-card img{height:210px}.product-image{height:145px}.about-section{gap:12px}}
</style>
