---
const {title='Shop the picks',description,products=[]} = Astro.props;
const picks = products.filter((p) => p?.image && /^https:\/\/www\.amazon\.com\/dp\/[A-Z0-9]{10}\?tag=buybetterfi06-20$/.test(p.url || ''));
---
{picks.length > 0 && <section class="article-shop" aria-label={title}>
  <div class="shop-heading"><p>CURATED BY BUY BETTER FINDS</p><h3>{title}</h3>{description && <span>{description}</span>}</div>
  <div class="product-grid">{picks.map((p) => <div class="product-card">
    <a href={p.url} target="_blank" rel="sponsored noopener noreferrer" aria-label={`View ${p.name} on Amazon`}><img src={p.image} alt={p.imageAlt || p.name} loading="lazy" decoding="async" /></a>
    <div class="product-copy"><h4>{p.name}</h4>{p.bestFor && <p>{p.bestFor}</p>}{typeof p.score === 'number' && <span class="score">Buy Better Score: {p.score.toFixed(1)}/10</span>}<a class="buy-link" href={p.url} target="_blank" rel="sponsored noopener noreferrer">View on Amazon <span aria-hidden="true">↗</span></a></div>
  </div>)}</div>
  <p class="shop-disclaimer">As an Amazon Associate, we earn from qualifying purchases. Check the current listing for price, availability and product details.</p>
</section>}
<style>
.article-shop{margin:34px 0;padding:22px;background:#fff;border:1px solid #e5ded2;font-family:Arial,Helvetica,sans-serif;color:#142b45}
.shop-heading>p{margin:0 0 7px;color:#c8102e;font-size:.65rem;letter-spacing:.13em;font-weight:800}
.shop-heading h3{margin:0 0 6px;font-family:Georgia,serif;font-size:1.65rem;font-weight:500;line-height:1.2}
.shop-heading>span{display:block;font-size:.83rem;color:#596168;line-height:1.5;margin-bottom:18px}
.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
.product-card{border:1px solid #ece5db;min-width:0;display:flex;flex-direction:column}
.product-card>a:first-child{display:flex;align-items:center;justify-content:center;background:#fff;aspect-ratio:1.3;padding:12px;flex-shrink:0}
.product-card img{width:100%;height:100%;max-height:175px;object-fit:contain}
.product-copy{padding:12px;display:flex;flex-direction:column;gap:9px;flex:1;min-height:165px}
.product-copy h4{margin:0;font-family:Arial,Helvetica,sans-serif;font-size:.87rem;line-height:1.4;font-weight:750}
.product-copy p{margin:0;font-size:.75rem;line-height:1.4;color:#596168}
.score{font-size:.72rem;font-weight:800;color:#142b45}
.buy-link{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:auto;padding:10px;background:#c8102e;color:#fff!important;text-decoration:none;font-size:.76rem;font-weight:800}
.shop-disclaimer{font-size:.68rem;line-height:1.5;color:#666;margin:15px 0 0}
@media(max-width:550px){.article-shop{padding:15px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.product-copy{min-height:195px}.product-card>a:first-child{aspect-ratio:1}.product-card img{max-height:125px}}
</style>