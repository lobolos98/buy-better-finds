        <button type="button" class="affiliate-arrow" data-affiliate-prev aria-label="Previous sponsored banners">❮</button>
        <div class="affiliate-carousel-viewport" data-affiliate-viewport tabindex="0" aria-label="Sponsored advertiser banners">
          <div class="affiliate-banner-track" data-affiliate-track>
            <div class="affiliate-banner-card">
              <span class="affiliate-banner-heading">PISCIFUN · SPONSORED</span>
              <a href="https://www.awin1.com/cread.php?s=4936689&v=89509&q=522775&r=3119041" target="_blank" rel="sponsored nofollow noopener" aria-label="Shop Piscifun fishing gear">
                <img src="https://www.awin1.com/cshow.php?s=4936689&v=89509&q=522775&r=3119041" alt="Piscifun fishing gear promotional banner" loading="lazy" decoding="async" />
              </a>
            </div>
            <div class="affiliate-banner-card">
              <span class="affiliate-banner-heading">GRUNDIG AUTO · SPONSORED</span>
              <a href="https://www.awin1.com/cread.php?s=4954913&v=130595&q=615269&r=3119041" target="_blank" rel="sponsored nofollow noopener" aria-label="Shop Grundig Auto products">
                <img src="https://www.awin1.com/cshow.php?s=4954913&v=130595&q=615269&r=3119041" alt="Grundig Auto promotional banner" loading="eager" decoding="async" referrerpolicy="no-referrer-when-downgrade" />
              </a>
            </div>
            <div class="affiliate-banner-card">
              <span class="affiliate-banner-heading">SILVER BRUSH · SPONSORED</span>
              <a href="https://www.awin1.com/cread.php?s=4874984&amp;v=129485&amp;q=613592&amp;r=3119041" target="_blank" rel="sponsored nofollow noopener" aria-label="Shop Silver Brush products">
                <img src="https://www.awin1.com/cshow.php?s=4874984&amp;v=129485&amp;q=613592&amp;r=3119041" alt="Silver Brush promotional banner" loading="eager" decoding="async" />
              </a>
            </div>
            <div class="affiliate-banner-card">
              <span class="affiliate-banner-heading">SHENZHEN CANGYU · SPONSORED</span>
