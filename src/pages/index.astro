---
import BaseLayout from '../layouts/BaseLayout.astro';

const products = [
  { name: 'Wireless Noise-Canceling Headphones', category: 'Tech', price: '$99–$199', href: '/products/example-product/' },
  { name: 'Compact Air Fryer', category: 'Home', price: '$59–$129', href: '/categories/home/' },
  { name: '20V Cordless Drill Kit', category: 'Tools & DIY', price: '$79–$149', href: '/categories/home/' },
  { name: 'Portable Patio Heater', category: 'Outdoor', price: '$129–$249', href: '/categories/outdoor/' }
];

const categories = [
  ['⌂','Home & Kitchen','/categories/home/'],
  ['◈','Tech','/categories/tech/'],
  ['⚒','Tools & DIY','/categories/home/'],
  ['☼','Outdoor','/categories/outdoor/'],
  ['◆','Lifestyle','/categories/lifestyle/'],
  ['★','Deals','/products/']
];
---
<BaseLayout
  title="Buy Better Finds | Smart Product Recommendations"
  description="Discover useful products, compare options, and shop with confidence through Buy Better Finds."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Smarter shopping starts here</div>
        <h1>Find products worth buying.</h1>
        <p>Practical recommendations, useful comparisons, and buying guidance designed to help you spend your money with confidence.</p>
        <div class="buttons">
          <a class="btn primary" href="/products/">Explore Our Finds →</a>
          <a class="btn secondary" href="/categories/">Browse Categories</a>
        </div>
        <div class="hero-note"><span>✓</span> Independent product discovery · Clear pros &amp; cons · No shopping clutter</div>
      </div>

      <div class="hero-product">
        <div class="pick-badge">FEATURED FIND</div>
        <div class="hero-visual">
          <div class="hero-product-shape">
            <div class="hero-ring"></div>
            <div class="hero-label">AUDIO<small>SMART PICK</small></div>
          </div>
        </div>
        <div class="hero-product-copy">
          <div>
            <div class="tag">Tech</div>
            <h3>Wireless Noise-Canceling Headphones</h3>
            <p>A strong everyday option for commuters, work, travel, and focused listening.</p>
          </div>
          <div class="hero-price">$99–$199</div>
        </div>
        <a class="hero-shop" href="/products/example-product/">See the product review <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="finds">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Featured finds</div>
          <h2>Products worth a closer look.</h2>
          <p>Start with practical picks across the categories shoppers use most.</p>
        </div>
        <a class="arrow" href="/products/">View all products →</a>
      </div>
      <div class="products">
        {products.map((product) => (
          <article class="product">
            <div class="product-img">
              <span class="product-mark">{product.category}</span>
              <div class="product-art" aria-hidden="true">
                <svg viewBox="0 0 200 140"><rect x="38" y="42" width="124" height="58" rx="16"/><path d="M58 42c4-25 80-25 84 0"/><path d="M25 65h13M162 65h13"/></svg>
              </div>
            </div>
            <div class="product-body">
              <div class="tag">{product.category}</div>
              <h3>{product.name}</h3>
              <p>Research the key features, tradeoffs, and shopper considerations before you buy.</p>
              <div class="price">Typical range<strong>{product.price}</strong></div>
              <a class="shop" href={product.href}>View Find →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section categories-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Browse</div>
          <h2>Shop by category.</h2>
          <p>Go directly to the products and research that matter to you.</p>
        </div>
        <a class="arrow" href="/categories/">All categories →</a>
      </div>
      <div class="categories">
        {categories.map(([icon, name, href]) => (
          <a class="cat" href={href}><span>{icon}</span>{name}<small>Explore →</small></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section trust">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow light">Our approach</div>
          <h2>Why shoppers can use our recommendations.</h2>
          <p>We focus on useful information rather than endless product lists.</p>
        </div>
        <a class="arrow light" href="/why-we-recommend/">How we choose →</a>
      </div>
      <div class="trust-grid">
        <div><b>01 — RESEARCH</b><h3>We focus on what matters.</h3><p>Features, use cases, tradeoffs, value, and practical buying considerations come first.</p></div>
        <div><b>02 — COMPARE</b><h3>We make differences easier to see.</h3><p>Good buying decisions start with understanding which option fits the shopper.</p></div>
        <div><b>03 — RECOMMEND</b><h3>We keep the shortlist useful.</h3><p>Our goal is clarity—not making you sort through hundreds of nearly identical products.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div>
        <div class="eyebrow">About Buy Better Finds</div>
        <h2>Better information. Better purchases.</h2>
      </div>
      <div>
        <p>Buy Better Finds is an independent product-discovery site built around practical recommendations, comparisons, and buying guides.</p>
        <p>We help shoppers slow down, understand their options, and find products that make sense for the way they actually shop and live.</p>
        <a class="arrow" href="/about/">Learn more about us →</a>
      </div>
    </div>
  </section>
</BaseLayout>
