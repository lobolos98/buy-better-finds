---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products as catalog } from '../data/products.js';
import { trendingProducts, trendingUpdated } from '../data/trending.js';
import { amazonProductUrl, amazonSearchUrl } from '../utils/amazon.js';
const products = catalog.slice(0, 8);
const amazonUrl = (product) => product?.amazonAsin ? amazonProductUrl(product.amazonAsin) : amazonSearchUrl(product?.name || '');
const categoryPreviews = [
  { name: 'Tech', href: '/categories/tech/', image: '/images/products/sony-wh-1000xm5.svg', alt: 'Tech products including Sony headphones', description: 'Headphones, tablets, accessories & more' },
  { name: 'Home & Kitchen', href: '/categories/home-kitchen/', image: '/images/products/ninja-af101.svg', alt: 'Home and kitchen products including an air fryer', description: 'Kitchen gear, cleaning & organization' },
  { name: 'Tools & DIY', href: '/categories/tools-diy/', image: '/images/products/dewalt-dck240c2.svg', alt: 'DEWALT tools for DIY projects', description: 'Tools and gear for projects at home' },
  { name: 'Outdoor', href: '/categories/outdoor/', image: '/images/products/solo-stove-tower.svg', alt: 'Outdoor products including a patio heater', description: 'Grilling, patios & outdoor living' },
  { name: 'Smart Home', href: '/categories/smart-home/', image: '/images/products/tp-link-ep40m.svg', alt: 'Smart home outdoor plug', description: 'Connected devices for a smarter home' },
  { name: 'Fitness', href: '/categories/fitness/', image: '/images/products/garmin-forerunner-265.svg', alt: 'Garmin fitness running watch', description: 'Fitness watches and training gear' },
  { name: 'Lifestyle', href: '/categories/lifestyle/', image: '/images/products/yeti-rambler.svg', alt: 'YETI Rambler drinkware', description: 'Everyday products worth considering' },
  { name: 'Gifts & Collectibles', href: '/categories/gifts-collectibles/', image: '/images/products/disney-stitch-plush.svg', alt: 'Disney Stitch plush representing Gifts and Collectibles', description: 'Disney, LEGO, Pokémon, Funko & fandom gifts' },
  { name: 'Toys & Games', href: '/categories/toys-games/', image: '/images/products/lego-city-lava-rollercoaster.svg', alt: 'LEGO City set representing Toys and Games', description: 'Building, STEM, puzzles & family games' },
  { name: 'Beauty & Personal Care', href: '/categories/beauty-personal-care/', image: '/images/products/cerave-hydrating-cleanser.svg', alt: 'CeraVe cleanser representing Beauty and Personal Care', description: 'Skincare, hair care & grooming' }
];
const guides = [
  ['Best Tech Products','best-tech','◈'],['Best Home & Kitchen Products','best-home-kitchen','⌂'],['Best Tools & DIY Products','best-tools-diy','⚒'],['Best Outdoor Products','best-outdoor','☼'],['Best Products Under $100','best-products-under-100','★']
];
const featured = catalog[0];
const dealQueue = catalog.filter((p) => p && p.dailyDealDate).sort((a, b) => a.dailyDealDate.localeCompare(b.dailyDealDate));
const deal = dealQueue[0] ?? catalog[0];
const editorChoices = ['sony-wh-1000xm5','dewalt-dck240c2','garmin-forerunner-265'].map((slug) => catalog.find((p) => p.slug === slug)).filter(Boolean);
const dealAlternates = [catalog.find((p) => p.slug === 'apple-airpods-4'), catalog.find((p) => p.slug === 'lego-botanicals-mushrooms'), catalog.find((p) => p.slug === 'disney-stitch-plush')].filter(Boolean);
const trending = trendingProducts.slice(0, 4).map((trend) => ({ ...trend, product: catalog.find((p) => p.slug === trend.slug) })).filter((item) => item.product);
---
<BaseLayout title="Buy Better Finds | Better Products. Smarter Choices." description="Discover real products, compare useful options, and shop with confidence through Buy Better Finds.">
  <section class="hero"><div class="container hero-grid"><div><div class="eyebrow">REAL PRODUCTS · SMARTER SHOPPING</div><h1>Find products worth buying.</h1><p>Better research. Clearer tradeoffs. Smarter choices. We narrow down real products and explain what makes each one worth considering before you spend your money.</p><div class="buttons"><a class="btn primary" href="/products/">Explore Our Finds →</a><a class="btn secondary" href="/categories/">Browse Categories</a></div><div class="hero-note"><span>✓</span> Real products · Original buying guidance · Clear strengths and tradeoffs</div></div><div class="hero-product"><div class="pick-badge">BUY BETTER FINDS PICK</div><div class="hero-visual hero-image-wrap"><img src={featured.image} alt={featured.imageAlt} width="1000" height="750" /><div class="hero-image-fallback" aria-hidden="true"><div class="hero-product-shape"><div class="hero-ring"></div><div class="hero-label">SONY<small>WH-1000XM5</small></div></div></div></div><div class="hero-product-copy"><div><div class="tag">{featured.category}</div><h3>{featured.name}</h3><p>{featured.why}</p></div><div class="hero-price">{featured.price}</div></div><div class="hero-actions"><a class="hero-shop" href={`/products/${featured.slug}/`}>See why we recommend it <span>→</span></a><a class="amazon-btn" href={amazonUrl(featured)} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a></div></div></div></section>

  <section class="section product-search-home">
    <div class="container">
      <div class="search-home-copy">
        <div>
          <div class="eyebrow">SEARCH ANY PRODUCT</div>
          <h2>Looking for something specific?</h2>
          <p>Search for a product, brand, or model and then use Buy Better Finds research to understand what to look for before you buy.</p>
        </div>
        <div class="home-search-placeholder">
          <div class="placeholder-icon">⌕</div>
          <strong>Amazon Product Search</strong>
          <span>Coming soon</span>
          <small>Live Amazon product search will be available once Creators API access is enabled for the Buy Better Finds Associates account.</small>
          <a class="btn primary" href="/search/">Explore Product Search →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section affiliate-strip"><div class="container"><strong>Shop with confidence.</strong><span>Review our recommendation first, then check Amazon for current price and availability.</span>{amazonUrl(featured) ? <a href={amazonUrl(featured)} target="_blank" rel="nofollow sponsored noopener">Check today's Amazon listing →</a> : <span>Amazon listing link pending verified ASIN.</span>}</div></section>

  <section class="section deal-section"><div class="container"><div class="deal-header"><div><div class="eyebrow">🔥 Deal of the Day</div><h2>A new product every day.</h2><p>A new product is introduced each day. After its feature day ends, it stays permanently available in its regular category.</p></div><a class="arrow" href="/deals/" aria-label="View all Deal of the Day offers">View all deals →</a></div><div class="deal-feature" id="daily-deal"><div class="deal-image"><span class="deal-badge">NEW TODAY</span><img src={deal.image} alt={deal.imageAlt} width="900" height="650" /></div><div class="deal-copy"><div class="tag">{deal.category}</div><h3>{deal.name}</h3><div class="deal-stars" aria-label="Editorial recommendation">★★★★★ <span>Buy Better Finds pick</span></div><p><strong>Why we're highlighting it:</strong> {deal.why}</p><div class="deal-points"><span>✓ Strong fit for {deal.bestFor.toLowerCase()}</span><span>✓ New to the Buy Better Finds category</span><span>✓ After today, it remains in its permanent category</span></div><div class="deal-actions"><a class="shop" href={`/products/${deal.slug}/`}>See Our Take →</a><a class="amazon-btn" href={amazonUrl(deal)} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a></div><small>Deal prices and availability can change at any time. Check Amazon for current details.</small></div></div><div class="deal-alternates"><div class="deal-alt-title"><strong>Deals Worth Clicking</strong><span>More products worth checking</span></div>{dealAlternates.map((product)=><div class="deal-alt"><img src={product.image} alt={product.imageAlt} loading="lazy" width="500" height="350" /><div><span>{product.category}</span><h3>{product.name}</h3><a href={`/products/${product.slug}/`}>See our take →</a><a href={amazonUrl(product)} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a></div></div>)}</div></div></section>

  <section class="section quick-picks"><div class="container"><div class="section-head"><div><div class="eyebrow">Start here</div><h2>Shop our top finds.</h2><p>Specific products with a clear reason to consider them.</p></div><a class="arrow" href="/products/">View all products →</a></div><div class="products">{products.map((product,index)=><article class="product"><a class="product-img" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>{index===0&&<span class="product-badge">TOP PICK</span>}<img src={product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" /><span class="product-image-fallback" aria-hidden="true"><span class="real-product-icon">{product.icon}</span><small>{product.category}</small></span></a><div class="product-body"><div class="tag">{product.category}</div><h3>{product.name}</h3><div class="best-for"><strong>Best for:</strong> {product.bestFor}</div><p>{product.why}</p><div class="watch"><strong>Watch before you buy:</strong> {product.watch}</div><div class="price">Reference price<strong>{product.price}</strong></div><div class="product-actions"><a class="shop" href={`/products/${product.slug}/`}>See Our Take →</a><a class="amazon-btn" href={amazonUrl(product)} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a></div></div></article>)}</div><p class="affiliate-disclosure">As an Amazon Associate I earn from qualifying purchases. Product availability and prices can change, so always confirm current details on Amazon before buying.</p></div></section>
  <section class="section comparison-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Compare before you buy</div><h2>Make the decision easier.</h2><p>Side-by-side comparisons built around real buying questions—not generic product lists.</p></div><a class="arrow" href="/comparisons/">See all comparisons →</a></div><div class="comparison-grid"><a class="comparison-card" href="/comparisons/sony-wh-1000xm5-vs-airpods-4/"><span class="comparison-type">HEAD-TO-HEAD</span><h3>Sony WH-1000XM5 vs Apple AirPods 4</h3><p>Compare premium over-ear noise cancellation with compact everyday earbuds.</p><strong>See comparison →</strong></a><a class="comparison-card" href="/comparisons/ninja-af101-vs-instant-vortex-plus/"><span class="comparison-type">HEAD-TO-HEAD</span><h3>Ninja AF101 vs Instant Vortex Plus</h3><p>Compare two popular air-fryer formats by capacity and everyday use.</p><strong>See comparison →</strong></a><a class="comparison-card" href="/comparisons/dyson-v8-vs-shark-navigator/"><span class="comparison-type">HEAD-TO-HEAD</span><h3>Dyson V8 vs Shark Navigator Lift-Away</h3><p>Compare cordless convenience with a traditional upright vacuum.</p><strong>See comparison →</strong></a><a class="comparison-card" href="/comparisons/yeti-rambler-vs-stanley-quencher/"><span class="comparison-type">HEAD-TO-HEAD</span><h3>YETI Rambler vs Stanley Quencher</h3><p>Compare insulated drinkware by size, portability, and everyday fit.</p><strong>See comparison →</strong></a></div><div class="comparison-method"><strong>Our comparison format</strong><span>Question → products → side-by-side table → pros &amp; cons → best for → tradeoffs → retailer check</span></div></div></section>

  <section class="section seasonal-home-section"><div class="container"><div class="section-head"><div><div class="eyebrow">SEASONAL & HOLIDAYS</div><h2>Shop what’s timely.</h2><p>We track the shopping moments, gifts, and seasonal products that matter now—then refresh the focus as the calendar changes.</p></div><a class="arrow" href="/categories/seasonal-holidays/">Explore Seasonal & Holidays →</a></div><div class="seasonal-home-grid"><a class="seasonal-home-card featured" href="/categories/seasonal-holidays/"><span class="seasonal-home-label">RIGHT NOW</span><h3>Fall, Halloween & Prime Big Deal Days</h3><p>Get ahead of the season with Prime Big Deal Days, timely finds, gift ideas, and the holiday deal calendar.</p><strong>See what’s on the radar →</strong></a><a class="seasonal-home-card" href="/categories/seasonal-holidays/prime-big-deal-days/"><span class="seasonal-home-label">OCT. 6–7</span><h3>Prime Big Deal Days</h3><p>Follow the fall shopping event and see what Buy Better Finds will be watching.</p><strong>View the event guide →</strong></a><a class="seasonal-home-card" href="/deals/"><span class="seasonal-home-label">DEALS</span><h3>Seasonal Deals</h3><p>Watch for timely price drops across home, outdoor, beauty, tech, and more.</p><strong>See current deals →</strong></a><a class="seasonal-home-card" href="/guides/"><span class="seasonal-home-label">GIFTS</span><h3>Holiday Gift Ideas</h3><p>Build gift shortlists early instead of waiting for the holiday rush.</p><strong>Browse buying guides →</strong></a><a class="seasonal-home-card" href="/trending/"><span class="seasonal-home-label">TRENDING</span><h3>What’s Hot Right Now</h3><p>Follow products showing current shopper, seasonal, search, or retail signals.</p><strong>View trend watchlist →</strong></a></div></div></section>\n\n  <section class="section categories-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Browse smarter</div><h2>Shop by category.</h2><p>Start with a visual preview, then explore the products and research for that category.</p></div><a class="arrow" href="/categories/">All categories →</a></div><div class="category-preview-grid">{categoryPreviews.map((category)=><a class="category-preview" href={category.href}><div class="category-preview-image"><img src={category.image} alt={category.alt} loading="lazy" width="800" height="500" /></div><div class="category-preview-body"><div><span class="category-kicker">SHOP</span><h3>{category.name}</h3><p>{category.description}</p></div><span class="category-arrow">Explore →</span></div></a>)}</div></div></section>
  <section class="section trending-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Trending now · Research snapshot</div><h2>What's Trending</h2><p>Products showing meaningful current shopper, seasonal, search, or retail coverage signals as of {trendingUpdated}.</p></div><a class="arrow" href="/trending/">See the full trend watchlist →</a></div><div class="trending-grid">{trending.map(({ product, signal })=><a class="trend-card" href={`/products/${product.slug}/`}><div class="trend-image"><span class="trend-signal">{signal}</span><img src={product.image} alt={product.imageAlt} loading="lazy" /></div><div class="trend-copy"><span>{product.category}</span><h3>{product.name}</h3><strong>See our take →</strong></div></a>)}</div><p class="trend-note">Trend status is based on current public research signals, not a claim of Amazon’s exact live sales ranking. Signals can change quickly.</p></div></section>
  <section class="section trust"><div class="container"><div class="section-head"><div><div class="eyebrow light">Our recommendation process</div><h2>We help you make the shortlist.</h2><p>Instead of throwing hundreds of products at you, we focus on useful information and practical differences.</p></div><a class="arrow light" href="/why-we-recommend/">How we choose →</a></div><div class="trust-grid"><div><b>01 — RESEARCH</b><h3>Start with real products.</h3><p>We identify specific models from established brands and organize the product information shoppers actually need.</p></div><div><b>02 — COMPARE</b><h3>Make the differences obvious.</h3><p>We look at features, intended use, price, strengths, limitations, and the tradeoffs that can change a buying decision.</p></div><div><b>03 — RECOMMEND</b><h3>Keep the shortlist useful.</h3><p>We explain who a product is best suited for—and who may be better off choosing something else.</p></div></div></div></section>
  <section class="section buying-guides"><div class="container"><div class="section-head"><div><div class="eyebrow">Buying guidance</div><h2>Go beyond the product list.</h2><p>Our buying guides explain what to look for and make the important differences easier to understand.</p></div><a class="arrow" href="/guides/">View all guides →</a></div><div class="guide-grid">{guides.map(([title,slug,icon])=><a class="guide-card" href={`/guides/${slug}/`}><span>{icon}</span><div><strong>{title}</strong><p>Practical picks, buying considerations, strengths, and tradeoffs.</p></div><b>→</b></a>)}</div></div></section>
  <section class="section about-section"><div class="container about"><div><div class="eyebrow">About Buy Better Finds</div><h2>Better information. Better purchases.</h2></div><div><p>Buy Better Finds is an independent product-discovery site built around practical recommendations, comparisons, and buying guidance.</p><p>We may earn commissions when visitors purchase through qualifying links. Product availability and prices can change, so always confirm the current details at checkout.</p><a class="arrow" href="/about/">Learn more about us →</a></div></div></section>
</BaseLayout>
<script define:vars={{ dailyDealQueue: dealQueue.map(({ slug, name, category, image, imageAlt, bestFor, why, dailyDealDate, amazonAsin }) => ({ slug, name, category, image, imageAlt, bestFor, why, dailyDealDate, amazonAsin })) }}>
  const dailyDealCatalog = [];
  const amazonTag = 'buybetterfi06-20';
  const amazonSearch = (name) => 'https://www.amazon.com/s?k=' + encodeURIComponent(name) + '&tag=' + amazonTag;
  const amazonProduct = (asin, name) => asin ? 'https://www.amazon.com/dp/' + encodeURIComponent(asin) + '?tag=' + amazonTag : amazonSearch(name);
  const amazonCta = (item) => '<a class="amazon-btn" href="' + amazonProduct(item.amazonAsin, item.name) + '" target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a>';
  const escapeHtml = (value = '') => String(value).replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const easternDate = () => {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
    const get = (type) => parts.find((part) => part.type === type)?.value || '';
    return get('year') + '-' + get('month') + '-' + get('day');
  };
  const renderDailyDeal = () => {
    const root = document.getElementById('daily-deal');
    if (!root) return;
    const today = easternDate();
    const item = dailyDealQueue.find((product) => product.dailyDealDate === today);
    if (!item) {
      root.innerHTML = '<div class="deal-image deal-placeholder"><span class="deal-badge">COMING NEXT</span><div class="deal-placeholder-mark">✦</div></div><div class="deal-copy"><div class="tag">NEW PRODUCT QUEUE</div><h3>Our next new product is being prepared.</h3><p>We never recycle an old Daily Deal. New products are added to the queue and then permanently placed in their category after their feature day.</p><div class="deal-points"><span>✓ A fresh product is added to the queue</span><span>✓ Each featured product keeps its permanent category</span><span>✓ Check back for the next feature</span></div><small>Deal availability and retailer details can change at any time.</small></div>';
      return;
    }
    root.innerHTML =
      '<div class="deal-image"><span class="deal-badge">NEW TODAY</span><img src="' + escapeHtml(item.image) + '" alt="' + escapeHtml(item.imageAlt) + '" width="900" height="650" /></div>' +
      '<div class="deal-copy"><div class="tag">' + escapeHtml(item.category) + '</div><h3>' + escapeHtml(item.name) + '</h3><div class="deal-stars" aria-label="Editorial recommendation">★★★★★ <span>Buy Better Finds pick</span></div><p><strong>Why we’re highlighting it:</strong> ' + escapeHtml(item.why) + '</p><div class="deal-points"><span>✓ Strong fit for ' + escapeHtml(item.bestFor.toLowerCase()) + '</span><span>✓ New to the Buy Better Finds category</span><span>✓ After today, it remains in its permanent category</span></div><div class="deal-actions"><a class="shop" href="/products/' + encodeURIComponent(item.slug) + '/">See Our Take →</a>' + amazonCta(item) + '</div><small>Amazon price and availability can change at any time. Check Amazon for current details.</small></div>';
  };
  renderDailyDeal();
  const scheduleNextDealRefresh = () => {
    const now = new Date();
    const next = new Date(now);
    next.setHours(24, 0, 5, 0);
    window.setTimeout(() => { renderDailyDeal(); scheduleNextDealRefresh(); }, Math.max(1000, next.getTime() - now.getTime()));
  };
  scheduleNextDealRefresh();
</script>
<style>
