<!-- Deal of the Day exact-link deployment guard: 2026-10-05 -->
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products as catalog } from '../data/products.js';
import { trendingProducts, trendingUpdated } from '../data/trending.js';
import { amazonProductUrl, amazonSearchUrl } from '../utils/amazon.js';
import { getDealOfTheDay } from '../utils/priceWatch.js';
const validCatalog = catalog.filter((product) => product?.slug);
const products = validCatalog.slice(0, 8);
const exactDealAmazonUrl = 'https://www.amazon.com/dp/B0C6XJNKP8/ref=cm_sw_r_as_gl_apa_gl_i_TT11G26RB9T7ADWVK57N?linkCode=ml1&tag=buybetterfi06-20&linkId=e9bec15ede862289c17773f1aff94a3f&gaOptInStatus=true';
const amazonUrl = (product) => product?.affiliateUrl
  ? product.affiliateUrl
  : product?.amazonAsin === 'B0C6XJNKP8'
  ? exactDealAmazonUrl
  : (product?.amazonUrl
      ?? (product?.amazonAsin ? amazonProductUrl(product.amazonAsin) : amazonSearchUrl(product?.name || '')));
const categoryPreviews = [
  { name: 'Tech', href: '/categories/tech/', slug: 'sony-wh-1000xm5-tech', alt: 'Tech products including Sony headphones', description: 'Headphones, tablets, accessories & more' },
  { name: 'Home & Kitchen', href: '/categories/home-kitchen/', slug: 'ninja-af101', alt: 'Home and kitchen products including an air fryer', description: 'Kitchen gear, cleaning & organization' },
  { name: 'Tools & DIY', href: '/categories/tools-diy/', slug: 'dewalt-dck240c2', alt: 'DEWALT tools for DIY projects', description: 'Tools and gear for projects at home' },
  { name: 'Outdoor', href: '/categories/outdoor/', slug: 'solo-stove-tower', alt: 'Outdoor products including a patio heater', description: 'Grilling, patios & outdoor living' },
  { name: 'Smart Home', href: '/categories/smart-home/', slug: 'tp-link-ep40m', alt: 'Smart home outdoor plug', description: 'Connected devices for a smarter home' },
  { name: 'Fitness', href: '/categories/fitness/', slug: 'garmin-forerunner-265', alt: 'Garmin fitness running watch', description: 'Fitness watches and training gear' },
  { name: 'Lifestyle', href: '/categories/lifestyle/', slug: 'yeti-rambler', alt: 'YETI Rambler drinkware', description: 'Everyday products worth considering' },
  { name: 'Gifts & Collectibles', href: '/categories/gifts-collectibles/', slug: 'disney-stitch-plush', alt: 'Disney Stitch plush representing Gifts and Collectibles', description: 'Disney, LEGO, Pokémon, Funko & fandom gifts' },
  { name: 'Toys & Games', href: '/categories/toys-games/', slug: 'lego-city-lava-rollercoaster', alt: 'LEGO City set representing Toys and Games', description: 'Building, STEM, puzzles & family games' },
  { name: 'Beauty & Personal Care', href: '/categories/beauty-personal-care/', slug: 'cerave-hydrating-cleanser', alt: 'CeraVe cleanser representing Beauty and Personal Care', description: 'Skincare, hair care & grooming' },
  { name: 'Pet Supplies', href: '/categories/pet-supplies/', slug: 'earth-rated-dog-waste-bags', alt: 'Earth Rated dog waste bags representing Pet Supplies', description: 'Dog and cat essentials, cleanup & grooming' },
  { name: 'Clothing & Accessories', href: '/categories/clothing-accessories/', slug: 'sunshine-tienda-style', alt: 'Colorful clothing and accessories from Sunshine Tienda', description: 'Clothing, bags, jewelry & hats', image: 'https://www.sunshinetienda.com/cdn/shop/files/sunshine-tienda-rainbow-colorblock-earrings-1220266770.jpg?v=1770771009&width=1920' }
].map((category) => ({ ...category, product: category.image ? { image: category.image, imageAlt: category.alt } : validCatalog.find((product) => product?.slug === category.slug) })).filter((category) => category.product?.image);
const guides = [
  ['Best Tech Products','best-tech','◈'],['Best Home & Kitchen Products','best-home-kitchen','⌂'],['Best Tools & DIY Products','best-tools-diy','⚒'],['Best Outdoor Products','best-outdoor','☼'],['Best Products Under $100','best-products-under-100','★']
];
const featured = validCatalog[0];
const rotationStart = '2026-10-14';
const rotationStartMs = Date.parse(rotationStart + 'T12:00:00Z');
const alreadyScheduled = new Set(validCatalog.filter(p => p.dailyDealDate).map(p => p.slug));
const rotationCandidates = validCatalog.filter(p => p.slug && p.image && (p.amazonAsin || (p.amazonUrl && p.amazonUrl.includes('/dp/'))) && !alreadyScheduled.has(p.slug));
const rotation = rotationCandidates.slice(0, 30).map((p, i) => ({
  ...p,
  dailyDealDate: new Date(rotationStartMs + i * 86400000).toISOString().slice(0, 10)
}));
const allScheduledDeals = [...validCatalog.filter(p => p.dailyDealDate && p.dailyDealDate < rotationStart), ...rotation];
const deal = getDealOfTheDay(allScheduledDeals) ?? validCatalog[0];
const dailyDealSchedule = allScheduledDeals.filter((p) => p.dailyDealDate && p.image && p.slug).map((p) => ({ date: p.dailyDealDate, name: p.name, image: p.image, imageAlt: p.imageAlt, category: p.category, why: p.why, bestFor: p.bestFor, slug: p.slug, amazonUrl: p.amazonUrl || (p.amazonAsin ? amazonProductUrl(p.amazonAsin) : '') }));
const editorChoices = ['sony-wh-1000xm5-tech','dewalt-dck240c2','garmin-forerunner-265'].map((slug) => validCatalog.find((p) => p?.slug === slug)).filter(Boolean);
const dealAlternates = [validCatalog.find((p) => p?.slug === 'apple-airpods-4'), validCatalog.find((p) => p?.slug === 'lego-botanicals-mushrooms'), validCatalog.find((p) => p?.slug === 'disney-stitch-plush')].filter(Boolean);
const trending = trendingProducts.slice(0, 4).map((trend) => ({ ...trend, product: validCatalog.find((p) => p?.slug === trend.slug) })).filter((item) => item.product);
---
<BaseLayout title="Buy Better Finds | Independent Product Reviews & Buying Guides" description="Buy Better Finds offers independent product research, practical comparisons, and buying guides. Better research. Clearer tradeoffs. Smarter choices.">
  <section class="hero"><div class="container hero-grid"><div><div class="eyebrow">REAL PRODUCTS · SMARTER SHOPPING</div><h1>Buy Better Finds: Better Research. Smarter Shopping.</h1><p>Buy Better Finds is an independent shopping research and product discovery site. We compare features, explain strengths and tradeoffs, and share practical buying guides across tech, home, beauty, fitness, gifts, and more—helping you decide what is worth buying and what may not be right for you.</p><div class="buttons"><a class="btn primary" href="/products/">Explore Our Finds →</a><a class="btn secondary" href="/categories/">Browse Categories</a></div><div class="hero-note"><span>✓</span> Real products · Original buying guidance · Clear strengths and tradeoffs</div></div><div class="hero-product"><div class="pick-badge">BUY BETTER FINDS PICK</div><div class="hero-visual hero-image-wrap"><img src={featured.image} alt={featured.imageAlt} width="1000" height="750" /><div class="hero-image-fallback" aria-hidden="true"><div class="hero-product-shape"><div class="hero-ring"></div><div class="hero-label">SONY<small>WH-1000XM5</small></div></div></div></div><div class="hero-product-copy"><div><div class="tag">{featured.category}</div><h3>{featured.name}</h3><p>{featured.why}</p></div><div class="hero-price">{featured.price}</div></div><div class="hero-actions"><a class="hero-shop" href={`/products/${featured.slug}/`}>See why we recommend it <span>→</span></a><a class="amazon-btn" href={amazonUrl(featured)} target="_blank" rel="nofollow sponsored noopener">{featured.affiliateLabel || "Check on Amazon"} →</a></div></div></div></section>


  <section class="affiliate-home-banners" aria-label="Featured partner advertisements">
    <div class="container affiliate-carousel" data-affiliate-carousel>
