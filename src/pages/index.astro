---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products as catalog } from '../data/products.js';
const products = catalog.slice(0, 8);
const categoryPreviews = [
  { name: 'Tech', href: '/categories/tech/', image: '/images/products/sony-wh-1000xm5.svg', alt: 'Tech products including Sony headphones', description: 'Headphones, tablets, accessories & more' },
  { name: 'Home & Kitchen', href: '/categories/home/', image: '/images/products/ninja-af101.svg', alt: 'Home and kitchen products including an air fryer', description: 'Kitchen gear, cleaning & organization' },
  { name: 'Tools & DIY', href: '/categories/tools-diy/', image: '/images/products/dewalt-dck240c2.svg', alt: 'DEWALT tools for DIY projects', description: 'Tools and gear for projects at home' },
  { name: 'Outdoor', href: '/categories/outdoor/', image: '/images/products/solo-stove-tower.svg', alt: 'Outdoor products including a patio heater', description: 'Grilling, patios & outdoor living' },
  { name: 'Smart Home', href: '/categories/smart-home/', image: '/images/products/tp-link-ep40m.svg', alt: 'Smart home outdoor plug', description: 'Connected devices for a smarter home' },
  { name: 'Fitness', href: '/categories/fitness/', image: '/images/products/garmin-forerunner-265.svg', alt: 'Garmin fitness running watch', description: 'Fitness watches and training gear' },
  { name: 'Lifestyle', href: '/categories/lifestyle/', image: '/images/products/yeti-rambler.svg', alt: 'YETI Rambler drinkware', description: 'Everyday products worth considering' }
];
const guides = [
  ['Best Tech Products','best-tech','◈'],['Best Home & Kitchen Products','best-home-kitchen','⌂'],['Best Tools & DIY Products','best-tools-diy','⚒'],['Best Outdoor Products','best-outdoor','☼'],['Best Products Under $100','best-products-under-100','★']
];
const featured = catalog[0];
---
<BaseLayout title="Buy Better Finds | Better Products. Smarter Choices." description="Discover real products, compare useful options, and shop with confidence through Buy Better Finds.">
  <section class="hero"><div class="container hero-grid"><div><div class="eyebrow">REAL PRODUCTS · SMARTER SHOPPING</div><h1>Find products worth buying.</h1><p>Better research. Clearer tradeoffs. Smarter choices. We narrow down real products and explain what makes each one worth considering before you spend your money.</p><div class="buttons"><a class="btn primary" href="/products/">Explore Our Finds →</a><a class="btn secondary" href="/categories/">Browse Categories</a></div><div class="hero-note"><span>✓</span> Real products · Original buying guidance · Clear strengths and tradeoffs</div></div><div class="hero-product"><div class="pick-badge">EDITOR'S PICK</div><div class="hero-visual hero-image-wrap"><img src={featured.image} alt={featured.imageAlt} width="1000" height="750" /><div class="hero-image-fallback" aria-hidden="true"><div class="hero-product-shape"><div class="hero-ring"></div><div class="hero-label">SONY<small>WH-1000XM5</small></div></div></div></div><div class="hero-product-copy"><div><div class="tag">{featured.category}</div><h3>{featured.name}</h3><p>{featured.why}</p></div><div class="hero-price">{featured.price}</div></div><a class="hero-shop" href={`/products/${featured.slug}/`}>See why we recommend it <span>→</span></a></div></div></section>
  <section class="section quick-picks"><div class="container"><div class="section-head"><div><div class="eyebrow">Start here</div><h2>Shop our top finds.</h2><p>Specific products with a clear reason to consider them.</p></div><a class="arrow" href="/products/">View all products →</a></div><div class="products">{products.map((product,index)=><article class="product"><a class="product-img" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>{index===0&&<span class="product-badge">TOP PICK</span>}<img src={product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" /><span class="product-image-fallback" aria-hidden="true"><span class="real-product-icon">{product.icon}</span><small>{product.category}</small></span></a><div class="product-body"><div class="tag">{product.category}</div><h3>{product.name}</h3><div class="best-for"><strong>Best for:</strong> {product.bestFor}</div><p>{product.why}</p><div class="watch"><strong>Watch before you buy:</strong> {product.watch}</div><div class="price">Reference price<strong>{product.price}</strong></div><a class="shop" href={`/products/${product.slug}/`}>See Our Take →</a></div></article>)}</div></div></section>
  <section class="section categories-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Browse smarter</div><h2>Shop by category.</h2><p>Start with a visual preview, then explore the products and research for that category.</p></div><a class="arrow" href="/categories/">All categories →</a></div><div class="category-preview-grid">{categoryPreviews.map((category)=><a class="category-preview" href={category.href}><div class="category-preview-image"><img src={category.image} alt={category.alt} loading="lazy" width="800" height="500" /></div><div class="category-preview-body"><div><span class="category-kicker">SHOP</span><h3>{category.name}</h3><p>{category.description}</p></div><span class="category-arrow">Explore →</span></div></a>)}</div></div></section>
  <section class="section trust"><div class="container"><div class="section-head"><div><div class="eyebrow light">Our recommendation process</div><h2>We help you make the shortlist.</h2><p>Instead of throwing hundreds of products at you, we focus on useful information and practical differences.</p></div><a class="arrow light" href="/why-we-recommend/">How we choose →</a></div><div class="trust-grid"><div><b>01 — RESEARCH</b><h3>Start with real products.</h3><p>We identify specific models from established brands and organize the product information shoppers actually need.</p></div><div><b>02 — COMPARE</b><h3>Make the differences obvious.</h3><p>We look at features, intended use, price, strengths, limitations, and the tradeoffs that can change a buying decision.</p></div><div><b>03 — RECOMMEND</b><h3>Keep the shortlist useful.</h3><p>We explain who a product is best suited for—and who may be better off choosing something else.</p></div></div></div></section>
  <section class="section buying-guides"><div class="container"><div class="section-head"><div><div class="eyebrow">Buying guidance</div><h2>Go beyond the product list.</h2><p>Our buying guides explain what to look for and make the important differences easier to understand.</p></div><a class="arrow" href="/guides/">View all guides →</a></div><div class="guide-grid">{guides.map(([title,slug,icon])=><a class="guide-card" href={`/guides/${slug}/`}><span>{icon}</span><div><strong>{title}</strong><p>Practical picks, buying considerations, strengths, and tradeoffs.</p></div><b>→</b></a>)}</div></div></section>
  <section class="section about-section"><div class="container about"><div><div class="eyebrow">About Buy Better Finds</div><h2>Better information. Better purchases.</h2></div><div><p>Buy Better Finds is an independent product-discovery site built around practical recommendations, comparisons, and buying guidance.</p><p>We may earn commissions when visitors purchase through qualifying links. Product availability and prices can change, so always confirm the current details at checkout.</p><a class="arrow" href="/about/">Learn more about us →</a></div></div></section>
</BaseLayout>
<style>
.product-img,.hero-image-wrap{position:relative;overflow:hidden}.product-img img{width:100%;height:100%;object-fit:contain;padding:20px;display:block;transition:transform .25s ease}.product-img:hover img{transform:scale(1.04)}.product-image-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:8px;background:linear-gradient(145deg,#f7f9fc,#e7ebf1)}.product-image-fallback .real-product-icon{font-size:58px}.product-image-fallback small{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;color:#64748b}.product-badge{position:absolute;top:12px;left:12px;background:#d6a84f;color:#fff;padding:7px 9px;border-radius:5px;font-size:9px;font-weight:900;letter-spacing:.8px;z-index:3}.best-for{font-size:12px;line-height:1.45;background:#f5f8fb;border-radius:7px;padding:9px 10px;margin:2px 0 11px;color:#405166}.best-for strong{color:#10233f}.watch{font-size:11px;line-height:1.45;color:#64748b;border-top:1px solid #edf0f3;padding-top:10px;margin-top:2px}.watch strong{color:#475569}.hero-image-wrap>img{width:100%;height:100%;object-fit:contain;padding:26px;display:block;position:relative;z-index:2}.hero-image-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center}.category-preview-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.category-preview{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.category-preview:hover{transform:translateY(-4px);box-shadow:0 14px 32px rgba(16,35,63,.12);border-color:#b8c7d8}.category-preview-image{height:190px;background:linear-gradient(145deg,#f7f9fc,#e9eef4);display:flex;align-items:center;justify-content:center;overflow:hidden}.category-preview-image img{width:100%;height:100%;object-fit:contain;padding:22px;transition:transform .25s ease}.category-preview:hover .category-preview-image img{transform:scale(1.06)}.category-preview-body{padding:16px 17px 18px;display:flex;flex-direction:column;gap:12px;min-height:116px}.category-kicker{font-size:9px;font-weight:900;letter-spacing:.14em;color:var(--blue);text-transform:uppercase}.category-preview h3{margin:4px 0 4px;color:var(--navy);font-size:18px}.category-preview p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.category-arrow{font-size:12px;font-weight:800;color:var(--blue);margin-top:auto}.guide-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.guide-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;display:flex;flex-direction:column;min-height:170px;transition:.2s}.guide-card:hover{transform:translateY(-3px);box-shadow:0 12px 25px #10233f12;border-color:#b9c9da}.guide-card>span{font-size:25px;margin-bottom:18px}.guide-card strong{color:var(--navy);font-size:14px}.guide-card p{font-size:12px;line-height:1.45;color:var(--muted);margin:7px 0}.guide-card>b{color:var(--blue);margin-top:auto;font-size:16px}.about-section{background:#fff}@media(max-width:1050px){.category-preview-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.category-preview-grid{grid-template-columns:repeat(2,1fr)}.guide-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.category-preview-grid{grid-template-columns:1fr}.category-preview-image{height:210px}.guide-grid{grid-template-columns:1fr}}
</style>
<script>document.querySelectorAll('.product-img img, .hero-image-wrap>img').forEach((img)=>{img.addEventListener('error',()=>{img.style.display='none';const fallback=img.nextElementSibling;if(fallback)fallback.style.display='flex';});});</script>
