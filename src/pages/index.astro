---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products as catalog } from '../data/products.js';

const products = catalog.slice(0, 8);
const categories = [
  ['⌂','Home & Kitchen','/categories/home/'],
  ['◈','Tech','/categories/tech/'],
  ['⚒','Tools & DIY','/categories/tools-diy/'],
  ['☼','Outdoor','/categories/outdoor/'],
  ['◆','Lifestyle','/categories/lifestyle/'],
  ['★','Deals','/products/']
];
const featured = catalog[0];
---
<BaseLayout title="Buy Better Finds | Better Products. Smarter Choices." description="Discover real products, compare useful options, and shop with confidence through Buy Better Finds.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">REAL PRODUCTS · SMARTER SHOPPING</div>
        <h1>Find products worth buying.</h1>
        <p>We highlight real products from established brands and retailers, then give you the key details, tradeoffs, and buying links in one place.</p>
        <div class="buttons"><a class="btn primary" href="/products/">Explore Our Finds →</a><a class="btn secondary" href="/categories/">Browse Categories</a></div>
        <div class="hero-note"><span>✓</span> Real product links · Practical comparisons · Clear buying information</div>
      </div>
      <div class="hero-product">
        <div class="pick-badge">FEATURED FIND</div>
        <div class="hero-visual hero-image-wrap">
          <img src={featured.image} alt={featured.imageAlt} width="1000" height="750" />
          <div class="hero-image-fallback" aria-hidden="true"><div class="hero-product-shape"><div class="hero-ring"></div><div class="hero-label">SONY<small>WH-1000XM5</small></div></div></div>
        </div>
        <div class="hero-product-copy"><div><div class="tag">{featured.category}</div><h3>{featured.name}</h3><p>{featured.why}</p></div><div class="hero-price">{featured.price}</div></div>
        <a class="hero-shop" href={`/products/${featured.slug}/`}>See the product review <span>→</span></a>
      </div>
    </div>
  </section>
  <section class="section" id="finds">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Featured finds</div><h2>Real products. Useful reasons to consider them.</h2><p>Start with a growing catalog of specific products across tech, home, outdoor, tools, smart home, and lifestyle.</p></div><a class="arrow" href="/products/">View all products →</a></div>
      <div class="products">
        {products.map((product) => <article class="product"><a class="product-img" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}><img src={product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" /><span class="product-image-fallback" aria-hidden="true"><span class="real-product-icon">{product.icon}</span><small>{product.category}</small></span></a><div class="product-body"><div class="tag">{product.category}</div><h3>{product.name}</h3><p>{product.why}</p><div class="price">Reference price<strong>{product.price}</strong></div><a class="shop" href={`/products/${product.slug}/`}>View Find →</a></div></article>)}
      </div>
    </div>
  </section>
  <section class="section categories-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Browse</div><h2>Shop by category.</h2><p>Go directly to the products and research that matter to you.</p></div><a class="arrow" href="/categories/">All categories →</a></div><div class="categories">{categories.map(([icon, name, href]) => <a class="cat" href={href}><span>{icon}</span>{name}<small>Explore →</small></a>)}</div></div></section>
  <section class="section trust"><div class="container"><div class="section-head"><div><div class="eyebrow light">Our approach</div><h2>Why shoppers can use our recommendations.</h2><p>We focus on useful information rather than endless product lists.</p></div><a class="arrow light" href="/why-we-recommend/">How we choose →</a></div><div class="trust-grid"><div><b>01 — RESEARCH</b><h3>We start with real products.</h3><p>We identify specific models from established brands and check current product information before publishing a find.</p></div><div><b>02 — COMPARE</b><h3>We make differences easier to see.</h3><p>Good buying decisions start with understanding features, use cases, price, and tradeoffs.</p></div><div><b>03 — RECOMMEND</b><h3>We keep the shortlist useful.</h3><p>Our goal is clarity—not making you sort through hundreds of nearly identical products.</p></div></div></div></section>
  <section class="section"><div class="container about"><div><div class="eyebrow">About Buy Better Finds</div><h2>Better information. Better purchases.</h2></div><div><p>Buy Better Finds is an independent product-discovery site built around practical recommendations, comparisons, and buying guides.</p><p>Product availability and prices can change. Always confirm the current price, seller, shipping, and return terms at checkout.</p><a class="arrow" href="/about/">Learn more about us →</a></div></div></section>
</BaseLayout>

<style>
  .product-img,.hero-image-wrap{position:relative;overflow:hidden}
  .product-img img{width:100%;height:100%;object-fit:contain;padding:20px;display:block;transition:transform .25s ease}
  .product-img:hover img{transform:scale(1.04)}
  .product-image-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:8px;background:linear-gradient(145deg,#f7f9fc,#e7ebf1)}
  .product-image-fallback .real-product-icon{font-size:58px}.product-image-fallback small{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;color:#64748b}
  .hero-image-wrap>img{width:100%;height:100%;object-fit:contain;padding:26px;display:block;position:relative;z-index:2}
  .hero-image-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center}
</style>
<script>
  document.querySelectorAll('.product-img img, .hero-image-wrap>img').forEach((img) => {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      const fallback = img.nextElementSibling;
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
