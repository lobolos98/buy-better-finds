---
import '../styles/global.css';
const products=[
 {n:'01',cat:'Tech',name:'Wireless Noise-Canceling Headphones',desc:'A comfortable everyday upgrade for work, travel and focused listening.',price:'$99–$199',mark:'Top Tech Pick',icon:'headphones'},
 {n:'02',cat:'Home',name:'Compact Air Fryer',desc:'A practical countertop pick for quick meals without taking over the kitchen.',price:'$59–$129',mark:'Best Kitchen Value',icon:'airfryer'},
 {n:'03',cat:'Tools',name:'20V Cordless Drill Kit',desc:'A versatile starter option for common home projects and weekend repairs.',price:'$79–$149',mark:'DIY Favorite',icon:'drill'},
 {n:'04',cat:'Outdoor',name:'Portable Patio Heater',desc:'A compact way to make cool-weather outdoor time more comfortable.',price:'$129–$249',mark:'Outdoor Pick',icon:'heater'}
];
const cats=[['⌂','Home & Kitchen'],['◉','Tech'],['⚒','Tools & DIY'],['☀','Outdoor'],['◆','Lifestyle'],['$','Deals']];
const icon=(type)=> type==='headphones' ? `<svg viewBox="0 0 240 180" aria-hidden="true"><path d="M55 105V83c0-38 29-61 65-61s65 23 65 61v22"/><rect x="39" y="95" width="38" height="58" rx="16"/><rect x="163" y="95" width="38" height="58" rx="16"/><path d="M77 128h-5M163 128h5"/></svg>` : type==='airfryer' ? `<svg viewBox="0 0 240 180" aria-hidden="true"><rect x="57" y="28" width="126" height="124" rx="24"/><rect x="76" y="65" width="88" height="57" rx="10"/><circle cx="120" cy="47" r="7"/><path d="M88 91h64M99 106h42"/></svg>` : type==='drill' ? `<svg viewBox="0 0 240 180" aria-hidden="true"><path d="M67 69h82c19 0 31 13 31 30s-12 30-31 30H98l-18-21H67z"/><path d="M98 129v27h-30v-27M180 88h31v22h-31M70 80H43v38h27"/></svg>` : `<svg viewBox="0 0 240 180" aria-hidden="true"><path d="M120 29v25M78 55h84M91 55l-13 91h84l-13-91"/><path d="M105 80h30M103 103h34M98 126h44"/><circle cx="120" cy="40" r="8"/></svg>`;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Buy Better Finds helps shoppers discover useful products, smart upgrades and worthwhile deals."/><title>Buy Better Finds | Better Products. Smarter Choices.</title></head><body>
<div class="topbar"><div class="container"><span>Smart shopping starts with better information.</span><span>Independent product recommendations</span></div></div>
<header class="header"><div class="container nav"><a class="logo" href="/">Buy <span>Better</span> Finds</a><nav class="links"><a href="#finds">Best Finds</a><a href="#categories">Categories</a><a href="#why">Why We Recommend</a><a href="#about">About</a></nav><a class="btn primary" href="#finds">Shop Finds</a></div></header>
<main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">Today's better find</div><h1>Find the products worth buying.</h1><p>We cut through the endless choices and spotlight useful products that deserve a closer look — starting with the finds shoppers are watching now.</p><div class="buttons"><a class="btn primary" href="#finds">See Featured Products</a><a class="btn secondary" href="#categories">Browse Categories</a></div><div class="hero-note"><span>✓</span> Independent recommendations · Affiliate-supported</div></div><div class="hero-product"><div class="pick-badge">EDITOR'S PICK</div><div class="hero-visual"><div class="hero-product-shape"><div class="hero-ring"></div><div class="hero-label">BBF<br/><small>BETTER FIND</small></div></div></div><div class="hero-product-copy"><div><span class="tag">Featured product</span><h3>Wireless Noise-Canceling Headphones</h3><p>Comfort + focus for work, travel and everyday listening.</p></div><div class="hero-price">$99–$199</div></div><a class="hero-shop" href="#finds">Check Price <span>→</span></a></div></div></section>
<section class="section" id="finds"><div class="container"><div class="section-head"><div><div class="eyebrow">Hand-picked</div><h2>Featured Finds</h2><p>Products selected to give shoppers a strong place to start.</p></div><a class="btn secondary" href="#categories">See categories</a></div><div class="products">{products.map(p=><article class="product"><div class="product-img"><div class="product-mark">{p.mark}</div><div class="product-art" set:html={icon(p.icon)}></div></div><div class="product-body"><div class="tag">{p.cat}</div><h3>{p.name}</h3><p>{p.desc}</p><div class="price">Typical range <strong>{p.price}</strong></div><a class="shop" href="#" aria-label={`Check price for ${p.name}`}>Check Price →</a></div></article>)}</div></div></section>
<section class="section categories-section" id="categories"><div class="container"><div class="section-head"><div><div class="eyebrow">Shop smarter</div><h2>Shop by Category</h2><p>Jump straight to the kind of product you're looking for.</p></div></div><div class="categories">{cats.map(c=><a class="cat" href="#finds"><span>{c[0]}</span>{c[1]}<small>Explore finds →</small></a>)}</div></div></section>
<section class="section trust" id="why"><div class="container"><div class="section-head"><div><div class="eyebrow light">Our approach</div><h2>Why Buy Better Finds?</h2><p>A recommendation should help you decide, not pressure you to buy.</p></div></div><div class="trust-grid"><div><b>01</b><h3>Useful first</h3><p>We focus on products that solve a problem, improve a routine or offer meaningful value.</p></div><div><b>02</b><h3>Simple comparisons</h3><p>We make the important differences easier to understand so you can shop with confidence.</p></div><div><b>03</b><h3>Value matters</h3><p>Price is only one part of the equation. We consider usefulness, features and overall value.</p></div></div></div></section>
<section class="section" id="about"><div class="container about"><div><div class="eyebrow">About us</div><h2>Better shopping starts with better information.</h2></div><p>Buy Better Finds is a product discovery site built to make online shopping less overwhelming. Our goal is simple: surface interesting products, explain why they may be worth considering, and give shoppers a clear next step.</p></div></section>
</main><footer class="footer"><div class="container footer-grid"><div><strong>Buy Better Finds</strong><div class="disclosure">Disclosure: Buy Better Finds may earn a commission when you purchase through certain links. This does not change the price you pay. Recommendations should be evaluated based on your own needs, preferences and budget.</div></div><div><strong>Shop smarter.</strong><div style="margin-top:8px">Better products. Smarter choices.</div></div></div></footer>
</body></html>
