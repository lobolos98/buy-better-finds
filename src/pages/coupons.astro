---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Coupons & Offers | Buy Better Finds" description="Browse featured brand coupons, promotional codes, and affiliate offers from Buy Better Finds. Check each offer's terms and expiration before purchasing.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">COUPONS &amp; OFFERS</div>
      <h1>Brand coupons and special offers.</h1>
      <p class="lead">Find featured promotions and partner offers in one place. Offers can change or expire, so always confirm the details with the retailer before checkout.</p>
      <article class="offer-card">
        <div class="offer-copy">
          <div class="eyebrow">FEATURED PARTNER OFFER</div>
          <h2>FliKEZE Special Offer</h2>
          <p>Use the promotional code below when eligible at FliKEZE. Click the official offer creative to visit the retailer through our tracked affiliate link.</p>
          <div class="code-label">PROMOTIONAL CODE</div>
          <div class="code">2026FKBFAFF80</div>
          <p class="expiry">Offer ends November 26, 2026. Eligible products and promotion terms are determined by FliKEZE.</p>
          <a class="shop-link" href="https://www.awin1.com/cread.php?s=4978461&amp;v=100401&amp;q=588037&amp;r=3119041" target="_blank" rel="sponsored nofollow noopener">Shop FliKEZE offer →</a>
        </div>
        <a class="creative" href="https://www.awin1.com/cread.php?s=4978461&amp;v=100401&amp;q=588037&amp;r=3119041" target="_blank" rel="sponsored nofollow noopener" aria-label="View FliKEZE offer">
          <img src="https://www.awin1.com/cshow.php?s=4978461&amp;v=100401&amp;q=588037&amp;r=3119041" alt="FliKEZE promotional offer" loading="lazy" />
        </a>
      </article>
      <p class="disclosure">Some links on this page are affiliate links. Buy Better Finds may earn a commission from qualifying purchases at no additional cost to you.</p>
    </div>
  </section>
</BaseLayout>
<style>
.section{padding:54px 20px 72px}.container{max-width:1080px;margin:0 auto}.eyebrow{font-size:11px;font-weight:900;letter-spacing:.13em;color:#c8102e}.section h1{margin:10px 0 12px;color:#10233f;font-size:clamp(30px,5vw,46px);line-height:1.08}.lead{max-width:720px;color:#475569;font-size:16px;line-height:1.65;margin:0 0 30px}.offer-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:30px;align-items:center;padding:28px;border:1px solid #d9e2ec;border-radius:16px;background:#fff;box-shadow:0 10px 28px #10233f0d}.offer-copy h2{margin:8px 0 10px;color:#10233f;font-size:27px}.offer-copy p{color:#475569;font-size:14px;line-height:1.65}.code-label{margin-top:22px;color:#64748b;font-size:10px;font-weight:900;letter-spacing:.12em}.code{display:inline-block;margin-top:7px;padding:12px 16px;border:1px dashed #c8102e;border-radius:8px;background:#fff7f8;color:#10233f;font-size:20px;font-weight:900;letter-spacing:.04em}.expiry{font-size:12px!important}.shop-link{display:inline-block;margin-top:8px;padding:13px 18px;border-radius:7px;background:#c8102e;color:#fff;text-decoration:none;font-size:13px;font-weight:900}.creative{display:block}.creative img{display:block;width:100%;height:auto;max-width:100%;border:0}.disclosure{margin-top:24px;color:#64748b;font-size:12px;line-height:1.6}@media(max-width:700px){.section{padding:38px 16px 56px}.offer-card{grid-template-columns:1fr;padding:20px;gap:22px}.creative{grid-row:1}.offer-copy h2{font-size:23px}}
</style>
