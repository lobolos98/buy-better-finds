---
import BaseLayout from '../../layouts/BaseLayout.astro';
const sections = [
  ['Tech','best-tech','Headphones, tablets, mice, power, and everyday technology.','/guides/best-tech/'],
  ['Home & Kitchen','best-home-kitchen','Appliances, cleaning, organization, and practical household upgrades.','/guides/best-home-kitchen/'],
  ['Tools & DIY','best-tools-diy','Useful tools for repairs, projects, and general homeowner work.','/guides/best-tools-diy/'],
  ['Outdoor','best-outdoor','Grilling, patio heating, and products for spending more time outside.','/guides/best-outdoor/'],
  ['Smart Home','best-smart-home','Connected products for convenience, monitoring, lighting, and routines.','/guides/best-smart-home/'],
  ['Fitness','best-fitness-watches','Fitness watches and gear for structured activity and training.','/guides/best-fitness-watches/'],
  ['Everyday Products','best-everyday-products','Useful products that solve common daily problems.','/guides/best-everyday-products/']
];
---
<BaseLayout title="Best Products | Buy Better Finds" description="Browse Buy Better Finds best-product guides by category, with practical comparisons, scores, tradeoffs, and buying advice.">
<section class="hero"><div class="container"><div class="eyebrow">BEST OF BUY BETTER FINDS</div><h1>Start with the products worth considering.</h1><p>Our best-of hub connects shoppers to focused buying guides, direct comparisons, and individual product reviews—so you can move from broad category to specific decision without getting lost.</p></div></section>
<section class="section"><div class="container"><div class="grid">{sections.map(([name,slug,description,href])=><article class="card"><span>BEST {name.toUpperCase()}</span><h2>{name}</h2><p>{description}</p><a class="arrow" href={href}>Explore {name} →</a></article>)}</div></div></section>
<section class="section pathways"><div class="container"><div class="path-grid"><div><div class="eyebrow">NEED A SHORTLIST?</div><h2>Read a buying guide.</h2><p>Use a focused guide when you know the type of product you want but need help narrowing the field.</p><a class="arrow" href="/guides/">Browse All Buying Guides →</a></div><div><div class="eyebrow">ALREADY HAVE TWO OPTIONS?</div><h2>Compare them directly.</h2><p>Use our comparison pages when you are deciding between specific products.</p><a class="arrow" href="/comparisons/">Browse Comparisons →</a></div><div><div class="eyebrow">READY TO SHOP?</div><h2>See every find.</h2><p>Browse the full catalog with product scores, best-for guidance, and practical watch-outs.</p><a class="arrow" href="/products/">View All Products →</a></div></div></div></section>
</BaseLayout>
<style>
.hero{background:linear-gradient(135deg,#10233f,#173c69);color:#fff;padding:82px 0}.hero .eyebrow,.hero h1,.hero p{color:#fff}.hero h1{font-size:clamp(40px,6vw,68px);line-height:1.02;max-width:850px;margin:12px 0 20px}.hero p{max-width:780px;font-size:18px;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{border:1px solid var(--line);border-radius:14px;padding:28px;background:#fff;min-height:230px;display:flex;flex-direction:column}.card span{font-size:10px;letter-spacing:.12em;font-weight:900;color:var(--red)}.card h2{font-size:27px;color:var(--navy);margin:13px 0 8px}.card p{font-size:14px;line-height:1.6;color:var(--muted)}.card .arrow{margin-top:auto}.pathways{background:#f5f7fa}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.path-grid>div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:25px}.path-grid h2{color:var(--navy);margin:9px 0}.path-grid p{color:var(--muted);line-height:1.6;font-size:13px}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.path-grid{grid-template-columns:1fr}}@media(max-width:600px){.grid{grid-template-columns:1fr}.hero{padding:60px 0}.hero p{font-size:16px}}
</style>
