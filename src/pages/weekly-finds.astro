    "image": "https://accessories.three.co.uk/cdn/shop/files/E71033095AppleAirPodsPro3MFHP4ZM_A.png?v=1758181825",
    "url": "https://www.amazon.com/dp/B0FQFB8FMG?tag=buybetterfi06-20"
  },
  {
    "name": "Shark AI Ultra Robot Vacuum",
    "asin": "B09T4YZGQR",
    "description": "A hands-off floor-cleaning option for busy homes.",
    "image": "https://assets.sharkninja.com/image/upload/f_auto/q_auto/SharkNinja-NA/AV2511AE_02.jpg",
    "url": "https://www.amazon.com/dp/B09T4YZGQR?tag=buybetterfi06-20"
  },
  {
    "name": "Owala FreeSip Twist 24 oz",
    "asin": "B0CZ7KJQR9",
    "description": "A portable insulated water bottle for daily hydration.",
    "image": "https://rimage.ripley.com.pe/home.ripley/Attachment/MKP/5742/PMP20001483777/full_image-1.jpeg",
    "url": "https://www.amazon.com/dp/B0CZ7KJQR9?tag=buybetterfi06-20"
  },
  {
    "name": "Walker's Razor Slim Electronic Hearing Protection Earmuffs",
    "asin": "B01AAH8CRU",
    "description": "Low-profile electronic hearing protection. Not music headphones.",
    "image": "https://cdn.broman.group/api/image/v1/image/FF3F7EE1D3FE3CE1BF6C61DC57A6A636E48B7682",
    "url": "https://www.amazon.com/dp/B01AAH8CRU?tag=buybetterfi06-20"
  },
  {
    "name": "Hanes EcoSmart Fleece Sweatshirt",
    "asin": "B01L8JJ57U",
    "description": "A casual fleece layer for cooler days.",
    "image": "https://theparkwholesale.com/cdn/shop/files/Hanes_P160_Black_Front_High_Model_1512x.png?v=1760324819",
    "url": "https://www.amazon.com/dp/B01L8JJ57U?tag=buybetterfi06-20"
  },
  {
    "name": "BAGSMART Crush Puffy Travel Toiletry Bag — Pink",
    "asin": "B0CKYZBRDV",
    "description": "A roomy, wide-open puffy organizer for toiletries and travel essentials.",
    "image": "https://www.bagsmart.com/cdn/shop/files/Crush_Toiletry_Bag_Large_Capacity_1x.webp?v=1767172809",
    "url": "https://www.amazon.com/dp/B0CKYZBRDV?tag=buybetterfi06-20"
  },
  {
    "name": "KitchenAid Prep Bowls",
    "asin": "B0FR2JZ35B",
    "description": "Handy bowls for organizing ingredients while cooking.",
    "image": "https://static.athome.com/images/w_1200%2Ch_1200%2Cc_pad%2Cf_auto%2Cfl_lossy%2Cq_auto/v1703352104/p/124395106_D1/kitchenaid-set-of-4-prep-bowls-aqua-sky.jpg",
