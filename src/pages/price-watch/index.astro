---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { EDITORIAL_TODAY, getPriceWatchStatus, formatPriceWatchDate } from '../../utils/priceWatch.js';
import { getPriceHistory, getCurrentPriceObservation, getFreshCurrentPriceObservation, getLowestObservedPrice } from '../../data/priceHistory.js';
import { amazonProductUrl, amazonSearchUrl } from '../../utils/amazon.js';

const today = EDITORIAL_TODAY;
const tracked = products.filter((product) => product.dailyDealDate || product.price !== 'Check price').sort((a,b) => (b.dailyDealDate || '').localeCompare(a.dailyDealDate || ''));
const featured = products.filter((product) => product.dailyDealDate === today);
const upcoming = products.filter((product) => product.dailyDealDate > today).sort((a,b) => a.dailyDealDate.localeCompare(b.dailyDealDate)).slice(0, 6);
const historyProducts = products.map((product) => ({ product, history: getPriceHistory(product.slug) })).filter(({ history }) => history.length > 0);
const historyCount = historyProducts.reduce((total, item) => total + item.history.length, 0);
const getRetailerUrl = (product) => product.amazonAsin ? amazonProductUrl(product.amazonAsin) : (product.url?.includes('amazon.com') ? product.url : amazonSearchUrl(product.name));
---

<BaseLayout title="Price Watch | Buy Better Finds" description="Track reference prices, understand deal context, and verify current retailer pricing before you buy.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">PRICE WATCH</div>
        <h1>Know the price before you buy.</h1>
        <p>Buy Better Finds uses reference prices to give deals context without pretending a static site has live retailer pricing. When a price matters, verify the current offer at the retailer before purchasing.</p>
      </div>
      <div class="price-card">
        <span>WHAT THIS MEANS</span>
        <strong>Reference price ≠ live price</strong>
        <p>Retail prices can change at any time. We label our prices as reference prices unless we have a verified current price source.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">CURRENTLY TRACKED</div>
          <h2>Products with published reference prices</h2>
          <p>These are editorial reference points, not guarantees of today's Amazon price.</p>
        </div>
      </div>

      <div class="status-grid"><div class="status-card today"><span>TODAY</span><strong>{featured.length ? featured.map((product) => product.name).join(" · ") : "No featured price watch today"}</strong><p>Check the product page and retailer listing for the current offer.</p></div><div class="status-card"><span>NEXT UP</span><strong>{upcoming.length ? upcoming[0].name : "More price-watch features coming"}</strong><p>{upcoming.length ? `Scheduled Deal of the Day feature: ${upcoming[0].dailyDealDate}.` : "We will add new dated features as the editorial queue grows."}</p></div></div>

      <div class="history-summary"><div><span>OBSERVED HISTORY</span><strong>{historyCount}</strong><p>Dated editorial price observations currently recorded.</p></div><div><span>PRODUCTS WITH HISTORY</span><strong>{historyProducts.length}</strong><p>Product pages with at least one dated observation.</p></div><div><span>TRACKING MODEL</span><strong>EDITORIAL</strong><p>Reference observations now; verified live pricing later.</p></div></div>

      <div class="watch-grid">
        {tracked.map((product) => (
          <article class="watch-card">
            <a class="watch-image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>
              <img src={product.image} alt={product.imageAlt} loading="lazy" />
            </a>
            <div class="watch-top">
              <span>{product.category}</span>
              <b>{product.price === 'Check price' ? 'VERIFY PRICE' : 'REFERENCE'}</b>
            </div>
            <h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3>
<div class="watch-price">{getFreshCurrentPriceObservation(getPriceHistory(product.slug)) ? `${getFreshCurrentPriceObservation(getPriceHistory(product.slug)).price.toFixed(2)} ${getFreshCurrentPriceObservation(getPriceHistory(product.slug)).currency}` : (product.price === 'Check price' ? 'Verify current price' : product.price)}</div>
{getFreshCurrentPriceObservation(getPriceHistory(product.slug)) && <div class="current-verified">VERIFIED CURRENT · {formatPriceWatchDate(getFreshCurrentPriceObservation(getPriceHistory(product.slug)).date)}</div>}
            {!getFreshCurrentPriceObservation(getPriceHistory(product.slug)) && getCurrentPriceObservation(getPriceHistory(product.slug)) && <div class="history-stale">Verified observation · {formatPriceWatchDate(getCurrentPriceObservation(getPriceHistory(product.slug)).date)} · refresh needed</div>}
            {!getFreshCurrentPriceObservation(getPriceHistory(product.slug)) && !getCurrentPriceObservation(getPriceHistory(product.slug)) && getLowestObservedPrice(getPriceHistory(product.slug)) && <div class="history-low">Lowest observed: $\{getLowestObservedPrice(getPriceHistory(product.slug)).price.toFixed(2)}</div>}
            {getPriceWatchStatus(product.dailyDealDate)?.key === 'today' && <div class="deal-status live">DEAL OF THE DAY · TODAY</div>}
            {getPriceWatchStatus(product.dailyDealDate)?.key === 'upcoming' && <div class="deal-status upcoming">DEAL SCHEDULED · {formatPriceWatchDate(product.dailyDealDate)}</div>}
            {getPriceWatchStatus(product.dailyDealDate)?.key === 'past' && <div class="deal-status past">FEATURED · {formatPriceWatchDate(product.dailyDealDate)}</div>}
            <p>{product.watch}</p>
            <div class="watch-actions"><a class="watch-link" href={`/products/${product.slug}/`}>Review &amp; buying context →</a>{product.dailyDealDate && <a class="deal-link" href="/deals/">View deal history →</a>}</div>
            <a class="verify-retailer" href={getRetailerUrl(product)} target="_blank" rel="nofollow sponsored noopener">Verify current price at Amazon →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {historyProducts.length > 0 && (
    <section class="section history-section">
      <div class="container">
        <div class="section-head"><div><div class="eyebrow">OBSERVED PRICE HISTORY</div><h2>What we've actually recorded</h2><p>Only dated observations that have been recorded in the site's Price Watch data appear here. This is not a claim of Amazon's historical pricing.</p></div></div>
        <div class="history-table">
          {historyProducts.map(({ product, history }) => (
            <article class="history-item">
              <div><span>{product.category}</span><h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3></div>
              <div class="history-entries">
                {history.slice().reverse().map((entry) => <div><span>{formatPriceWatchDate(entry.date)}</span><strong>${entry.price.toFixed(2)} {entry.currency}</strong><small>{entry.source}</small></div>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section context">
    <div class="container context-grid">
      <div>
        <div class="eyebrow">HOW TO READ PRICE WATCH</div>
        <h2>We separate price context from product judgment.</h2>
        <p>A lower price does not automatically make a product a better fit. Our product pages explain strengths, tradeoffs, and who the product is best for.</p>
      </div>
      <div class="rules">
        <div><strong>Reference price</strong><span>A published price point used for context.</span></div>
        <div><strong>Deal of the Day</strong><span>A featured editorial opportunity, not a guarantee of the lowest price.</span></div>
        <div><strong>Check on Amazon</strong><span>Use the retailer link to verify the current price and availability.</span></div>
      </div>
    </div>
  </section>

  <section class="section next">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">NEXT PHASE</div>
          <h2>Verified price tracking is the next phase.</h2>
          <p>When a retailer price is explicitly verified, we record it as a dated observation. Fresh observations can power the site's active-price data without turning an old price into a live claim.</p>
        </div>
        <a class="btn primary" href="/products/">Browse product reviews →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.hero{background:var(--navy);color:#fff;padding:72px 0}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:42px;align-items:center}.hero h1{font-size:clamp(38px,5vw,62px);line-height:1.02;margin:10px 0 18px;color:#fff}.hero p{font-size:17px;line-height:1.65;color:#dbe5ef;max-width:700px}.eyebrow{letter-spacing:.12em;font-weight:900;font-size:10px}.price-card{background:#fff;color:var(--navy);border-radius:16px;padding:28px;box-shadow:0 20px 50px #0002}.price-card span{font-size:10px;letter-spacing:.12em;color:#1d4ed8;font-weight:900}.price-card strong{display:block;font-size:24px;margin:10px 0}.price-card p{color:#64748b;font-size:14px;line-height:1.55;margin:0}.status-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 0 28px}.status-card{border:1px solid var(--line);border-radius:14px;padding:20px;background:#f8fafc}.status-card.today{background:#fff7f8;border-color:#f1c6cd}.status-card span{font-size:9px;letter-spacing:.12em;color:#c8102e;font-weight:900}.status-card strong{display:block;color:var(--navy);font-size:17px;line-height:1.35;margin:8px 0}.status-card p{margin:0;color:var(--muted);font-size:12px;line-height:1.5}.watch-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.watch-card{border:1px solid var(--line);border-radius:14px;padding:16px;background:#fff;display:flex;flex-direction:column;min-height:205px}.watch-image{height:175px;border-radius:10px;background:radial-gradient(circle at 50% 40%,#fff 0,#f1f5f9 55%,#e5ebf1 100%);display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:16px}.watch-image img{width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;padding:18px;box-sizing:border-box;display:block}.watch-top{display:flex;justify-content:space-between;gap:10px;font-size:10px;letter-spacing:.08em;font-weight:900}.watch-top span{color:#1d4ed8}.watch-top b{color:#64748b}.watch-card h3{font-size:19px;line-height:1.3;margin:12px 0}.watch-card h3 a{color:var(--navy);text-decoration:none}.watch-price{font-size:24px;font-weight:900;color:var(--navy)}.history-low{font-size:11px;color:#64748b;margin-top:4px}.current-verified{display:inline-block;margin-top:6px;padding:4px 6px;border-radius:4px;background:#e9f7ef;color:#176b3a;font-size:9px;font-weight:900;letter-spacing:.05em}.history-stale{display:inline-block;margin-top:6px;padding:4px 6px;border-radius:4px;background:#fff7ed;color:#9a5a00;font-size:9px;font-weight:900;letter-spacing:.03em}.verify-retailer{display:block;margin-top:10px;padding-top:10px;border-top:1px solid var(--line);font-size:11px;color:#c8102e;font-weight:900;text-decoration:none}.verify-retailer:hover{text-decoration:underline}.history-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 0 28px}.history-summary>div{background:#f8fafc;border:1px solid var(--line);border-radius:12px;padding:16px}.history-summary span{display:block;font-size:9px;letter-spacing:.12em;color:#1d4ed8;font-weight:900}.history-summary strong{display:block;color:var(--navy);font-size:24px;margin-top:4px}.history-summary p{margin:4px 0 0;color:var(--muted);font-size:11px;line-height:1.45}.history-section{background:#fff}.history-table{border-top:1px solid var(--line)}.history-item{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px;padding:20px 0;border-bottom:1px solid var(--line)}.history-item>div:first-child span{font-size:9px;letter-spacing:.08em;color:#1d4ed8;font-weight:900}.history-item h3{font-size:18px;line-height:1.3;margin:7px 0}.history-item h3 a{color:var(--navy);text-decoration:none}.history-entries{display:grid;gap:8px}.history-entries>div{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:12px;padding:10px 12px;background:#f8fafc;border-radius:8px;align-items:center}.history-entries span{font-size:11px;color:#64748b}.history-entries strong{font-size:13px;color:var(--navy)}.history-entries small{font-size:10px;color:#64748b}@media(max-width:900px){.history-summary{grid-template-columns:1fr}.history-item{grid-template-columns:1fr}.history-entries>div{grid-template-columns:1fr 1fr}.history-entries small{grid-column:1/-1}}.deal-status{display:inline-block;align-self:flex-start;margin-top:9px;padding:5px 7px;border-radius:5px;font-size:9px;font-weight:900;letter-spacing:.06em}.deal-status.live{background:#c8102e;color:#fff}.deal-status.upcoming{background:#eef4fb;color:#2366a8}.deal-status.past{background:#f1f5f9;color:#64748b}.watch-actions{margin-top:auto;padding-top:14px;display:flex;justify-content:space-between;gap:10px;align-items:center}.watch-actions .watch-link{margin-top:0}.deal-link{font-size:11px;color:#64748b;font-weight:800}.watch-card p{font-size:13px;line-height:1.55;color:var(--muted);margin:8px 0 14px}.watch-link{font-size:12px;color:#1d4ed8;font-weight:900;margin-top:auto}.context{background:#f8fafc}.context-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px}.context h2{font-size:32px;color:var(--navy);margin:8px 0 12px}.context p{color:var(--muted);line-height:1.6}.rules{display:grid;gap:12px}.rules div{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}.rules strong{display:block;color:var(--navy);font-size:14px}.rules span{display:block;color:var(--muted);font-size:12px;line-height:1.5;margin-top:5px}.next{padding-bottom:85px}.next .section-head{align-items:center}@media(max-width:900px){.watch-grid{grid-template-columns:1fr 1fr}.status-grid{grid-template-columns:1fr}.hero-grid,.context-grid{grid-template-columns:1fr}}@media(max-width:600px){.watch-grid{grid-template-columns:1fr}.watch-image{height:165px}.watch-image img{padding:16px}.hero{padding:55px 0}.hero h1{font-size:42px}.price-card{padding:22px}}
</style>