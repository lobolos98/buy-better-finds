---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { products } from '../../data/products.js';
import { getRecommendation } from '../../data/recommendations.js';
import { amazonProductUrl, amazonSearchUrl } from '../../utils/amazon.js';
import { getPriceWatchStatus, formatPriceWatchDate } from '../../utils/priceWatch.js';
import { getPriceHistory, getCurrentPriceObservation, getFreshCurrentPriceObservation, getLowestObservedPrice } from '../../data/priceHistory.js';

const guideMap = {
  tech: { label: 'Best Tech Products', href: '/guides/best-tech/' },
  'home-kitchen': { label: 'Best Home & Kitchen Products', href: '/guides/best-home-kitchen/' },
  'tools-diy': { label: 'Best Tools & DIY Products', href: '/guides/best-tools-diy/' },
  outdoor: { label: 'Best Outdoor Products', href: '/guides/best-outdoor/' },
  'smart-home': { label: 'Best Smart Home Products', href: '/guides/best-smart-home/' },
  fitness: { label: 'Best Fitness Watches', href: '/guides/best-fitness-watches/' },
  lifestyle: { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'gifts-collectibles': { label: 'Best Gifts & Collectibles', href: '/categories/gifts-collectibles/' }
};

const comparisonMap = {
  'sony-wh-1000xm5': { label: 'Sony WH-1000XM5 vs AirPods 5', href: '/comparisons/sony-wh-1000xm5-vs-airpods-4/' },
  'apple-airpods-4': { label: 'Sony WH-1000XM5 vs AirPods 5', href: '/comparisons/sony-wh-1000xm5-vs-airpods-4/' },
  'ninja-af101': { label: 'Ninja AF101 vs Instant Vortex Plus', href: '/comparisons/ninja-af101-vs-instant-vortex-plus/' },
  'instant-vortex-plus': { label: 'Ninja AF101 vs Instant Vortex Plus', href: '/comparisons/ninja-af101-vs-instant-vortex-plus/' },
  'dyson-v8': { label: 'Dyson V8 vs Shark Navigator', href: '/comparisons/dyson-v8-vs-shark-navigator/' },
  'shark-navigator-lift-away': { label: 'Dyson V8 vs Shark Navigator', href: '/comparisons/dyson-v8-vs-shark-navigator/' },
  'yeti-rambler': { label: 'YETI Rambler vs Stanley Quencher', href: '/comparisons/yeti-rambler-vs-stanley-quencher/' },
  'stanley-quencher': { label: 'YETI Rambler vs Stanley Quencher', href: '/comparisons/yeti-rambler-vs-stanley-quencher/' },
  'tp-link-ep40m': { label: 'TP-Link Outdoor Plug vs Ring Doorbell', href: '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/' },
  'ring-battery-doorbell': { label: 'TP-Link Outdoor Plug vs Ring Doorbell', href: '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/' }
};

const guideByName = {
  'Sony WH-1000XM5 Noise-Canceling Headphones': { label: 'Best Noise-Canceling Headphones', href: '/guides/best-noise-canceling-headphones/' },
  'Apple AirPods 5': { label: 'Best Noise-Canceling Headphones', href: '/guides/best-noise-canceling-headphones/' },
  'Ninja 4-Qt Air Fryer AF101': { label: 'Best Air Fryers', href: '/guides/best-air-fryers/' },
  'Instant Vortex Plus Air Fryer': { label: 'Best Air Fryers', href: '/guides/best-air-fryers/' },
  'Dyson V8 Cordless Vacuum': { label: 'Best Cordless & Everyday Vacuums', href: '/guides/best-vacuums/' },
  'Shark Navigator Lift-Away': { label: 'Best Cordless & Everyday Vacuums', href: '/guides/best-vacuums/' },
  'DEWALT 20V MAX Drill/Impact Driver Combo Kit': { label: 'Best Tools for Homeowners', href: '/guides/best-homeowner-drills/' },
  'Solo Stove Tower Patio Heater': { label: 'Best Patio Heaters', href: '/guides/best-patio-heaters/' },
  'TP-Link Kasa Smart Outdoor Plug EP40M': { label: 'Best Smart Plugs', href: '/guides/best-smart-plugs/' },
  'Garmin Forerunner 265': { label: 'Best Fitness Watches', href: '/guides/best-fitness-watches/' },
  'YETI Rambler Drinkware': { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'Stanley Quencher H2.0 Tumbler': { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'OXO Good Grips Refrigerator Organization Set': { label: 'Best Home Organization Products', href: '/guides/best-home-organization/' }
};

export function getStaticPaths() {
  return products
    .filter((product) => product && typeof product.slug === 'string' && product.slug.length > 0)
    .map((product) => ({
      params: { slug: String(product.slug) },
      props: { product }
    }));
}

const { product } = Astro.props;
const recommendationCase = {
  'sony-wh-1000xm5': 'Its strongest case is the combination of active noise cancellation, long-session comfort, and premium everyday listening features for travel and focused work.',
  'apple-airpods-5': 'The appeal is convenience: a compact everyday listening option that fits naturally into the Apple ecosystem without the bulk of over-ear headphones.',
  'apple-ipad-a16': 'Its value is versatility—a fast tablet that can handle streaming, browsing, schoolwork, and light productivity without requiring a full laptop setup.',
  'apple-watch-series-10': 'The case is the combination of fitness tracking and smartwatch functions in one device, especially for shoppers already using an iPhone.',
  'anker-nano-power-bank': 'Its biggest advantage is portability, making it useful for everyday backup power when carrying a larger power bank would be unnecessary.',
  'logitech-mx-master-3s': 'It is built for productivity, with controls and multi-device features that become more useful the more time you spend working at a desktop.',
  'ninja-af101': 'The 4-quart format makes this a practical choice for smaller households that want quick countertop cooking without a large appliance footprint.',
  'govee-smart-light-bulbs': 'The reason to consider these is the flexibility of adding app-controlled, customizable lighting without replacing an entire lighting system.',
  'oxo-everyday-cutting-board': 'Its case is everyday kitchen practicality: a dedicated prep surface that is easy to reach for during routine chopping and food preparation.',
  'dyson-v8': 'The strongest case is grab-and-go cordless cleaning for quick messes and hard-to-reach areas rather than maximum whole-home runtime.',
  'instant-vortex-plus': 'It is worth considering when you want a versatile countertop cooker and more functions than a basic air fryer, while still keeping the workflow simple.',
  'shark-navigator-lift-away': 'Its case is whole-home versatility: an upright format for floor coverage plus a lift-away design for stairs and above-floor cleaning.',
  'skil-brushless-flip-drill': 'The flip-head design solves a practical problem by making tight-space drilling and driving easier than with a conventional fixed-head drill.',
  'solo-stove-tower': 'This is aimed at outdoor entertaining where a tall patio format and visual presentation matter alongside heat output.',
  'weber-spirit-e210': 'The compact two-burner format is the main reason to consider it when you want straightforward backyard grilling without a large grill footprint.',
  'tp-link-ep40m': 'Its case is outdoor automation: two independently controlled outlets, scheduling, and outdoor-oriented construction make it useful for lights and other connected devices.',
  'ring-battery-doorbell': 'The battery format provides installation flexibility when running new wiring is inconvenient, but subscription costs should be part of the buying decision.',
  'amazon-echo-dot': 'Its value grows when you want a compact voice-control hub for timers, music, and compatible smart-home routines.',
  'yeti-rambler': 'The case is durable insulated drinkware for people who carry drinks regularly and want to choose a size and lid configuration around their routine.',
  'stanley-quencher': 'Its strongest case is high-volume hydration for people who want to carry a large drink throughout the day, provided the larger footprint works for them.'
};

const recommendation = getRecommendation(product);
const related = products.filter((item) => item.slug !== product.slug && item.category === product.category).slice(0, 3);
const categorySlug = product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const categoryGuide = guideMap[categorySlug];
const focusedGuide = guideByName[product.name];
const comparison = comparisonMap[product.slug];
const guideHref = focusedGuide?.href ?? categoryGuide?.href;
const guideLabel = focusedGuide?.label ?? categoryGuide?.label;
const exactDealAmazonUrl = 'https://www.amazon.com/dp/B0C6XJNKP8/ref=cm_sw_r_as_gl_apa_gl_i_TT11G26RB9T7ADWVK57N?linkCode=ml1&tag=buybetterfi06-20&linkId=e9bec15ede862289c17773f1aff94a3f&gaOptInStatus=true';
const exactSeesiiAmazonUrl = 'https://www.amazon.com/dp/B0CS3FF4RF?tag=buybetterfi06-20';
const affiliateUrl = product.amazonAsin === 'B0C6XJNKP8'
  ? exactDealAmazonUrl
  : (product.amazonAsin === 'B0F2J118F4' || product.amazonAsin === 'B0CS3FF4RF')
    ? exactSeesiiAmazonUrl
    : (product.amazonUrl
      ?? (product.amazonAsin ? amazonProductUrl(product.amazonAsin)
      : (product.url?.includes('amazon.com') ? product.url : amazonSearchUrl(product.name))));
const reviewDate = 'September 22, 2026';
const dealStatus = getPriceWatchStatus(product.dailyDealDate);
const priceHistory = getPriceHistory(product.slug);
const lowestObserved = getLowestObservedPrice(priceHistory);
const verifiedCurrentPrice = getCurrentPriceObservation(priceHistory);
const freshCurrentPrice = getFreshCurrentPriceObservation(priceHistory);
const canonicalUrl = new URL(Astro.url.pathname, 'https://buybetterfinds.com').toString();
const metaDescription = `${product.name}: independent buying guidance for ${product.category.toLowerCase()} shoppers, including strengths, tradeoffs, best-for use cases, and price context.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'All Finds', item: 'https://buybetterfinds.com/products/' },
    { '@type': 'ListItem', position: 2, name: product.category, item: `https://buybetterfinds.com/categories/${categorySlug}/` },
    { '@type': 'ListItem', position: 3, name: product.name, item: canonicalUrl }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: [new URL(product.image, 'https://buybetterfinds.com').toString()],
  description: product.why,
  url: canonicalUrl,
  ...(freshCurrentPrice ? { offers: { '@type': 'Offer', url: affiliateUrl, price: freshCurrentPrice.price, priceCurrency: freshCurrentPrice.currency, availability: 'https://schema.org/InStock' } } : {}),
  review: {
    '@type': 'Review',
    author: { '@type': 'Organization', name: 'Buy Better Finds' },
    datePublished: '2026-09-22',
    reviewBody: `${product.why} Best for: ${recommendation.bestFor} Key tradeoff: ${recommendation.skipIf}`,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: recommendation.score ?? 1,
      bestRating: 10,
      worstRating: 1
    },
    positiveNotes: {
      '@type': 'ItemList',
      itemListElement: (recommendation.pros ?? []).map((name, index) => ({
        '@type': 'ListItem', position: index + 1, name
      }))
    },
    negativeNotes: {
      '@type': 'ItemList',
      itemListElement: (recommendation.cons ?? []).map((name, index) => ({
        '@type': 'ListItem', position: index + 1, name
      }))
    }
  }
})} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<BaseLayout title={`${product.name} | Buy Better Finds`} description={metaDescription} image={product.image} imageAlt={product.imageAlt}>
  <section class="section product-page">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/products/">All Finds</a><span>/</span>
        <a href={`/categories/${categorySlug}/`}>{product.category}</a><span>/</span>
        <strong>{product.name}</strong>
      </div>

      <div class="product-detail">
        <div class="product-detail-visual">
          <div class="find-badge">BUY BETTER FIND</div>
          <div class="product-photo">
            <img src={product.image} alt={product.imageAlt} width="1000" height="750" onerror="if(this.dataset.fallback){this.style.display='none'; this.nextElementSibling.style.display='flex';} else if(this.dataset.fallbackUrl){this.dataset.fallback='1'; this.src=this.dataset.fallbackUrl;}" data-fallback-url={product.imageFallback || undefined} />
            <div class="product-image-fallback" style="display:none">Product image unavailable</div>
            <div class="photo-fallback" aria-hidden="true"><span>{product.icon}</span><small>{product.category}</small></div>
          </div>
          <span class="category-label">{product.category}</span>
        </div>

        <div class="product-detail-copy">
          <div class="eyebrow">BUY BETTER FIND · {product.category}</div>
          <h1>{product.name}</h1>
          <p class="lead">{product.why}</p>

          <div class="review-meta">
            <span>Research updated: {reviewDate}</span>
            <a href="/why-we-recommend/">How we evaluate →</a>
          </div>

          <div class="score-panel">
            <div class="score-ring"><strong>{recommendation.score ?? '—'}</strong><span>/10</span></div>
            <div>
              <div class="score-label">BUY BETTER SCORE</div>
              <strong class="score-status">{recommendation.label}</strong>
              <p>Editorial score based on practical fit, value, useful features, and documented tradeoffs—not paid placement.</p>
            </div>
          </div>

          <div class="verdict">
            <div class="verdict-label">QUICK ANSWER · BEST FOR</div>
            <p>{recommendation.bestFor}</p>
            <small>Skip it if: {recommendation.skipIf}</small>
          </div>

          <div class="price-box">
            <div class="price-context-head">
              <span>PRICE WATCH</span>
              {dealStatus?.key === 'today' && <b class="deal-live">DEAL OF THE DAY · TODAY</b>}
              {dealStatus?.key === 'upcoming' && <b>DEAL SCHEDULED · {formatPriceWatchDate(product.dailyDealDate)}</b>}
              {dealStatus?.key === 'past' && <b class="deal-past">FEATURED · {formatPriceWatchDate(product.dailyDealDate)}</b>}
            </div>
            {verifiedCurrentPrice ? <><strong>${verifiedCurrentPrice.price.toFixed(2)} {verifiedCurrentPrice.currency}</strong><small>Verified current price · {formatPriceWatchDate(verifiedCurrentPrice.date)}. Prices and availability can change.</small></> : <><strong>{product.price}</strong><small>Reference price only. Prices and availability can change. Verify the current offer at the retailer.</small></>}
            {dealStatus && <a class="price-watch-link" href="/price-watch/">See Price Watch context →</a>}
          </div>

          <div class="detail-actions">
            <a class="btn primary amazon-btn" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a>
            <a class="btn secondary" href="/products/">Browse all finds</a>
          </div>

          <p class="disclosure">We may earn a commission from qualifying purchases when affiliate links are used. Our recommendations are based on product fit and editorial evaluation, not commission size.</p>
        </div>
      </div>

      <section class="recommendation-breakdown" aria-labelledby="why-recommend-heading">
        <div class="recommendation-breakdown-grid">
          <div class="recommendation-card">
            <div class="eyebrow">WHY WE RECOMMEND IT</div>
            <h2 id="why-recommend-heading">The case for this find</h2>
            <p class="recommendation-case">{recommendationCase[product.slug] ?? product.why}</p><ul>{(recommendation.pros ?? []).map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="recommendation-card caution">
            <div class="eyebrow">WHAT COULD CHANGE OUR RECOMMENDATION</div>
            <h2>Know the tradeoffs</h2>
            <ul>{(recommendation.cons ?? []).map((item) => <li>{item}</li>)}</ul>
            <p class="recommendation-skip"><strong>Skip it if:</strong> {recommendation.skipIf}</p>
          </div>
        </div>
      </section>

      {priceHistory.length > 0 && (
        <section class="price-history" aria-labelledby="price-history-heading">
          <div class="section-head">
            <div>
              <div class="eyebrow">PRICE WATCH HISTORY</div>
              <h2 id="price-history-heading">Observed price context</h2>
              <p>These are dated Buy Better Finds observations. Current-price entries are explicitly verified retailer observations; reference entries are editorial context only.</p>
            </div>
            {lowestObserved && <div class="price-history-low"><span>LOWEST OBSERVED</span><strong>${lowestObserved.price.toFixed(2)}</strong></div>}
          </div>
          <div class="price-history-list">
            {priceHistory.slice().reverse().map((entry) => (
              <div class="price-history-row">
                <span>{formatPriceWatchDate(entry.date)}</span>
                <strong>${entry.price.toFixed(2)} {entry.currency}</strong>
                <small>{entry.source}</small>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="decision-paths" aria-labelledby="research-heading">
        <div class="section-head research-heading">
          <div>
            <div class="eyebrow">CONTINUE RESEARCHING</div>
            <h2 id="research-heading">Build the bigger picture</h2>
            <p>Move from this individual product to the broader category, guide, comparison, and related finds.</p>
          </div>
        </div>

        <div class="research-link-grid">
          <a class="research-link-card" href={`/categories/${categorySlug}/`}>
            <span>CATEGORY</span>
            <h3>{product.category}</h3>
            <p>Browse more {product.category.toLowerCase()} finds in one place.</p>
            <strong>Explore category →</strong>
          </a>

          {guideHref && (
            <a class="research-link-card" href={guideHref}>
              <span>SHOPPING GUIDE</span>
              <h3>{guideLabel}</h3>
              <p>See the broader shortlist and the buying considerations behind it.</p>
              <strong>Read the guide →</strong>
            </a>
          )}

          {comparison && (
            <a class="research-link-card" href={comparison.href}>
              <span>COMPARISON</span>
              <h3>{comparison.label}</h3>
              <p>Put this find next to a relevant alternative before deciding.</p>
              <strong>See the comparison →</strong>
            </a>
          )}
        </div>
      </section>

      {related.length > 0 && (
        <section class="related-finds" aria-labelledby="related-heading">
          <div class="section-head">
            <div>
              <div class="eyebrow">MORE TO CONSIDER</div>
              <h2 id="related-heading">Related {product.category} finds</h2>
              <p>Keep researching without leaving the category.</p>
            </div>
            <a class="arrow" href={`/categories/${categorySlug}/`}>View category →</a>
          </div>

          <div class="products related-product-grid">
            {related.map((item) => (
              <article class="product">
                <a href={`/products/${item.slug}/`} class="product-img" aria-label={`View ${item.name}`}>
                  <div class="product-mark">{item.category}</div>
                  <div class="product-art">
                    <img src={item.image} alt={item.imageAlt} loading="lazy" width="400" height="300" />
                  </div>
                </a>
                <div class="product-body">
                  <div class="tag">{item.category}</div>
                  <h3><a href={`/products/${item.slug}/`}>{item.name}</a></h3>
                  <p>{item.why}</p>
                  <div class="best-for"><strong>Best for:</strong> {item.bestFor}</div>
                  <div class="watch"><strong>Watch:</strong> {item.watch}</div>
                  <div class="price"><span>Reference price</span><strong>{item.price}</strong></div>
                  <a class="shop" href={`/products/${item.slug}/`}>See our take →</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <ComparisonTable product={product} related={related} />
    </div>
  </section>
</BaseLayout>

<style>
.product-page{padding-top:34px}.breadcrumbs{display:flex;gap:9px;align-items:center;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-bottom:28px}.breadcrumbs a{color:var(--blue);font-weight:800}.breadcrumbs strong{color:var(--navy);font-weight:800}.product-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:42px;align-items:start}.product-detail-visual{position:sticky;top:98px}.find-badge{position:absolute;top:16px;left:16px;z-index:2;background:var(--gold);color:#fff;font-size:10px;font-weight:900;letter-spacing:1px;padding:7px 10px;border-radius:5px}.product-photo{height:520px;width:100%;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,#f8fafc,#e9f0f6);display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}.product-photo img{display:block;width:auto;height:auto;max-width:84%;max-height:84%;object-fit:contain}.photo-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;color:var(--navy);background:linear-gradient(145deg,#f1f5f9,#e6edf4)}.photo-fallback span{font-size:56px}.photo-fallback small{font-size:11px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--blue);margin-top:8px}.category-label{display:block;margin-top:10px;text-transform:uppercase;letter-spacing:1px;font-size:10px;color:var(--muted);font-weight:900}.product-detail-copy{min-width:0}.product-detail-copy .eyebrow{margin-bottom:9px}.product-detail-copy h1{font-size:44px;line-height:1.08;letter-spacing:-1.5px;color:var(--navy);margin:0 0 15px}.product-detail-copy .lead{font-size:18px;line-height:1.65;color:var(--muted);margin:0 0 18px}.review-meta{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:12px 0;margin-bottom:18px;font-size:11px;color:var(--muted)}.review-meta a{color:var(--blue);font-weight:900}.score-panel{display:flex;gap:16px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:13px;padding:16px;margin-bottom:14px}.score-ring{width:68px;height:68px;flex:0 0 68px;border:5px solid var(--blue);border-radius:50%;display:flex;align-items:center;justify-content:center;line-height:1;color:var(--navy)}.score-ring strong{font-size:21px}.score-ring span{font-size:9px;color:var(--muted);margin-top:9px}.score-label{font-size:9px;letter-spacing:1.2px;color:var(--blue);font-weight:900}.score-status{display:block;color:var(--navy);font-size:15px;margin-top:3px}.score-panel p{font-size:11px;line-height:1.45;color:var(--muted);margin:4px 0 0}.verdict{background:#eef4f9;border-left:4px solid var(--blue);border-radius:0 9px 9px 0;padding:14px 16px;margin-bottom:14px}.verdict-label{font-size:9px;letter-spacing:1.1px;color:var(--blue);font-weight:900}.verdict p{font-size:15px;line-height:1.5;font-weight:800;color:var(--navy);margin:5px 0}.verdict small{font-size:11px;line-height:1.45;color:var(--muted)}.price-box{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:15px}.price-box>strong{display:block;color:var(--navy);font-size:25px;margin-top:8px}.price-box>small{display:block;color:var(--muted);font-size:11px;line-height:1.45;margin-top:3px}.detail-actions{display:flex;gap:10px}.detail-actions .btn{flex:1;text-align:center}.disclosure{font-size:10px;line-height:1.5;color:var(--muted);margin:11px 0 0}.price-history{margin-top:55px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:25px}.price-history-list{border-top:1px solid var(--line)}.price-history-row{display:grid;grid-template-columns:1fr auto 1.4fr;gap:15px;align-items:center;padding:11px 0;border-bottom:1px solid #edf0f3;font-size:12px}.price-history-row strong{color:var(--navy)}.price-history-row small{color:var(--muted)}.price-history-low{background:#f5f8fb;border:1px solid var(--line);border-radius:10px;padding:10px 14px;text-align:right}.price-history-low span{display:block;font-size:9px;letter-spacing:1px;color:var(--muted);font-weight:900}.price-history-low strong{display:block;font-size:20px;color:var(--navy);margin-top:2px}.related-product-grid .product-art{display:flex;align-items:center;justify-content:center;width:100%;height:100%}.related-product-grid .product-art img{display:block;object-fit:contain}.decision-paths{margin-top:55px}.recommendation-breakdown{margin-top:42px}
  .research-link-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .research-link-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px;display:flex;flex-direction:column;min-height:190px;transition:.2s}
