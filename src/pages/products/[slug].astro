---

import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { products } from '../../data/products.js';
import { getRecommendation } from '../../data/recommendations.js';
import { amazonSearchUrl } from '../../utils/amazon.js';

const guideMap = {
  tech: { label: 'Best Tech Products', href: '/guides/best-tech/' },
  'home-kitchen': { label: 'Best Home & Kitchen Products', href: '/guides/best-home-kitchen/' },
  'tools-diy': { label: 'Best Tools & DIY Products', href: '/guides/best-tools-diy/' },
  outdoor: { label: 'Best Outdoor Products', href: '/guides/best-outdoor/' },
  'smart-home': { label: 'Best Smart Home Products', href: '/guides/best-smart-home/' },
  fitness: { label: 'Best Fitness Watches', href: '/guides/best-fitness-watches/' },
  lifestyle: { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' }
};

const comparisonMap = {
  'sony-wh-1000xm5-noise-canceling-headphones': { label: 'Sony WH-1000XM5 vs AirPods 4', href: '/comparisons/sony-wh-1000xm5-vs-airpods-4/' },
  'apple-airpods-4': { label: 'Sony WH-1000XM5 vs AirPods 4', href: '/comparisons/sony-wh-1000xm5-vs-airpods-4/' },
  'ninja-4-qt-air-fryer-af101': { label: 'Ninja AF101 vs Instant Vortex Plus', href: '/comparisons/ninja-af101-vs-instant-vortex-plus/' },
  'instant-vortex-plus-air-fryer': { label: 'Ninja AF101 vs Instant Vortex Plus', href: '/comparisons/ninja-af101-vs-instant-vortex-plus/' },
  'dyson-v8-cordless-vacuum': { label: 'Dyson V8 vs Shark Navigator', href: '/comparisons/dyson-v8-vs-shark-navigator/' },
  'shark-navigator-lift-away': { label: 'Dyson V8 vs Shark Navigator', href: '/comparisons/dyson-v8-vs-shark-navigator/' },
  'yeti-rambler-drinkware': { label: 'YETI Rambler vs Stanley Quencher', href: '/comparisons/yeti-rambler-vs-stanley-quencher/' },
  'stanley-quencher-h2-0-tumbler': { label: 'YETI Rambler vs Stanley Quencher', href: '/comparisons/yeti-rambler-vs-stanley-quencher/' },
  'tp-link-kasa-smart-outdoor-plug-ep40m': { label: 'TP-Link Outdoor Plug vs Ring Doorbell', href: '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/' },
  'ring-battery-doorbell': { label: 'TP-Link Outdoor Plug vs Ring Doorbell', href: '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/' }
};

const guideByName = {
  'Sony WH-1000XM5 Noise-Canceling Headphones': { label: 'Best Noise-Canceling Headphones', href: '/guides/best-noise-canceling-headphones/' },
  'Apple AirPods 4': { label: 'Best Noise-Canceling Headphones', href: '/guides/best-noise-canceling-headphones/' },
  'Ninja 4-Qt Air Fryer AF101': { label: 'Best Air Fryers', href: '/guides/best-air-fryers/' },
  'Instant Vortex Plus Air Fryer': { label: 'Best Air Fryers', href: '/guides/best-air-fryers/' },
  'Dyson V8 Cordless Vacuum': { label: 'Best Cordless & Everyday Vacuums', href: '/guides/best-vacuums/' },
  'Shark Navigator Lift-Away': { label: 'Best Cordless & Everyday Vacuums', href: '/guides/best-vacuums/' },
  'DEWALT 20V MAX Drill/Impact Driver Combo Kit': { label: 'Best Tools for Homeowners', href: '/guides/best-homeowner-drills/' },
  'Solo Stove Tower Patio Heater': { label: 'Best Patio Heaters', href: '/guides/best-patio-heaters/' },
  'TP-Link Kasa Smart Outdoor Plug EP40M': { label: 'Best Smart Plugs', href: '/guides/best-smart-plugs/' },
  'Garmin Forerunner 265': { label: 'Best Fitness Watches', href: '/guides/best-fitness-watches/' },
  'YETI Rambler Drinkware': { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'Stanley Quencher H2.0 Tumbler': { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'OXO Good Grips Refrigerator Organization Set': { label: 'Best Home Organization Products', href: '/guides/best-home-organization/' }
};

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const recommendation = getRecommendation(product);
const related = products.filter((item) => item.slug !== product.slug && item.category === product.category).slice(0, 3);
const categorySlug = product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const categoryGuide = guideMap[categorySlug];
const focusedGuide = guideByName[product.name];
const comparison = comparisonMap[product.slug];
const affiliateUrl = product.url?.includes('amazon.com') ? product.url : amazonSearchUrl(product.name);
const reviewDate = 'September 22, 2026';
const canonicalUrl = new URL(Astro.url.pathname, 'https://buybetterfinds.com').toString();
---
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: [new URL(product.image, 'https://buybetterfinds.com').toString()],
  description: product.why,
  url: canonicalUrl,
  review: {
    '@type': 'Review',
    author: { '@type': 'Organization', name: 'Buy Better Finds' },
    reviewBody: `${product.why} Best for: ${recommendation.bestFor} Key tradeoff: ${recommendation.skipIf}`,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: recommendation.score ?? 1,
      bestRating: 10,
      worstRating: 1
    }
  }
})} />

<BaseLayout title={`${product.name} | Buy Better Finds`} description={`${product.name}: independent buying guidance, strengths, tradeoffs, and practical product information.`}>
  <section class="section product-page">
    <div class="container">
      <div class="breadcrumbs"><a href="/products/">All Finds</a><span>/</span><a href={`/categories/${categorySlug}/`}>{product.category}</a><span>/</span><strong>{product.name}</strong></div>
      <div class="product-detail">
        <div class="product-detail-visual"><div class="find-badge">BUY BETTER FIND</div><div class="product-photo"><img src={product.image} alt={product.imageAlt} width="1000" height="750" /><div class="photo-fallback" aria-hidden="true"><span>{product.icon}</span><small>{product.category}</small></div></div><span class="category-label">{product.category}</span></div>
        <div class="product-detail-copy">
          <div class="eyebrow">BUY BETTER FIND · {product.category}</div><h1>{product.name}</h1><p class="lead">{product.why}</p>
          <div class="review-meta"><span>Research updated: {reviewDate}</span><a href="/why-we-recommend/">How we evaluate →</a></div>
          <div class="score-panel"><div class="score-ring"><strong>{recommendation.score ?? '—'}</strong><span>/10</span></div><div><div class="score-label">BUY BETTER SCORE</div><strong class="score-status">{recommendation.label}</strong><p>Editorial score based on practical fit, value, useful features, and documented tradeoffs—not paid placement.</p></div></div>
          <div class="verdict"><div class="verdict-label">QUICK ANSWER · BEST FOR</div><p>{recommendation.bestFor}</p><small>Skip it if: {recommendation.skipIf}</small></div>
          <div class="price-box"><span>Reference price</span><strong>{product.price}</strong><small>Prices and availability can change. Verify the current offer at the retailer.</small></div>
          <div class="detail-actions"><a class="btn primary" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon · Paid link →</a><a class="btn secondary" href="/products/">Browse all finds</a></div>
          <p class="disclosure">We may earn a commission from qualifying purchases when affiliate links are used. Our recommendations are based on product fit and editorial evaluation, not commission size.</p>
        </div>
      </div>

      <section class="decision-paths" aria-label="Continue researching this product">
        <div class="path-card"><span>SHOPPING GUIDE</span><h3>{focusedGuide?.label ?? categoryGuide?.label ?? `Best ${product.category} Products`}</h3><p>See this product in a broader shortlist with practical alternatives and buying considerations.</p><a href={focusedGuide?.href ?? categoryGuide?.href ?? '/guides/'}>Read the buying guide →</a></div>
        {comparison ? <div class="path-card"><span>DIRECT COMPARISON</span><h3>{comparison.label}</h3><p>Already deciding between two options? See the key differences side by side.</p><a href={comparison.href}>Compare directly →</a></div> : <div class="path-card"><span>EXPLORE MORE</span><h3>Browse related finds</h3><p>See other products in this category before making your decision.</p><a href={`/categories/${categorySlug}/`}>Explore {product.category} →</a></div>}
        <div class="path-card"><span>CATEGORY</span><h3>{product.category}</h3><p>Explore the wider category and discover other products worth considering.</p><a href={`/categories/${categorySlug}/`}>View category →</a></div>
      </section>

      <div class="review-heading"><div class="eyebrow">THE BUYING BREAKDOWN</div><h2>What to know before you buy</h2><p>We focus on practical fit—not just specifications. Here's the quick decision guide.</p></div>
      <div class="detail-grid">
        <article class="card recommendation-card"><div class="number">01</div><div class="tag">BEST FOR</div><h2>Who should consider it?</h2><p>{recommendation.bestFor}</p></article>
        <article class="card recommendation-card"><div class="number">02</div><div class="tag">WHY WE PICKED IT</div><h2>What stands out</h2><ul class="pros-list">{recommendation.pros.map((item) => <li>{item}</li>)}</ul></article>
        <article class="card warning-card"><div class="number">03</div><div class="tag">KEY TRADEOFF</div><h2>What to know before buying</h2><ul class="cons-list">{recommendation.cons.map((item) => <li>{item}</li>)}</ul><p class="skip"><strong>Look elsewhere if:</strong> {recommendation.skipIf}</p></article>
      </div>

      <ComparisonTable product={product} related={related} />
      <div class="methodology"><div><div class="eyebrow">HOW WE RECOMMEND</div><h2>Research. Compare. Recommend.</h2><p>Buy Better Finds is built to help shoppers narrow a crowded market. We evaluate intended use, useful features, practical tradeoffs, value, and overall fit before recommending a product.</p><a href="/why-we-recommend/" class="method-link">See our recommendation methodology →</a></div><div class="method-steps"><div><strong>01</strong><span>Research</span><small>Understand the product and its use case.</small></div><div><strong>02</strong><span>Compare</span><small>Consider strengths, limitations, value, and alternatives.</small></div><div><strong>03</strong><span>Recommend</span><small>Tell you who it's actually for—and who should skip it.</small></div></div></div>

      {related.length > 0 && <section class="related-section"><div class="review-heading compact"><div class="eyebrow">MORE TO CONSIDER</div><h2>Alternatives worth considering</h2><p>We show nearby options so you can compare before making your final decision.</p></div><div class="related-grid">{related.map((item) => {const itemRec = getRecommendation(item); return <a class="related-card" href={`/products/${item.slug}/`}><div class="related-image"><img src={item.image} alt={item.imageAlt} loading="lazy" width="600" height="450" /></div><div class="related-copy"><span>{item.category}</span><h3>{item.name}</h3><div class="mini-score"><strong>{itemRec.score ?? '—'}/10</strong><span>{itemRec.label}</span></div><p>{itemRec.bestFor}</p><strong>See our take →</strong></div></a>;})}</div></section>}
      <div class="comparison-note"><div class="eyebrow">BEFORE YOU BUY</div><h2>Check the current offer.</h2><p>The retailer or manufacturer remains the source of truth for today's price, stock, shipping, warranty, and return policy.</p><a class="btn primary" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon · Paid link →</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-page{padding-top:24px}.breadcrumbs{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:28px;color:#64748b;font-size:13px}.breadcrumbs a{color:#475569;text-decoration:none}.breadcrumbs a:hover{text-decoration:underline}.breadcrumbs strong{color:#111827;font-weight:700}.product-detail{display:grid;grid-template-columns:1fr 1.1fr;gap:52px;align-items:center}.product-detail-visual{display:flex;flex-direction:column;align-items:center;gap:14px}.find-badge{font-size:11px;font-weight:900;letter-spacing:.14em;color:#fff;background:#c8102e;padding:8px 13px;border-radius:999px}.product-photo{position:relative;width:100%;min-height:440px;border:1px solid #d9dee8;border-radius:24px;background:linear-gradient(145deg,#f7f9fc,#e9edf4);overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:0 20px 55px rgba(15,23,42,.1)}.product-photo img{width:100%;height:100%;min-height:440px;object-fit:contain;padding:32px;display:block}.photo-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:14px;color:#0f172a}.photo-fallback span{font-size:120px;line-height:1}.photo-fallback small{text-transform:uppercase;letter-spacing:.14em;color:#64748b;font-weight:800}.category-label{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#64748b}.product-detail-copy h1{font-size:clamp(34px,5vw,58px);line-height:1.03;margin:10px 0 18px}.lead{font-size:20px;line-height:1.65;color:#475569;max-width:680px}.review-meta{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:15px;font-size:11px;color:#64748b}.review-meta a{color:#c8102e;font-weight:800;text-decoration:none}.score-panel{margin:25px 0;padding:18px 20px;border:1px solid #d9dee8;border-radius:18px;background:#fff;display:flex;align-items:center;gap:18px;box-shadow:0 10px 30px rgba(15,23,42,.06)}.score-ring{width:78px;height:78px;flex:0 0 78px;border-radius:50%;background:#0f172a;color:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column}.score-ring strong{font-size:26px;line-height:1}.score-ring span{font-size:10px;color:#cbd5e1;margin-top:3px}.score-label{font-size:10px;font-weight:900;letter-spacing:.14em;color:#c8102e}.score-status{display:block;margin-top:3px;color:#111827}.score-panel p{margin:5px 0 0;color:#64748b;font-size:12px;line-height:1.5}.verdict{margin:25px 0;padding:18px 20px;border-left:4px solid #c8102e;background:#f8fafc;border-radius:0 12px 12px 0}.verdict-label{font-size:11px;font-weight:900;letter-spacing:.14em;color:#c8102e}.verdict p{margin:6px 0 0;font-weight:700;color:#111827}.verdict small{display:block;margin-top:9px;color:#64748b;line-height:1.5}.price-box{margin:24px 0;padding:18px 20px;border:1px solid #d9dee8;border-radius:16px;background:#fff;display:grid;gap:5px}.price-box span,.price-box small{color:#64748b}.price-box strong{font-size:28px;color:#111827}.detail-actions{display:flex;gap:12px;flex-wrap:wrap}.disclosure{font-size:11px;color:#64748b;margin-top:14px;max-width:650px;line-height:1.6}
  .decision-paths{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:58px}.path-card{padding:24px;border:1px solid #d9dee8;border-radius:18px;background:#fff;display:flex;flex-direction:column}.path-card span{font-size:10px;font-weight:900;letter-spacing:.14em;color:#c8102e}.path-card h3{font-size:21px;color:#0f172a;margin:9px 0}.path-card p{color:#64748b;line-height:1.55;font-size:14px;margin:0 0 18px}.path-card a{margin-top:auto;color:#c8102e;font-weight:800;text-decoration:none}.path-card a:hover{text-decoration:underline}
  .review-heading{text-align:center;max-width:760px;margin:80px auto 30px}.review-heading h2{font-size:clamp(28px,4vw,42px);margin:8px 0}.review-heading p{color:#64748b;font-size:17px}.review-heading.compact{margin:0 auto 25px}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.number{font-size:12px;font-weight:900;color:#c8102e;letter-spacing:.12em}.detail-grid h2{font-size:23px;margin:10px 0}.pros-list,.cons-list{list-style:none;padding:0;margin:15px 0}.pros-list li,.cons-list li{position:relative;padding:7px 0 7px 24px;color:#475569;line-height:1.5}.pros-list li::before{content:'✓';position:absolute;left:0;color:#c8102e;font-weight:900}.cons-list li::before{content:'—';position:absolute;left:0;color:#c8102e;font-weight:900}.skip{border-top:1px solid #e2e8f0;padding-top:13px;margin-top:14px;font-size:13px!important}.skip strong{color:#111827}.methodology{margin-top:65px;padding:38px;border-radius:24px;background:#0f172a;color:#fff;display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:center}.methodology h2{color:#fff;font-size:32px;margin:8px 0 12px}.methodology p{color:#cbd5e1;line-height:1.7}.method-link{display:inline-block;color:#fff;font-weight:800;margin-top:10px;text-decoration:none}.method-steps{display:grid;gap:15px}.method-steps div{display:grid;grid-template-columns:38px 1fr;column-gap:12px;align-items:center}.method-steps strong{grid-row:span 2;color:#c8102e}.method-steps span{font-weight:800}.method-steps small{color:#94a3b8}.related-section{margin-top:70px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.related-card{text-decoration:none;color:inherit;border:1px solid #d9dee8;border-radius:20px;overflow:hidden;background:#fff;transition:transform .2s ease,box-shadow .2s ease}.related-card:hover{transform:translateY(-4px);box-shadow:0 14px 35px rgba(15,23,42,.1)}.related-image{aspect-ratio:4/3;background:#f5f7fa;display:flex;align-items:center;justify-content:center}.related-image img{width:100%;height:100%;object-fit:contain;padding:18px}.related-copy{padding:20px}.related-copy>span{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#64748b;font-weight:800}.related-copy h3{font-size:19px;line-height:1.3;margin:8px 0}.related-copy p{font-size:14px;color:#64748b;line-height:1.5}.related-copy>strong{font-size:14px;color:#c8102e}.mini-score{display:flex;align-items:center;gap:8px;margin:7px 0}.mini-score strong{font-size:13px;color:#111827}.mini-score span{font-size:11px;color:#64748b}.comparison-note{margin-top:65px;padding:40px 30px;border-radius:24px;background:#f1f5f9;text-align:center}.comparison-note h2{margin:8px 0 10px}.comparison-note p{max-width:680px;margin:0 auto 22px;color:#64748b}
  @media(max-width:900px){.product-detail,.methodology{grid-template-columns:1fr}.decision-paths,.detail-grid,.related-grid{grid-template-columns:1fr}.product-photo,.product-photo img{min-height:320px}.methodology{padding:28px}.product-detail-copy h1{font-size:40px}}@media(max-width:600px){.breadcrumbs{font-size:12px}.product-detail{gap:28px}.product-photo,.product-photo img{min-height:270px}.product-photo img{padding:20px}.detail-actions .btn{width:100%;justify-content:center}.review-heading{margin-top:55px}.methodology h2{font-size:27px}.score-panel{align-items:flex-start}.score-ring{width:68px;height:68px;flex-basis:68px}.score-ring strong{font-size:23px}}
</style>
<script>
  const image = document.querySelector('.product-photo img');
  image?.addEventListener('error', () => { image.style.display = 'none'; const fallback = image.nextElementSibling; if (fallback) fallback.style.display = 'flex'; });
</script>
