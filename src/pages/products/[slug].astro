---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---
<BaseLayout title={`${product.name} | Buy Better Finds`} description={`${product.name}: practical buying information, strengths, tradeoffs, and a direct product link.`}>
  <section class="section">
    <div class="container">
      <div class="eyebrow">{product.category} · BUY BETTER FIND</div>
      <div class="product-detail">
        <div class="product-detail-visual">
          <div class="product-photo">
            <img src={product.image} alt={product.imageAlt} width="1000" height="750" />
            <div class="photo-fallback" aria-hidden="true"><span>{product.icon}</span><small>{product.category}</small></div>
          </div>
          <span>{product.category}</span>
        </div>
        <div class="product-detail-copy">
          <h1>{product.name}</h1>
          <p class="lead">{product.why}</p>
          <div class="price-box"><span>Reference price</span><strong>{product.price}</strong><small>Prices and availability can change. Verify the current offer at the retailer.</small></div>
          <div class="detail-actions"><a class="btn primary" href={product.url} target="_blank" rel="noopener noreferrer">Check current product →</a><a class="btn secondary" href="/products/">Back to products</a></div>
        </div>
      </div>

      <div class="detail-grid">
        <article class="card"><div class="tag">BEST FOR</div><h2>{product.bestFor}</h2><p>Think about your actual use case before paying for features you may not need.</p></article>
        <article class="card"><div class="tag">WHY IT MADE THE LIST</div><h2>Useful, specific, easy to compare.</h2><p>{product.why}</p></article>
        <article class="card"><div class="tag">WATCH BEFORE BUYING</div><h2>Know the tradeoffs.</h2><p>{product.watch}</p></article>
      </div>

      <div class="comparison-note">
        <div class="eyebrow">Buying note</div>
        <h2>Check the current offer before you buy.</h2>
        <p>Buy Better Finds is designed to narrow the field. The retailer or manufacturer remains the source of truth for today's price, stock, shipping, warranty, and return policy.</p>
        <a class="arrow" href={product.url} target="_blank" rel="noopener noreferrer">Open product source →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-detail{display:grid;grid-template-columns:1fr 1.25fr;gap:40px;align-items:center;margin-top:30px}
  .product-detail-visual{display:flex;flex-direction:column;align-items:center;gap:14px}
  .product-detail-visual>span{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#64748b}
  .product-photo{position:relative;width:100%;min-height:390px;border:1px solid #d9dee8;border-radius:24px;background:linear-gradient(145deg,#f7f9fc,#e9edf4);overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:0 18px 45px rgba(15,23,42,.08)}
  .product-photo img{width:100%;height:100%;min-height:390px;object-fit:contain;padding:34px;display:block}
  .photo-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:14px;color:#0f172a}
  .photo-fallback span{font-size:120px;line-height:1}.photo-fallback small{text-transform:uppercase;letter-spacing:.14em;color:#64748b;font-weight:800}
  .product-detail-copy h1{margin-bottom:18px}
  .price-box{margin:28px 0;padding:20px;border:1px solid #d9dee8;border-radius:16px;background:#fff;display:grid;gap:6px}
  .price-box span,.price-box small{color:#64748b}.price-box strong{font-size:28px;color:#111827}
  .detail-actions{display:flex;gap:12px;flex-wrap:wrap}
  .detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:55px}
  .detail-grid h2{font-size:22px;margin:12px 0}
  .comparison-note{margin-top:55px;padding:34px;border-radius:22px;background:#0f172a;color:#fff;text-align:center}
  .comparison-note h2{color:#fff;margin:10px 0}.comparison-note p{max-width:720px;margin:0 auto 18px;color:#cbd5e1}.comparison-note .arrow{color:#fff}
  @media(max-width:800px){.product-detail,.detail-grid{grid-template-columns:1fr}.product-photo,.product-photo img{min-height:280px}.photo-fallback span{font-size:90px}}
</style>
<script>
  const image = document.querySelector('.product-photo img');
  image?.addEventListener('error', () => {
    image.style.display = 'none';
    const fallback = image.nextElementSibling;
    if (fallback) fallback.style.display = 'flex';
  });
</script>
