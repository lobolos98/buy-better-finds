---

import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { products } from '../../data/products.js';
import { getRecommendation } from '../../data/recommendations.js';
import { amazonProductUrl, amazonSearchUrl } from '../../utils/amazon.js';

const guideMap = {
  tech: { label: 'Best Tech Products', href: '/guides/best-tech/' },
  'home-kitchen': { label: 'Best Home & Kitchen Products', href: '/guides/best-home-kitchen/' },
  'tools-diy': { label: 'Best Tools & DIY Products', href: '/guides/best-tools-diy/' },
  outdoor: { label: 'Best Outdoor Products', href: '/guides/best-outdoor/' },
  'smart-home': { label: 'Best Smart Home Products', href: '/guides/best-smart-home/' },
  fitness: { label: 'Best Fitness Watches', href: '/guides/best-fitness-watches/' },
  lifestyle: { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' }
};

const comparisonMap = {
  'sony-wh-1000xm5-noise-canceling-headphones': { label: 'Sony WH-1000XM5 vs AirPods 4', href: '/comparisons/sony-wh-1000xm5-vs-airpods-4/' },
  'apple-airpods-4': { label: 'Sony WH-1000XM5 vs AirPods 4', href: '/comparisons/sony-wh-1000xm5-vs-airpods-4/' },
  'ninja-4-qt-air-fryer-af101': { label: 'Ninja AF101 vs Instant Vortex Plus', href: '/comparisons/ninja-af101-vs-instant-vortex-plus/' },
  'instant-vortex-plus-air-fryer': { label: 'Ninja AF101 vs Instant Vortex Plus', href: '/comparisons/ninja-af101-vs-instant-vortex-plus/' },
  'dyson-v8-cordless-vacuum': { label: 'Dyson V8 vs Shark Navigator', href: '/comparisons/dyson-v8-vs-shark-navigator/' },
  'shark-navigator-lift-away': { label: 'Dyson V8 vs Shark Navigator', href: '/comparisons/dyson-v8-vs-shark-navigator/' },
  'yeti-rambler-drinkware': { label: 'YETI Rambler vs Stanley Quencher', href: '/comparisons/yeti-rambler-vs-stanley-quencher/' },
  'stanley-quencher-h2-0-tumbler': { label: 'YETI Rambler vs Stanley Quencher', href: '/comparisons/yeti-rambler-vs-stanley-quencher/' },
  'tp-link-kasa-smart-outdoor-plug-ep40m': { label: 'TP-Link Outdoor Plug vs Ring Doorbell', href: '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/' },
  'ring-battery-doorbell': { label: 'TP-Link Outdoor Plug vs Ring Doorbell', href: '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/' }
};

const guideByName = {
  'Sony WH-1000XM5 Noise-Canceling Headphones': { label: 'Best Noise-Canceling Headphones', href: '/guides/best-noise-canceling-headphones/' },
  'Apple AirPods 4': { label: 'Best Noise-Canceling Headphones', href: '/guides/best-noise-canceling-headphones/' },
  'Ninja 4-Qt Air Fryer AF101': { label: 'Best Air Fryers', href: '/guides/best-air-fryers/' },
  'Instant Vortex Plus Air Fryer': { label: 'Best Air Fryers', href: '/guides/best-air-fryers/' },
  'Dyson V8 Cordless Vacuum': { label: 'Best Cordless & Everyday Vacuums', href: '/guides/best-vacuums/' },
  'Shark Navigator Lift-Away': { label: 'Best Cordless & Everyday Vacuums', href: '/guides/best-vacuums/' },
  'DEWALT 20V MAX Drill/Impact Driver Combo Kit': { label: 'Best Tools for Homeowners', href: '/guides/best-homeowner-drills/' },
  'Solo Stove Tower Patio Heater': { label: 'Best Patio Heaters', href: '/guides/best-patio-heaters/' },
  'TP-Link Kasa Smart Outdoor Plug EP40M': { label: 'Best Smart Plugs', href: '/guides/best-smart-plugs/' },
  'Garmin Forerunner 265': { label: 'Best Fitness Watches', href: '/guides/best-fitness-watches/' },
  'YETI Rambler Drinkware': { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'Stanley Quencher H2.0 Tumbler': { label: 'Best Everyday Drinkware', href: '/guides/best-everyday-drinkware/' },
  'OXO Good Grips Refrigerator Organization Set': { label: 'Best Home Organization Products', href: '/guides/best-home-organization/' }
};

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const recommendation = getRecommendation(product);
const related = products.filter((item) => item.slug !== product.slug && item.category === product.category).slice(0, 3);
const categorySlug = product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const categoryGuide = guideMap[categorySlug];
const focusedGuide = guideByName[product.name];
const comparison = comparisonMap[product.slug];
const affiliateUrl = product.amazonAsin ? amazonProductUrl(product.amazonAsin) : (product.url?.includes('amazon.com') ? product.url : amazonSearchUrl(product.name));
const reviewDate = 'September 22, 2026';
const canonicalUrl = new URL(Astro.url.pathname, 'https://buybetterfinds.com').toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'All Finds', item: 'https://buybetterfinds.com/products/' },
    { '@type': 'ListItem', position: 2, name: product.category, item: `https://buybetterfinds.com/categories/${categorySlug}/` },
    { '@type': 'ListItem', position: 3, name: product.name, item: canonicalUrl }
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: [new URL(product.image, 'https://buybetterfinds.com').toString()],
  description: product.why,
  url: canonicalUrl,
  review: {
    '@type': 'Review',
    author: { '@type': 'Organization', name: 'Buy Better Finds' },
    reviewBody: `${product.why} Best for: ${recommendation.bestFor} Key tradeoff: ${recommendation.skipIf}`,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: recommendation.score ?? 1,
      bestRating: 10,
      worstRating: 1
    }
  }
})} />

<BaseLayout title={`${product.name} | Buy Better Finds`} description={`${product.name}: independent buying guidance, strengths, tradeoffs, and practical product information.`}>
  <section class="section product-page">
    <div class="container">
      <div class="breadcrumbs"><a href="/products/">All Finds</a><span>/</span><a href={`/categories/${categorySlug}/`}>{product.category}</a><span>/</span><strong>{product.name}</strong></div>
      <div class="product-detail">
        <div class="product-detail-visual"><div class="find-badge">BUY BETTER FIND</div><div class="product-photo"><img src={product.image} alt={product.imageAlt} width="1000" height="750" /><div class="photo-fallback" aria-hidden="true"><span>{product.icon}</span><small>{product.category}</small></div></div><span class="category-label">{product.category}</span></div>
        <div class="product-detail-copy">
          <div class="eyebrow">BUY BETTER FIND · {product.category}</div><h1>{product.name}</h1><p class="lead">{product.why}</p>
          <div class="review-meta"><span>Research updated: {reviewDate}</span><a href="/why-we-recommend/">How we evaluate →</a></div>
          <div class="score-panel"><div class="score-ring"><strong>{recommendation.score ?? '—'}</strong><span>/10</span></div><div><div class="score-label">BUY BETTER SCORE</div><strong class="score-status">{recommendation.label}</strong><p>Editorial score based on practical fit, value, useful features, and documented tradeoffs—not paid placement.</p></div></div>
          <div class="verdict"><div class="verdict-label">QUICK ANSWER · BEST FOR</div><p>{recommendation.bestFor}</p><small>Skip it if: {recommendation.skipIf}</small></div>
          <div class="price-box"><span>Reference price</span><strong>{product.price}</strong><small>Prices and availability can change. Verify the current offer at the retailer.</small></div>
          <div class="detail-actions"><a class="btn primary" href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon · Paid link →</a><a class="btn secondary" href="/products/">Browse all finds</a></div>
          <p class="disclosure">We may earn a commission from qualifying purchases when affiliate links are used. Our recommendations are based on product fit and editorial evaluation, not commission size.</p>
        </div>
      </div>

      <section class="decision-paths" aria-label="Continue researching this product">
        <div class="path-card"><span>SHOPPING GUIDE</span><h3>{focusedGuide?.label ?? categoryGuide?.label ?? `Best ${product.category} Products`}</h3><p>See this product in a broader shortlist with practical alternatives and buying considerations.</p><a href={focusedGuide?.href ?? categoryGuide?.href ?? '/guides/'}>Read the buying guide →</a></div>