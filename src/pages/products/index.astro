---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import ProductCard from '../../components/ProductCard.astro';
---
<BaseLayout title="Products | Buy Better Finds" description="Browse real products and practical recommendations from Buy Better Finds.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">REAL PRODUCTS · EDITORIALLY EVALUATED</div>
      <h1>Products worth considering.</h1>
      <p class="lead">Explore specific products, see how we rate their practical fit, understand the tradeoffs, and follow the product link to verify today's price and availability.</p>

      <div class="catalog-note">
        <div><strong>How to use our scores</strong><span>Buy Better Scores summarize our editorial view of practical fit, value, useful features, and tradeoffs. They are not paid ratings.</span></div>
        <a href="/why-we-recommend/">How we recommend →</a>
      </div>

      <p class="affiliate-notice"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Product availability and prices can change, so always confirm the current details on Amazon before buying.</p>

      <div class="grid product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .catalog-note{margin:30px 0 22px;padding:18px 20px;border:1px solid #d9dee8;border-radius:16px;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;gap:20px}.catalog-note div{display:grid;gap:4px}.catalog-note strong{color:#111827}.catalog-note span{color:#64748b;font-size:13px;line-height:1.5}.catalog-note a{color:#c8102e;font-weight:800;text-decoration:none;white-space:nowrap}.catalog-note a:hover{text-decoration:underline}
  .affiliate-notice{margin:0 0 38px;padding:14px 16px;border-left:4px solid #c8102e;background:#fff7f8;color:#475569;font-size:12px;line-height:1.6}.affiliate-notice strong{color:#111827}
  .product-grid{align-items:stretch}
  @media(max-width:700px){.catalog-note{align-items:flex-start;flex-direction:column}.catalog-note a{white-space:normal}.product-actions{gap:9px}}
</style>
<script>
  document.querySelectorAll('.product-image img').forEach((img) => {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      const fallback = img.nextElementSibling;
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
