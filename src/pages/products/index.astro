---
import BaseLayout from '../../layouts/BaseLayout.astro';
const products = [
  ['Sony WH-1000XM5 Noise-Canceling Headphones','Tech','$299.99','/products/sony-wh-1000xm5/'],
  ['Ninja 4-Qt Air Fryer AF101','Home & Kitchen','$119.99','/products/ninja-af101/'],
  ['DEWALT 20V MAX Drill/Impact Driver Combo Kit','Tools & DIY','Check price','/products/dewalt-dck240c2/'],
  ['Solo Stove Tower Patio Heater','Outdoor','$799.99','/products/solo-stove-tower/']
];
---
<BaseLayout title="Products | Buy Better Finds" description="Browse real products and practical recommendations from Buy Better Finds.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">REAL PRODUCTS</div>
      <h1>Products worth considering.</h1>
      <p class="lead">Explore specific products, understand the tradeoffs, and follow the product link to verify today's price and availability.</p>
      <div class="grid">
        {products.map(([name,cat,price,href]) => <article class="card">
          <div class="tag">{cat}</div><h3>{name}</h3><p>See why this product made the Buy Better Finds shortlist and what to consider before buying.</p>
          <p><strong>{price}</strong></p><a class="arrow" href={href}>View product →</a>
        </article>)}
      </div>
    </div>
  </section>
</BaseLayout>
