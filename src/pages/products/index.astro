---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
---
<BaseLayout title="Products | Buy Better Finds" description="Browse real products and practical recommendations from Buy Better Finds.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">REAL PRODUCTS · UPDATED CATALOG</div>
      <h1>Products worth considering.</h1>
      <p class="lead">Explore specific products, understand the tradeoffs, and follow the product link to verify today's price and availability.</p>
      <div class="grid">
        {products.map((product) => <article class="card">
          <div class="tag">{product.category}</div>
          <h3>{product.name}</h3>
          <p>{product.why}</p>
          <p><strong>{product.price}</strong></p>
          <a class="arrow" href={`/products/${product.slug}/`}>View product →</a>
        </article>)}
      </div>
    </div>
  </section>
</BaseLayout>
