    'pokemon-tcg-collector': '<rect x="120" y="60" width="160" height="220" rx="12"/><circle cx="200" cy="135" r="55"/><path d="M145 135h110M200 80v110"/><circle cx="200" cy="135" r="15"/>',
    'lego-classic-creative-brick-box': '<path d="M95 125h210v130H95z"/><circle cx="140" cy="110" r="18"/><circle cx="200" cy="110" r="18"/><circle cx="260" cy="110" r="18"/><rect x="125" y="155" width="55" height="45"/><rect x="205" y="155" width="70" height="45"/>',
    'osmo-learning-system': '<rect x="105" y="80" width="190" height="170" rx="15"/><rect x="130" y="105" width="140" height="95"/><path d="M155 225h90"/>',
    'thinkfun-gravity-maze': '<rect x="105" y="75" width="190" height="190" rx="15"/><path d="M145 115h110v110H145zM170 140v60h60v-60z"/><circle cx="200" cy="170" r="10"/>',
    'exploding-kittens': '<rect x="115" y="65" width="170" height="230" rx="15"/><circle cx="200" cy="155" r="55"/><path d="M165 145h20M215 145h20M170 185q30 20 60 0"/>',
    'hape-wooden-activity-toy': '<rect x="100" y="95" width="200" height="150" rx="20"/><circle cx="145" cy="145" r="25"/><rect x="180" y="120" width="75" height="45" rx="8"/><circle cx="150" cy="205" r="18"/><circle cx="225" cy="205" r="18"/>',
    'cerave-foaming-cleanser': '<path d="M155 85h90v45l20 25v115H135V155l20-25z"/><line x1="155" y1="110" x2="245" y2="110"/><line x1="155" y1="180" x2="245" y2="180"/>',
    'ordinary-niacinamide': '<path d="M160 75h80v45l20 25v135H140V145l20-25z"/><line x1="160" y1="105" x2="240" y2="105"/><line x1="160" y1="190" x2="240" y2="190"/>',
    'revlon-one-step': '<path d="M125 90h150v55l-45 30v105h-60V175l-45-30z"/><circle cx="200" cy="120" r="22"/><line x1="170" y1="205" x2="230" y2="205"/>',
    'braun-series-7': '<rect x="145" y="80" width="110" height="210" rx="35"/><circle cx="200" cy="130" r="28"/><rect x="170" y="180" width="60" height="55" rx="8"/>'
  };
  const body = drawings[slug] || '<rect x="120" y="85" width="160" height="205" rx="22"/><circle cx="200" cy="160" r="45"/>';
  return `<svg class="product-drawing" viewBox="0 0 400 340" aria-hidden="true"><g fill="none" stroke="#334155" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">${body}</g></svg>`;
};

const productCards = products.map((product) => {
  const slug = escapeHtml(product.slug);
  const name = escapeHtml(product.name);
  const category = escapeHtml(product.category);
  const icon = escapeHtml(product.icon);
  const image = escapeHtml(product.image);
  const imageAlt = escapeHtml(product.imageAlt || product.name);
  const score = escapeHtml(product.score ?? '—');
  const bestFor = escapeHtml(product.bestFor);
  const why = escapeHtml(product.why);
  const watch = escapeHtml(product.watch);
  const price = escapeHtml(product.price);
  const hasRealImage = Boolean(product.image) && !String(product.image).includes('new-product-placeholder.svg');
  const amazonUrl = product.amazonAsin
    ? `https://www.amazon.com/dp/${encodeURIComponent(product.amazonAsin)}?tag=buybetterfi06-20`
    : (product.url || `https://www.amazon.com/s?k=${encodeURIComponent(product.name)}`);

  return `<article class="card product-card">
    <a class="product-image" href="/products/${slug}/" aria-label="View ${name}">
      ${hasRealImage ? `<img src="${image}" alt="${imageAlt}" loading="lazy" width="800" height="600">` : `<div class="image-fallback" role="img" aria-label="${name} product drawing">${drawingFor(product.slug)}<small>${name}</small></div>`}
      <span class="pick-badge">BUY BETTER FIND</span>
    </a>
    <div class="product-meta">
      <div class="tag">${category}</div>
      <div class="score-mini"><strong>${score}</strong><span>/10</span></div>
    </div>
    <h3>${name}</h3>
    <p class="best-for"><strong>Best for:</strong> ${bestFor}</p>
    <p>${why}</p>
    <div class="tradeoff"><strong>Watch:</strong> ${watch}</div>
    <p class="price"><strong>${price}</strong></p>
    <div class="product-actions">
      <a class="shop-btn secondary-shop" href="/products/${slug}/">See our take →</a>
      <a class="shop-btn amazon-shop" href="${escapeHtml(amazonUrl)}" target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a>
    </div>
  </article>`;
}).join('');
---
<BaseLayout title="Products | Buy Better Finds" description="Browse real products and practical recommendations from Buy Better Finds.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">REAL PRODUCTS · EDITORIALLY EVALUATED</div>
      <h1>Products worth considering.</h1>
      <p class="lead">Explore specific products, see how we rate their practical fit, understand the tradeoffs, and follow the product link to verify today's price and availability.</p>
      <div class="catalog-note">
        <div><strong>How to use our scores</strong><span>Buy Better Scores summarize our editorial view of practical fit, value, useful features, and tradeoffs. They are not paid ratings.</span></div>
        <a href="/why-we-recommend/">How we recommend →</a>
      </div>
      <p class="affiliate-notice"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Product availability and prices can change, so always confirm the current details on Amazon before buying.</p>
      <div class="grid product-grid" set:html={productCards}></div>
    </div>
  </section>
</BaseLayout>

<style>
  .catalog-note{margin:30px 0 22px;padding:18px 20px;border:1px solid #d9dee8;border-radius:16px;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;gap:20px}.catalog-note div{display:grid;gap:4px}.catalog-note strong{color:#111827}.catalog-note span{color:#64748b;font-size:13px;line-height:1.5}.catalog-note a{color:#c8102e;font-weight:800;text-decoration:none;white-space:nowrap}.catalog-note a:hover{text-decoration:underline}
  .affiliate-notice{margin:0 0 38px;padding:14px 16px;border-left:4px solid #c8102e;background:#fff7f8;color:#475569;font-size:12px;line-height:1.6}.affiliate-notice strong{color:#111827}
  :global(.product-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch;width:100%;max-width:100%;overflow:hidden}
  :global(.product-card){min-width:0;width:100%;max-width:100%;overflow:hidden;display:flex;flex-direction:column}
  :global(.product-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch;width:100%;max-width:100%}
  :global(.product-card){min-width:0;width:100%;max-width:100%;overflow:hidden;display:flex;flex-direction:column}
  :global(.product-image){display:block;position:relative;width:100%;height:220px;min-width:0;overflow:hidden;background:linear-gradient(145deg,#f1f5f9,#e6edf4);border-radius:9px;flex:0 0 220px}
  :global(.product-image img){position:absolute;inset:0;display:block;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;object-fit:contain;object-position:center;z-index:1}
  :global(.product-image .image-fallback){position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;text-align:center;padding:18px;box-sizing:border-box;background:linear-gradient(145deg,#f1f5f9,#e6edf4)}
  :global(.product-image .product-drawing){width:78%;height:78%;display:block}
  :global(.product-image .image-fallback small){display:block;font-size:11px;line-height:1.3;max-width:90%;overflow-wrap:anywhere;color:#64748b;font-weight:700}
  :global(.product-image img[style*="display: none"] + .image-fallback){display:flex}
  :global(.product-card h3),:global(.product-card p),:global(.product-card .tradeoff){overflow-wrap:anywhere;word-break:normal}
  :global(.product-actions){display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:auto;padding-top:14px;min-width:0}
  :global(.product-actions .shop-btn){display:block;min-width:0;width:100%;text-align:center;overflow:hidden}
  @media(max-width:900px){:global(.product-grid){grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.catalog-note{align-items:flex-start;flex-direction:column}.catalog-note a{white-space:normal}:global(.product-actions){gap:9px;grid-template-columns:1fr}}
  @media(max-width:560px){:global(.product-grid){grid-template-columns:1fr}:global(.product-image){height:200px;flex-basis:200px}}
</style>
<script>
  document.querySelectorAll('.product-image img').forEach((img) => {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      const fallback = img.nextElementSibling;
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
