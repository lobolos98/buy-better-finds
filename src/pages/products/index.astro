---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { getRecommendation } from '../../data/recommendations.js';
import { amazonSearchUrl } from '../../utils/amazon.js';
---
<BaseLayout title="Products | Buy Better Finds" description="Browse real products and practical recommendations from Buy Better Finds.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">REAL PRODUCTS · EDITORIALLY EVALUATED</div>
      <h1>Products worth considering.</h1>
      <p class="lead">Explore specific products, see how we rate their practical fit, understand the tradeoffs, and follow the product link to verify today's price and availability.</p>

      <div class="catalog-note">
        <div><strong>How to use our scores</strong><span>Buy Better Scores summarize our editorial view of practical fit, value, useful features, and tradeoffs. They are not paid ratings.</span></div>
        <a href="/why-we-recommend/">How we recommend →</a>
      </div>

      <p class="affiliate-notice"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Product availability and prices can change, so always confirm the current details on Amazon before buying.</p>

      <div class="grid product-grid">
        {products.map((product) => {
          const recommendation = getRecommendation(product);
          const amazonUrl = amazonSearchUrl(product.name);
          return <article class="card product-card">
            <a class="product-image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>
              <img src={product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" />
              <span class="image-fallback" aria-hidden="true"><span>{product.icon}</span><small>{product.category}</small></span>
              <span class="pick-badge">BUY BETTER FIND</span>
            </a>
            <div class="product-meta"><div class="tag">{product.category}</div><div class="score-mini"><strong>{recommendation.score}</strong><span>/10</span></div></div>
            <h3>{product.name}</h3>
            <p class="best-for"><strong>Best for:</strong> {recommendation.bestFor}</p>
            <p>{product.why}</p>
            <div class="tradeoff"><strong>Watch:</strong> {product.watch}</div>
            <p class="price"><strong>{product.price}</strong></p>
            <div class="product-actions">
              <a class="shop-btn secondary-shop" href={`/products/${product.slug}/`}>See our take →</a>
              <a class="shop-btn amazon-shop" href={amazonUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a>
            </div>
          </article>;
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .catalog-note{margin:30px 0 22px;padding:18px 20px;border:1px solid #d9dee8;border-radius:16px;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;gap:20px}.catalog-note div{display:grid;gap:4px}.catalog-note strong{color:#111827}.catalog-note span{color:#64748b;font-size:13px;line-height:1.5}.catalog-note a{color:#c8102e;font-weight:800;text-decoration:none;white-space:nowrap}.catalog-note a:hover{text-decoration:underline}
  .affiliate-notice{margin:0 0 38px;padding:14px 16px;border-left:4px solid #c8102e;background:#fff7f8;color:#475569;font-size:12px;line-height:1.6}.affiliate-notice strong{color:#111827}
  .product-grid{align-items:stretch}
  .product-card{overflow:hidden;display:flex;flex-direction:column}.product-image{position:relative;display:block;aspect-ratio:4/3;margin:-1px -1px 18px;background:#f3f5f8;overflow:hidden;border-radius:18px 18px 0 0}.product-image img{width:100%;height:100%;display:block;object-fit:contain;padding:24px;transition:transform .25s ease}.product-image:hover img{transform:scale(1.04)}
  .pick-badge{position:absolute;top:12px;left:12px;padding:6px 9px;border-radius:999px;background:#0f172a;color:#fff;font-size:9px;font-weight:900;letter-spacing:.1em}.image-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;background:linear-gradient(145deg,#f8fafc,#e7ebf1);color:#0f172a}.image-fallback span{font-size:64px;line-height:1}.image-fallback small{text-transform:uppercase;letter-spacing:.12em;font-weight:800;color:#64748b}.product-image img + .image-fallback{display:none}.product-image img:not([src]) + .image-fallback{display:flex}
  .product-meta{display:flex;align-items:center;justify-content:space-between;gap:12px}.score-mini{display:flex;align-items:baseline;gap:2px;padding:5px 8px;border-radius:8px;background:#f1f5f9}.score-mini strong{font-size:15px;color:#111827}.score-mini span{font-size:9px;color:#64748b}.product-card h3{margin-top:9px}.product-card p{line-height:1.6}.best-for{font-size:13px;color:#475569}.best-for strong{color:#111827}.tradeoff{margin:4px 0 8px;padding-top:10px;border-top:1px solid #e2e8f0;color:#64748b;font-size:12px;line-height:1.5}.tradeoff strong{color:#c8102e}.price{margin-top:auto}.product-actions{display:flex;flex-direction:column;gap:8px;margin-top:10px}.shop-btn{display:inline-flex;align-items:center;justify-content:center;align-self:stretch;padding:13px 18px;border-radius:6px;color:#fff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;transition:background .2s ease,transform .2s ease}.shop-btn:hover{transform:translateY(-1px)}.secondary-shop{background:#2366a8}.secondary-shop:hover{background:#1d578f}.amazon-shop{background:#c8102e}.amazon-shop:hover{background:#a80d27}
  @media(max-width:700px){.catalog-note{align-items:flex-start;flex-direction:column}.catalog-note a{white-space:normal}.product-actions{gap:9px}}
</style>
<script>
  document.querySelectorAll('.product-image img').forEach((img) => {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      const fallback = img.nextElementSibling;
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
