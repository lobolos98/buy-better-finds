---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Christmas Finds | Buy Better Finds" description="Christmas gift ideas, stocking stuffers, seasonal home finds, and holiday shopping inspiration from Buy Better Finds.">
  <main class="christmas-page">
    <section class="hero"><div class="wrap"><p class="eyebrow">THE CHRISTMAS EDIT · 2026</p><h1>Christmas Finds</h1><p>Thoughtful gifts, cozy comforts, useful little extras, and festive finds—curated to make holiday shopping easier.</p><a href="/blog/christmas-gift-ideas-under-25/">Read our gift guide: 15 ideas under $25 ↗</a></div></section>
    <section class="wrap"><p class="eyebrow red">THE HOLIDAY SHORTLIST</p><h2>Good gifts don’t have to be complicated.</h2><p class="intro">Browse gift ideas across tech, cozy home comforts, kitchen favorites, beauty, and useful everyday extras. Check product pages for current pricing, available colors, and the exact version you want—prices and availability can change.</p><div class="grid">
      <a class="tile" href="/blog/christmas-gift-ideas-under-25/"><span>01 / THE GIFT GUIDE</span><h3>Gifts Under $25</h3><p>Thoughtful ideas that feel special without stretching your budget.</p><strong>Explore the guide ↗</strong></a>
      <a class="tile" href="/categories/seasonal-holidays/halloween/"><span>02 / SEASONAL FAVORITES</span><h3>Seasonal Finds</h3><p>Explore our dedicated seasonal collections as the calendar changes.</p><strong>Browse seasonal finds ↗</strong></a>
      <a class="tile" href="/deals/"><span>03 / SHOP SMART</span><h3>Holiday Deals</h3><p>Check current deal listings before you buy.</p><strong>See current deals ↗</strong></a>
    </div><p class="disclosure">As an Amazon Associate, Buy Better Finds earns from qualifying purchases.</p></section>
  </main>
</BaseLayout>
<style>
.christmas-page{background:#fffdf9;color:#142b45;padding-bottom:60px}.wrap{width:min(1180px,calc(100% - 36px));margin:0 auto}.hero{background:linear-gradient(115deg,rgba(13,34,57,.94),rgba(20,43,69,.78)),url('https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&fit=crop&w=1600&q=85') center/cover;color:white;padding:76px 0}.hero h1{font:500 clamp(3rem,7vw,5.4rem)/1 Georgia,serif;color:#fff;margin:12px 0 18px;letter-spacing:-.04em}.hero p{max-width:660px;line-height:1.7;color:#e1e8ef}.eyebrow{font-size:.7rem;letter-spacing:.16em;font-weight:800;color:#f3c9d0}.hero a{display:inline-block;margin-top:16px;padding:13px 16px;background:#c8102e;color:#fff;text-decoration:none;font-size:.8rem;font-weight:800}.red{color:#c8102e;margin-top:44px}.wrap>h2{font:500 clamp(1.8rem,4vw,2.6rem)/1.15 Georgia,serif;margin:10px 0}.intro{max-width:800px;color:#64748b;line-height:1.75}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:28px 0}.tile{display:flex;flex-direction:column;min-height:220px;padding:25px;border:1px solid #e1e5e9;background:#fff;text-decoration:none;color:#142b45;transition:transform .2s,box-shadow .2s}.tile:hover{transform:translateY(-3px);box-shadow:0 12px 30px #142b4512}.tile span{font-size:.65rem;letter-spacing:.12em;font-weight:800;color:#c8102e}.tile h3{font:500 1.6rem Georgia,serif;margin:18px 0 8px}.tile p{color:#64748b;font-size:.9rem;line-height:1.65}.tile strong{margin-top:auto;color:#003087;font-size:.8rem}.disclosure{font-size:.72rem;color:#747d85;margin-top:25px}@media(max-width:700px){.hero{padding:50px 0}.grid{grid-template-columns:1fr}.tile{min-height:180px}.wrap>h2{margin-top:8px}}
</style>
