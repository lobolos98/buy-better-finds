  { name: 'Rechargeable Electric Candle Lighters, 2-Pack', category: 'USEFUL EXTRAS', description: 'A practical household extra for candle lovers. Review charging instructions and safety guidance.', bestFor: 'Candle fans and useful stocking stuffers', image: 'https://m.media-amazon.com/images/I/71s0mqypf4L._AC_SL1500_.jpg', url: 'https://www.amazon.com/dp/B0D4PHGPMN?tag=buybetterfi06-20' },
  { name: 'PULIDIKI Car Cleaning Gel Putty', category: 'CAR CARE', description: 'A compact car-care extra for someone who likes keeping their interior tidy. Follow product directions.', bestFor: 'Drivers and car-care enthusiasts', image: 'https://m.media-amazon.com/images/I/71WpCXsPbML._AC_SL1500_.jpg', url: 'https://www.amazon.com/dp/B081T7N948?tag=buybetterfi06-20' },
  { name: 'LENRUE Compact Bluetooth Speaker, Gray', category: 'TECH & MUSIC', description: 'A compact speaker for desks, travel, or casual listening. Check current listing details for battery and connectivity.', bestFor: 'Students, travelers, and casual listeners', image: 'https://m.media-amazon.com/images/I/610yy0u0QWL.jpg', url: 'https://www.amazon.com/dp/B0CM2WNR7V?tag=buybetterfi06-20' },
  { name: 'GODONLIF Candle Warmer Lamp with Timer', category: 'COZY HOME', description: 'A cozy display option for candle and home décor fans. Check candle compatibility and safety instructions.', bestFor: 'Home décor fans and candle lovers', image: 'https://m.media-amazon.com/images/I/810vcJJDrkL._AC_SL1500_.jpg', url: 'https://www.amazon.com/dp/B0CTJGJL2T?tag=buybetterfi06-20' }
