---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { amazonSearchUrl } from '../../../../data/products';

const primeSearchUrl = amazonSearchUrl('Prime Big Deal Days');
---

<BaseLayout title="Prime Big Deal Days 2026 | Buy Better Finds" description="Your Buy Better Finds guide to Amazon Prime Big Deal Days 2026, October 6–7. Follow the biggest fall shopping event, seasonal categories, and deals worth watching.">
  <section class="prime-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/categories/seasonal-holidays/">Seasonal & Holidays</a><span>/</span><strong>Prime Big Deal Days</strong></div>
      <div class="hero-grid">
        <div>
          <div class="eyebrow">SEASONAL SHOPPING EVENT</div>
          <h1>Prime Big Deal Days 2026</h1>
          <p class="hero-copy">Two days of fall shopping opportunities, early holiday gifting, and limited-time deals worth watching.</p>
          <div class="event-date"><strong>October 6–7, 2026</strong><span>48 hours • Prime member event</span></div>
          <div class="hero-actions">
            <a class="btn primary" href={primeSearchUrl} target="_blank" rel="nofollow sponsored noopener">Browse on Amazon →</a>
            <a class="btn secondary" href="/deals/">See Buy Better Finds deals</a>
          </div>
        </div>
        <div class="event-card">
          <span class="card-label">WHAT TO WATCH</span>
          <h2>Prime Big Deal Days</h2>
          <ul>
            <li><span>01</span>Tech & electronics</li>
            <li><span>02</span>Home & kitchen</li>
            <li><span>03</span>Beauty & personal care</li>
            <li><span>04</span>Fashion & lifestyle</li>
            <li><span>05</span>Halloween & holiday gifting</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">THE EVENT</div>
          <h2>What to expect</h2>
          <p>Amazon says Prime Big Deal Days runs October 6–7, with exclusive Prime-member deals across more than 35 categories. New Today's Big Deals are scheduled to drop three times daily during the event.</p>
        </div>
      </div>
      <div class="info-grid">
        <article><strong>Oct. 6–7</strong><h3>48-hour event</h3><p>The 2026 event begins October 6 and runs through October 7.</p></article>
        <article><strong>3× daily</strong><h3>New deal drops</h3><p>Amazon says new Today's Big Deals launch at midnight, 8 a.m., and 1 p.m. PDT.</p></article>
        <article><strong>35+ categories</strong><h3>Broad selection</h3><p>Expect opportunities across tech, kitchen, home, beauty, fashion, toys, and seasonal shopping.</p></article>
      </div>
    </div>
  </section>

  <section class="section watch-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">BUY BETTER FINDS WATCHLIST</div>
          <h2>What we'll be watching.</h2>
          <p>We'll focus on products and categories where shoppers can benefit from comparing value, features, reviews, and timing rather than simply chasing the biggest discount.</p>
        </div>
      </div>
      <div class="watch-grid">
        <a href="/categories/tech/"><strong>Tech</strong><span>Electronics, accessories, devices</span>→</a>
        <a href="/categories/home-kitchen/"><strong>Home & Kitchen</strong><span>Appliances, cookware, home upgrades</span>→</a>
        <a href="/categories/beauty-personal-care/"><strong>Beauty & Personal Care</strong><span>Beauty tools, skincare, personal care</span>→</a>
        <a href="/categories/gifts-collectibles/"><strong>Gifts & Collectibles</strong><span>Toys, collectibles, holiday gift ideas</span>→</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="bottom-cta">
        <div>
          <div class="eyebrow light">SAVE THE DATE</div>
          <h2>October 6–7.</h2>
          <p>Check back during the event as Buy Better Finds updates its deal coverage and highlights products worth a closer look.</p>
        </div>
        <a class="btn primary" href="/categories/seasonal-holidays/">Back to Seasonal & Holidays →</a>
      </div>
    </div>
  </section>

  <section class="disclosure">
    <div class="container">
      <p>Disclosure: Buy Better Finds may earn a commission from qualifying purchases made through affiliate links. Prices and availability can change.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .prime-hero{background:#10233f;color:#fff;padding:24px 0 62px}
  .breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:40px;color:#aebed1;font-size:13px}
  .breadcrumbs a{color:#d5deea;text-decoration:none}.breadcrumbs strong{color:#fff}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:54px;align-items:center}
  .prime-hero h1{color:#fff;font-size:clamp(44px,6vw,70px);line-height:1.02;margin:10px 0 18px}
  .hero-copy{color:#d5deea;font-size:19px;line-height:1.6;max-width:700px;margin:0}
  .event-date{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:25px 0}
  .event-date strong{background:#c8102e;color:#fff;border-radius:999px;padding:9px 13px;font-size:12px;letter-spacing:.05em}
  .event-date span{color:#d6a84f;font-size:12px;font-weight:800}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap}
  .hero-actions .btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;text-decoration:none}
  .hero-actions .secondary{background:#fff;color:#10233f}
  .event-card{background:#fff;color:#10233f;border-radius:18px;padding:30px;box-shadow:0 25px 60px #0003}
  .card-label,.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:900}
  .card-label{color:#c8102e}.event-card h2{font-size:30px;margin:8px 0 20px}
  .event-card ul{list-style:none;padding:0;margin:0;display:grid;gap:14px}
  .event-card li{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:800}
  .event-card li span{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#f1f5f9;color:#003087;font-size:10px}
  .section-head{max-width:820px;margin-bottom:28px}.section-head h2{margin:7px 0 10px}.section-head p{color:#64748b;line-height:1.65;margin:0}
  .info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .info-grid article{padding:25px;border:1px solid #d9e2ec;border-radius:16px;background:#fff;box-shadow:0 8px 25px #10233f0a}
  .info-grid article>strong{font-size:11px;color:#c8102e;letter-spacing:.08em;text-transform:uppercase}.info-grid h3{font-size:20px;color:#10233f;margin:9px 0}.info-grid p{font-size:13px;line-height:1.6;color:#64748b;margin:0}
  .watch-section{background:#f8fafc}
  .watch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .watch-grid a{display:flex;flex-direction:column;gap:8px;min-height:130px;padding:22px;background:#fff;border:1px solid #d9e2ec;border-radius:15px;text-decoration:none;box-shadow:0 8px 25px #10233f0a}
  .watch-grid strong{font-size:18px;color:#10233f}.watch-grid span{font-size:12px;line-height:1.55;color:#64748b}.watch-grid a::after{content:attr(href);display:none}.watch-grid a{color:#003087}.watch-grid a> :last-child{margin-top:auto;font-weight:900}
  .bottom-cta{padding:34px;border-radius:20px;background:#0f172a;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:30px}.bottom-cta h2{color:#fff;margin:7px 0 8px}.bottom-cta p{color:#cbd5e1;max-width:700px;line-height:1.6;margin:0}.bottom-cta .btn{white-space:nowrap}
  .disclosure{background:#f8fafc;padding:22px 0}.disclosure p{font-size:11px;line-height:1.6;color:#64748b;text-align:center;margin:0}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr}.info-grid,.watch-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:600px){.prime-hero{padding-bottom:44px}.breadcrumbs{margin-bottom:28px;font-size:12px;gap:7px;overflow:hidden;white-space:nowrap}.prime-hero h1{font-size:43px}.hero-copy{font-size:16px}.event-date{align-items:flex-start;flex-direction:column;gap:8px}.hero-actions{display:grid;grid-template-columns:1fr;gap:10px}.hero-actions .btn{width:100%;box-sizing:border-box}.event-card{padding:22px}.event-card h2{font-size:25px}.info-grid,.watch-grid{grid-template-columns:1fr}.info-grid article{padding:21px}.watch-grid a{min-height:110px}.bottom-cta{flex-direction:column;align-items:flex-start;padding:26px}.bottom-cta .btn{width:100%;text-align:center;box-sizing:border-box}.disclosure{padding:20px 16px}}
</style>
