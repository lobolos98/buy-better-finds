---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const gifts = [
  { name: 'Apple AirPods 4', category: 'Tech', price: 'Check price', image: 'https://www.apple.com/v/airpods-5/b/images/overview/bento-gallery/bento_pair__c7i9mu5k2zee_xlarge.jpg', alt: 'Apple AirPods 4 wireless earbuds', href: '/products/apple-airpods-4/' },
  { name: 'LEGO Bonsai Tree Building Kit', category: 'Toys & Games', price: '$17.04', image: 'https://ws-na.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=B08HVXZW8X&Format=_SL500_&ID=AsinImage&MarketPlace=US&ServiceVersion=20070822&WS=1', alt: 'LEGO Bonsai Tree building kit', href: '/products/lego-bonsai-tree-10281/' },
  { name: 'YETI Rambler Drinkware', category: 'Lifestyle', price: 'Check price', image: 'https://yeti-webmedia.imgix.net/m/3f71b90ff226c222/original/PDP_Asset_Banner_Square_PDP_Product_Navy_Coffee_Overview_Lifestyle.jpg?auto=format%2Ccompress&fit=crop&h=400&w=400', alt: 'YETI Rambler insulated drinkware', href: '/products/yeti-rambler/' },
  { name: 'Stanley Quencher H2.0 Tumbler', category: 'Lifestyle', price: 'Check price', image: 'https://www.stanley1913.com/cdn/shop/files/B2B_Web_PNG-TheQuencherH2.OFlowStateTMTumbler20OZ-Black2.0-Front_20399a06-bbde-478f-a91e-c3b545d6457d.png?v=1716304216&width=990', alt: 'Stanley Quencher H2.0 Tumbler', href: '/products/stanley-quencher/' },
  { name: 'Anker Nano Power Bank', category: 'Tech', price: 'Check price', image: 'https://cdn.shopify.com/s/files/1/0493/9834/9974/files/A1653011_ND01_V1.png?v=1728462233&width=1200', alt: 'Anker Nano Power Bank', href: '/products/anker-nano-power-bank/' },
  { name: 'Amazon Echo Dot', category: 'Smart Home', price: 'Check price', image: 'https://m.media-amazon.com/images/I/71xoR4A6q-L._AC_SL1000_.jpg', alt: 'Amazon Echo Dot smart speaker', href: '/products/amazon-echo-dot/' }
];

const giftTypes = [
  { title: 'For Tech Lovers', text: 'Useful headphones, chargers, smart devices, and everyday tech.', href: '/categories/tech/' },
  { title: 'For Homebodies', text: 'Comfortable, practical finds for cooking, relaxing, and staying organized.', href: '/categories/home-kitchen/' },
  { title: 'For Kids & Families', text: 'Toys, games, building sets, and giftable activities.', href: '/categories/toys-games/' },
  { title: 'For Everyday Life', text: 'Drinkware, lifestyle upgrades, and useful gifts people can actually use.', href: '/categories/lifestyle/' }
];
---
<BaseLayout title="Holiday Gifts | Buy Better Finds" description="Holiday gift ideas organized by recipient, interest, and everyday usefulness from Buy Better Finds.">
  <section class="gift-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/categories/">Categories</a><span>/</span><a href="/categories/seasonal-holidays/">Seasonal & Holidays</a><span>/</span><strong>Holiday Gifts</strong></div>
      <div class="hero-copy">
        <div class="eyebrow">HOLIDAY GIFTS</div>
        <h1>Gift ideas without the guesswork.</h1>
        <p>We’re building this page around useful, giftable products — not endless lists. Browse by the kind of person you’re shopping for, then see the products we think are worth a closer look.</p>
        <div class="hero-pills"><span>Useful</span><span>Giftable</span><span>Worth a look</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">SHOP BY RECIPIENT</div><h2>Start with who you're buying for.</h2><p>These gift paths will expand as we add more seasonal and holiday-specific finds.</p></div>
      </div>
      <div class="type-grid">
        {giftTypes.map((type) => (
          <a class="type-card" href={type.href}>
            <div class="type-icon">→</div>
            <h3>{type.title}</h3>
            <p>{type.text}</p>
            <strong>Explore category →</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">GIFTABLE FINDS</div><h2>Products worth putting on the list.</h2><p>A rotating selection of recognizable, practical products that can work across different gift occasions.</p></div>
      </div>
      <div class="product-grid">
        {gifts.map((gift) => (
          <a class="product-card" href={gift.href}>
            <div class="product-image"><img src={gift.image} alt={gift.alt} loading="lazy" /></div>
            <div class="product-body">
              <span class="category">{gift.category}</span>
              <h3>{gift.name}</h3>
              <div class="product-bottom"><strong>{gift.price}</strong><span>See product →</span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gift-note">
        <div><div class="eyebrow light">BUY BETTER</div><h2>We look beyond the gift wrap.</h2><p>Our goal is to help you compare products based on usefulness, value, quality, and what makes them worth considering — not simply what is trending.</p></div>
        <a class="btn primary" href="/categories/seasonal-holidays/">Back to Seasonal & Holidays →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.gift-hero{background:#10233f;color:#fff;padding:24px 0 68px}.breadcrumbs{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:44px;color:#aebed1;font-size:13px}.breadcrumbs a{color:#d5deea;text-decoration:none}.breadcrumbs strong{color:#fff}.hero-copy{max-width:820px}.gift-hero h1{color:#fff;font-size:clamp(44px,6vw,70px);line-height:1.02;margin:10px 0 18px}.gift-hero p{color:#d5deea;font-size:18px;line-height:1.7;margin:0;max-width:760px}.hero-pills{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.hero-pills span{border:1px solid #ffffff33;border-radius:999px;padding:8px 14px;font-size:12px;font-weight:800;color:#fff}.section-head{max-width:820px;margin-bottom:28px}.section-head h2{margin:7px 0 10px}.section-head p{color:#64748b;line-height:1.65;margin:0}.type-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.type-card{padding:25px;border:1px solid #d9e2ec;border-radius:16px;background:#fff;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.type-card:hover{transform:translateY(-4px);box-shadow:0 16px 32px #10233f16}.type-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:50%;background:#f8e8eb;color:#c8102e;font-size:20px;font-weight:900;margin-bottom:22px}.type-card h3{color:#10233f;font-size:20px;margin:0 0 8px}.type-card p{color:#64748b;font-size:14px;line-height:1.6;margin:0 0 18px}.type-card strong{color:#003087;font-size:12px}.featured-section{background:#f8fafc}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.product-card{overflow:hidden;background:#fff;border:1px solid #d9e2ec;border-radius:16px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.product-card:hover{transform:translateY(-4px);box-shadow:0 16px 32px #10233f16}.product-image{aspect-ratio:1/1;background:#fff;overflow:hidden}.product-image img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .3s ease}.product-card:hover img{transform:scale(1.04)}.product-body{padding:19px 20px 21px}.category{color:#c8102e;font-size:10px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.product-body h3{color:#10233f;font-size:18px;line-height:1.3;margin:8px 0 18px}.product-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px}.product-bottom strong{color:#10233f;font-size:14px}.product-bottom span{color:#003087;font-size:12px;font-weight:900}.gift-note{padding:36px;border-radius:20px;background:#0f172a;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:30px}.gift-note h2{color:#fff;margin:7px 0 8px}.gift-note p{color:#cbd5e1;max-width:700px;line-height:1.6;margin:0}.gift-note .btn{white-space:nowrap}@media(max-width:900px){.type-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.type-grid,.product-grid{grid-template-columns:1fr}.gift-hero{padding-bottom:48px}.gift-hero h1{font-size:43px}.gift-hero p{font-size:16px}.product-body h3{font-size:18px}.gift-note{flex-direction:column;align-items:flex-start}.gift-note .btn{width:100%;text-align:center}}
</style>
