---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { halloweenProducts } from '../../../../data/halloween-products.js';
import { getRecommendation } from '../../../../data/recommendations.js';
import { amazonImageOverrides } from '../../../../data/amazon-images.js';

const ranked = [...halloweenProducts].sort((a,b) => (getRecommendation(b).score ?? 0) - (getRecommendation(a).score ?? 0));
---
<BaseLayout title="Halloween Finds 2026 | Buy Better Finds" description="New Halloween 2026 products, decorations, interactive props, lighting, and seasonal builds selected and scored by Buy Better Finds.">
  <section class="hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/categories/seasonal-holidays/">Seasonal & Holidays</a><span>/</span><strong>Halloween</strong></div>
      <div class="eyebrow">HALLOWEEN 2026 · NEW FINDS</div>
      <h1>Halloween Finds Worth Clicking.</h1>
      <p class="lead">6 verified Amazon Halloween finds for the 2026 season—from outdoor displays and animatronics to costumes, party supplies, pet finds, and seasonal builds.</p>
      <div class="hero-actions"><a class="btn primary" href="#halloween-finds">Shop the finds →</a><a class="btn secondary" href="/categories/seasonal-holidays/">Seasonal & Holidays</a></div>
    </div>
  </section>
  <section class="section" id="halloween-finds">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">6 VERIFIED AMAZON HALLOWEEN FINDS</div><h2>Decorate, entertain, and build.</h2><p>Every item below is an Amazon-only Halloween shopping target using your Buy Better Finds affiliate tag. Scores use the same site-wide Buy Better Score system as the rest of the catalog. Exact Amazon ASINs and product imagery will be resolved automatically when Amazon Creators API access is enabled.</p></div></div>
      <div class="grid product-grid">
        {ranked.map((product) => {
          const rec = getRecommendation(product);
          const amazon = amazonImageOverrides[product.slug];
          const amazonUrl = amazon?.asin ? `https://www.amazon.com/dp/${amazon.asin}?tag=buybetterfi06-20` : product.url;
          const productImage = amazon?.image || product.image;
          return <article class="card product-card">
            <a class="product-image" href={`/products/${product.slug}/`}><img src={productImage} alt={product.imageAlt} loading="lazy" width="900" height="900" /><span class="pick-badge">HALLOWEEN FIND</span></a>
            <div class="tag">SEASONAL & HOLIDAYS</div>
            <h3>{product.name}</h3>
            <div class="score-row"><strong>{Number(rec.score).toFixed(1)}</strong><span>BUY BETTER SCORE</span></div>
            <div class="best-for"><strong>BEST FOR</strong><span>{rec.bestFor || product.bestFor}</span></div>
            <p>{product.why}</p>
            <div class="tradeoff"><strong>WATCH</strong><span>{product.watch}</span></div>
            <div class="card-footer"><strong>{product.price}</strong><a href={`/products/${product.slug}/`}>See our take →</a></div>
            <div class="affiliate-actions"><a href={amazonUrl} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a></div>
          </article>
        })}
      </div>
      <p class="affiliate-disclosure">Retailer prices and availability can change. We may earn commissions from qualifying purchases where applicable; always confirm current details on the retailer's site before buying.</p>
    </div>
  </section>
</BaseLayout>
<style>
.hero{padding:24px 0 58px;background:#10233f;color:#fff}.breadcrumbs{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:35px;font-size:13px;color:#aebed1}.breadcrumbs a{color:#d5deea;text-decoration:none}.breadcrumbs strong{color:#fff}.hero h1{color:#fff;font-size:clamp(42px,6vw,70px);line-height:1.02;max-width:850px;margin:8px 0 18px}.hero .lead{color:#d5deea;max-width:820px;font-size:18px;line-height:1.65}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.section-head{max-width:850px;margin-bottom:28px}.section-head h2{margin:7px 0 10px}.section-head p{color:#64748b;line-height:1.6}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.product-card{overflow:hidden;display:flex;flex-direction:column}.product-image{position:relative;display:block;aspect-ratio:1/1;background:#f3f5f8;overflow:hidden;border-radius:16px 16px 0 0}.product-image img{width:100%;height:100%;object-fit:contain;padding:22px}.pick-badge{position:absolute;top:14px;left:14px;background:#c8102e;color:#fff;padding:7px 9px;border-radius:999px;font-size:9px;font-weight:900;letter-spacing:.1em}.score-row{display:flex;align-items:baseline;gap:8px;margin:12px 0}.score-row strong{font-size:25px;color:#10233f}.score-row span{font-size:9px;letter-spacing:.12em;color:#c8102e;font-weight:900}.best-for,.tradeoff{display:grid;gap:4px;padding:11px;margin:10px 0;border-radius:10px;background:#f8fafc}.best-for strong,.tradeoff strong{font-size:10px;letter-spacing:.12em;color:#c8102e}.best-for span,.tradeoff span{font-size:13px;line-height:1.45;color:#334155}.tradeoff{background:#fff7f7;border:1px solid #f3dddd}.card-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto;padding-top:14px}.card-footer a{background:#2366a8;color:#fff;padding:11px 13px;border-radius:8px;text-decoration:none;font-size:12px;font-weight:850}.affiliate-actions{margin-top:9px}.affiliate-actions a{display:block;text-align:center;background:#ffb000;color:#10233f;padding:12px;border-radius:8px;text-decoration:none;font-size:12px;font-weight:900}@media(max-width:900px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.product-grid{grid-template-columns:1fr}.hero h1{font-size:43px}.hero .lead{font-size:16px}.card-footer{flex-direction:column;align-items:stretch}.card-footer a{width:100%;box-sizing:border-box;text-align:center}.affiliate-actions a{min-height:44px;display:flex;align-items:center;justify-content:center;box-sizing:border-box}}
</style>
