---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const productSpecs = [
  { category: 'CLOTHING', terms: ['fable top','hali top','charlotte dress','leighton set','dress','top','set','blouse'], detail: 'A colorful clothing option to style with everyday wardrobe basics.' },
  { category: 'JEWELRY', terms: ['rainbow confetti necklace','rainbow colorblock earrings','flower tile cabana earrings','earrings','necklace','bangle','bracelet'], detail: 'A statement accessory for adding a playful accent to an outfit.' },
  { category: 'BAGS & TOTES', terms: ['painted gingham canvas tote','rainbow plaid canvas tote','canvas tote','tote','bag'], detail: 'A patterned bag for errands, travel, or carrying everyday essentials.' },
  { category: 'CLOTHING', terms: ['colorful leighton set','harbor plaid charlotte dress','wildflower tango fable top','harvest blooms hali top','dress','top','set'], detail: 'An easy-to-style clothing piece with color or pattern.' },
  { category: 'JEWELRY', terms: ['rainbow colorblock earrings','rainbow tile earrings','flower tile cabana earrings','earrings','necklace','bangle'], detail: 'A colorful jewelry option to finish a casual or vacation-ready look.' },
  { category: 'HATS', terms: ['gabriela bucket hat','marta palm hat','rosita palm hat','carolina palm hat','natural rancher palm hat','palm hat','bucket hat','hat'], detail: 'A distinctive hat for sunny days, travel, and vacation outfits.' },
  { category: 'BAGS & TOTES', terms: ['rainbow plaid canvas tote','painted gingham canvas tote','tote','bag'], detail: 'A colorful carryall for everyday essentials or weekend packing.' },
  { category: 'CLOTHING', terms: ['harvest blooms hali top','wildflower tango fable top','harbor plaid charlotte dress','dress','top','set'], detail: 'A printed or colorful clothing piece for a standout outfit.' },
  { category: 'HATS', terms: ['gabriela bucket hat','marta palm hat','rosita palm hat','carolina palm hat','natural rancher palm hat','hat'], detail: 'An alternative hat silhouette for a sunny-day wardrobe.' },
  { category: 'JEWELRY', terms: ['rainbow colorblock earrings','rainbow confetti necklace','flower tile cabana earrings','earrings','necklace','bangle','bracelet'], detail: 'A bright finishing touch that can make a simple outfit feel more personal.' }
];
const normalize = (value) => String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const cleanImage = (value) => {
  if (typeof value !== 'string' || !value) return '';
  try {
    const url = new URL(value.startsWith('//') ? 'https:' + value : value, 'https://www.sunshinetienda.com');
    return url.protocol === 'https:' && (url.hostname === 'sunshinetienda.com' || url.hostname.endsWith('.sunshinetienda.com') || url.hostname === 'cdn.shopify.com' || url.hostname.endsWith('.shopifycdn.net')) ? url.toString() : '';
  } catch { return ''; }
};
let catalog = [];
try {
  const response = await fetch('https://www.sunshinetienda.com/products.json?limit=250', { signal: AbortSignal.timeout(12000) });
  if (response.ok) {
    const data = await response.json();
    catalog = (Array.isArray(data.products) ? data.products : []).map((product) => {
      const image = cleanImage(product.images?.[0]?.src || product.image?.src || product.image);
      const priceValue = Number(product.variants?.[0]?.price);
      return { title: String(product.title || ''), handle: String(product.handle || ''), image, price: Number.isFinite(priceValue) && priceValue > 0 ? '$' + priceValue.toFixed(2) : 'Check current price' };
    }).filter((product) => product.handle && product.image && product.title);
  }
} catch (error) {
  console.warn('Sunshine Tienda product catalog could not be loaded:', String(error));
}
const usedHandles = new Set();
const items = productSpecs.map((spec) => {
  const match = catalog.find((product) => !usedHandles.has(product.handle) && spec.terms.some((term) => normalize(product.title).includes(normalize(term))));
  if (!match) return null;
  usedHandles.add(match.handle);
  const url = 'https://www.sunshinetienda.com/products/' + match.handle;
  return {
    name: match.title,
    category: spec.category,
    detail: spec.detail,
    price: match.price,
    image: match.image,
    verified: true,
    url,
    affiliateUrl: 'https://www.awin1.com/cread.php?awinmid=59383&awinaffid=3119041&ued=' + encodeURIComponent(url)
  };
}).filter(Boolean);
const photoItems = items.filter((item) => item.image && item.verified);

---
<BaseLayout title="Clothing & Accessories | Buy Better Finds" description="Browse colorful clothing, bags, jewelry, and hats from brands worth a closer look. Compare style, details, and current product listings.">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buybetterfinds.com/' },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://buybetterfinds.com/categories/' },
      { '@type': 'ListItem', position: 3, name: 'Clothing & Accessories', item: 'https://buybetterfinds.com/categories/clothing-accessories/' }
    ]
  })} />
  <main class="section fashion-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/categories/">Categories</a><span>/</span><strong>Clothing &amp; Accessories</strong></nav>
      <section class="fashion-hero">
        <div class="fashion-hero-copy">
          <span class="eyebrow">THE STYLE EDIT · CURATED FINDS</span>
          <h1>Clothing &amp; Accessories</h1>
          <p class="lead">Colorful clothing, standout jewelry, useful bags, and hats that bring personality to everyday outfits. Start with this curated Sunshine Tienda edit, then check back as we add more brands and price points.</p>
          <div class="hero-pills"><span>Clothing</span><span>Bags &amp; Totes</span><span>Jewelry</span><span>Hats</span></div>
          <a class="shop-collection" href="https://www.awin1.com/cread.php?awinmid=59383&awinaffid=3119041&ued=https%3A%2F%2Fwww.sunshinetienda.com%2Fcollections%2Fall" target="_blank" rel="sponsored nofollow noopener noreferrer">Browse Sunshine Tienda collection ↗</a>
        </div>
        <div class="hero-image">
          {photoItems[0]?.image && <img src={photoItems[0].image} alt={photoItems[0].name + ' from Sunshine Tienda'} fetchpriority="high" />}
          <div class="hero-image-caption"><span>FEATURED BRAND</span><strong>Sunshine Tienda</strong><small>Colorful pieces for everyday and getaway style</small></div>
        </div>
      </section>

      <section class="intro-strip">
        <div><span class="eyebrow">THE FIRST EDIT</span><h2>{items.length} Sunshine Tienda finds to browse</h2></div>
        <p>Every card below is matched to a live Sunshine Tienda catalog entry with its own product image and product URL. Items that cannot be matched are omitted rather than shown with broken links or placeholder photography.</p>
      </section>

      <div class="fashion-grid">
        {items.map((item, index) => <article class="fashion-card">
          {item.image && <a class="fashion-photo" href={item.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label={'Shop ' + item.name + ' at Sunshine Tienda'}><img src={item.image} alt={item.name + ' product photo from Sunshine Tienda'} loading="lazy" /></a>}
          <div class="fashion-card-body">
            <div class="fashion-card-meta"><span>{item.category}</span><span>FIND {String(index + 1).padStart(2, '0')}</span></div>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
            <div class="fashion-card-bottom"><span>{item.price}</span><a href={item.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">Shop item ↗</a></div>
          </div>
        </article>)}
      </div>
      <p class="affiliate-note">Affiliate disclosure: Buy Better Finds may earn a commission when you shop through links on this page. This is an independent shopping edit, not a hands-on review. Prices, sizes, availability, and product details can change; confirm the current listing before ordering.</p>
      <section class="more-style">
        <div><span class="eyebrow">KEEP EXPLORING</span><h2>More ways to shop</h2><p>Explore the wider catalog and practical shopping guides as the category grows.</p></div>
        <div class="more-links"><a href="/blog/sunshine-tienda-style-accessories/">Read the Sunshine Tienda style guide <span>→</span></a><a href="/categories/">Browse all categories <span>→</span></a><a href="/guides/">Explore buying guides <span>→</span></a></div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
.fashion-page{padding-top:24px}.catalog-empty{padding:24px;border:1px solid #e2e8f0;border-radius:12px;color:#475569;background:#f8fafc}.breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:30px;color:#64748b;font-size:13px}.breadcrumbs a{color:#475569;text-decoration:none}.breadcrumbs strong{color:#111827}.fashion-hero{display:grid;grid-template-columns:1.08fr .92fr;gap:34px;align-items:stretch;margin-bottom:42px}.fashion-hero-copy{padding:clamp(22px,4vw,48px);border-radius:18px;background:#f8fafc;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;color:#c8102e}.fashion-hero h1{font-size:clamp(38px,5.4vw,64px);line-height:.99;letter-spacing:-.04em;margin:14px 0 18px;color:#111827}.lead{font-size:17px;line-height:1.7;color:#475569;max-width:640px;margin:0}.hero-pills{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0}.hero-pills span{padding:8px 11px;background:#fff;border:1px solid #e2e8f0;border-radius:999px;color:#334155;font-size:12px;font-weight:700}.shop-collection{display:inline-flex;background:#c8102e;color:#fff;text-decoration:none;font-weight:800;border-radius:8px;padding:13px 17px}.hero-image{position:relative;min-height:380px;background:#f1f5f9;border-radius:18px;overflow:hidden}.hero-image>img{width:100%;height:100%;min-height:380px;object-fit:cover;display:block}.hero-image-caption{position:absolute;left:16px;right:16px;bottom:16px;padding:16px;background:rgba(255,255,255,.94);border-radius:10px;display:grid;gap:4px}.hero-image-caption span{font-size:10px;letter-spacing:.12em;font-weight:800;color:#c8102e}.hero-image-caption strong{font-size:20px;color:#111827}.hero-image-caption small{font-size:12px;color:#475569}.intro-strip{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;align-items:end;margin:42px 0 22px;border-bottom:1px solid #e2e8f0;padding-bottom:20px}.intro-strip h2,.more-style h2{font-size:clamp(25px,3vw,34px);line-height:1.1;margin:8px 0 0;color:#111827}.intro-strip p,.more-style p{color:#64748b;line-height:1.65;margin:0}.fashion-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.fashion-card{border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;background:#fff;display:flex;flex-direction:column;min-width:0}.fashion-photo{display:block;aspect-ratio:4/5;background:#f8fafc;overflow:hidden}.fashion-photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.fashion-photo:hover img{transform:scale(1.025)}.fashion-card-body{padding:18px;display:flex;flex-direction:column;flex:1}.fashion-card-meta{display:flex;justify-content:space-between;gap:8px;color:#64748b;font-size:10px;font-weight:800;letter-spacing:.08em}.fashion-card-meta span:first-child{color:#c8102e}.fashion-card h3{font-size:20px;line-height:1.2;margin:11px 0;color:#111827}.fashion-card p{font-size:14px;line-height:1.6;color:#64748b;margin:0 0 18px}.fashion-card-bottom{margin-top:auto;border-top:1px solid #e2e8f0;padding-top:14px;display:flex;justify-content:space-between;align-items:center;gap:10px}.fashion-card-bottom>span{font-weight:800;color:#111827;font-size:14px}.fashion-card-bottom a{font-weight:800;font-size:12px;color:#003087;text-decoration:none}.affiliate-note{margin:28px 0;color:#64748b;font-size:12px;line-height:1.6}.more-style{margin-top:52px;padding:28px;border-radius:16px;background:#f8fafc;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center}.more-links{display:grid;gap:0}.more-links a{display:flex;justify-content:space-between;gap:16px;padding:13px 0;color:#003087;text-decoration:none;font-weight:750;border-bottom:1px solid #e2e8f0}.more-links a:last-child{border-bottom:0}@media(max-width:800px){.fashion-hero{grid-template-columns:1fr}.hero-image,.hero-image>img{min-height:300px}.intro-strip,.more-style{grid-template-columns:1fr;gap:14px}.fashion-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.fashion-card-body{padding:14px}.fashion-card h3{font-size:17px}}@media(max-width:520px){.fashion-grid{grid-template-columns:1fr}.fashion-photo{aspect-ratio:4/3}.fashion-hero h1{font-size:40px}.hero-image,.hero-image>img{min-height:280px}}
</style>
