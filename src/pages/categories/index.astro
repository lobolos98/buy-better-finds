---
import BaseLayout from '../../layouts/BaseLayout.astro';
const cats = [
  ['Home & Kitchen','home'],
  ['Tech','tech'],
  ['Tools & DIY','tools-diy'],
  ['Outdoor','outdoor'],
  ['Smart Home','smart-home'],
  ['Fitness','fitness'],
  ['Lifestyle','lifestyle']
];
---
<BaseLayout title="Categories | Buy Better Finds" description="Browse Buy Better Finds product categories.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Browse</div>
      <h1>Shop by category.</h1>
      <p class="lead">Explore the areas where better product research can make a difference.</p>
      <div class="grid">
        {cats.map(([name, slug]) => <article class="card">
          <span class="tag">Category</span>
          <h3>{name}</h3>
          <p>Curated recommendations and buying notes for practical purchases.</p>
          <a class="arrow" href={`/categories/${slug}/`}>Explore {name} →</a>
        </article>)}
      </div>
    </div>
  </section>
</BaseLayout>
