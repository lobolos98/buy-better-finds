---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { amazonProductUrl } from '../../utils/amazon.js';
import { getRecommendation } from '../../data/recommendations.js';

export function getStaticPaths() {
  const categoryNames = {
    'home-kitchen': 'Home & Kitchen',
    tech: 'Tech',
    'tools-diy': 'Tools & DIY',
    outdoor: 'Outdoor',
    'smart-home': 'Smart Home',
    fitness: 'Fitness',
    lifestyle: 'Lifestyle',
    'gifts-collectibles': 'Gifts & Collectibles',
    'toys-games': 'Toys & Games',
    'beauty-personal-care': 'Beauty & Personal Care',
    'pet-supplies': 'Pet Supplies',
    'automotive-car-accessories': 'Automotive & Car Accessories'
  };
  return Object.entries(categoryNames).map(([slug, name]) => ({ params: { category: slug }, props: { name } }));
}

const categoryNames = {
  'home-kitchen': 'Home & Kitchen',
  tech: 'Tech',
  'tools-diy': 'Tools & DIY',
  outdoor: 'Outdoor',
  'smart-home': 'Smart Home',
  fitness: 'Fitness',
  lifestyle: 'Lifestyle',
  'gifts-collectibles': 'Gifts & Collectibles',
  'toys-games': 'Toys & Games',
  'beauty-personal-care': 'Beauty & Personal Care',
  'pet-supplies': 'Pet Supplies',
    'automotive-car-accessories': 'Automotive & Car Accessories'
};

const categoryThemes = {
  'Home & Kitchen': ['Counter space', 'Capacity', 'Ease of cleaning', 'Everyday convenience'],
  Tech: ['Compatibility', 'Battery life', 'Comfort & fit', 'Long-term value'],
  'Tools & DIY': ['Power & platform', 'Kit contents', 'Ergonomics', 'Project fit'],
  Outdoor: ['Space & setup', 'Durability', 'Weather exposure', 'Seasonal use'],
  'Smart Home': ['Compatibility', 'Setup', 'Subscriptions', 'Automation'],
  Fitness: ['Training goals', 'Battery life', 'Comfort', 'Data & features'],
  Lifestyle: ['Size & portability', 'Durability', 'Daily use', 'Cleaning'],
  'Gifts & Collectibles': ['Who it is for', 'Edition & availability', 'Display value', 'Gift budget'],
  'Toys & Games': ['Age fit', 'Play value', 'Repeat use', 'Storage'],
  'Beauty & Personal Care': ['Skin or hair goal', 'Formula', 'Routine fit', 'Value'],
  'Pet Supplies': ['Pet size & age', 'Cleaning & upkeep', 'Safety & materials', 'Long-term value'],
  'Automotive & Car Accessories': ['Vehicle compatibility', 'Installation', 'Safety & reliability', 'Long-term value']
};

const categoryAdvice = {
  'Home & Kitchen': 'Prioritize capacity, footprint, cleanup, and how often the product will actually earn its counter or cabinet space.',
  Tech: 'Start with the device ecosystem and your main use case. Then compare comfort, battery life, connectivity, and the features you will use most.',
  'Tools & DIY': 'Match the tool to the work you actually do. Platform compatibility, included accessories, ergonomics, and kit contents can matter more than headline specs. For fishing tools, consider whether you need a full kit or only essentials such as pliers, line cutters, or a spooler.',
  Outdoor: 'For fishing gear, match rod power, action, line and lure ratings to your target species and conditions. For patio products, consider footprint, weather exposure, setup, maintenance, and seasonal storage.',
  'Smart Home': 'Check compatibility before features. The right product should work with your existing ecosystem and make everyday routines simpler rather than adding another app.',
  Fitness: 'Choose around your training goal rather than the feature count. Comfort, battery life, accuracy, and the metrics you will use are the practical priorities.',
  Lifestyle: 'Focus on the way you carry, use, clean, and store the product. Small differences in size and durability can matter every day.',
  'Gifts & Collectibles': 'Shop around the recipient and the occasion first. Edition, character or franchise, display value, age fit, and current availability all matter.',
  'Toys & Games': 'Look beyond the box art. Age fit, repeat play, setup time, storage, and whether the child can play independently are useful filters.',
  'Beauty & Personal Care': 'Start with the specific routine or grooming goal. Formula, compatibility, frequency of use, and total routine cost are more useful than hype.',
  'Pet Supplies': 'Start with your pet’s species, size, age, and daily routine. Compare safety, ease of cleaning, durability, and ongoing supply costs before buying.',
  'Automotive & Car Accessories': 'Check your vehicle compatibility first, then compare reliability, installation requirements, safety, and practical everyday value.'
};

const categoryGuides = {
  'Home & Kitchen': '/guides/best-home-kitchen/',
  Tech: '/guides/best-tech/',
  'Tools & DIY': '/guides/best-tools-diy/',
  Outdoor: '/guides/best-outdoor/',
  'Smart Home': '/guides/best-smart-home/',
  Lifestyle: '/guides/best-everyday-products/',
  'Beauty & Personal Care': '/categories/beauty-personal-care/cosmetics/',
  'Automotive & Car Accessories': '/guides/best-automotive-accessories/'
};

const categoryComparisons = {
  Tech: [['Sony WH-1000XM5 vs AirPods 4', '/comparisons/sony-wh-1000xm5-vs-airpods-4/']],
  'Home & Kitchen': [['Ninja AF101 vs Instant Vortex Plus', '/comparisons/ninja-af101-vs-instant-vortex-plus/'], ['Dyson V8 vs Shark Navigator', '/comparisons/dyson-v8-vs-shark-navigator/']],
  Lifestyle: [['YETI Rambler vs Stanley Quencher', '/comparisons/yeti-rambler-vs-stanley-quencher/']],
  'Smart Home': [['TP-Link Outdoor Plug vs Ring Doorbell', '/comparisons/tp-link-outdoor-plug-vs-ring-doorbell/']],
  'Toys & Games': [['Goally vs. iPad: Learning, Routines & Independence', '/blog/goally-vs-ipad-learning-tablet/']]
};


const { name } = Astro.props;
const matches = products.filter((product) => product.category === name);
const themes = categoryThemes[name] ?? [];
const advice = categoryAdvice[name] ?? 'Start with your use case, then compare the features, limitations, and total cost that matter most to you.';
const isAutomotivePending = name === 'Automotive & Car Accessories' && matches.length === 0;
const rankedMatches = [...matches].sort((a, b) => (getRecommendation(b).score ?? 0) - (getRecommendation(a).score ?? 0));
const imageSource = (product) => product.manufacturerImage || product.amazonImage || product.image;

// Featured LEGO sets paired with their matching BRKOX lighting accessories.
// Keep Amazon destinations as direct product-detail URLs with the site's affiliate tag.
const legoFeaturedKits = [
  { name: 'LEGO Star Wars Death Star', set: '75419', asin: 'B0FMS7Y4NN', url: 'https://brkox.com/products/light-kit-compatible-with-lego%C2%AE-death-star-set-75419' },
  { name: 'LEGO The Legend of Zelda Great Deku Tree 2-in-1', set: '77092', asin: 'B0DG2RXK46', url: 'https://brkox.com/products/led-light-kit-compatible-with-lego%C2%AE-the-legend-of-zelda-great-deku-tree-2-in-1-set-77092' },
  { name: 'LEGO Winter Village Station', set: '10259', asin: 'B075LVT3PH', url: 'https://brkox.com/products/light-kit-for-lego%C2%AE-winter-village-station-10259' },
  { name: 'LEGO Harry Potter Diagon Alley', set: '75978', asin: 'B08H5TT95H', url: 'https://brkox.com/products/light-kit-compatible-with-lego%C2%AE-diagon-alley%E2%84%A2-set-75978' },
  { name: 'LEGO Holiday Main Street', set: '10308', asin: 'B0BBSW13CH', url: 'https://brkox.com/products/light-kit-for-lego%C2%AE-holiday-main-street-10308' },
  { name: 'LEGO Icons Hubble Space Telescope', set: '11382', asin: 'B0G2T1RCPX', url: 'https://brkox.com/products/light-kit-for-lego-hubble-space-telescope-11382' }
];
const legoImageResults = await Promise.all(legoFeaturedKits.map(async (kit) => {
  try {
    const response = await fetch(kit.url + '.js', { signal: AbortSignal.timeout(8000) });
    if (!response.ok) return null;
    const product = await response.json();
    const title = String(product.title || '');
    if (!new RegExp('(?:^|\\D)' + kit.set + '(?:\\D|$)').test(title)) return null;
    const image = product.featured_image || product.images?.[0];
    if (typeof image !== 'string') return null;
    const url = new URL(image.startsWith('//') ? 'https:' + image : image, kit.url);
    if (url.protocol !== 'https:' || !url.hostname.endsWith('shopify.com')) return null;
    return url.toString();
  } catch { return null; }
}));
const featuredLego = legoFeaturedKits.map((kit, i) => ({
  ...kit,
  image: legoImageResults[i],
  amazonUrl: 'https://www.amazon.com/dp/' + kit.asin + '?tag=buybetterfi06-20',
  lightUrl: 'https://www.awin1.com/cread.php?awinmid=129093&awinaffid=3119041&ued=' + encodeURIComponent(kit.url)
}));

// Everblog products are presented as an editorial partner collection, not Amazon products.
const everblogCategories = ['Smart Home', 'Home & Kitchen', 'Gifts & Collectibles'];
const showEverblog = everblogCategories.includes(name);
const everblogAffiliate = (url) => 'https://www.awin1.com/cread.php?awinmid=128579&awinaffid=3119041&ued=' + encodeURIComponent(url);
const everblogCollection = everblogAffiliate('https://everblog.com/collections/all-products');
const everblogProducts = [
 { name: 'Everblog FridgeCal 13.4-inch Smart Calendar', match: 'fridgecal', description: 'Rechargeable, fridge-friendly family calendar for schedules, meals and shared household planning.', best: 'Kitchen-centered organization' },
 { name: 'Everblog HomeCal 21.5-inch Smart Calendar', match: 'homecal', description: 'Larger shared family organizer for schedules, chores, lists and meal planning.', best: 'A visible household command center' }
];
let everblogListings = [];
if (showEverblog) {
 try {
  const response = await fetch('https://everblog.com/collections/all-products/products.json?limit=100', { signal: AbortSignal.timeout(9000) });
  if (response.ok) {
   const data = await response.json();
   const catalog = Array.isArray(data.products) ? data.products : [];
   everblogListings = everblogProducts.map(p => {
    const item = catalog.find(x => String(x.title || '').toLowerCase().includes(p.match));
    if (!item?.handle) return null;
    const raw = item.images?.[0]?.src || item.image?.src || '';
    let image = '';
    try {
     const u = new URL(raw, 'https://everblog.com');
     if (u.protocol === 'https:' && (u.hostname === 'everblog.com' || u.hostname.endsWith('.shopify.com'))) image = u.toString();
    } catch {}
    return { ...p, image, href: everblogAffiliate('https://everblog.com/products/' + item.handle) };
   }).filter(Boolean);
  }
 } catch {}
}

---
<BaseLayout title={name === 'Toys & Games' ? 'Toys & Games: Learning Toys, LEGO & Family Games | Buy Better Finds' : `${name} Buying Guide | Buy Better Finds`} description={name === 'Toys & Games' ? 'Compare learning tablets, building sets, creative toys and family games. Explore age fit, repeat-play value, parent involvement and buying tradeoffs.' : `Shop ${name} recommendations from Buy Better Finds, with practical buying guidance, strengths, tradeoffs, comparisons, and product sources.`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buybetterfinds.com/' },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://buybetterfinds.com/categories/' },
      { '@type': 'ListItem', position: 3, name, item: new URL(Astro.url.pathname, 'https://buybetterfinds.com').toString() }
    ]
  })} />
  <section class="section category-page"><div class="container">
    <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/categories/">Categories</a><span>/</span><strong>{name}</strong></div>
    <div class="category-hero"><div><div class="eyebrow">SHOPPING HUB · {matches.length} FINDS</div><h1>{name}</h1><p class="lead">{advice}</p>{name === 'Gifts & Collectibles' && <p style="margin-top:1rem"><a href="/categories/gifts-collectibles/lego-light-kits/" style="display:inline-block;background:#003087;color:#fff;padding:.8rem 1.1rem;border-radius:9px;text-decoration:none;font-weight:700">Explore LEGO-compatible lighting kits →</a></p>}</div><div class="category-rule"><strong>HOW TO SHOP</strong><span>Start with your use case, then compare the tradeoffs.</span></div></div>
    {name === 'Toys & Games' && <section class="section" aria-label="Toys and games buying advice"><div class="container" style="padding:22px 0"><p class="eyebrow">BEYOND THE PRODUCT LIST</p><h2>Choose for the way your child actually plays and learns.</h2><p>For building sets, compare age recommendations with the child's experience, the number of pieces and whether the finished build is meant for display or repeated play. For family games, check player count, reading requirements and how long a round takes. For learning tablets, distinguish structured routines and guided lessons from a general-purpose device with broader apps and entertainment.</p><p>A higher score is not a universal recommendation: a child who enjoys open-ended building may get more repeat value from a construction set, while a family prioritizing visual schedules may prefer a dedicated learning device. Compare the tradeoffs before choosing.</p><p><a href="/blog/goally-vs-ipad-learning-tablet/">Explore our detailed Goally vs. iPad learning comparison →</a></p></div></section>}
    {name === 'Beauty & Personal Care' && <section class="section" aria-label="Featured toothbrush comparison"><div class="container" style="padding:22px 0"><p class="eyebrow">FEATURED ORAL CARE COMPARISON</p><h2>Triple Bristle: four toothbrushes compared</h2><p>Explore Original, Max, Kids and Duo three-sided sonic toothbrushes, including fit, replacement-head compatibility and buying considerations.</p><a href="/blog/triple-bristle-sonic-toothbrush/" style="display:inline-block;background:#142b45;color:#fff;padding:13px 20px;border-radius:8px;text-decoration:none;font-weight:700">Read the comparison →</a></div></section>}
    {name === 'Gifts & Collectibles' && <section class="lego-featured" aria-label="Featured LEGO sets and matching lighting kits">
      <div class="section-head"><div><div class="eyebrow">FEATURED COLLECTIBLES</div><h2>LEGO sets &amp; matching light kits.</h2><p class="lego-intro">Shop the building set on Amazon, then add its separate BRKOX lighting kit if you want to illuminate your display.</p></div><a class="text-link" href="/categories/gifts-collectibles/lego-light-kits/">View the full LEGO collection →</a></div>
      <div class="lego-featured-grid">{featuredLego.map((kit) => <article class="lego-featured-card">
        {kit.image && <a class="lego-featured-photo" href={kit.amazonUrl} target="_blank" rel="nofollow sponsored noopener" aria-label={`Shop ${kit.name} on Amazon`}><img src={kit.image} alt={`BRKOX lighting kit for ${kit.name}, set ${kit.set}`} loading="lazy" width="640" height="480" /></a>}
        <div class="lego-featured-body"><span class="lego-set-number">LEGO SET #{kit.set}</span><h3>{kit.name}</h3><p class="lego-note">Building set and lighting kit are sold separately.</p>
          <a class="lego-amazon-link" href={kit.amazonUrl} target="_blank" rel="nofollow sponsored noopener">Shop LEGO set on Amazon →</a>
          <a class="lego-light-link" href={kit.lightUrl} target="_blank" rel="nofollow sponsored noopener">Shop matching BRKOX light kit →</a>
        </div>
      </article>)}</div>
      <p class="lego-disclosure">As an Amazon Associate, Buy Better Finds earns from qualifying purchases. BRKOX links may also earn a commission. LEGO® is a trademark of the LEGO Group; BRKOX lighting kits are independent accessories. LEGO sets are not included with lighting kits.</p>
    </section>}
    {showEverblog && <section class="everblog-category" aria-label="Everblog smart family calendars">
      <div class="section-head"><div><div class="eyebrow">FEATURED FAMILY ORGANIZATION</div><h2>Meet Everblog smart calendars.</h2><p>Compare connected household calendars for kitchen routines and shared family spaces.</p></div><a class="text-link" href="/blog/everblog-smart-family-calendars/">Read our FridgeCal vs. HomeCal guide →</a></div>
      {everblogListings.length > 0 && <div class="everblog-category-grid">{everblogListings.map(p => <article class="everblog-category-card">
        {p.image && <a href={p.href} target="_blank" rel="sponsored noopener noreferrer"><img src={p.image} alt={p.name} loading="lazy" /></a>}
        <div><span class="eyebrow">{p.best}</span><h3>{p.name}</h3><p>{p.description}</p><a class="everblog-category-buy" href={p.href} target="_blank" rel="sponsored noopener noreferrer">View product details →</a></div>
      </article>)}</div>}
      <p class="everblog-category-note">Everblog links are Awin affiliate links; Buy Better Finds may earn a commission. Product photos and direct links appear when verified against Everblog's current catalog. <a href={everblogCollection} target="_blank" rel="sponsored noopener noreferrer">Shop Everblog's full collection →</a></p>
    </section>}
    {isAutomotivePending && <section class="theme-panel" aria-label="Automotive catalog status"><div><div class="eyebrow">PRODUCT REVIEWS IN PROGRESS</div><h2>We're checking products before listing them.</h2><p>We are verifying exact Amazon listings and genuine product photography for jump starters, tire inflators, dash cameras, and practical car accessories.</p><p><a class="text-link" href="/guides/best-automotive-accessories/">Read the automotive buying guide →</a></p></div></section>}
    {themes.length > 0 && <section class="theme-panel"><div><div class="eyebrow">SHOPPING FILTERS</div><h2>What to look for.</h2><p>Use these practical filters to narrow the category before you compare individual products.</p></div><div class="theme-list">{themes.map((theme) => <span>{theme}</span>)}</div></section>}
    {rankedMatches.length > 0 && <>
      <section class="featured-section"><div class="section-head"><div><div class="eyebrow">SHORTLISTED FINDS</div><h2>Start with the products worth comparing.</h2></div><a class="text-link" href="/products/">Browse all finds →</a></div>
        <div class="grid category-product-grid">{rankedMatches.map((product, index) => { const amazonUrl = product.affiliateUrl ?? (product.category === 'Beauty & Personal Care' && product.url?.includes('amazon.com/dp/')
          ? product.url
          : (product.amazonUrl ?? (product.amazonAsin ? amazonProductUrl(product.amazonAsin) : (product.url?.includes('/dp/') ? product.url : null)))); const rec = getRecommendation(product); return <article class="card product-card">
          {product.image && <a class="product-image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>{index === 0 && <span class="pick-badge">TOP FIND</span>}<img src={product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" /></a>}
          <div class="tag">{index === 0 ? 'TOP FIND · ' : ''}{product.category}</div><h3>{product.name}</h3>
          {rec?.score != null && Number.isFinite(Number(rec.score)) && <div class="score-row"><strong>{Number(rec.score).toFixed(1)}/10</strong><span>BUY BETTER SCORE</span></div>}
          <div class="best-for"><strong>BEST FOR</strong><span>{rec.bestFor || product.bestFor}</span></div><p>{product.why}</p>
          <div class="tradeoff"><strong>WATCH</strong><span>{product.watch}</span></div>
          <div class="card-footer"><strong>{name === 'Toys & Games' ? 'Check Price' : product.price}</strong><a class="arrow" href={`/products/${product.slug}/`}>See our take →</a></div>
          <div class="affiliate-actions">{amazonUrl && !product.affiliateDestinationUnverified && <a class="amazon-button" href={amazonUrl} target="_blank" rel="nofollow sponsored noopener">{product.affiliateLabel ?? 'Check on Amazon'} →</a>}</div>
        </article>; })}</div>
        <p class="affiliate-disclosure">As an Amazon Associate and Awin publisher, Buy Better Finds may earn from qualifying purchases. Product availability and prices can change; confirm current details with the retailer before buying.</p>
      </section>
      <section class="decision-section"><div class="decision-copy"><div class="eyebrow">BUYING CHECKLIST</div><h2>Before you buy, ask these questions.</h2><p>{advice}</p></div>
        <div class="checklist">{themes.slice(0,4).map((theme, index) => <div class="check-item"><span>0{index + 1}</span><div><strong>{theme}</strong><p>{index === 0 ? 'Does this match the way you will actually use it?' : index === 1 ? 'Will the product fit your space, setup, or existing gear?' : index === 2 ? 'What limitation could matter after the first few weeks?' : 'Is the extra cost buying something you will actually use?'}</p></div></div>)}</div>
      </section>
      {categoryComparisons[name]?.length > 0 && <section class="compare-section"><div class="section-head"><div><div class="eyebrow">SIDE-BY-SIDE</div><h2>Compare before choosing.</h2></div><a class="text-link" href="/comparisons/">All comparisons →</a></div><div class="compare-grid">{categoryComparisons[name].map(([title, href]) => <a class="compare-card" href={href}><span>COMPARISON</span><strong>{title}</strong><b>See the tradeoffs →</b></a>)}</div></section>}
      {categoryGuides[name] && <section class="guide-banner"><div><div class="eyebrow">GO DEEPER</div><h2>Read the buying guide.</h2><p>Use a longer-form guide when you want the reasoning behind the shortlist, not just the product cards.</p></div><a class="btn primary" href={categoryGuides[name]}>Read the guide →</a></section>}
    </>}
    <div class="category-cta"><div><div class="eyebrow">KEEP EXPLORING</div><h2>Want to compare more?</h2><p>Browse the full catalog or jump to another shopping category.</p></div><div class="cta-actions"><a class="btn primary" href="/products/">View all finds →</a><a class="btn secondary" href="/categories/">All categories</a></div></div>
  </div></section>
</BaseLayout>
<style>
.lego-featured{margin:42px 0 12px;padding:26px;border:1px solid #d9dee8;border-radius:18px;background:#f8fafc}.lego-intro{max-width:650px;color:#64748b;line-height:1.6;margin:.5rem 0 0}.lego-featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.lego-featured-card{background:#fff;border:1px solid #d9dee8;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;min-width:0}.lego-featured-photo{display:block;background:#fff;aspect-ratio:4/3;overflow:hidden}.lego-featured-photo img{width:100%;height:100%;object-fit:contain;padding:12px;box-sizing:border-box}.lego-featured-body{padding:16px;display:flex;flex-direction:column;flex:1}.lego-set-number{font-size:10px;font-weight:900;letter-spacing:.1em;color:#c8102e}.lego-featured-body h3{font-size:18px;line-height:1.35;margin:8px 0}.lego-note{font-size:12px;line-height:1.5;color:#64748b;margin:0 0 12px}.lego-amazon-link,.lego-light-link{display:block;text-align:center;padding:11px 10px;border-radius:8px;text-decoration:none;font-size:12px;font-weight:850;margin-top:8px}.lego-amazon-link{background:#c8102e;color:#fff}.lego-light-link{background:#003087;color:#fff}.lego-disclosure{font-size:11px;color:#64748b;line-height:1.6;text-align:center;margin:18px 0 0}@media(max-width:900px){.lego-featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.lego-featured{padding:16px;margin-top:28px}.lego-featured-grid{grid-template-columns:1fr}.lego-featured-photo{aspect-ratio:16/10}}\n.category-page{padding-top:24px}.breadcrumbs{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:30px;color:#64748b;font-size:13px}.breadcrumbs a{color:#475569;text-decoration:none}.breadcrumbs strong{color:#111827}.category-hero{display:grid;grid-template-columns:1.5fr .7fr;gap:40px;align-items:end}.category-hero h1{font-size:clamp(40px,6vw,68px);margin:8px 0 15px}.category-rule{padding:20px;border-top:3px solid #c8102e;background:#f8fafc;border-radius:12px;display:gri