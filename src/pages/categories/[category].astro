---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

const categoryNames = {
  home: 'Home & Kitchen',
  tech: 'Tech',
  outdoor: 'Outdoor',
  kitchen: 'Home & Kitchen',
  lifestyle: 'Lifestyle',
  'tools-diy': 'Tools & DIY',
  'smart-home': 'Smart Home',
  fitness: 'Fitness'
};

export function getStaticPaths() {
  return Object.entries(categoryNames).map(([slug, name]) => ({ params: { category: slug }, props: { name } }));
}

const { name } = Astro.props;
const matches = products.filter((product) => product.category === name || (name === 'Home & Kitchen' && product.category === 'Home & Kitchen'));
---
<BaseLayout title={`${name} Products | Buy Better Finds`} description={`Browse Buy Better Finds recommendations for ${name}.`}>
  <section class="section">
    <div class="container">
      <div class="eyebrow">CATEGORY</div>
      <h1>{name}</h1>
      <p class="lead">Specific products, practical buying notes, and direct product sources—without filler.</p>
      <div class="grid">
        {matches.map((product) => <article class="card">
          <div class="tag">{product.category}</div>
          <h3>{product.name}</h3>
          <p>{product.why}</p>
          <p><strong>{product.price}</strong></p>
          <a class="arrow" href={`/products/${product.slug}/`}>View product →</a>
        </article>)}
      </div>
      {matches.length === 0 && <p>No products are published in this category yet. <a class="arrow" href="/products/">See all products →</a></p>}
    </div>
  </section>
</BaseLayout>
