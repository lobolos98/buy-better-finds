---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

export function getStaticPaths() {
  const categoryNames = {
    home: 'Home & Kitchen',
    tech: 'Tech',
    outdoor: 'Outdoor',
    kitchen: 'Home & Kitchen',
    lifestyle: 'Lifestyle',
    'tools-diy': 'Tools & DIY',
    'smart-home': 'Smart Home',
    fitness: 'Fitness'
  };

  return Object.entries(categoryNames).map(([slug, name]) => ({
    params: { category: slug },
    props: { name }
  }));
}

const { name } = Astro.props;
const matches = products.filter((product) => product.category === name);
---
<BaseLayout title={`${name} Products | Buy Better Finds`} description={`Browse Buy Better Finds recommendations for ${name}.`}>
  <section class="section">
    <div class="container">
      <div class="eyebrow">CATEGORY</div>
      <h1>{name}</h1>
      <p class="lead">Specific products, practical buying notes, and direct product sources—without filler.</p>
      <div class="grid category-product-grid">
        {matches.map((product) => (
          <article class="card product-card">
            <a class="product-image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}>
              <img src={product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" />
              <span class="image-fallback" aria-hidden="true"><span>{product.icon}</span><small>{product.category}</small></span>
            </a>
            <div class="tag">{product.category}</div>
            <h3>{product.name}</h3>
            <p>{product.why}</p>
            <p><strong>{product.price}</strong></p>
            <a class="arrow" href={`/products/${product.slug}/`}>View product →</a>
          </article>
        ))}
      </div>
      {matches.length === 0 && (
        <p>No products are published in this category yet. <a class="arrow" href="/products/">See all products →</a></p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .product-card{overflow:hidden}
  .product-image{position:relative;display:block;aspect-ratio:4/3;margin:-1px -1px 22px;background:#f3f5f8;overflow:hidden;border-radius:18px 18px 0 0}
  .product-image img{width:100%;height:100%;display:block;object-fit:contain;padding:24px;transition:transform .25s ease}
  .product-image:hover img{transform:scale(1.04)}
  .image-fallback{display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:10px;background:linear-gradient(145deg,#f8fafc,#e7ebf1);color:#0f172a}
  .image-fallback span{font-size:64px;line-height:1}.image-fallback small{text-transform:uppercase;letter-spacing:.12em;font-weight:800;color:#64748b}
  @media(max-width:800px){.category-product-grid{grid-template-columns:1fr}}
</style>
<script>
  document.querySelectorAll('.product-image img').forEach((img) => {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      const fallback = img.nextElementSibling;
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
