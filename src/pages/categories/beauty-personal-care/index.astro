---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { products } from '../../../data/products.js';
const finds = products.filter((p)=>p.category==='Beauty & Personal Care');
---
<BaseLayout title="Beauty & Personal Care | Buy Better Finds" description="Beauty, skincare, hair care, grooming, and cosmetics products with practical comparisons and buying guidance.">
<section class="section"><div class="container">
<div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/categories/">Categories</a><span>/</span><strong>Beauty & Personal Care</strong></div>
<div class="heading"><div class="eyebrow">SHOP SMARTER</div><h1>Beauty & Personal Care</h1><p>Practical beauty buying guidance across skincare, hair care, grooming, cosmetics, and beauty tools. We focus on use case, tradeoffs, and value rather than one-size-fits-all claims.</p></div>
<div class="subcats"><a href="/categories/beauty-personal-care/cosmetics/"><strong>Cosmetics & Beauty Tools</strong><span>Makeup, precision tools, finish, shade, and value.</span>Explore →</a><a href="/comparisons/skincare-cleansers-compared/"><strong>Skincare Comparisons</strong><span>Compare product formats and practical buying considerations.</span>Coming soon →</a></div>
<h2>Current finds</h2>
<div class="products">{finds.map((product)=><article><img src={product.image} alt={product.imageAlt}/><span>{product.category}</span><h3>{product.name}</h3><p><strong>Best for:</strong> {product.bestFor}</p><p>{product.why}</p><a href={'/products/'+product.slug+'/'}>See Our Take →</a></article>)}</div>
</div></section>
</BaseLayout>
<style>
.breadcrumbs{display:flex;gap:8px;flex-wrap:wrap;font-size:12px;color:#64748b;margin-bottom:30px}.breadcrumbs a{color:#475569;text-decoration:none}.heading{max-width:850px}.heading h1{font-size:clamp(40px,6vw,64px);line-height:1.04;color:var(--navy);margin:8px 0 16px}.heading p{font-size:16px;line-height:1.7;color:var(--muted)}.subcats{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:34px 0 46px}.subcats a{border:1px solid var(--line);border-radius:13px;padding:20px;text-decoration:none;background:#fff}.subcats strong{display:block;color:var(--navy);font-size:15px}.subcats span{display:block;color:var(--muted);font-size:11px;line-height:1.5;margin:7px 0 13px}.subcats a{color:#003087;font-size:11px;font-weight:900}.heading+h2,h2{color:var(--navy);margin-bottom:18px}.products{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.products article{border:1px solid var(--line);border-radius:14px;padding:20px;background:#fff}.products img{width:100%;height:220px;object-fit:contain;background:#f5f7fa;border-radius:10px;padding:20px;box-sizing:border-box}.products span{display:block;margin-top:16px;font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#c8102e;font-weight:900}.products h3{font-size:20px;color:var(--navy);margin:7px 0 10px}.products p{font-size:12px;line-height:1.55;color:var(--muted)}.products a{font-size:12px;color:#003087;font-weight:900;text-decoration:none}@media(max-width:700px){.subcats,.products{grid-template-columns:1fr}}
</style>