---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { getRecommendation } from '../../data/recommendations.js';
import { amazonSearchUrl } from '../../utils/amazon.js';

const deals = products.filter((p) => p && p.dailyDealDate).sort((a, b) => b.dailyDealDate.localeCompare(a.dailyDealDate));
---
<BaseLayout title="Deals | Buy Better Finds" description="Browse Deal of the Day features from Buy Better Finds.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">DEAL OF THE DAY</div>
      <h1>Deals worth checking.</h1>
      <p class="lead">Explore products featured as Deal of the Day picks, see our reasoning, and check Amazon for current price and availability.</p>
      <div class="note"><strong>How our deals work</strong><span>Each featured product gets its own feature day, then remains available in its regular category after the day ends.</span></div>
      <p class="disclosure"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Prices and availability can change, so confirm current details on Amazon before buying.</p>

      <div class="section-head"><div><div class="eyebrow">FEATURED DEALS</div><h2>Deal of the Day archive.</h2><p>Browse products that have been featured as daily deals.</p></div></div>
      <div class="grid">
        {deals.map((product) => {
          const recommendation = getRecommendation(product);
          return <article class="card">
            <a class="image" href={`/products/${product.slug}/`}><img src={product.amazonImage || product.image} alt={product.imageAlt} loading="lazy" width="800" height="600" /></a>
            <div class="tag">{product.category}</div>
            <h3>{product.name}</h3>
            <p>{product.why}</p>
            <div class="score"><strong>{recommendation.score}</strong><span>/10 Buy Better Score</span></div>
            <a class="take" href={`/products/${product.slug}/`}>See our take →</a>
            <a class="amazon" href={amazonSearchUrl(product.name)} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a>
          </article>;
        })}
      </div>
      {deals.length === 0 && <div class="empty"><strong>New deals are coming soon.</strong><span>Check back as we add daily features.</span></div>}
    </div>
  </section>
</BaseLayout>
<style>
.note{margin:30px 0 22px;padding:18px 20px;border:1px solid #d9dee8;border-radius:16px;background:#f8fafc;display:flex;gap:20px;align-items:center}.note strong{color:#111827}.note span{color:#64748b;font-size:13px;line-height:1.5}.disclosure{margin-bottom:38px;padding:14px 16px;border-left:4px solid #c8102e;background:#fff7f8;color:#475569;font-size:12px;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{background:#fff;border:1px solid #d9e2ec;border-radius:16px;padding:14px;display:flex;flex-direction:column;box-shadow:0 10px 28px #10233f0d}.image{display:block;height:220px;border-radius:12px;background:#f3f5f8;overflow:hidden;margin-bottom:16px}.image img{width:100%;height:100%;object-fit:contain;padding:20px;box-sizing:border-box}.card h3{font-size:18px;line-height:1.3;color:#10233f;margin:8px 0}.card p{font-size:13px;line-height:1.55;color:#475569}.score{display:flex;align-items:baseline;gap:6px;margin-top:auto;padding-top:12px}.score strong{font-size:18px;color:#10233f}.score span{font-size:10px;color:#64748b}.take,.amazon{display:block;text-align:center;padding:13px 18px;border-radius:7px;color:#fff;text-decoration:none;font-size:13px;font-weight:800;margin-top:8px}.take{background:#2366a8}.amazon{background:#c8102e}.empty{margin-top:28px;padding:28px;border:1px dashed #cbd5e1;border-radius:16px;text-align:center;display:grid;gap:6px}.empty strong{color:#10233f}.empty span{color:#64748b;font-size:13px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.note{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.image{height:220px}}
</style>