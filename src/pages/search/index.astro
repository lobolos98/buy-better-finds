---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Search Products | Buy Better Finds" description="Amazon product search is coming soon to Buy Better Finds. Search products and connect results with our research, comparisons, pros, cons, and retailer links.">
  <section class="product-search-home search-page-notification">
    <div class="container">
      <div class="search-home-copy">
        <div>
          <div class="eyebrow">SEARCH ANY PRODUCT</div>
          <h1>Looking for something specific?</h1>
          <p>Search for a product, brand, or model and then use Buy Better Finds research to understand what to look for before you buy.</p>
        </div>
        <div class="home-search-placeholder">
          <div class="placeholder-icon">⌕</div>
          <strong>Amazon Product Search</strong>
          <span>Coming soon</span>
          <small>Live Amazon product search will be available once Creators API access is enabled for the Buy Better Finds Associates account.</small>
          <a class="btn primary" href="/search/">Explore Product Search →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section search-next">
    <div class="container">
      <div>
        <div class="eyebrow">WHAT COMES NEXT</div>
        <h2>Search should lead to a better buying decision.</h2>
        <p>Our long-term search experience is designed to connect a product query with Buy Better Finds research—not simply send you straight to a retailer.</p>
      </div>
      <div class="search-flow">
        <div><b>01</b><strong>Search</strong><span>Product, brand, or model</span></div>
        <div><b>02</b><strong>Compare</strong><span>Side-by-side options and tradeoffs</span></div>
        <div><b>03</b><strong>Decide</strong><span>Pros, cons, and best-for guidance</span></div>
        <div><b>04</b><strong>Shop</strong><span>Check current retailer details</span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
    .search-next { background:#111827; color:#fff; }
  .search-next .container { display:grid; grid-template-columns:1fr 1.3fr; gap:50px; align-items:center; }
  .search-next p { color:#d1d5db; line-height:1.7; }
  .search-flow { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .search-flow div { padding:20px; border:1px solid #374151; border-radius:12px; display:grid; gap:5px; }
  .search-flow b { font-size:.78rem; opacity:.65; }
  .search-flow span { color:#d1d5db; font-size:.9rem; }
  @media (max-width:900px) { .results-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .search-next .container { grid-template-columns:1fr; } }
  @media (max-width:620px) { .search-page-notification { min-height:0; } }
  .search-page-notification { min-height:420px; display:flex; align-items:center; }
  .search-page-notification .search-home-copy { width:100%; }
  .search-page-notification h1 { color:#fff; font-size:clamp(2.2rem,4vw,3.2rem); line-height:1.08; margin:7px 0 10px; }
  .search-page-notification p { max-width:680px; }
  .search-page-notification .eyebrow { color:#d6a84f; }
  .search-page-notification .home-search-placeholder { max-width:520px; width:100%; box-sizing:border-box; }
</style>
