---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { amazonSearchUrl } from '../../utils/amazon.js';

const searchableProducts = products.map((product) => ({
  slug: product.slug,
  name: product.name,
  category: product.category,
  image: product.image,
  imageAlt: product.imageAlt,
  bestFor: product.bestFor,
  why: product.why,
  watch: product.watch,
}));
---

<BaseLayout title="Search Products | Buy Better Finds" description="Search the Buy Better Finds product catalog and find product research, comparisons, pros, cons, and retailer links.">
  <section class="search-hero search-coming-soon-hero">
    <div class="container">
      <div class="eyebrow">PRODUCT SEARCH</div>
      <div class="coming-soon-badge">COMING SOON</div>
      <h1>Amazon Product Search is coming soon.</h1>
      <p>We’re building a product search experience that will let you look up products and connect each result with Buy Better Finds research, pros and cons, and a clear link to check the current Amazon listing.</p>
      <div class="search-preview-card">
        <div class="preview-icon">⌕</div>
        <strong>Search any product</strong>
        <span>Live Amazon product discovery is being prepared.</span>
        <small>The search feature will be expanded once the required Amazon Associates/Creators API access is available.</small>
      </div>
    </div>
  </section>

  <section class="section search-status">
    <div class="container">
      <div class="coming-soon">
        <span class="status-icon">✦</span>
        <div>
          <strong>The full product search is coming soon.</strong>
          <p>We’re intentionally keeping live Amazon product discovery disabled until the required API access is available. This avoids presenting a limited catalog as if it were a live Amazon search.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section search-next">
    <div class="container">
      <div>
        <div class="eyebrow">WHAT COMES NEXT</div>
        <h2>Search should lead to a better buying decision.</h2>
        <p>Our long-term search experience is designed to connect a product query with Buy Better Finds research—not simply send you straight to a retailer.</p>
      </div>
      <div class="search-flow">
        <div><b>01</b><strong>Search</strong><span>Product, brand, or model</span></div>
        <div><b>02</b><strong>Compare</strong><span>Side-by-side options and tradeoffs</span></div>
        <div><b>03</b><strong>Decide</strong><span>Pros, cons, and best-for guidance</span></div>
        <div><b>04</b><strong>Shop</strong><span>Check current retailer details</span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ searchableProducts }}>
  const input = document.getElementById('search-input');
  const form = document.getElementById('product-search');
  const cards = [...document.querySelectorAll('.result-card')];
  const count = document.getElementById('results-count');
  const title = document.getElementById('results-title');
  const empty = document.getElementById('no-results');

  const runSearch = (raw) => {
    const query = raw.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const match = !query || card.dataset.search.includes(query);
      card.hidden = !match;
      if (match) visible++;
    });
    count.textContent = query ? `${visible} result${visible === 1 ? '' : 's'}` : `${cards.length} products`;
    title.textContent = query ? `Results for “${raw.trim()}”` : 'Browse our products';
    empty.hidden = visible !== 0;
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    runSearch(input.value);
    history.replaceState(null, '', input.value.trim() ? `/search/?q=${encodeURIComponent(input.value.trim())}` : '/search/');
  });

  document.querySelectorAll('[data-query]').forEach((button) => {
    button.addEventListener('click', () => {
      input.value = button.dataset.query;
      runSearch(button.dataset.query);
      history.replaceState(null, '', `/search/?q=${encodeURIComponent(button.dataset.query)}`);
    });
  });

  const params = new URLSearchParams(window.location.search);
  const initial = params.get('q') || '';
  input.value = initial;
  runSearch(initial);
</script>

<style>
  .search-hero { padding: 72px 0 56px; background: linear-gradient(180deg,#f4f7fb 0%,#fff 100%); text-align:center; }
  .search-hero h1 { max-width:900px; margin:10px auto 16px; font-size:clamp(2.3rem,5vw,4.2rem); line-height:1.05; }
  .search-hero p { max-width:760px; margin:0 auto 32px; font-size:1.08rem; line-height:1.7; }
  .search-form { max-width:900px; margin:0 auto; text-align:left; background:#fff; padding:24px; border:1px solid #dfe5ec; border-radius:18px; box-shadow:0 12px 35px rgba(17,24,39,.08); }
  .search-form label { display:block; font-weight:700; margin-bottom:8px; }
  .search-row { display:flex; gap:10px; }
  .search-row input { flex:1; min-width:0; border:2px solid #cbd5e1; border-radius:10px; padding:15px 16px; font-size:1rem; }
  .search-row input:focus { outline:3px solid rgba(0,48,135,.15); border-color:#003087; }
  .search-row button { border:0; border-radius:10px; padding:0 25px; background:#003087; color:#fff; font-weight:800; cursor:pointer; }
  .search-suggestions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
  .search-suggestions button { border:1px solid #cbd5e1; background:#f8fafc; border-radius:999px; padding:7px 12px; cursor:pointer; }
  .search-status { padding-top:42px; }
  .coming-soon { display:flex; gap:16px; align-items:flex-start; padding:20px 22px; border:1px solid #dbe4ef; border-radius:14px; background:#f8fafc; margin-bottom:48px; }
  .status-icon { font-size:1.8rem; line-height:1; }
  .coming-soon strong { font-size:1.05rem; }
  .coming-soon p { margin:5px 0 0; line-height:1.6; color:#4b5563; }
  .results-head { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:22px; }
  .results-head h2 { margin:7px 0 0; }
  #results-count { color:#64748b; font-weight:700; }
  .results-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; }
  .result-card { overflow:hidden; border:1px solid #e2e8f0; border-radius:16px; background:#fff; display:flex; flex-direction:column; }
  .result-card[hidden] { display:none; }
  .result-image { display:block; aspect-ratio:4/3; background:#f8fafc; }
  .result-image img { width:100%; height:100%; object-fit:contain; }
  .result-body { padding:20px; display:flex; flex-direction:column; flex:1; }
  .tag { font-size:.78rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:#003087; }
  .result-body h3 { margin:7px 0 10px; font-size:1.2rem; }
  .result-body h3 a { color:#111827; text-decoration:none; }
  .result-body p { line-height:1.55; color:#4b5563; margin:7px 0; }
  .result-actions { margin-top:auto; padding-top:15px; display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
  .details { color:#003087; font-weight:800; text-decoration:none; }
  .amazon { display:inline-block; padding:9px 13px; border-radius:8px; background:#c8102e; color:#fff; font-weight:800; text-decoration:none; }
  .no-results { text-align:center; padding:60px 20px; border:1px dashed #cbd5e1; border-radius:16px; }
  .no-results[hidden] { display:none; }
  .search-next { background:#111827; color:#fff; }
  .search-next .container { display:grid; grid-template-columns:1fr 1.3fr; gap:50px; align-items:center; }
  .search-next p { color:#d1d5db; line-height:1.7; }
  .search-flow { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .search-flow div { padding:20px; border:1px solid #374151; border-radius:12px; display:grid; gap:5px; }
  .search-flow b { font-size:.78rem; opacity:.65; }
  .search-flow span { color:#d1d5db; font-size:.9rem; }
  @media (max-width:900px) { .results-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .search-next .container { grid-template-columns:1fr; } }
  @media (max-width:620px) { .search-row { flex-direction:column; } .search-row button { padding:13px; } .results-grid { grid-template-columns:1fr; } .results-head { align-items:start; flex-direction:column; } .search-hero { padding-top:45px; } }
</style>
