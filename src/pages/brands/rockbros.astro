---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'ROCKBROS Cycling Gear & Accessories | Brand Hub | Buy Better Finds';
const description = 'Explore ROCKBROS cycling gear across bike bags, lights, pumps, helmets, apparel, glasses, tools, pedals, racks and more. Compare practical features and shop through tracked affiliate links.';
const store = 'https://rockbrosbike.us';
const affiliate = (url) => 'https://www.awin1.com/cread.php?awinmid=58007&awinaffid=3119041&ued=' + encodeURIComponent(url);
const guide = '/blog/rockbros-cycling-gear-guide/';
const categories = [
  { title: 'Bike bags & bikepacking', handle: 'bike-bags', description: 'Frame, saddle, handlebar and rack bags for carrying everyday essentials or packing for longer rides.' },
  { title: 'Bike lights & visibility', handle: 'safety-visibility', description: 'Lights, bells, mirrors and other accessories to consider for visibility and awareness.' },
  { title: 'Bike pumps', handle: 'bike-pump', description: 'Portable inflation options for home maintenance, commuting and ride-day kits.' },
  { title: 'Helmets & protection', handle: 'bike-helmets', description: 'Compare helmet styles, fit details, sizing and safety certifications listed for each model.' },
  { title: 'Cycling glasses & sun protection', handle: 'cycling-glasses', description: 'Eyewear and sun-protection accessories for different light and riding conditions.' },
  { title: 'Cycling clothing & gloves', handle: 'cycling-wearables', description: 'Jerseys, jackets, gloves, tights and layers to compare by fit, season and intended use.' },
  { title: 'Tools & maintenance', handle: 'tool-accessories', description: 'Repair tools, stands and maintenance essentials for basic upkeep and roadside preparedness.' },
  { title: 'Pedals, parts & contact points', handle: 'bike-pedals', description: 'Explore pedal styles and other parts, checking compatibility with your bike before ordering.' },
  { title: 'Cycling computers & sensors', handle: 'cycling-data-devices', description: 'Devices and sensors for riders who want to monitor ride data and training metrics.' },
  { title: 'Phone mounts & holders', handle: 'bike-phone-mount', description: 'Mounting options for navigation and access to your phone while parked or riding safely.' },
  { title: 'Racks & indoor training', handle: 'suction-cup-bike-rack', description: 'Explore transport and storage options, and verify vehicle, bike and mounting compatibility.' },
  { title: 'Outdoor & camping bags', handle: 'outdoor-bags', description: 'Compact carry solutions for day trips and cycling-adjacent outdoor adventures.' }
];
const safeImage = (raw) => {
  try {
    const u = new URL(typeof raw === 'string' ? raw : raw?.src || '', store);
    return u.protocol === 'https:' && ['rockbrosbike.us','www.rockbrosbike.us','cdn.shopify.com'].includes(u.hostname) ? u.href : '';
  } catch { return ''; }
};
const collectionData = await Promise.all(categories.map(async (category) => {
  let products = [];
  try {
    const response = await fetch(`${store}/collections/${category.handle}/products.json?limit=12`, { headers: { accept: 'application/json' } });
    if (response.ok) {
      const data = await response.json();
      products = (data.products || []).map((p) => {
        const image = safeImage(p.images?.[0]?.src || p.image?.src || p.images?.[0]);
        const url = `${store}/products/${p.handle}`;
        return { title: p.title, url, image, price: p.variants?.[0]?.price ? '$' + Number(p.variants[0].price).toFixed(2) : '', alt: p.title + ' by ROCKBROS' };
      }).filter((p) => p.title && p.image && p.url);
    }
  } catch (error) { console.warn('ROCKBROS collection unavailable:', category.handle, String(error)); }
  return { ...category, products: products.slice(0, 2), shopUrl: `${store}/collections/${category.handle}` };
}));
const allProducts = collectionData.flatMap((c) => c.products).filter((p, i, arr) => arr.findIndex((x) => x.url === p.url) === i);
const heroImage = allProducts.find((p) => /bag/i.test(p.title))?.image || allProducts[0]?.image || '';
---
<BaseLayout title={title} description={description} image={heroImage} imageAlt="ROCKBROS cycling gear and accessories">
  <main class="rockbros-hub">
    <section class="rb-hero">
      <div class="rb-hero-copy">
        <p class="rb-eyebrow">THE BUY BETTER FINDS BRAND HUB</p>
        <p class="rb-kicker">Gear for the ride—and everything around it</p>
        <h1>Explore ROCKBROS cycling gear by category.</h1>
        <p class="rb-intro">From bike bags and lights to helmets, clothing, pumps and maintenance tools, this guide brings a broad cross-section of ROCKBROS gear together. Start with the kind of riding you do, compare the practical details, and confirm compatibility before buying.</p>
        <div class="rb-actions">
          <a class="rb-button primary" href={affiliate(store + '/collections/all')} target="_blank" rel="sponsored nofollow noopener noreferrer">Shop all ROCKBROS gear ↗</a>
          <a class="rb-button secondary" href={guide}>Read our cycling gear guide</a>
        </div>
        <p class="rb-disclosure">Buy Better Finds may earn a commission from qualifying purchases through links on this page. We have not independently tested these products; our guidance is based on published product information.</p>
      </div>
      {heroImage && <a class="rb-hero-photo" href={affiliate(store + '/collections/all')} target="_blank" rel="sponsored nofollow noopener noreferrer"><img src={heroImage} alt="ROCKBROS cycling product from the official U.S. store" fetchpriority="high" /></a>}
    </section>

    <nav class="rb-jump-nav" aria-label="ROCKBROS categories">
      {categories.map((category, i) => <a href={'#rb-category-' + i}>{category.title}</a>)}
    </nav>

    <section class="rb-intro-section">
      <p class="rb-eyebrow">SHOP BY NEED</p>
      <h2>A broad look across the ROCKBROS range</h2>
      <p>Choose a category to see products currently returned by the official store. Product assortment, images, prices and availability may change, so use the retailer listing to confirm current details.</p>
    </section>

    {collectionData.map((category, i) => <section class="rb-category" id={'rb-category-' + i}>
      <div class="rb-category-head">
        <div><p class="rb-eyebrow">CATEGORY {String(i + 1).padStart(2, '0')}</p><h2>{category.title}</h2><p>{category.description}</p></div>
        <a class="rb-text-link" href={affiliate(category.shopUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer">Shop category ↗</a>
      </div>
      {category.products.length > 0 ? <div class="rb-product-grid">
        {category.products.map((product) => <article class="rb-product-card">
          <a class="rb-product-image" href={affiliate(product.url)} target="_blank" rel="sponsored nofollow noopener noreferrer"><img src={product.image} alt={product.alt} loading="lazy" decoding="async" /></a>
          <div class="rb-product-copy"><p class="rb-product-label">ROCKBROS FEATURE</p><h3>{product.title}</h3>{product.price && <p class="rb-price">Listed price at review: {product.price}</p>}<p>Review the full listing for sizing, materials, compatibility, included accessories and current availability.</p><a class="rb-product-cta" href={affiliate(product.url)} target="_blank" rel="sponsored nofollow noopener noreferrer">Check product details ↗</a></div>
        </article>)}
      </div> : <div class="rb-empty"><p>Browse the official category for the latest selection and product images.</p></div>}
    </section>)}

    <section class="rb-buying-checklist">
      <p class="rb-eyebrow">BEFORE YOU BUY</p><h2>Five checks for choosing cycling gear</h2>
      <div class="rb-check-grid">
        <div><strong>Fit & compatibility</strong><p>Check bike type, frame dimensions, wheel size, mount type and supported devices where relevant.</p></div>
        <div><strong>Weather & conditions</strong><p>Look for published water-resistance details and use-case guidance instead of assuming every item is waterproof.</p></div>
        <div><strong>Comfort & sizing</strong><p>Use the brand's size chart and review materials, adjustment points and fit notes.</p></div>
        <div><strong>Safety specifications</strong><p>For helmets, lights and locks, verify the exact model's listed standards and capabilities.</p></div>
        <div><strong>Total cost</strong><p>Confirm current price, shipping, returns, warranty and any accessories sold separately.</p></div>
      </div>
    </section>

    <section class="rb-guide-cta"><div><p class="rb-eyebrow">THE FINDS EDIT</p><h2>Want help narrowing the options?</h2><p>Our ROCKBROS guide explains what to compare across bags, lights, apparel, tools and more—without treating every product as right for every rider.</p></div><a class="rb-button primary" href={guide}>Read the complete guide →</a></section>
    <p class="rb-footer-note">ROCKBROS is a third-party brand. Buy Better Finds is an independent editorial shopping resource and is not claiming to be the manufacturer or an authorized service provider. Always confirm product details and current retailer terms on the official store.</p>
  </main>
</BaseLayout>

<style>
.rockbros-hub{max-width:1240px;margin:0 auto;padding:28px 22px 70px;color:#17283b}.rb-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.95fr);gap:34px;align-items:center;background:linear-gradient(120deg,#0e2239,#193b5b);color:#fff;border-radius:20px;padding:clamp(25px,4vw,54px);overflow:hidden}.rb-hero-copy{min-width:0}.rb-eyebrow{font:800 .68rem/1.4 Arial,sans-serif;letter-spacing:.15em;color:#c8102e;margin:0 0 10px}.rb-hero .rb-eyebrow{color:#ffb8c3}.rb-kicker{font:700 .85rem/1.5 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:#d6e4ef}.rb-hero h1{font:800 clamp(2.2rem,4.2vw,3.8rem)/1.04 Arial,sans-serif;letter-spacing:-.045em;color:#fff;margin:12px 0 18px}.rb-intro{font-size:1.05rem;line-height:1.75;color:#e3edf6}.rb-actions{display:flex;flex-wrap:wrap;gap:11px;margin:23px 0}.rb-button{display:inline-flex;align-items:center;justify-content:center;padding:13px 17px;border-radius:7px;font:800 .82rem/1.3 Arial,sans-serif;text-decoration:none}.rb-button.primary{background:#c8102e;color:#fff}.rb-button.secondary{background:#fff;color:#142b45}.rb-disclosure{font: .74rem/1.65 Arial,sans-serif;color:#d2dce7}.rb-hero-photo{display:block;min-height:300px;height:100%;background:#fff;border-radius:14px;overflow:hidden}.rb-hero-photo img{width:100%;height:100%;min-height:300px;max-height:470px;object-fit:contain;padding:20px}.rb-jump-nav{display:flex;gap:9px;flex-wrap:wrap;padding:22px 0;border-bottom:1px solid #dfe5eb}.rb-jump-nav a{background:#f0f3f6;color:#233a51;border:1px solid #dfe5eb;border-radius:999px;padding:8px 12px;font:700 .75rem/1.3 Arial,sans-serif;text-decoration:none}.rb-intro-section{padding:38px 0 12px;max-width:790px}.rb-intro-section h2,.rb-category h2,.rb-buying-checklist h2,.rb-guide-cta h2{font:800 clamp(1.65rem,3vw,2.3rem)/1.15 Arial,sans-serif;color:#142b45;margin:0 0 12px;letter-spacing:-.03em}.rb-intro-section>p:last-child,.rb-category-head p:not(.rb-eyebrow),.rb-guide-cta p:not(.rb-eyebrow){line-height:1.7;color:#5b6671}.rb-category{padding:30px 0 34px;border-top:1px solid #e1e6eb;scroll-margin-top:100px}.rb-category-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.rb-category-head>div{max-width:760px}.rb-category-head h2{margin-bottom:8px}.rb-text-link{white-space:nowrap;color:#b10f29;font:800 .8rem/1.4 Arial,sans-serif;text-decoration:none}.rb-product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.rb-product-card{display:grid;grid-template-columns:minmax(130px,.8fr) minmax(0,1.2fr);gap:18px;border:1px solid #dfe5eb;border-radius:14px;overflow:hidden;background:#fff}.rb-product-image{display:flex;align-items:center;justify-content:center;background:#f4f6f8;min-height:220px}.rb-product-image img{width:100%;height:100%;max-height:280px;object-fit:contain;padding:14px}.rb-product-copy{padding:18px 17px 18px 0}.rb-product-label{font:800 .62rem/1.4 Arial,sans-serif;letter-spacing:.12em;color:#b10f29;margin:0 0 8px}.rb-product-copy h3{font:800 1.05rem/1.3 Arial,sans-serif;color:#142b45;margin:0 0 10px}.rb-product-copy p:not(.rb-product-label){font:.85rem/1.6 Arial,sans-serif;color:#586573}.rb-price{font:800 .85rem/1.4 Arial,sans-serif;color:#142b45!important}.rb-product-cta{display:inline-block;margin-top:5px;background:#c8102e;color:#fff;border-radius:5px;padding:10px 12px;font:800 .73rem/1.3 Arial,sans-serif;text-decoration:none}.rb-empty{background:#f5f7f9;padding:15px 18px;border-radius:8px;color:#586573}.rb-buying-checklist{background:#f1f4f7;border-radius:16px;padding:clamp(22px,4vw,38px);margin:35px 0}.rb-check-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:22px}.rb-check-grid>div{background:#fff;border:1px solid #e0e6ec;border-radius:10px;padding:18px}.rb-check-grid strong{font:800 .93rem/1.4 Arial,sans-serif;color:#142b45}.rb-check-grid p{font:.84rem/1.65 Arial,sans-serif;color:#5b6671;margin-bottom:0}.rb-guide-cta{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:30px 0;border-top:3px solid #c8102e;border-bottom:1px solid #dfe5eb}.rb-guide-cta>div{max-width:720px}.rb-footer-note{font:.75rem/1.7 Arial,sans-serif;color:#6b7280;margin-top:25px}
@media(max-width:820px){.rb-hero{grid-template-columns:1fr}.rb-hero-photo{min-height:220px}.rb-hero-photo img{min-height:220px;max-height:320px}.rb-product-grid{grid-template-columns:1fr}.rb-check-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.rockbros-hub{padding:16px 14px 45px}.rb-category-head,.rb-guide-cta{align-items:flex-start;flex-direction:column}.rb-product-card{grid-template-columns:1fr}.rb-product-image{min-height:200px}.rb-product-copy{padding:0 17px 18px}.rb-check-grid{grid-template-columns:1fr}.rb-button{width:100%;box-sizing:border-box}.rb-hero-photo{min-height:190px}.rb-hero-photo img{min-height:190px}}
</style>
