---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Piscifun Fishing Gear | Rods, Reels & Combos | Buy Better Finds';
const description = 'Explore Piscifun fishing gear, including spinning and baitcasting reels, rods, combos and fishing accessories. Compare options and check current details before buying.';
const affiliateFor = (url) => 'https://www.awin1.com/cread.php?awinmid=89509&awinaffid=3119041&ued=' + encodeURIComponent(url);
const spinningComboUrl = 'https://www.piscifun.com/products/torrent-lite-twin-tip-spinning-rod-and-reel-combo';
const baitcastingComboUrl = 'https://www.piscifun.com/products/torrent-lite-twin-tip-baitcasting-rod-and-reel-combo';
const liteReelUrl = 'https://www.piscifun.com/products/torrent-lite-ultra-light-baitcasting-reel';
const spinningComboImage = 'https://www.piscifun.com/cdn/shop/files/Frame7.jpg?v=1790064177&width=1200';
const baitcastingComboImage = 'https://www.piscifun.com/cdn/shop/files/Frame27.jpg?v=1790065218&width=1200';
const liteReelImage = 'https://www.piscifun.com/cdn/shop/files/BK-R-2.png?v=1773830619&width=1000';
const products = [
  { name: 'Torrent Lite Twin-tip Spinning Combo', type: 'Rod + spinning reel', price: '$89.99', detail: 'A two-piece spinning setup with a spare rod tip. Check reel size, rod length and power/action options.', url: spinningComboUrl, image: spinningComboImage, alt: 'Piscifun Torrent Lite twin-tip spinning rod and reel combo' },
  { name: 'Torrent Lite Twin-tip Baitcasting Combo', type: 'Rod + baitcasting reel', price: '$94.99', detail: 'A two-piece casting setup with a low-profile reel and backup tip. Check retrieve hand and rod power/action.', url: baitcastingComboUrl, image: baitcastingComboImage, alt: 'Piscifun Torrent Lite twin-tip baitcasting rod and reel combo' },
  { name: 'Torrent Lite Baitcasting Reel', type: 'Baitcasting reel', price: '$44.99', detail: 'A compact reel option available in black or teal. Confirm color and retrieve-hand selection on the retailer page.', url: liteReelUrl, image: liteReelImage, alt: 'Piscifun Torrent Lite low-profile baitcasting reel' }
];
---
<BaseLayout title={title} description={description} image={spinningComboImage}>
<main class="piscifun">
<section class="hero"><div class="hero-copy"><p class="eyebrow">FEATURED BRAND · FISHING GEAR</p><p class="kicker">Gear up for your next day on the water</p><h1>Find the Piscifun gear that fits your fishing style.</h1><p class="intro">Compare fishing reels, rods, combos and useful tackle accessories in one place. Start with how you fish, then check the specifications, included components and current price before choosing.</p><div class="actions"><a class="btn primary" href={affiliateFor(spinningComboUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer">Explore Piscifun gear ↗</a><a class="btn secondary" href="#gear">Browse gear types</a></div><p class="disclosure">Buy Better Finds may earn a commission from qualifying purchases made through sponsored links on this page, at no additional cost to you.</p></div><a class="hero-image" href={affiliateFor(spinningComboUrl)} target="_blank" rel="sponsored nofollow noopener noreferrer"><img src={spinningComboImage} alt="Piscifun Torrent Lite spinning rod and reel combo" fetchpriority="high"/><span>Explore the Torrent Lite spinning combo ↗</span></a></section>
<section class="product-section"><div class="section-heading"><p class="eyebrow">FEATURED PISCIFUN PRODUCTS</p><h2>See the gear before you shop</h2><p>Official Piscifun product images help you compare the actual gear. Prices shown reflect the official listings checked for this update and may change.</p></div><div class="product-grid">{products.map((product) => <article class="product-card"><a class="product-photo" href={affiliateFor(product.url)} target="_blank" rel="sponsored nofollow noopener noreferrer"><img src={product.image} alt={product.alt} loading="lazy" decoding="async"/></a><div class="product-copy"><p class="product-type">{product.type}</p><h3>{product.name}</h3><p class="price">{product.price}</p><p>{product.detail}</p><a class="product-link" href={affiliateFor(product.url)} target="_blank" rel="sponsored nofollow noopener noreferrer">View product details ↗</a></div></article>)}</div></section>
<section id="gear" class="gear-section"><div class="section-heading"><p class="eyebrow">START WITH YOUR SETUP</p><h2>Shop by gear type</h2><p>Choose a category based on your fishing approach and compare the details that matter for your setup.</p></div><div class="grid">
<article class="card"><span class="number">01 / REELS</span><h3>Spinning reels</h3><p>Compare reel size, gear ratio, drag capacity, weight and intended line type for your target species.</p><a href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Explore spinning reels ↗</a></article>
<article class="card"><span class="number">02 / REELS</span><h3>Baitcasting reels</h3><p>Check braking adjustments, retrieve ratio, spool capacity and whether the setup matches your experience level.</p><a href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Explore baitcasting reels ↗</a></article>
<article class="card"><span class="number">03 / RODS</span><h3>Fishing rods</h3><p>Match rod power, action, length and lure rating to the techniques and water you fish most often.</p><a href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Explore fishing rods ↗</a></article>
<article class="card"><span class="number">04 / COMBOS</span><h3>Rod & reel combos</h3><p>A combo can simplify setup shopping. Verify rod length, reel type, power, action and included pieces.</p><a href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Explore combos ↗</a></article>
<article class="card"><span class="number">05 / ACCESSORIES</span><h3>Tackle & tools</h3><p>Explore useful accessories for rigging, line management and time spent on the water.</p><a href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Explore fishing accessories ↗</a></article>
<article class="card featured"><span class="number">FEATURED FIND</span><h3>Torrent Lite combos</h3><p>Compare spinning and baitcasting versions carefully—the reel style and rod specifications are not interchangeable. Check current options and pricing before ordering.</p><a href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Check Torrent Lite options ↗</a></article>
</div></section>
<section class="check"><div><p class="eyebrow">BEFORE YOU BUY</p><h2>Choose the setup—not just the name.</h2></div><ul><li><strong>Match the technique:</strong> consider target species, water type, lure weight and fishing method.</li><li><strong>Check compatibility:</strong> verify rod power/action, reel type, line capacity and lure ratings.</li><li><strong>Compare the complete listing:</strong> confirm whether it includes a rod, reel, combo or accessories.</li><li><strong>Review the current offer:</strong> pricing, stock, shipping and included items can change.</li></ul></section>
<section class="cta"><p class="eyebrow">SHOP WITH A PLAN</p><h2>Make the specifications work for you.</h2><p>Fishing setups work best when the rod, reel, line and technique make sense together. Confirm the details for the exact version you want on the retailer's current listing.</p><a class="btn primary" href={affiliate} target="_blank" rel="sponsored nofollow noopener noreferrer">Shop Piscifun ↗</a></section>
<p class="fine">Affiliate disclosure: Buy Better Finds may receive a commission if you purchase through links on this page, at no extra cost to you. This page provides general buying considerations and does not claim hands-on testing. Confirm product specifications, availability and price with the retailer.</p>
</main></BaseLayout>
<style>
.piscifun{--pine:#172923;--forest:#476b48;--cream:#f3f0e7;--ink:#1f2b26;--muted:#59665f;max-width:1200px;margin:auto;padding:24px 22px 64px;color:var(--ink)}.hero{display:grid;grid-template-columns:1.12fr .88fr;gap:28px;align-items:center;background:linear-gradient(125deg,#172923,#243d30 68%,#35513a);color:#f8f7f1;padding:clamp(25px,5vw,58px);border-bottom:6px solid #78956b}.eyebrow{font-size:.7rem;font-weight:850;letter-spacing:.16em;color:#a8c69b;margin:0 0 14px}.kicker{font-weight:750;color:#d4e0ce}.hero h1{font:500 clamp(2.35rem,5vw,4.4rem)/.99 Georgia,serif;letter-spacing:-.045em;color:white;margin:0 0 20px}.intro{font-size:1.04rem;line-height:1.75;color:#e0e7df}.actions{display:flex;flex-wrap:wrap;gap:12px;margin:25px 0 18px}.btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-weight:800;padding:13px 18px;min-height:48px}.primary{background:#78956b;color:white}.secondary{border:1px solid #b8cbb1;color:#f5f6ef}.disclosure{font-size:.77rem;line-height:1.6;color:#c6d1c4}.hero-image{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:#f4f2eb;padding:18px;color:var(--pine);text-decoration:none;font-size:.82rem;font-weight:850;min-width:0}.hero-image img{display:block;width:100%;height:290px;object-fit:contain}.product-section{padding:42px 0 8px}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.product-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid #dce3d9;background:white}.product-photo{height:250px;display:flex;align-items:center;justify-content:center;background:#f4f2eb;padding:16px}.product-photo img{display:block;width:100%;height:100%;object-fit:contain}.product-copy{display:flex;flex-direction:column;align-items:flex-start;flex:1;padding:20px}.product-type{margin:0 0 8px;font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--forest)}.product-copy h3{font:600 1.3rem/1.2 Georgia,serif;color:var(--pine);margin:0 0 8px}.product-copy .price{font-weight:850;color:var(--pine);font-size:1.1rem;margin:0 0 8px}.product-copy p:not(.product-type):not(.price){font-size:.9rem;line-height:1.65;color:var(--muted)}.product-link{display:block;width:100%;box-sizing:border-box;text-align:center;background:var(--pine);color:#fff;text-decoration:none;font-size:.84rem;font-weight:850;padding:12px;margin-top:auto}.product-section{padding:42px 0 8px}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.product-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid #dce3d9;background:white}.product-photo{height:250px;display:flex;align-items:center;justify-content:center;background:#f4f2eb;padding:16px}.product-photo img{display:block;width:100%;height:100%;object-fit:contain}.product-copy{display:flex;flex-direction:column;align-items:flex-start;flex:1;padding:20px}.product-type{margin:0 0 8px;font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--forest)}.product-copy h3{font:600 1.3rem/1.2 Georgia,serif;color:var(--pine);margin:0 0 8px}.product-copy .price{font-weight:850;color:var(--pine);font-size:1.1rem;margin:0 0 8px}.product-copy p:not(.product-type):not(.price){font-size:.9rem;line-height:1.65;color:var(--muted)}.product-link{display:block;width:100%;box-sizing:border-box;text-align:center;background:var(--pine);color:#fff;text-decoration:none;font-size:.84rem;font-weight:850;padding:12px;margin-top:auto}.gear-section{padding:54px 0 8px}.section-heading{max-width:720px;margin-bottom:24px}.section-heading .eyebrow,.check .eyebrow,.cta .eyebrow{color:var(--forest)}.section-heading h2,.check h2,.cta h2{font:500 clamp(2rem,3.7vw,3rem)/1.05 Georgia,serif;color:var(--pine);letter-spacing:-.035em;margin:0 0 12px}.section-heading>p:last-child{line-height:1.65;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card{display:flex;flex-direction:column;align-items:flex-start;min-height:220px;padding:22px;border:1px solid #dce3d9;background:white;min-width:0}.number{font-size:.68rem;font-weight:900;letter-spacing:.14em;color:var(--forest)}.card h3{font:600 1.3rem/1.15 Georgia,serif;color:var(--pine);margin:24px 0 8px}.card p{font-size:.9rem;line-height:1.65;color:var(--muted)}.card a{font-size:.83rem;font-weight:850;color:#31583b;text-decoration:none;margin-top:auto;padding-top:12px}.card a:hover{text-decoration:underline}.featured{background:var(--cream);border-color:#cbd7c4}.featured h3{margin-top:24px}.check{display:grid;grid-template-columns:.9fr 1.1fr;gap:32px;margin:58px 0;background:var(--pine);color:white;padding:clamp(24px,4vw,44px)}.check h2{color:white}.check .eyebrow{color:#b6d2a8}.check ul{margin:0;padding-left:20px;line-height:1.75}.check li+li{margin-top:10px}.cta{text-align:center;padding:42px 24px;background:var(--cream);border-bottom:5px solid var(--forest)}.cta p:not(.eyebrow){max-width:700px;margin:0 auto 22px;line-height:1.7;color:var(--muted)}.cta .primary{background:var(--pine)}.fine{font-size:.78rem;line-height:1.65;color:#667168;margin-top:24px}@media(max-width:850px){.hero{grid-template-columns:1fr}.hero-image img{height:250px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.check{grid-template-columns:1fr}}@media(max-width:520px){.piscifun{padding:12px 12px 40px}.product-grid,.grid{grid-template-columns:1fr}.product-photo{height:230px}.card{min-height:190px}.hero{padding:23px}.hero-image img{height:220px}}
</style>