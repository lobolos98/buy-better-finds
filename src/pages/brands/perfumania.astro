const highlights = [
  { title: 'Compare the exact scent', text: 'Fragrance names can have several editions and flankers. Check the full product name and scent version so you compare the same fragrance.' },
  { title: 'Check concentration and size', text: 'Eau de parfum, eau de toilette and parfum are different formats. Compare concentration and milliliters or fluid ounces before judging the price.' },
  { title: 'Read the scent notes', text: 'Look at top, middle and base notes, but remember fragrance develops differently on different skin. If possible, sample before committing to a full bottle.' },
  { title: 'Review gift-set contents', text: 'Check each included item, bottle size and whether the set contains full-size products, travel sprays or mini vials.' },
  { title: 'Check current promotions', text: 'BOGO and bundle offers may apply only to selected products. Confirm exclusions, mix-and-match rules and discount application in the cart.' },
  { title: 'Review shipping and returns', text: 'Perfumania’s policy pages describe shipping thresholds and conditions for unopened returns. Read the current terms before placing an order.' }
];

const faqs = [
  { question: 'What does Perfumania sell?', answer: 'Perfumania sells designer and value-focused perfumes, colognes, fragrance gift sets, body sprays and related accessories for a range of shoppers and budgets.' },
  { question: 'Does Perfumania carry designer fragrance brands?', answer: 'Yes. Its catalog includes well-known fragrance labels such as Yves Saint Laurent, Gucci, Versace, Burberry, Calvin Klein, Dolce & Gabbana and other brands. Product selection changes over time.' },
  { question: 'Does Perfumania offer fragrance deals?', answer: 'Perfumania advertises rotating promotions that can include buy-one-get-one offers, multi-fragrance deals and bundles. Eligibility and terms vary, so check the live promotion page and final cart total.' },
  { question: 'Are fragrance gift sets worth considering?', answer: 'They can be useful for gifting or trying several formats of a familiar scent. Compare the exact products and sizes included with the cost of buying those items separately.' },
  { question: 'What should I compare before buying perfume online?', answer: 'Check the full fragrance name, concentration, bottle size, scent notes, included accessories, shipping cost and return conditions. Fragrance preferences are personal, so sampling is helpful when possible.' },
  { question: 'Does Buy Better Finds personally test every Perfumania product?', answer: 'No. This page is a research-based brand guide using publicly available retailer and product information. It does not claim hands-on testing or independent authentication of every product listed.' }
];

const related = [
  { title: 'Browse more Buy Better Finds brand guides', url: '/brands/' },
  { title: 'Explore Beauty & Personal Care', url: '/categories/beauty-personal-care/' },
  { title: 'Read more shopping guides', url: '/blog/' }
];
---
<BrandSpotlight
  brandName={brandName}
  brandUrl={brandUrl}
  title={title}
  description={description}
  heroImage={heroImage}
  heroAlt={heroAlt}
  intro={intro}
  affiliateFor={affiliateFor}
  offers={offers}
  categories={categories}
  products={products}
  highlights={highlights}
  faqs={faqs}
  related={related}
  lastVerified="November 24, 2026"
  storefrontIntro="Explore selected perfumes and gift sets, then open the exact Perfumania product listing for current sizes, prices and availability."
  productSearchPlaceholder="Search perfumes, colognes and gift sets..."
  allProductsUrl="https://perfumania.com/collections/all"
/>
