    alt: 'Camille Rochelle four-piece mini fragrance gift set',
    url: 'https://perfumania.com/collections/fragrance-gift-sets'
  }
];

const products = [
  {
    category: 'Women’s fragrance',
    name: 'Yves Saint Laurent Black Opium Eau de Parfum',
