    button: 'Shop bundle deals',
    featured: true
  },
  {
    type: 'THREE-FRAGRANCE OFFER',
    title: 'Choose three eligible scents for $99',
    details: 'Perfumania currently lists a mix-and-match 3 for $99 collection for selected perfumes and colognes.',
    terms: 'Only participating products qualify. Verify the promotion is applied to all three selected items before checkout.',
