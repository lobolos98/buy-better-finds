const intro = 'Perfumania is a discount fragrance retailer with a wide selection of designer perfumes, colognes, gift sets and fragrance accessories. Its catalog includes familiar fragrance houses, everyday scents and giftable collections at a range of price points. This guide brings together useful shopping categories, selected products and practical details to compare before ordering.';

const offers = [
