  { category: 'Knife sets', name: '8-Piece Japanese Knife Set', description: 'A multi-piece collection that includes kitchen shears and a solid wood knife block alongside its knives. Check the full bundle contents on the listing.', image: threePieceImage, alt: 'HOSHANHO 8-piece Japanese knife set', url: 'https://www.hoshanho.com/products/8-piece-japanese-knife-set', price: 'See current price', priceValue: 0, priceNote: 'Check current product price and bundle options' },
  { category: 'Knife sets', name: '17-Piece Knife Set with Magnetic Block', description: 'A larger collection with a mix of prep knives, steak knives and accessories. Review the included pieces and storage footprint before choosing.', image: sevenPieceImage, alt: 'HOSHANHO 17-piece knife set with magnetic block', url: 'https://www.hoshanho.com/products/17-piece-japanese-knife-set-with-magnetic-block', price: 'See current price', priceValue: 0, priceNote: 'Check current product price and bundle options' },
  { category: 'Storage & accessories', name: '14 × 10-inch Double-Sided Magnetic Knife Stand', description: 'A countertop storage stand with an acacia wood finish and magnetic knife display. Check dimensions and available counter space.', image: blockImage, alt: 'HOSHANHO double-sided magnetic acacia wood knife stand', url: 'https://www.hoshanho.com/products/14x10-inch-double-sided-magnetic-knife-stand', price: '$74.99', priceValue: 74.99, priceNote: 'Official listing price checked Nov. 23, 2026' },
  { category: 'Storage & accessories', name: 'Magnetic Knife Holder', description: 'A wall-mounted magnetic storage option that keeps knives visible and off the counter. Check mounting hardware and wall requirements.', image: blockImage, alt: 'HOSHANHO magnetic knife holder', url: 'https://www.hoshanho.com/collections/all', price: '$37.99', priceValue: 37.99, priceNote: 'Official store price checked Nov. 23, 2026' },
