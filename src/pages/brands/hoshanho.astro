];

const products = [
  { category: 'Individual knives', name: 'Hiro 8-inch Chef Knife', description: 'An 8-inch chef knife with a hammered finish and rosewood handle. Review the steel, blade geometry and care details on the official listing.', image: chefImage, alt: 'HOSHANHO Hiro 8-inch chef knife with rosewood handle', url: 'https://www.hoshanho.com/products/hiro-8chef-knife', price: '$168.99', priceValue: 168.99, priceNote: 'Official listing price checked Nov. 23, 2026' },
