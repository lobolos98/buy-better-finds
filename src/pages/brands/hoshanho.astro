  { category: 'Storage & accessories', name: '3-Piece Acacia Wood Cutting Board Set', description: 'A set of three acacia cutting boards. Compare board dimensions, thickness and cleaning instructions for your kitchen.', image: blockImage, alt: 'HOSHANHO 3-piece acacia wood cutting board set', url: 'https://www.hoshanho.com/collections/knife-cutting-board', price: '$189.99', priceValue: 189.99, priceNote: 'Official store price checked Nov. 23, 2026' },
  { category: 'Storage & accessories', name: 'Leather Kitchen Apron', description: 'A kitchen apron accessory. Check material details, fit and care instructions on the official listing.', image: blockImage, alt: 'HOSHANHO leather kitchen apron', url: 'https://www.hoshanho.com/collections/all', price: '$65.96', priceValue: 65.96, priceNote: 'Official store sale price checked Nov. 23, 2026' }
