  { category: 'Individual knives', name: '7-inch Nakiri Knife, Japanese Steel', description: 'A Nakiri-style vegetable knife. Compare blade dimensions, steel description and handle style on the product page before choosing.', image: nakiriImage, alt: 'HOSHANHO 7-inch Nakiri Japanese steel knife', url: 'https://www.hoshanho.com/products/7-nakiri-knife-japanese-steel', price: '$67.99', priceValue: 67.99, priceNote: 'Official listing price checked Nov. 23, 2026' },
