  { category: 'Individual knives', name: '12-inch Japanese Carving Knife', description: 'A long slicing blade for carving and serving roasts. Check the exact handle and blade details on the product page.', image: heroImage, alt: 'HOSHANHO 12-inch Japanese carving knife', url: 'https://www.hoshanho.com/products/12-japanese-carving-knife', price: '$79.99', priceValue: 79.99, priceNote: 'Official listing price checked Nov. 23, 2026' },
  { category: 'Individual knives', name: '10-inch BBQ Brisket Carving Knife', description: 'A long carving knife intended for slicing cooked brisket and other larger cuts. Check the blade length and care instructions on the product page.', image: breadImage, alt: 'HOSHANHO 10-inch BBQ brisket carving knife', url: 'https://www.hoshanho.com/products/10-bbq-brisket-carving-knife', price: '$75.99', priceValue: 75.99, priceNote: 'Official listing price checked Nov. 23, 2026' },
