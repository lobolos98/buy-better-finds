  { category: 'Storage & accessories', name: '14 × 10-inch Double-Sided Magnetic Knife Stand', description: 'A countertop knife-storage stand with an acacia wood finish. Check the dimensions and available counter space before ordering.', image: blockImage, alt: 'HOSHANHO double-sided magnetic acacia wood knife stand', url: 'https://www.hoshanho.com/products/14x10-inch-double-sided-magnetic-knife-stand', price: '$74.99', priceValue: 74.99, priceNote: 'Official listing price checked Nov. 23, 2026' }
