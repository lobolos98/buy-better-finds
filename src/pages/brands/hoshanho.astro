  { category: 'Individual knives', name: '7-inch Nakiri Knife', description: 'A vegetable knife with a broad, flatter blade profile suited to chopping and push-cutting. Review its handle and blade specifications on the listing.', image: nakiriImage, alt: 'HOSHANHO 7-inch Nakiri Japanese steel knife', url: 'https://www.hoshanho.com/products/7-nakiri-knife-japanese-steel', price: '$67.99', priceValue: 67.99, priceNote: 'Official listing price checked Nov. 23, 2026' },
  { category: 'Individual knives', name: '7-inch Santoku Knife', description: 'An all-purpose Japanese-style knife for slicing, dicing and mincing. Compare blade length and handle material on the official collection.', image: chefImage, alt: 'HOSHANHO Japanese-style Santoku knife', url: 'https://www.hoshanho.com/collections/santoku-knife', price: '$65.99', priceValue: 65.99, priceNote: 'Official series collection price checked Nov. 23, 2026' },
