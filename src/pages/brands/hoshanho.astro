---
<BrandSpotlight
  brandName={brandName}
  brandUrl={brandUrl}
  title={title}
  description={description}
  heroImage={heroImage}
  heroAlt="HOSHANHO 8-inch Gyuto Japanese chef knife with rosewood handle"
  intro={intro}
  affiliateFor={affiliateFor}
  offers={offers}
  categories={categories}
  products={products}
  highlights={highlights}
  faqs={faqs}
  related={related}
  lastVerified="November 23, 2026"
/>
