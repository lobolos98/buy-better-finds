  { type: 'NEW EMAIL SUBSCRIBERS', title: '10% off one item', details: 'HOSHANHO advertises 10% off one item for new email subscribers.', terms: 'New subscribers only. Sign-up and retailer terms apply; this is not a universal coupon code.', url: 'https://www.hoshanho.com/', button: 'Visit HOSHANHO' }
];

const categories = [
  { label: 'CHEF & EVERYDAY KNIVES', title: 'Chef knives & single blades', description: 'Compare Gyuto, Santoku, Nakiri, paring and other individual knives by blade shape, length, steel and handle.', image: heroImage, alt: 'HOSHANHO 8-inch Gyuto Japanese chef knife with rosewood handle', url: 'https://www.hoshanho.com/collections/1-piece' },
  { label: 'KNIFE SETS', title: 'Knife sets & collections', description: 'Browse multi-piece sets and compare which blades, storage pieces and accessories are included in each bundle.', image: nakiriImage, alt: 'HOSHANHO Japanese-style Nakiri kitchen knife', url: 'https://www.hoshanho.com/pages/black-friday' },
