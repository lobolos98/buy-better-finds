const intro = 'HOSHANHO is a kitchenware brand whose catalog centers on kitchen knives, knife sets and practical kitchen accessories. Its official store organizes products by knife type, series and set size, with options ranging from individual chef knives to multi-piece collections and magnetic storage. This guide brings those choices together and highlights the specifications, care instructions, warranty terms and current offers shoppers should review before ordering.';

const offers = [
  { type: 'BLACK FRIDAY · SPEND & SAVE', title: 'Save up to $130 with a tiered code', details: 'Choose the code that matches your order: BF20 on $175+, BF35 on $250+, BF50 on $300+, BF85 on $450+, or BF130 on $600+.', code: 'BF20 · BF35 · BF50 · BF85 · BF130', terms: 'One code per order; the highest eligible tier applies. The official page says codes do not stack on discounted bundle products. Check final terms at checkout.', url: 'https://www.hoshanho.com/pages/black-friday', button: 'Shop Black Friday offers', featured: true },
