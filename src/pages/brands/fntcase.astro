  { name: 'Samsung Galaxy S25 Textured Shock-Protection Case', category: 'Textured protection', device: 'Samsung Galaxy S25 (6.2-inch)', url: 'https://fntcase.com/products/fntcase-for-samsung-galaxy-s25-6-2-inch-shock-protection-cell-phone-case-sturdy-cover-with-non-slip-texture', image: 'https://fntcase.com/cdn/shop/files/1_6c646a02-450c-4975-8df4-b8245821fa1e.jpg?v=1737707964', description: 'A dual-layer textured case listing for the 6.2-inch Galaxy S25. Check the exact phone size and color before purchase.' },
