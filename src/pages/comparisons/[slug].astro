---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products as catalog } from '../../data/products.js';
import { halloweenProducts } from '../../data/halloween-products.js';
import { getRecommendation } from '../../data/recommendations.js';

const comparisonConfig = {
  'sony-wh-1000xm5-vs-airpods-4': { title: 'Sony WH-1000XM5 vs Apple AirPods 4', intro: 'Two different approaches to wireless listening: premium over-ear noise cancellation versus compact everyday earbuds. The WH-1000XM5 is the stronger choice for immersive over-ear listening and active noise cancellation, while AirPods 4 emphasize a lighter, pocket-friendly everyday experience.', products: ['Sony WH-1000XM5 Noise-Canceling Headphones','Apple AirPods 4'] },
  'ninja-af101-vs-instant-vortex-plus': { title: 'Ninja 4-Qt Air Fryer AF101 vs Instant Vortex Plus', intro: 'Two popular air fryers aimed at quick, convenient countertop cooking. The Ninja AF101 favors a compact footprint and straightforward everyday use, while the Instant Vortex Plus offers another flexible approach for shoppers who want easy air-fryer cooking with a different basket and control experience.', products: ['Ninja 4-Qt Air Fryer AF101','Instant Vortex Plus Air Fryer'] },
  'seesii-car-jack-vs-fanttik-e1-max': { title: 'Seesii Electric Car Jack Kit vs Fanttik E1 Max', intro: 'Two very different tools for very different jobs. Seesii is built around roadside and automotive lifting needs, while the Fanttik E1 Max is a compact precision screwdriver for electronics, repairs, and detailed DIY work.', products: ['Seesii Electric Car Jack Kit','Fanttik E1 Max Precision Electric Screwdriver'] },
  'amazon-basics-vs-solo-stove-patio-heaters': { title: 'Amazon Basics Patio Heater vs Solo Stove Tower', intro: 'Two ways to keep an outdoor space more comfortable as temperatures fall. The Amazon Basics heater emphasizes familiar propane-powered patio heating, while the Solo Stove Tower takes a more design-forward approach to outdoor warmth and gathering spaces.', products: ['Amazon Basics 46,000 BTU Portable Outdoor Propane Patio Heater','Solo Stove Tower Patio Heater'] },
  'echo-dot-vs-kasa-ep40m': { title: 'Amazon Echo Dot vs TP-Link Kasa Smart Outdoor Plug', intro: 'Two smart-home products that solve completely different problems. Echo Dot centers on voice control and everyday smart-home interaction, while the Kasa EP40M focuses on bringing connected control to outdoor devices such as lights and seasonal displays.', products: ['Amazon Echo Dot','TP-Link Kasa Smart Outdoor Plug EP40M'] },
  'bowflex-552-vs-amazon-basics-neoprene-dumbbells': { title: 'BowFlex SelectTech 552 vs Amazon Basics Neoprene Dumbbells', intro: 'Two approaches to building a home dumbbell setup. BowFlex SelectTech 552 is designed around adjustable weight and space efficiency, while Amazon Basics neoprene dumbbells offer simple, familiar weights for straightforward home workouts.', products: ['BowFlex SelectTech 552 Adjustable Dumbbells','Amazon Basics Neoprene Dumbbells'] },
  'yeti-rambler-vs-stanley-quencher': { title: 'YETI Rambler vs Stanley Quencher', intro: 'Two recognizable drinkware lines with different strengths in everyday use. YETI Rambler products emphasize rugged construction and dependable insulation, while the Stanley Quencher is especially appealing to shoppers who prioritize a large-capacity tumbler format and easy everyday carry.', products: ['YETI Rambler Drinkware','Stanley Quencher H2.0 Tumbler'] },
  'funko-bitty-pop-vs-stitch-plush': { title: 'Funko Bitty Pop! Harry Potter 6-Pack vs Disney Stitch Plush', intro: 'Two very different fandom gifts: a compact collectible set built around display and collecting versus a character plush designed for a softer, more playful gift experience.', products: ['Funko Bitty Pop! Harry Potter 6-Pack','Disney Stitch Plush'] },
  'lego-lava-land-vs-crunchlabs-crunchinator': { title: 'LEGO City Lava Land Roller Coaster Park vs CrunchLabs The Crunchinator', intro: 'Two hands-on choices for kids who enjoy making and experimenting. LEGO City emphasizes creative construction and imaginative play, while The Crunchinator brings a more STEM-oriented build-and-learn experience.', products: ['LEGO City Lava Land Roller Coaster Park','CrunchLabs The Crunchinator'] },
  'eltamd-uv-clear-vs-mighty-patch': { title: 'EltaMD UV Clear vs Hero Cosmetics Mighty Patch', intro: 'Two personal-care products designed for completely different routines. EltaMD UV Clear is centered on daily facial sun protection, while Mighty Patch is a targeted blemish-care product for shoppers looking for a simple spot-treatment approach.', products: ['EltaMD UV Clear Broad-Spectrum SPF 46','Hero Cosmetics Mighty Patch Original'] },
  'wymulot-vs-aiseno-halloween-skeletons': { title: 'wymulot Halloween Skeletons vs AISENO Skeleton Stakes', intro: 'Two ways to build a Halloween yard display. The wymulot poseable skeletons offer a more character-driven setup with multiple figures, while AISENO skeleton stakes are geared toward creating a classic skeletal yard scene with easy placement.', products: ['wymulot 2-Pack 40" Pose-N-Stay Halloween Skeletons','AISENO Realistic Skeleton Stakes'], seasonal: true }
};

export function getStaticPaths() {
  const comparisonConfig = { ...comparisonConfig };

  return Object.entries(comparisonConfig).map(([slug, comparison]) => ({
    params: { slug },
    props: { comparison }
  }));
}

const { comparison } = Astro.props;
const source = comparison.seasonal ? halloweenProducts : catalog;
const selected = comparison.products.map((name) => source.find((product) => product.name === name)).filter(Boolean);
const left = selected[0];
const right = selected[1];
const leftRec = left ? getRecommendation(left) : null;
const rightRec = right ? getRecommendation(right) : null;
if (!left || !right) {
  throw new Error(`Comparison products missing from catalog: ${comparison.products.join(' vs ')}`);
}
const reviewed = 'September 2026';
---
<BaseLayout title={`${comparison.title} | Buy Better Finds`} description={comparison.intro}>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buybetterfinds.com/' },
    { '@type': 'ListItem', position: 2, name: 'Comparisons', item: 'https://buybetterfinds.com/comparisons/' },
    { '@type': 'ListItem', position: 3, name: comparison.title, item: new URL(Astro.url.pathname, 'https://buybetterfinds.com').toString() }
  ]
})} />
<section class="hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/comparisons/">Comparisons</a><span>/</span><strong>{comparison.title}</strong></div><div class="eyebrow">PRODUCT COMPARISON</div><h1>{comparison.title}</h1><p>{comparison.intro}</p><div class="reviewed">Last reviewed: {reviewed}</div></div></section>
<section class="section"><div class="container"><div class="compare-products"><article class="compare-product"><div class="product-thumb"><img src={left.image} alt={left.imageAlt} onerror="if(this.dataset.fallback){this.style.display='none';} else if(this.dataset.fallbackUrl){this.dataset.fallback='1'; this.src=this.dataset.fallbackUrl;}" data-fallback-url={left.imageFallback || undefined} referrerpolicy="no-referrer" /></div><div><span>OPTION A</span><h2>{left.name}</h2><p>{leftRec.bestFor}</p><a href={`/products/${left.slug}/`}>View product details →</a></div></article><article class="compare-product"><div class="product-thumb"><img src={right.image} alt={right.imageAlt} onerror="if(this.dataset.fallback){this.style.display='none';} else if(this.dataset.fallbackUrl){this.dataset.fallback='1'; this.src=this.dataset.fallbackUrl;}" data-fallback-url={right.imageFallback || undefined} referrerpolicy="no-referrer" /></div><div><span>OPTION B</span><h2>{right.name}</h2><p>{rightRec.bestFor}</p><a href={`/products/${right.slug}/`}>View product details →</a></div></article></div><div class="quick"><div><div class="eyebrow">QUICK ANSWER</div><h2>Which one should you choose?</h2></div><div><p><strong>{left.name}</strong> is the better fit when you prioritize {leftRec.bestFor.toLowerCase()}. <strong>{right.name}</strong> is the better fit when you prioritize {rightRec.bestFor.toLowerCase()}.</p><p class="note">There is no universal winner. Use the side-by-side breakdown below to match the product to your priorities.</p></div></div></div></section>
<section class="section table-section"><div class="container"><div class="table-wrap"><table><thead><tr><th>Decision factor</th><th>{left.name}</th><th>{right.name}</th></tr></thead><tbody><tr><th>Buy Better Score</th><td><strong>{leftRec.score}/10</strong><br/><small>{leftRec.label}</small></td><td><strong>{rightRec.score}/10</strong><br/><small>{rightRec.label}</small></td></tr><tr><th>Best for</th><td>{leftRec.bestFor}</td><td>{rightRec.bestFor}</td></tr><tr><th>Why consider it</th><td>{left.why}</td><td>{right.why}</td></tr><tr><th>Watch before buying</th><td>{left.watch}</td><td>{right.watch}</td></tr><tr><th>Reference price</th><td>{left.price}</td><td>{right.price}</td></tr></tbody></table></div></div></section>
<section class="section verdicts"><div class="container"><div class="verdict-grid"><article><div class="eyebrow">CHOOSE {left.name.toUpperCase()}</div><h2>Best when {leftRec.bestFor.toLowerCase()}</h2><ul>{leftRec.pros.map((item)=><li><strong>+</strong> {item}</li>)}{leftRec.cons.map((item)=><li class="con"><strong>−</strong> {item}</li>)}</ul><a class="arrow" href={`/products/${left.slug}/`}>See our full take →</a></article><article><div class="eyebrow">CHOOSE {right.name.toUpperCase()}</div><h2>Best when {rightRec.bestFor.toLowerCase()}</h2><ul>{rightRec.pros.map((item)=><li><strong>+</strong> {item}</li>)}{rightRec.cons.map((item)=><li class="con"><strong>−</strong> {item}</li>)}</ul><a class="arrow" href={`/products/${right.slug}/`}>See our full take →</a></article></div></div></section>
<section class="section shopping"><div class="container"><div class="shopping-box"><div><div class="eyebrow">WHAT TO DO NEXT</div><h2>Use the comparison to narrow the shortlist.</h2><p>Once you know which set of tradeoffs fits your needs, review the full product page for more detail on the product, alternatives, and current retailer information.</p></div><div class="shopping-actions"><a class="btn primary" href={`/products/${left.slug}/`}>Review {left.name} →</a><a class="btn secondary" href={`/products/${right.slug}/`}>Review {right.name} →</a></div></div></div></section><section class="section method"><div class="container"><div class="eyebrow">OUR COMPARISON METHOD</div><h2>We compare fit, not just features.</h2><p>Our comparison looks at intended use, practical strengths, limitations, reference price, and editorial recommendation data. Recommendations are research-based and are not presented as hands-on testing unless explicitly stated.</p><p class="disclosure">Independent recommendation. We may earn a commission from qualifying purchases when affiliate links are used.</p></div></section>
<section class="final"><div class="container"><a class="btn primary" href="/comparisons/">More Comparisons →</a><a class="btn secondary" href="/guides/">Buying Guides</a></div></section>
</BaseLayout>
<style>
.hero{background:linear-gradient(135deg,#10233f,#173c69);color:#fff;padding:46px 0 78px}.breadcrumbs{display:flex;gap:9px;flex-wrap:wrap;font-size:11px;color:#b9c9da;margin-bottom:42px}.breadcrumbs a{color:#d9e4f1}.breadcrumbs strong{color:#fff}.hero h1{color:#fff;font-size:clamp(40px,6vw,68px);line-height:1.02;max-width:900px;margin:10px 0 18px}.hero p{color:#d9e4f1;font-size:18px;line-height:1.7;color:#d9e4f1;max-width:800px}.reviewed{margin-top:22px;font-size:11px;color:#c7d5e4;text-transform:uppercase;letter-spacing:.08em}.compare-products{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:55px}.compare-product{display:grid;grid-template-columns:130px 1fr;gap:20px;align-items:center;border:1px solid var(--line);border-radius:16px;padding:18px;background:#fff}.product-thumb{height:130px;border-radius:12px;background:#f5f7fa;display:flex;align-items:center;justify-content:center}.product-thumb img{width:100%;height:100%;object-fit:contain;padding:12px}.compare-product span{font-size:10px;letter-spacing:.12em;font-weight:900;color:var(--red)}.compare-product h2{color:var(--navy);font-size:21px;line-height:1.2;margin:7px 0}.compare-product p{color:var(--muted);font-size:13px;line-height:1.5;margin:0 0 10px}.compare-product a{color:var(--blue);font-size:12px;font-weight:800;text-decoration:none}.quick{display:grid;grid-template-columns:1fr 1.3fr;gap:60px}.quick h2{color:var(--navy);font-size:34px;margin:10px 0}.quick p{color:var(--muted);line-height:1.7}.quick .note{font-size:13px}.table-section{background:#f5f7fa}.table-wrap{overflow-x:auto;background:#fff;border:1px solid var(--line);border-radius:14px}.table-wrap table{width:100%;border-collapse:collapse;min-width:760px}.table-wrap th,.table-wrap td{padding:18px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;line-height:1.55;font-size:13px}.table-wrap thead th{background:#10233f;color:#fff;font-size:13px}.table-wrap tbody th{color:var(--navy);width:18%}.table-wrap small{color:var(--red);font-weight:800}.verdict-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.verdict-grid article{border:1px solid var(--line);border-radius:14px;padding:28px;background:#fff}.verdict-grid h2{color:var(--navy);font-size:25px;line-height:1.2}.verdict-grid ul{list-style:none;padding:0;margin:20px 0}.verdict-grid li{padding:8px 0;color:#334155;border-bottom:1px solid #edf0f3;font-size:13px}.verdict-grid li strong{color:#17814d}.verdict-grid li.con strong{color:var(--red)}.shopping{padding-top:0}.shopping-box{display:grid;grid-template-columns:1fr auto;gap:35px;align-items:center;padding:34px;border-radius:18px;background:#eef3f8}.shopping-box h2{color:var(--navy);margin:8px 0}.shopping-box p{max-width:700px;color:var(--muted);line-height:1.65}.shopping-actions{display:flex;gap:10px;flex-wrap:wrap}.shopping-actions .btn{white-space:nowrap}.method{background:#f5f7fa}.method h2{color:var(--navy);font-size:34px;margin:10px 0}.method p{max-width:800px;color:var(--muted);line-height:1.7}.disclosure{font-size:11px}.final{text-align:center;padding:60px 0}.final .btn{display:inline-block;margin:5px}@media(max-width:750px){.compare-products,.quick,.verdict-grid,.shopping-box{grid-template-columns:1fr;gap:18px}.compare-product{grid-template-columns:100px 1fr}.product-thumb{height:100px}.shopping-actions .btn{width:100%;text-align:center}.hero{padding-bottom:55px}.hero p{color:#d9e4f1;font-size:16px}}
</style>
