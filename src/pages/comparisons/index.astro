---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products as catalog } from '../../data/products.js';
import { halloweenProducts } from '../../data/halloween-products.js';

const featured = [
  { category: 'Tech', eyebrow: 'TECH', products: ['Sony WH-1000XM5 Noise-Canceling Headphones', 'Apple AirPods 4'], comparison: 'sony-wh-1000xm5-vs-airpods-4', description: 'Compare premium over-ear noise cancellation with compact everyday earbuds.' },
  { category: 'Home & Kitchen', eyebrow: 'HOME & KITCHEN', products: ['Ninja 4-Qt Air Fryer AF101', 'Instant Vortex Plus Air Fryer'], description: 'Two popular air-fryer formats for different kitchen needs.' },
  { category: 'Tools & DIY', eyebrow: 'TOOLS & DIY', products: ['Seesii Electric Car Jack Kit', 'Fanttik E1 Max Precision Electric Screwdriver'], description: 'Compare a practical automotive tool with a precision DIY favorite.' },
  { category: 'Outdoor', eyebrow: 'OUTDOOR', products: ['Amazon Basics 46,000 BTU Portable Outdoor Propane Patio Heater', 'Solo Stove Tower Patio Heater'], description: 'Two ways to extend comfortable outdoor time when the temperature drops.' },
  { category: 'Smart Home', eyebrow: 'SMART HOME', products: ['Amazon Echo Dot', 'TP-Link Kasa Smart Outdoor Plug EP40M'], description: 'Compare everyday voice control with practical connected-home automation.' },
  { category: 'Fitness', eyebrow: 'FITNESS', products: ['BowFlex SelectTech 552 Adjustable Dumbbells', 'Amazon Basics Neoprene Dumbbells'], description: 'Adjustable versatility versus straightforward home-workout simplicity.' },
  { category: 'Lifestyle', eyebrow: 'LIFESTYLE', products: ['YETI Rambler Drinkware', 'Stanley Quencher H2.0 Tumbler'], description: 'Compare two recognizable drinkware options by everyday fit and portability.' },
  { category: 'Gifts & Collectibles', eyebrow: 'GIFTS & COLLECTIBLES', products: ['Funko Bitty Pop! Harry Potter 6-Pack', 'Disney Stitch Plush'], description: 'Two different approaches to fandom-focused gifting and collecting.' },
  { category: 'Toys & Games', eyebrow: 'TOYS & GAMES', products: ['LEGO City Lava Land Roller Coaster Park', 'CrunchLabs The Crunchinator'], description: 'Compare creative building with hands-on STEM experimentation.' },
  { category: 'Beauty & Personal Care', eyebrow: 'BEAUTY & PERSONAL CARE', products: ['EltaMD UV Clear Broad-Spectrum SPF 46', 'Hero Cosmetics Mighty Patch Original'], description: 'Two very different everyday personal-care products, selected for distinct needs.' },
  { category: 'Seasonal & Holidays', eyebrow: 'SEASONAL & HOLIDAYS', products: ['wymulot 2-Pack 40" Pose-N-Stay Halloween Skeletons', 'AISENO Realistic Skeleton Stakes'], description: 'Compare two Halloween display approaches for building a standout yard scene.', seasonal: true }
];

const getProduct = (name, seasonal = false) => {
  const source = seasonal ? halloweenProducts : catalog;
  return source.find((product) => product.name === name);
};

const sections = featured.map((item) => ({
  ...item,
  items: item.products.map((name) => getProduct(name, item.seasonal)).filter(Boolean)
}));
---
<BaseLayout title="Product Comparisons | Buy Better Finds" description="Explore featured products from every Buy Better Finds category, then use the comparison experience to evaluate the options that fit you best.">
<section class="hero"><div class="container"><div class="eyebrow">COMPARE BEFORE YOU BUY</div><h1>Compare the products that make the shortlist.</h1><p>Start with two featured finds from each category, then use the comparison experience to look at the products and tradeoffs that matter to you.</p><div class="hero-actions"><span class="hero-note">More options. More useful tradeoffs. A better buying decision.</span></div></div></section>

<section class="section intro"><div class="container"><div class="section-head"><div><div class="eyebrow">FEATURED COMPARISONS</div><h2>Two products from every category.</h2></div><p>These featured pairs are a starting point—not a limit. The comparison experience lets shoppers evaluate products with more flexibility than a single editorial matchup.</p></div>
<div class="category-list">
{sections.map((section) => (<section class="category-block"><div class="category-heading"><div><div class="eyebrow">{section.eyebrow}</div><h2>{section.category}</h2><p>{section.description}</p></div>{section.comparison && <a class="category-link" href={\`/comparisons/\${section.comparison}/\`}>See head-to-head →</a>}</div>
<div class="product-pair">
{section.items.map((product, index) => (<article class="product-card"><div class="product-image"><img src={product.image} alt={product.imageAlt || product.name} onerror="if(this.dataset.fallback){this.style.display='none';} else if(this.dataset.fallbackUrl){this.dataset.fallback='1'; this.src=this.dataset.fallbackUrl;}" data-fallback-url={product.imageFallback || undefined} referrerpolicy="no-referrer" /></div><div class="product-content"><span class="option">OPTION {index === 0 ? 'A' : 'B'}</span><h3>{product.name}</h3><p class="best-for">{product.bestFor}</p><div class="product-meta"><span class="score">Buy Better Score {product.score || 8.5}/10</span><span>{product.price}</span></div><a href={\`/products/\${product.slug}/\`}>View product details →</a></div></article>))}
</div></section>))}
</div></div></section>

<section class="section tool-callout"><div class="container"><div class="tool-box"><div><div class="eyebrow">GO BEYOND THE FEATURED PAIRS</div><h2>Want to compare different products?</h2><p>The featured pairs above are curated starting points. Use the comparison experience to explore more products and compare the options that fit your own priorities.</p></div><div class="tool-points"><span>More product choices</span><span>More buying factors</span><span>More useful tradeoffs</span></div></div></div></section>

<section class="section method"><div class="container"><div class="eyebrow">HOW WE COMPARE</div><h2>Fit matters more than a universal winner.</h2><p>Buy Better Finds comparisons focus on intended use, strengths, limitations, practical tradeoffs, Buy Better Scores, and who each option is best suited for. Recommendations are research-based unless hands-on testing is explicitly stated.</p><a class="arrow" href="/why-we-recommend/">Read the Buy Better Finds Standards →</a></div></section>
</BaseLayout>

<style>
.hero{background:linear-gradient(135deg,#10233f,#173c69);color:#fff;padding:82px 0 70px}.hero .eyebrow,.hero h1,.hero p{color:#fff}.hero h1{font-size:clamp(40px,6vw,68px);line-height:1.02;max-width:900px;margin:12px 0 20px}.hero p{max-width:790px;font-size:18px;line-height:1.7;color:#d9e4f1}.hero-note{display:inline-flex;margin-top:20px;padding:10px 14px;border:1px solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.07);font-size:12px;color:#d9e4f1}.intro{padding-top:55px}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:end;margin-bottom:32px}.section-head h2{color:var(--navy);font-size:38px;margin:9px 0}.section-head p{color:var(--muted);line-height:1.7;margin:0}.category-list{display:flex;flex-direction:column;gap:42px}.category-block{border-top:1px solid var(--line);padding-top:32px}.category-heading{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:18px}.category-heading h2{color:var(--navy);font-size:28px;margin:6px 0}.category-heading p{color:var(--muted);font-size:14px;line-height:1.55;margin:0;max-width:700px}.category-link{white-space:nowrap;color:var(--blue);font-size:12px;font-weight:900;text-decoration:none}.product-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}.product-card{display:grid;grid-template-columns:150px 1fr;gap:20px;align-items:center;border:1px solid var(--line);border-radius:16px;background:#fff;padding:16px;min-height:180px;transition:transform .2s ease,box-shadow .2s ease}.product-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(16,35,63,.08)}.product-image{height:145px;border-radius:12px;background:#f5f7fa;display:flex;align-items:center;justify-content:center}.product-image img{width:100%;height:100%;object-fit:contain;padding:10px}.option{font-size:9px;letter-spacing:.13em;font-weight:900;color:var(--red)}.product-content h3{color:var(--navy);font-size:19px;line-height:1.25;margin:7px 0}.best-for{color:var(--muted);font-size:12px;line-height:1.45;margin:0 0 12px}.product-meta{display:flex;justify-content:space-between;gap:10px;font-size:10px;color:var(--muted);margin-bottom:12px}.score{font-weight:900;color:var(--red)}.product-content>a{color:var(--blue);font-size:11px;font-weight:900;text-decoration:none}.tool-callout{background:#f5f7fa;padding-top:60px;padding-bottom:60px}.tool-box{display:grid;grid-template-columns:1.5fr 1fr;gap:35px;align-items:center;border-radius:18px;background:#10233f;padding:35px;color:#fff}.tool-box h2{color:#fff;font-size:34px;margin:8px 0}.tool-box p{color:#d9e4f1;line-height:1.7;max-width:700px}.tool-points{display:grid;gap:10px}.tool-points span{padding:13px 15px;border:1px solid rgba(255,255,255,.18);border-radius:10px;color:#fff;font-size:12px;font-weight:800}.method{background:#fff}.method h2{color:var(--navy);font-size:34px;margin:10px 0}.method p{max-width:800px;color:var(--muted);line-height:1.7}.arrow{display:inline-block;margin-top:12px;color:var(--blue);font-size:12px;font-weight:900;text-decoration:none}@media(max-width:850px){.section-head,.tool-box{grid-template-columns:1fr}.category-heading{align-items:flex-start;flex-direction:column;gap:10px}.product-pair{grid-template-columns:1fr}}@media(max-width:600px){.hero{padding:60px 0}.hero p{font-size:16px}.intro{padding-top:40px}.section-head h2{font-size:30px}.product-card{grid-template-columns:100px 1fr;padding:12px;gap:14px}.product-image{height:105px}.product-content h3{font-size:17px}.product-meta{flex-direction:column;gap:4px}.category-list{gap:34px}}
</style>
