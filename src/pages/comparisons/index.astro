---
import BaseLayout from '../../layouts/BaseLayout.astro';
const comparisons = [
  ['Sony WH-1000XM5 vs Apple AirPods 4','sony-wh-1000xm5-vs-airpods-4','Noise-canceling headphones vs everyday open-style earbuds.'],
  ['Ninja AF101 vs Instant Vortex Plus','ninja-af101-vs-instant-vortex-plus','Two popular air-fryer options with different capacity and feature considerations.'],
  ['Dyson V8 vs Shark Navigator Lift-Away','dyson-v8-vs-shark-navigator','Cordless convenience vs traditional upright whole-home cleaning.'],
  ['YETI Rambler vs Stanley Quencher','yeti-rambler-vs-stanley-quencher','Two popular insulated drinkware families for everyday hydration.'],
  ['TP-Link Kasa Outdoor Plug vs Ring Battery Doorbell','tp-link-outdoor-plug-vs-ring-doorbell','Two very different smart-home purchases—and how to think about the use case.']
];
---
<BaseLayout title="Product Comparisons | Buy Better Finds" description="Direct product comparisons from Buy Better Finds with practical tradeoffs, best-for guidance, and Buy Better Scores.">
<section class="hero"><div class="container"><div class="eyebrow">PRODUCT COMPARISONS</div><h1>Compare the products you're actually deciding between.</h1><p>Side-by-side guidance helps you see the practical difference between products before you click through to shop.</p></div></section>
<section class="section"><div class="container"><div class="grid">{comparisons.map(([title,slug,description])=><a class="card" href={`/comparisons/${slug}/`}><span>COMPARE</span><h2>{title}</h2><p>{description}</p><b>See the comparison →</b></a>)}</div></div></section>
<section class="section method"><div class="container"><div class="eyebrow">HOW WE COMPARE</div><h2>Fit matters more than a single winner.</h2><p>We compare intended use, practical strengths, limitations, reference pricing, and our editorial recommendation score. A product can be the better choice for one shopper and the wrong choice for another.</p><a class="arrow" href="/why-we-recommend/">Learn how we recommend →</a></div></section>
</BaseLayout>
<style>
.hero{background:linear-gradient(135deg,#10233f,#173c69);color:#fff;padding:82px 0}.hero .eyebrow,.hero h1,.hero p{color:#fff}.hero h1{font-size:clamp(40px,6vw,68px);line-height:1.02;max-width:850px;margin:12px 0 20px}.hero p{max-width:740px;font-size:18px;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.card{border:1px solid var(--line);border-radius:14px;padding:30px;background:#fff;min-height:235px;display:flex;flex-direction:column;transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 15px 32px #10233f14}.card span{font-size:10px;letter-spacing:.12em;font-weight:900;color:var(--red)}.card h2{color:var(--navy);font-size:25px;line-height:1.15;margin:14px 0 10px}.card p{color:var(--muted);line-height:1.6}.card b{margin-top:auto;color:var(--blue);font-size:13px}.method{background:#f5f7fa}.method h2{color:var(--navy);font-size:34px;margin:10px 0}.method p{max-width:760px;color:var(--muted);line-height:1.7}@media(max-width:650px){.grid{grid-template-columns:1fr}.hero{padding:60px 0}.hero p{font-size:16px}}
</style>
