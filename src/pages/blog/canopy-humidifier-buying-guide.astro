const description = 'Considering a Canopy humidifier? Compare Bedside, Nursery and Large Room models, learn how evaporative humidification works, and understand filter costs and cleaning before buying.';
const affiliate = 'https://www.awin1.com/cread.php?s=3968588&v=92525&q=521919&r=3119041';
const banner = 'https://www.awin1.com/cshow.php?s=3968588&v=92525&q=521919&r=3119041';
const bedsideImage = 'https://getcanopy.co/cdn/shop/files/2.0_PDP_Exploded_4.jpg?v=1780592952&width=1200';
const filterImage = 'https://getcanopy.co/cdn/shop/files/2.0_PDP_Filter_3.jpg?v=1781721762&width=1200';
const pageStructuredData = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:'Canopy Humidifier Review: Bedside vs. Nursery vs. Large Room',
  description,
  datePublished:'2026-11-19',
  dateModified:'2026-11-19',
  author:{'@type':'Organization',name:'Buy Better Finds'},
