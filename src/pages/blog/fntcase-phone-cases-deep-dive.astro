.fnt-hero h1{font-size:clamp(2rem,4vw,3.6rem);line-height:1.08;letter-spacing:-.035em;margin:8px 0 18px;color:#fff}
.fnt-hero .fnt-kicker{color:#f2b9c3}.fnt-intro{font-size:1.05rem;color:#f1f4f6}.fnt-hero-image{display:flex;align-items:center;justify-content:center;min-height:300px;background:#fff;border-radius:12px;overflow:hidden}.fnt-hero-image img{display:block;width:100%;height:100%;max-height:460px;object-fit:contain}
.fnt-cta{display:inline-flex;align-items:center;justify-content:center;background:#c8102e;color:#fff!important;text-decoration:none;font-weight:800;padding:12px 18px;border-radius:7px;margin:8px 0}.fnt-cta:hover{background:#a40d25}.fnt-disclaimer{font-size:.82rem;color:#cbd5df;margin:10px 0 0}.fnt-highlights{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#dedfe2;border:1px solid #dedfe2;border-radius:12px;overflow:hidden;margin:22px 0}.fnt-highlights div{background:#f7f8fa;padding:18px;text-align:center}.fnt-highlights strong,.fnt-highlights span{display:block}.fnt-highlights strong{color:#142b45;font-size:1rem}.fnt-highlights span{font-size:.78rem;color:#5e6973;margin-top:4px}
.fnt-jump{display:flex;gap:14px;align-items:center;flex-wrap:wrap;border-block:1px solid #e0e3e6;padding:16px 0;margin:24px 0}.fnt-jump a,.fnt-text-link{color:#142b45;text-decoration:underline;text-underline-offset:3px;font-weight:700}.fnt-note{background:#fff6e8;border-left:4px solid #c8102e;padding:14px 17px;font-size:.92rem}.fnt-wrap h2{color:#142b45;line-height:1.2;font-size:clamp(1.6rem,3vw,2.3rem);margin:36px 0 14px}.fnt-wrap h3{color:#142b45;line-height:1.25}.fnt-table-wrap{overflow-x:auto}.fnt-table{width:100%;border-collapse:collapse;font-size:.91rem}.fnt-table th{background:#142b45;color:#fff;text-align:left}.fnt-table th,.fnt-table td{padding:13px;border:1px solid #dfe3e7;vertical-align:top}.fnt-table tbody tr:nth-child(even){background:#f6f8fa}
