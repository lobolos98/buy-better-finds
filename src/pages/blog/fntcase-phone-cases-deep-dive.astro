@media(max-width:760px){.fnt-hero{grid-template-columns:1fr;gap:22px}.fnt-hero-image{min-height:220px}.fnt-highlights{grid-template-columns:repeat(2,1fr)}.fnt-product{grid-template-columns:1fr}.fnt-product-image{min-height:220px}.fnt-choice-grid{grid-template-columns:1fr}.fnt-jump{gap:10px}.fnt-table{min-width:660px}}
