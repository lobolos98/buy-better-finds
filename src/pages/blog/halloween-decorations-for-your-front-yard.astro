  .byline{display:flex;align-items:center;gap:12px;border-top:1px solid var(--line);padding-top:16px;color:var(--ink);font-size:.68rem;font-weight:800;letter-spacing:.08em}
  .byline-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--ink);color:#fff;font-family:Georgia,serif;letter-spacing:-.05em}
  .byline small{display:block;color:#77736c;font-size:.65rem;letter-spacing:0;font-weight:500;margin-top:4px}
  .read-time{margin-left:auto;color:#77736c;font-size:.63rem}
  .hero-photo{width:min(1120px,calc(100% - 44px));margin:0 auto 46px}
  .hero-photo img{display:block;width:100%;height:clamp(260px,47vw,560px);object-fit:cover;background:#e8dfd2}
