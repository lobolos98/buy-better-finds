5fr;border:1px solid #e4ddd2;background:#fffdf9;overflow:hidden}.card.testing{grid-column:1/-1}.image-wrap{position:relative;background:#fff;min-height:260px}.image-wrap img{width:100%;height:100%;object-fit:contain}.badge{position:absolute;z-index:2;left:10px;top:10px;background:#142b45;color:#fff;padding:8px 10px;font-size:.65rem;font-weight:800;letter-spacing:.1em}.card-copy{padding:20px}.price{font-weight:800;color:#142b45;font-size:.86rem}@media(max-width:780px){.dh{padding:30px 16px 60px}.hero{grid-template-columns:1fr}.hero-img{height:300px}.cards,.tips,.feature-grid{grid-template-columns:1fr}.card,.card.testing{grid-column:auto;grid-template-columns:.8fr 1.2fr}}@media(max-width:520px){.card{grid-template-columns:1fr}.image-wrap{min-height:230px}.hero-img{height:260px}}
</style>
</BaseLayout>