---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'The Finds Edit | Shopping Ideas & Product Advice | Buy Better Finds';
const description = 'The Finds Edit by Buy Better Finds: thoughtful shopping ideas, seasonal inspiration, and practical advice to help you choose what is worth buying.';
---
<BaseLayout title={title} description={description}>
  <div class="edit-page">
    <div class="edit-topline"><div class="edit-wrap"><span>BUY BETTER FINDS PRESENTS</span><span>GOOD FINDS. SMARTER CHOICES.</span></div></div>
    <header class="masthead edit-wrap">
      <p class="masthead-kicker">THE BUY BETTER FINDS JOURNAL</p>
      <h1>The Finds <em>Edit</em></h1>
      <p>Ideas for a home you love, products worth a closer look, and smarter ways to shop.</p>
      <nav class="topic-nav" aria-label="Editorial topics">
        <a href="#latest">Latest stories</a><a href="/categories/seasonal-holidays/halloween/">Seasonal style</a><a href="/guides/">Buying guides</a><a href="/comparisons/">Head-to-heads</a>
      </nav>
    </header>

    <main class="edit-wrap editorial-content">
      <section class="lead-story" aria-labelledby="lead-title">
        <a class="lead-image" href="/blog/halloween-decorations-for-your-front-yard/" aria-label="Read Halloween yard decoration ideas">
          <img src="https://images.unsplash.com/photo-1509557965875-b88c97052f0e?auto=format&fit=crop&w=1400&q=85" alt="Warm autumn and Halloween pumpkins arranged on a front porch" loading="eager" fetchpriority="high" />
          <span class="image-label">THE SEASONAL EDIT</span>
        </a>
        <div class="lead-copy">
          <p class="story-meta">SEASONAL STYLE <span>•</span> 5 MIN READ</p>
          <h2 id="lead-title"><a href="/blog/halloween-decorations-for-your-front-yard/">A Front Yard That Says Halloween—Without Going Overboard</a></h2>
          <p>From one showstopper to a little atmospheric lighting, these ideas help you create a display that feels considered, not cluttered.</p>
          <a class="read-link" href="/blog/halloween-decorations-for-your-front-yard/">Read the story <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="latest" class="latest-section" aria-labelledby="latest-title">
        <div class="section-intro"><div><p class="section-kicker">THE LATEST</p><h2 id="latest-title">A little inspiration goes a long way.</h2></div><p>Practical ideas and useful details to help you shop with a plan.</p></div>
        <div class="story-grid">
          <article class="story-card">
            <a class="story-photo halloween-photo" href="/blog/halloween-decorations-for-your-front-yard/"><img src="https://images.unsplash.com/photo-1509557965875-b88c97052f0e?auto=format&fit=crop&w=900&q=80" alt="Seasonal pumpkins and porch decorations" loading="lazy" /></a>
            <div class="story-card-copy"><p class="story-meta">SEASONAL STYLE <span>•</span> HALLOWEEN</p><h3><a href="/blog/halloween-decorations-for-your-front-yard/">Halloween Yard Decorations: Ideas for a Spooky Front Yard</a></h3><a class="small-link" href="/blog/halloween-decorations-for-your-front-yard/">Explore the ideas →</a></div>
          </article>
          <article class="story-card lego-story-card">
            <a class="lego-editorial-photo" href="/blog/best-lego-light-kits/" aria-label="Read the LEGO light kit buying guide">
              <span class="lego-editorial-kicker">THE COLLECTOR'S EDIT</span>
              <span class="lego-editorial-title">Built to<br/><em>glow.</em></span>
              <span class="lego-editorial-caption">A guide to compatible display lighting</span>
            </a>
            <div class="story-card-copy"><p class="story-meta">COLLECTOR'S EDIT <span>•</span> 7 MIN READ</p><h3><a href="/blog/best-lego-light-kits/">Best LEGO Light Kits: 6 Ways to Upgrade Your Display</a></h3><p class="story-summary">Compare lighting options for six different builds, plus the compatibility and installation details to check before you buy.</p><a class="small-link" href="/blog/best-lego-light-kits/">Explore the guide →</a></div>
          </article>
          <article class="editorial-promo promo-guides">
            <span class="promo-number">01 / THE PRACTICAL EDIT</span><div><p class="section-kicker">BUY WITH CONFIDENCE</p><h3>Before you add to cart.</h3><p>Our buying guides focus on the details that matter—from useful features to questions worth asking before you spend.</p><a href="/guides/">Browse buying guides <span>↗</span></a></div>
          </article>
          <article class="editorial-promo promo-compare">
            <span class="promo-number">02 / THE SIDE-BY-SIDE</span><div><p class="section-kicker">MAKE THE CALL</p><h3>Two options. A clearer choice.</h3><p>Compare products and see the trade-offs so you can find the fit for your needs and budget.</p><a href="/comparisons/">Explore comparisons <span>↗</span></a></div>
          </article>
        </div>
      </section>

      <section class="shop-strip">
        <div><p class="section-kicker">CURATED FOR THE SEASON</p><h2>Ready to browse the finds?</h2><p>Explore seasonal picks and product collections, with direct links to check current details.</p></div>
        <a href="/categories/seasonal-holidays/halloween/">Shop Halloween finds <span aria-hidden="true">↗</span></a>
      </section>
      <p class="edit-disclosure">Some links may be affiliate links. As an Amazon Associate, Buy Better Finds earns from qualifying purchases. We aim to make recommendations useful and straightforward; always review the current product listing before buying.</p>
    </main>
  </div>
</BaseLayout>
<style>
  .edit-page{background:#fbf8f2;color:#242b32;--ink:#142b45;--red:#c8102e;--muted:#687078;--line:#e5ded2;font-family:Arial,Helvetica,sans-serif}
  .edit-wrap{width:min(1160px,calc(100% - 44px));margin-inline:auto}
  .edit-topline{background:#142b45;color:#fff;font-size:.67rem;font-weight:700;letter-spacing:.14em}
  .edit-topline .edit-wrap{display:flex;justify-content:space-between;gap:16px;padding:10px 0}
  .masthead{text-align:center;padding:40px 0 0}
  .masthead-kicker,.section-kicker{font-size:.68rem;letter-spacing:.19em;font-weight:800;color:var(--red);margin:0 0 12px}
  .masthead h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(3.3rem,8vw,6.2rem);font-weight:500;line-height:.95;letter-spacing:-.065em;color:var(--ink);margin:0}
  .masthead h1 em{font-weight:400;color:var(--red)}
  .masthead>p:not(.masthead-kicker){color:#60666b;font-family:Georgia,'Times New Roman',serif;font-size:1.12rem;margin:17px auto 25px;max-width:540px;line-height:1.6}
  .topic-nav{display:flex;justify-content:center;gap:clamp(18px,4vw,48px);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:15px 8px;margin-top:25px;flex-wrap:wrap}
  .topic-nav a{font-size:.78rem;font-weight:700;color:var(--ink);text-decoration:none}
  .topic-nav a:hover,.read-link:hover,.small-link:hover{color:var(--red)}
  .editorial-content{padding:34px 0 60px}
  .lead-story{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.8fr);gap:clamp(26px,5vw,64px);align-items:center;padding-bottom:52px;border-bottom:1px solid var(--line)}
  .lead-image{position:relative;display:block;aspect-ratio:1.3;overflow:hidden;background:#e8dfd2}
  .lead-image img,.story-photo img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .5s ease}
  .lead-image:hover img,.story-photo:hover img{transform:scale(1.035)}
  .image-label{position:absolute;left:16px;bottom:16px;background:#fbf8f2;padding:9px 12px;color:var(--ink);font-size:.64rem;letter-spacing:.14em;font-weight:800}
  .lead-copy{padding:12px 0}
  .story-meta{font-size:.65rem;letter-spacing:.14em;font-weight:800;color:#77736c;margin:0 0 15px}
  .story-meta span{color:var(--red);padding:0 5px}
  .lead-copy h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,3.5vw,3.2rem);font-weight:500;line-height:1.1;letter-spacing:-.04em;margin:0 0 18px;color:var(--ink)}
  .lead-copy h2 a,.story-card h3 a{color:inherit;text-decoration:none}
  .lead-copy>p:not(.story-meta){font-family:Georgia,'Times New Roman',serif;color:#555d63;font-size:1.05rem;line-height:1.75;margin:0 0 24px}
  .read-link{display:inline-flex;gap:12px;color:var(--ink);font-size:.79rem;font-weight:800;text-decoration:none;border-bottom:1px solid var(--red);padding-bottom:8px}
  .latest-section{padding:47px 0 48px}
  .section-intro{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:25px}
  .section-intro h2,.shop-strip h2{font-family:Georgia,'Times New Roman',serif;color:var(--ink);font-size:clamp(1.9rem,4vw,2.8rem);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin:0}
  .section-intro>p{max-width:310px;color:var(--muted);font-size:.88rem;line-height:1.65;margin:0}
  .story-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px}
  .story-card,.editorial-promo{min-width:0;background:#fffdf9;border:1px solid var(--line)}
  .story-photo{display:block;aspect-ratio:1.27;overflow:hidden;background:#e9dfd0}
  .story-card-copy{padding:20px}
  .story-card h3,.editorial-promo h3{font-family:Georgia,'Times New Roman',serif;color:var(--ink);font-size:1.55rem;line-height:1.17;letter-spacing:-.025em;font-weight:500;margin:0 0 20px}
  .small-link{font-size:.75rem;font-weight:800;color:var(--ink);text-decoration:none}
  .editorial-promo{display:flex;flex-direction:column;justify-content:space-between;padding:20px;min-height:100%}
  .promo-number{font-size:.61rem;font-weight:800;letter-spacing:.14em;color:#77736c}
  .editorial-promo h3{font-size:1.85rem;margin-bottom:12px}
  .editorial-promo div>p:not(.section-kicker){font-size:.86rem;line-height:1.7;color:#62686c;margin:0 0 22px}
  .editorial-promo div>a{display:flex;justify-content:space-between;gap:12px;padding-top:12px;border-top:1px solid var(--line);font-size:.75rem;font-weight:800;text-decoration:none;color:var(--ink)}
  .lego-editorial-photo{display:flex;flex-direction:column;justify-content:space-between;aspect-ratio:1.27;padding:22px;background:radial-gradient(circle at 75% 30%,#d5e5f3 0,transparent 32%),linear-gradient(140deg,#102b50,#1e456d 58%,#c8102e);color:#fff;text-decoration:none;overflow:hidden}
  .lego-editorial-kicker{font-size:.61rem;letter-spacing:.15em;font-weight:800}
  .lego-editorial-title{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2.5rem,4vw,3.8rem);line-height:.88;letter-spacing:-.06em;font-weight:500}
  .lego-editorial-title em{font-weight:400;color:#f2c9d1}
  .lego-editorial-caption{font-size:.72rem;line-height:1.5;max-width:190px;color:#e4edf5}
  .story-summary{font-size:.84rem;line-height:1.6;color:#62686c;margin:0 0 18px}
  .promo-guides{background:#f0e8dc}.promo-compare{background:#e8edf0}
  .shop-strip{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px 30px;background:#eae3d8}
  .shop-strip h2{font-size:2rem;margin-bottom:9px}
  .shop-strip div>p:last-child{color:#60666b;font-size:.85rem;line-height:1.6;margin:0;max-width:600px}
  .shop-strip>a{display:inline-flex;align-items:center;gap:18px;flex-shrink:0;padding:14px 17px;background:var(--red);color:#fff;text-decoration:none;font-size:.77rem;font-weight:800}
  .edit-disclosure{max-width:760px;margin:25px auto 0;text-align:center;color:#77736c;font-size:.72rem;line-height:1.7}
  @media(max-width:850px){.lead-story{grid-template-columns:1fr 0.85fr;gap:25px}.story-grid{grid-template-columns:1fr 1fr}.story-card{grid-row:span 2}.editorial-promo{min-height:230px}.section-intro{align-items:start;flex-direction:column;gap:10px}}
  @media(max-width:600px){.edit-wrap{width:calc(100% - 30px)}.edit-topline .edit-wrap{font-size:.56rem;letter-spacing:.08em}.edit-topline .edit-wrap span:last-child{display:none}.masthead{padding-top:32px}.masthead h1{font-size:3.5rem}.masthead>p:not(.masthead-kicker){font-size:1rem}.topic-nav{gap:12px 22px}.topic-nav a{font-size:.72rem}.editorial-content{padding-top:22px}.lead-story{grid-template-columns:1fr;gap:21px;padding-bottom:34px}.lead-image{aspect-ratio:1.18}.lead-copy{padding:0}.lead-copy h2{font-size:2.4rem}.latest-section{padding:34px 0}.story-grid{grid-template-columns:1fr}.story-card{grid-row:auto}.story-photo{aspect-ratio:1.35}.editorial-promo{min-height:235px}.shop-strip{align-items:flex-start;flex-direction:column;padding:24px 20px}.shop-strip h2{font-size:1.8rem}}
  @media(prefers-reduced-motion:reduce){.lead-image img,.story-photo img{transition:none}}
</style>
