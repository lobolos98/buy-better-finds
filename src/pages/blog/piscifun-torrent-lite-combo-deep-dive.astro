.torrent-table-scroll{overflow-x:auto}
.torrent-table{width:100%;border-collapse:collapse;min-width:650px}
.torrent-table th,.torrent-table td{text-align:left;vertical-align:top;border-bottom:1px solid #e1e5e8;padding:13px}
.torrent-table th{background:#f5f7f8;color:#142b45}
.torrent-feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:18px 0}
.torrent-feature-grid>div{padding:20px;border:1px solid #e1e5e8;border-radius:15px}
