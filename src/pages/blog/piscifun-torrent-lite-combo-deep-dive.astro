const description = 'A practical look at the Piscifun Torrent Lite twin-tip combos: published specs, rod lengths and actions, spinning vs. baitcasting, pros, trade-offs, and what to check before buying.';
const image = 'https://www.piscifun.com/cdn/shop/files/Frame6.jpg?v=1790064177&width=1200';
