---
import BlogArticleLayout from '../../layouts/BlogArticleLayout.astro';
const title = '10 Sunshine Tienda Finds: Clothing, Bags, Hats & Jewelry | The Finds Edit';
const description = 'Explore ten Sunshine Tienda clothing, bags, hats and jewelry picks, with styling tips and practical details to check before buying.';
const heroImage = 'https://cdn.shopify.com/s/files/1/0642/7243/files/Blog_Post-5_206ff737-7241-46e4-b436-6b1e9d017e09.png?v=1739908843&width=2000';
const products = [{"name":"Gabriela Bucket Hat","slug":"gabriela-bucket-hat","label":"RELAXED HAT","detail":"A relaxed bucket-hat silhouette to compare with traditional wide brims."},{"name":"Rainbow Confetti Necklace","slug":"rainbow-confetti-necklace","label":"COLORFUL JEWELRY","detail":"A playful necklace to bring color to a simple outfit."},{"name":"Rainbow Plaid Canvas Tote","slug":"rainbow-plaid-canvas-tote","label":"EVERYDAY BAG","detail":"A patterned tote to consider for errands or weekend packing."},{"name":"Harbor Plaid Charlotte Dress","slug":"harbor-plaid-charlotte-dress","label":"PLAID DRESS","detail":"A seasonal dress that can carry the colorful aesthetic beyond summer."},{"name":"Red Heart Bangle Stack","slug":"copy-of-red-heart-bangle-stack","approvedImage":"https://www.sunshinetienda.com/cdn/shop/products/sunshine-tienda-red-heart-bangle-stack-31791110324339.jpg?v=1717777725&width=1600","label":"STACKABLE JEWELRY","detail":"A coordinated bangle stack for an easy statement accessory."},{"name":"Carolina Palm Hat","slug":"carolina-palm-hat","label":"STATEMENT HAT","detail":"A bold palm-hat option for vacation wardrobes and sunny outings."},{"name":"Colorful Leighton Set","slug":"colorful-leighton-set","label":"COORDINATED OUTFIT","detail":"A colorful matching set for an outfit with minimal styling effort."},{"name":"Painted Gingham Canvas Tote","slug":"painted-gingham-canvas-tote","label":"PATTERNED BAG","detail":"A gingham carryall for a playful alternative to a plain tote."},{"name":"Rainbow Colorblock Earrings","slug":"copy-of-rainbow-colorblock-earrings","approvedImage":"https://www.sunshinetienda.com/cdn/shop/files/sunshine-tienda-rainbow-colorblock-earrings-1220266770.jpg?v=1770771009&width=1920","label":"COLORFUL STATEMENT EARRINGS","detail":"A vibrant mix of rainbow tones, tortoise and natural color in lightweight horn earrings with stainless-steel posts."},{"name":"Harvest Blooms Hali Top","slug":"harvest-blooms-hali-top","label":"PRINTED TOP","detail":"A printed top to pair with wardrobe basics."}];
const affiliateUrl = (url) => 'https://www.awin1.com/cread.php?awinmid=59383&awinaffid=3119041&ued=' + encodeURIComponent(url);
const saleItems = await (async () => {
  try {
    const response = await fetch('https://www.sunshinetienda.com/collections/sale-1/products.json?limit=12', { headers: { accept: 'application/json' } });
    if (!response.ok) return [];
    const data = await response.json();
    return (data.products || []).map((p) => {
      const rawImage = p.images?.[0]?.src || p.image?.src || '';
      let image = '';
      try {
        const u = new URL(rawImage, 'https://www.sunshinetienda.com');
        if (u.protocol === 'https:' && ['cdn.shopify.com','www.sunshinetienda.com','sunshinetienda.com'].includes(u.hostname)) image = u.href;
      } catch {}
      const variant = p.variants?.[0] || {};
      const price = Number(variant.price);
      const compare = Number(variant.compare_at_price);
      return {
        name: p.title,
        url: 'https://www.sunshinetienda.com/products/' + p.handle,
        image,
        price: Number.isFinite(price) ? '$' + price.toFixed(2) : '',
        comparePrice: Number.isFinite(compare) && compare > price ? '$' + compare.toFixed(2) : '',
        discount: Number.isFinite(compare) && compare > price ? Math.round((compare - price) / compare * 100) : 0
      };
    }).filter(p => p.name && p.url && p.image).slice(0, 8);
  } catch (error) {
    console.warn('Sunshine Tienda sale collection unavailable:', String(error));
    return [];
  }
})();
const items = await Promise.all(products.map(async (p) => {
  const url = 'https://www.sunshinetienda.com/products/' + p.slug;
  const norm = (value) => String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const imageUrl = (value) => {
    if (!value) return '';
    try {
      const raw = typeof value === 'string' ? value : (value.src || value.url || '');
      const u = new URL(raw.startsWith('//') ? 'https:' + raw : raw, url);
      if (u.protocol !== 'https:') return '';
      if (!['cdn.shopify.com', 'www.sunshinetienda.com', 'sunshinetienda.com'].includes(u.hostname)) return '';
      if (!u.pathname.includes('/s/files/') && !u.pathname.includes('/cdn/shop/')) return '';
      return u.href;
    } catch { return ''; }
  };
  let image = '';
  let verified = false;
  try {
    const response = await fetch(url + '.js');
    if (response.ok) {
      const data = await response.json();
      verified = norm(data.title).includes(norm(p.name));
      if (verified) image = [data.featured_image, ...(Array.isArray(data.images) ? data.images : [])].map(imageUrl).find(Boolean) || '';
    }
  } catch (error) { console.warn('Sunshine Tienda product JSON unavailable:', p.slug, String(error)); }
  if (!image) {
    try {
      const response = await fetch(url);
      if (response.ok) {
        const html = await response.text();
        const titleMatch = html.match(/<meta[^>]+property=["']og:title["'][^>]+content=["']([^"']+)/i) || html.match(/<title>([^<]+)/i);
        const title = titleMatch?.[1]?.replace(/&amp;/g, '&') || '';
        if (norm(title).includes(norm(p.name))) {
          verified = true;
          const match = html.match(/<meta[^>]+(?:property|name)=["'](?:og:image|twitter:image)["'][^>]+content=["']([^"']+)/i)
            || html.match(/<meta[^>]+content=["']([^"']+)["'][^>]+(?:property|name)=["'](?:og:image|twitter:image)["']/i);
          image = imageUrl(match?.[1]?.replace(/&amp;/g, '&'));
        }
      }
    } catch (error) { console.warn('Sunshine Tienda product page unavailable:', p.slug, String(error)); }
  }
  if (!image) console.warn('Sunshine Tienda: missing verified image for', p.name, url);
  return {...p, url, image: p.approvedImage || image, verified, affiliateUrl: affiliateUrl(url)};
}));
---
<BlogArticleLayout title={title} description={description} image={heroImage} imageAlt="Sunshine Tienda official Spring collection editorial campaign photograph" category="THE STYLE EDIT" readingTime="6 MIN READ" dek="From colorful clothing to bags, hats and jewelry, here are ten Sunshine Tienda finds to browse—and what to consider before choosing one." related={[{title:'More stories from The Finds Edit',href:'/blog/'},{title:'Explore Lifestyle finds',href:'/categories/lifestyle/'},{title:'Browse gifts and collectibles',href:'/categories/gifts-collectibles/'}]}>
  <span slot="caption">Hero photograph from Sunshine Tienda’s official “Meet Us in Bermuda” campaign story. Product availability and styling may change.</span>
  <a slot="contents" href="#sale-finds">Current sale picks</a>
  <a slot="contents" href="#picks">Ten finds to browse</a>
  <a slot="contents" href="#compare">Compare the styles</a>
  <a slot="contents" href="#shopping-tips">Shopping tips</a>
  <a slot="contents" href="#faq">Questions to consider</a>

  <p>Sunshine Tienda brings cheerful color to outfits and accessories, with statement jewelry, patterned totes, playful clothing and distinctive hats. If you prefer one memorable accessory over an entirely new outfit, this collection offers plenty of ways to experiment with pattern and texture.</p>
  <p>We selected two hats, three jewelry pieces, two bags and three clothing items to make browsing easier. This is an independent editorial shopping guide, not a hands-on review. Product details, sizing, availability and current prices should always be checked on the merchant's listing.</p>
  <section class="sale-feature" aria-label="Sunshine Tienda sale picks">
    <div class="sale-feature-heading"><p class="sale-kicker">THE SALE EDIT</p><h2 id="sale-finds" class="sale-anchor">Colorful finds to browse on sale</h2><p>We pulled a cross-section of products currently listed in Sunshine Tienda's sale collection. Sale prices and availability can change; confirm the final price and any sale conditions on the retailer's page.</p></div>
    {saleItems.length > 0 ? <div class="sale-product-grid">
      {saleItems.map((p) => <article class="sale-product-card">
        <a class="sale-product-image" href={affiliateUrl(p.url)} rel="sponsored nofollow noopener noreferrer" target="_blank"><img src={p.image} alt={p.name + ' from Sunshine Tienda'} loading="lazy" decoding="async" /></a>
        <div class="sale-product-copy"><h3>{p.name}</h3><p class="sale-price">{p.price}{p.comparePrice && <span class="sale-price-meta"><span class="sale-compare">{p.comparePrice}</span><span class="sale-discount"> {p.discount}% off</span></span>}</p><a class="sale-shop-link" href={affiliateUrl(p.url)} rel="sponsored nofollow noopener noreferrer" target="_blank">Check sale price ↗</a></div>
      </article>)}
    </div> : <div class="sale-fallback"><p>Browse the live sale collection for current product selection and pricing.</p><a href={affiliateUrl('https://www.sunshinetienda.com/collections/sale-1')} rel="sponsored nofollow noopener noreferrer" target="_blank">Shop the Sunshine Tienda sale ↗</a></div>}
    <p class="sale-footnote">Sale listings, discounts and product availability are not guaranteed and may change before checkout. Some products may have final-sale or other return restrictions.</p>
    <a class="sale-all-link" href={affiliateUrl('https://www.sunshinetienda.com/collections/sale-1')} rel="sponsored nofollow noopener noreferrer" target="_blank">Browse the full Sunshine Tienda sale collection →</a>
  </section>
  <section class="visual-feature" aria-label="Sunshine Tienda featured product photographs"><div class="visual-feature-heading"><span>THE COLOR EDIT</span><h2>Bright details. Easy outfit inspiration.</h2><p>Browse genuine product photography from Sunshine Tienda's catalog, then explore each matching item below.</p></div><div class="visual-feature-grid">{items.filter(p => p.image).slice(0,4).map(p => <a href={p.affiliateUrl} rel="sponsored noopener noreferrer" target="_blank"><img src={p.image} alt={p.name} loading="lazy" /><strong>{p.name}</strong></a>)}</div></section>
  <h2 id="picks">10 Sunshine Tienda finds across four categories</h2>
  <div class="finds-grid">
    {items.map((p, i) => <article class="find-card">
      {p.image && <a class="find-photo" href={p.affiliateUrl} rel="sponsored noopener noreferrer" target="_blank"><img src={p.image} alt={p.name + ' from Sunshine Tienda'} loading="lazy" referrerpolicy="no-referrer" /></a>}
      <div class="find-copy">
        <p class="find-number">FIND {i + 1} / {p.label}</p>
        <h3>{p.name}</h3>
        <p>{p.detail}</p>
        <a class="find-link" href={p.affiliateUrl} rel="sponsored noopener noreferrer" target="_blank">Shop at Sunshine Tienda <span aria-hidden="true">↗</span></a>
        <small>Check the current listing for price, color and availability.</small>
      </div>
    </article>)}
  </div>
  <h2 id="compare">Which Sunshine Tienda style fits your plans?</h2>
  <div class="compare-scroll"><table><thead><tr><th>Category</th><th>Consider for</th><th>Before buying</th></tr></thead><tbody>
    <tr><td>Palm hats</td><td>Travel, sunny days, statement styling</td><td>Head measurement, brim shape, personalization terms</td></tr>
    <tr><td>Bucket hats</td><td>Relaxed outfits and alternative silhouettes</td><td>Fit, brim coverage, care instructions</td></tr>
    <tr><td>Totes</td><td>Errands, weekend trips, gifting</td><td>Dimensions, material, carrying capacity</td></tr>
    <tr><td>Jewelry</td><td>Adding color to simple outfits</td><td>Dimensions, materials, care</td></tr>
    <tr><td>Dresses</td><td>Coordinated looks and occasion outfits</td><td>Size chart, fabric, return eligibility</td></tr>
  </tbody></table></div>
  <h2 id="shopping-tips">Three things to check before you order</h2>
  <h3>Measure for a hat, not just a clothing size</h3>
  <p>Sunshine Tienda's palm-hat listings provide head-circumference sizing. Use a soft measuring tape around your head and check the product's size guide; some styles offer personalization or removable straps at an additional cost.</p>
  <h3>Think about the outfit you already own</h3>
  <p>A colorful hat, tote or pair of earrings can do a lot of work with neutral clothing. If your wardrobe already has bold prints, consider choosing an accessory with one complementary color rather than matching every detail.</p>
  <h3>Read the returns and sale conditions</h3>
  <p>Personalized products and clearance merchandise may have different return conditions. Check the specific listing, shipping details and checkout total before purchasing.</p>
  <h2 id="faq">Frequently asked questions</h2>
  <h3>Is this a hands-on product review?</h3>
  <p>No. This is a curated editorial guide based on the brand's product listings and publicly described features; we have not independently tested these items.</p>
  <h3>Do the shopping links go to individual products?</h3>
  <p>Yes. Each shopping link is designed to open its matching Sunshine Tienda product listing through our Awin affiliate tracking link.</p>
  <h3>Are prices guaranteed?</h3>
  <p>No. Product prices, colors and stock can change. The merchant's product page and checkout show the current details.</p>
  <div class="shop-card"><p class="section-kicker">THE STYLE EDIT</p><h2>Browse more colorful finds</h2><p>Explore the full Sunshine Tienda collection and check current arrivals, sizes and availability.</p><a href={affiliateUrl('https://www.sunshinetienda.com/collections/all')} rel="sponsored noopener noreferrer" target="_blank">Shop Sunshine Tienda <span aria-hidden="true">↗</span></a></div>
  <p class="closing-note">Affiliate disclosure: Buy Better Finds participates in affiliate programs including Awin. We may earn a commission on qualifying purchases made through links in this article, at no additional cost to you.</p>
</BlogArticleLayout>
<style>
  .sale-feature{margin:34px 0 42px;padding:clamp(18px,3vw,30px);background:#fff4ed;border:1px solid #f0d6c7;border-radius:14px}
  .sale-kicker{font:800 .65rem/1.4 Arial,sans-serif;letter-spacing:.16em;color:#c8102e;margin:0 0 8px}
  .sale-feature-heading h2{margin:0 0 10px!important}
  .sale-feature-heading>p:last-child{font-size:.92rem;line-height:1.65}
  .sale-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:20px 0}
  .sale-product-card{min-width:0;background:#fff;border:1px solid #eaded6;border-radius:9px;overflow:hidden;display:flex;flex-direction:column}
  .sale-product-image{display:block;aspect-ratio:1;background:#fff;overflow:hidden}
  .sale-product-image img{display:block;width:100%;height:100%;object-fit:contain;padding:8px}
  .sale-product-copy{padding:12px;display:flex;flex-direction:column;flex:1}
  .sale-product-copy h3{font:700 .88rem/1.4 Arial,sans-serif;margin:0 0 9px;color:#142b45}
  .sale-price{font:800 .88rem/1.5 Arial,sans-serif;color:#142b45;margin:0 0 12px}
  .sale-price-meta{display:inline-flex;flex-wrap:wrap;gap:5px;align-items:center}\n  .sale-compare{font-weight:400;color:#777;text-decoration:line-through;margin-left:6px}
  .sale-discount{display:inline-block;color:#a20e28;font-size:.72rem;font-weight:800}
  .sale-shop-link,.sale-fallback a,.sale-all-link{display:inline-block;margin-top:auto;color:#b10f29;font:800 .76rem/1.5 Arial,sans-serif;text-decoration:none}
  .sale-footnote{font-size:.76rem;line-height:1.6;color:#6b7280}
  .sale-fallback{background:#fff;padding:16px;border-radius:8px}
  @media(max-width:760px){.sale-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n  @media(max-width:420px){.sale-product-grid{gap:9px}.sale-product-copy{padding:9px}.sale-product-copy h3{font-size:.8rem}}\n  .visual-feature{margin:30px 0 40px;background:#f5e7dd;padding:24px}
  .visual-feature-heading>span{font:800 .65rem Arial,sans-serif;color:#c8102e;letter-spacing:.15em}
  .visual-feature-heading h2{margin:10px 0!important}
  .visual-feature-heading p{font-size:.92rem;line-height:1.6}
  .visual-feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .visual-feature-grid a{background:white;text-decoration:none;color:#142b45;min-width:0}
  .visual-feature-grid img{width:100%;aspect-ratio:1;object-fit:contain;display:block}
  .visual-feature-grid strong{display:block;font:700 .75rem/1.4 Arial,sans-serif;padding:10px}
  .finds-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:24px 0}
  .find-card{min-width:0;background:#fffdf9;border:1px solid #e5ded2;overflow:hidden}
  .find-photo{display:block;aspect-ratio:1/1;background:#f3eee7;overflow:hidden}
  .find-photo img{display:block;width:100%;height:100%;object-fit:contain}
  .find-copy{padding:20px}
  .find-number{font:700 .65rem/1.5 Arial,sans-serif;letter-spacing:.12em;color:#c8102e;margin:0 0 10px}
  .find-copy h3{font:500 1.5rem/1.2 Georgia,serif;color:#142b45;margin:0 0 12px}
  .find-copy>p:not(.find-number){font-size:.96rem;line-height:1.65;margin:0 0 18px}
  .find-link{display:flex;align-items:center;justify-content:space-between;gap:8px;background:#c8102e;color:white;text-decoration:none;padding:12px 14px;font:700 .78rem Arial,sans-serif}
  .find-copy small{display:block;color:#687078;font:400 .7rem/1.5 Arial,sans-serif;margin-top:12px}
  .compare-scroll{overflow-x:auto;max-width:100%}
  .compare-scroll table{width:100%;min-width:480px;border-collapse:collapse;font:400 .85rem/1.6 Arial,sans-serif}
  .compare-scroll th,.compare-scroll td{padding:12px;text-align:left;border-bottom:1px solid #e5ded2}
  .compare-scroll th{color:#142b45}
  @media(max-width:700px){.finds-grid{grid-template-columns:minmax(0,1fr)}.find-copy{padding:17px}}
</style>
