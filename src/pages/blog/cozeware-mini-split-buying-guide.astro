  { name: 'Enduring Series · 24,000 BTU', btu: '24,000', voltage: '230V', seer: '20 SEER2', hspf: '8.5 HSPF2', coverage: 'Up to 1,500 sq. ft.', feature: 'App/voice control; standard series', url: 'https://www.cozeware.com/products/cozeware-enduring-series-24000-btu-20-seer2-mini-split-air-conditioner-230v-p-9581.html', image: 'https://img.yitashop.com/fit-in/800x800/10006/product/original/202603/8CDC1FBE-6C84-8F73-5617-5B1260FBFCA9.jpg', alt: 'Cozeware Enduring Series ductless mini-split indoor and outdoor units' },
