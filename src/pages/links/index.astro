---
import BaseLayout from '../../layouts/BaseLayout.astro';

const links = [
  {
    eyebrow: 'START HERE',
    title: "Today's Best Finds",
    description: 'Fresh discoveries, useful products, and deals worth a closer look.',
    href: '/weekly-finds/',
    label: 'Explore Weekly Finds',
    featured: true
  },
  {
    eyebrow: 'SEASONAL SAVINGS',
    title: 'Black Friday Deals',
    description: 'Browse current offers and shopping finds for the holiday season.',
    href: '/weekly-finds/',
    label: 'Shop the Deals'
  },
  {
    eyebrow: 'FRAGRANCE FAVORITES',
    title: 'Perfumania Bestselling Fragrances',
    description: 'Discover popular designer scents and gift-worthy fragrance picks.',
    href: 'https://www.kqzyfj.com/click-101914897-17358170',
    label: 'Shop Perfumania Bestsellers',
    external: true
  },
  {
    eyebrow: 'LIMITED-TIME OFFER',
    title: 'Perfumania Black Friday Fragrance Deals',
    description: 'Explore fragrance savings and limited-time offers at Perfumania.',
    href: 'https://www.kqzyfj.com/click-101914897-17325429',
    label: 'Explore Fragrance Deals',
    external: true
  },
  {
    eyebrow: 'DISCOVER OUR PARTNERS',
    title: 'Brand Pages',
    description: 'Explore dedicated brand guides, featured products, shopping details, and official-store links.',
    href: '/brands/',
    label: 'Explore All Brand Pages'
  },
  {
    eyebrow: 'SHOP BY INTEREST',
    title: 'Browse Categories',
    description: 'Find products and recommendations by the way you shop.',
    href: '/categories/',
    label: 'Explore Categories'
  },
  {
    eyebrow: 'GIFT INSPIRATION',
    title: 'The Gift Edit',
    description: 'Discover gift ideas and useful finds for the people on your list.',
    href: '/gifts/',
    label: 'Browse Gift Ideas'
  },
  {
    eyebrow: 'SAVE WHILE YOU SHOP',
    title: 'Coupons & Offers',
    description: 'Check current offers and ways to save on featured finds.',
    href: '/coupons/',
    label: 'View Offers'
  },
  {
    eyebrow: 'RESEARCH BEFORE YOU BUY',
    title: 'Product Reviews',
    description: 'Read our product research, hands-on testing updates, and practical evaluations.',
    href: '/reviews/',
    label: 'Read Reviews'
  },
  {
    eyebrow: 'MAKE A SMARTER CHOICE',
    title: 'Buying Guides & Comparisons',
    description: 'Understand features, tradeoffs, and what matters before you spend.',
    href: '/guides/',
    label: 'Explore Buying Guides'
  },
  {
    eyebrow: 'MORE TO DISCOVER',
    title: 'Browse All Products',
    description: 'Explore products and recommendations across categories.',
    href: '/products/',
    label: 'Browse Products'
  },
  {
    eyebrow: 'OUR APPROACH',
    title: 'How We Choose',
    description: 'Learn about our research standards and how we evaluate recommendations.',
    href: '/why-we-recommend/',
    label: 'Our Standards'
  }
];
---
<BaseLayout
  title="Buy Better Finds Links | Deals, Reviews & Buying Guides"
  description="Shop the latest finds, explore fragrance deals, read product reviews, and browse buying guides from Buy Better Finds."
  canonicalUrl="https://buybetterfinds.com/links/"
>
  <div class="links-page">
    <section class="links-hero">
      <div class="links-wrap">
        <div class="brand-lockup" aria-label="Buy Better Finds">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 48 48" role="img"><path d="M10 12h4l4.2 19.2a3 3 0 0 0 2.9 2.3h14.2a3 3 0 0 0 2.9-2.3L41 19H17" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 24h15M23 29h11" fill="none" stroke="#ef5368" stroke-width="2.5" stroke-linecap="round"/><circle cx="22" cy="39" r="2.7" fill="#fff"/><circle cx="35" cy="39" r="2.7" fill="#fff"/></svg></span>
          <span>BUY BETTER FINDS</span>
        </div>
        <p class="tagline">Smart shopping. Better finds.</p>
        <h1>Your next great find starts here.</h1>
        <p class="intro">Explore useful products, current offers, honest product research, and practical buying advice—all in one place.</p>
        <div class="hero-actions">
          <a class="hero-button primary" href="/weekly-finds/">🛍️ Shop This Week's Finds <span>→</span></a>
          <a class="hero-button secondary" href="/brands/">🏷️ Explore All Brands <span>→</span></a>
        </div>
        <div class="hero-product-strip" aria-label="A preview of products featured on Buy Better Finds">
          <img src="/images/products/apple-airpods-4.svg" alt="Wireless earbuds" loading="lazy" />
          <img src="/images/products/stanley-quencher.svg" alt="Insulated tumbler" loading="lazy" />
          <img src="/images/products/theragun-mini.svg" alt="Mini massage device" loading="lazy" />
          <span>Fresh finds for everyday life ✨</span>
        </div>
        <a class="instagram-link" href="https://www.instagram.com/buybetterfinds/" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">◎</span> Follow @buybetterfinds
        </a>
      </div>
    </section>

    <section class="links-content" aria-label="Buy Better Finds destinations">
      <div class="links-wrap">
        <div class="section-label"><span></span> FIND YOUR NEXT FAVORITE <span></span></div>
        <div class="quick-category-grid" aria-label="Quick shopping links">
          <a href="/weekly-finds/" class="quick-category deal"><span>🔥</span><strong>Weekly Finds</strong><small>Fresh picks & deals</small></a>
          <a href="/brands/" class="quick-category"><span>🏷️</span><strong>Brand Guides</strong><small>Explore our partners</small></a>
          <a href="/reviews/" class="quick-category"><span>⭐</span><strong>Reviews</strong><small>Research before buying</small></a>
          <a href="/gifts/" class="quick-category"><span>🎁</span><strong>Gift Ideas</strong><small>Find something special</small></a>
        </div>
        <div class="section-label destination-label"><span></span> EXPLORE MORE <span></span></div>
        <div class="link-list">
          {links.map((link) => (
            <a
              class:list={['link-card', link.featured && 'featured']}
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'sponsored nofollow noopener noreferrer' : undefined}
            >
              <span class="link-visual" aria-hidden="true">{link.title.includes('Perfumania') ? '🌸' : link.title.includes('Black Friday') ? '🛍️' : link.title.includes('Categories') ? '🧭' : link.title.includes('Gift') ? '🎁' : link.title.includes('Coupons') ? '🏷️' : link.title.includes('Reviews') ? '⭐' : link.title.includes('Guides') ? '📚' : link.title.includes('Products') ? '✨' : link.title.includes('Choose') ? '🔎' : link.title.includes('Brand') ? '💎' : '🔥'}</span>
              <span class="link-copy">
                <span class="link-eyebrow">{link.eyebrow}</span>
                <strong>{link.title}</strong>
                <span class="link-description">{link.description}</span>
                <span class="link-action">{link.label} <span aria-hidden="true">↗</span></span>
              </span>
              <span class="link-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <section class="brand-shortcuts" aria-labelledby="brand-shortcuts-title">
          <div class="brand-shortcuts-heading">
            <span class="link-eyebrow">FEATURED BRAND GUIDES</span>
            <h2 id="brand-shortcuts-title">Explore brands we feature</h2>
            <p>Visit dedicated brand pages for product highlights, shopping details, and official-store links.</p>
          </div>
          <div class="brand-shortcut-list">
            <a href="/brands/perfumania/"><span class="brand-image"><img src="https://perfumania.com/cdn/shop/files/Bundle33_Perf.jpg?v=1712147385&width=1200" alt="Perfumania fragrance gift pairing" loading="lazy" decoding="async" /></span><strong>Perfumania</strong><small>Fragrance & gifts</small><b>Explore brand →</b></a>
            <a href="/brands/silver-brush/"><span class="brand-image"><img src="https://www.silverbrush.com/cdn/shop/files/silver-kolinsky-r-round-paintbrush-short-handle-7200s-387.png?v=1787977993" alt="Silver Brush Kolinsky artist paintbrush" loading="lazy" decoding="async" /></span><strong>Silver Brush</strong><small>Artist supplies</small><b>Explore brand →</b></a>
            <a href="/brands/piscifun/"><span class="brand-image"><img src="https://www.piscifun.com/cdn/shop/files/Frame7.jpg?v=1790064177&width=1200" alt="Piscifun fishing rod and reel combo" loading="lazy" decoding="async" /></span><strong>Piscifun</strong><small>Fishing gear</small><b>Explore brand →</b></a>
            <a href="/brands/fntcase/"><span class="brand-image"><img src="https://fntcase.com/cdn/shop/files/6391ace427ade714b70fb966024ae804_a20f420e-d5d3-4d2b-88a6-10419faf4e25.jpg?v=1772271361" alt="FNTCASE protective phone case" loading="lazy" decoding="async" /></span><strong>FNTCASE</strong><small>Tech accessories</small><b>Explore brand →</b></a>
            <a href="/brands/rockbros/"><span class="brand-image"><img src="https://rockbrosus.com/cdn/shop/files/rockbros-lk69-bike-helmet-bionic-support-black_1.jpg?v=1759285865&width=1500" alt="ROCKBROS cycling helmet" loading="lazy" decoding="async" /></span><strong>ROCKBROS</strong><small>Cycling gear</small><b>Explore brand →</b></a>
            <a href="/brands/tidewe/"><span class="brand-image"><img src="https://www.tidewe.com/cdn/shop/files/WD018-VA-07-TE_6d90e871-320c-4b39-8c1f-79965f8540dd.png?v=1787738670&width=1000" alt="TIDEWE outdoor gear" loading="lazy" decoding="async" /></span><strong>TIDEWE</strong><small>Outdoor & hunting</small><b>Explore brand →</b></a>
            <a href="/brands/cozeware/"><span class="brand-image"><img src="https://img.yitashop.com/fit-in/800x800/10006/banners/original/202606/5905719B-E9E9-A632-9729-E66C3D3F6598.jpg" alt="Cozeware ductless mini-split system" loading="lazy" decoding="async" /></span><strong>Cozeware</strong><small>Home comfort</small><b>Explore brand →</b></a>
            <a href="/brands/canopy/"><span class="brand-image"><img src="https://getcanopy.co/cdn/shop/files/2.0_PDP_Exploded_4.jpg?v=1780592952&width=1200" alt="Canopy humidifier and filter components" loading="lazy" decoding="async" /></span><strong>Canopy</strong><small>Home wellness</small><b>Explore brand →</b></a>
            <a href="/brands/flikeze/"><span class="brand-image"><img src="https://flikeze.com/cdn/shop/files/BASIC78_6.jpg?v=1769421162&width=900" alt="FliKEZE red light therapy panel" loading="lazy" decoding="async" /></span><strong>FliKEZE</strong><small>Beauty & wellness tech</small><b>Explore brand →</b></a>
            <a href="/brands/hoshanho/"><span class="brand-image"><img src="https://www.hoshanho.com/cdn/shop/files/238c4bc0b69bda8657c8b3e678f6b05c_abe8d26d-6203-4e3b-a74a-20a7871b8442_800x.png?v=1786688971" alt="HOSHANHO kitchen knife" loading="lazy" decoding="async" /></span><strong>HOSHANHO</strong><small>Kitchen & cooking</small><b>Explore brand →</b></a>
            <a href="/brands/sunaofe/"><span class="brand-image"><img src="https://cdn.shopify.com/s/files/1/0273/7867/9908/files/sunaofe-sustainable-office-chair-green_76774736-e721-4fe9-a92f-dbdf580bac3e.webp?width=900" alt="Sunaofe ergonomic office chair" loading="lazy" decoding="async" /></span><strong>Sunaofe</strong><small>Office furniture</small><b>Explore brand →</b></a>
          </div>
        </section>

        <a class="edit-link" href="https://thebuybetterfindsedit.substack.com/" target="_blank" rel="noopener noreferrer">
          <span><strong>The Buy Better Finds Edit</strong><small>Smart shopping. Better finds. Read our Substack.</small></span>
          <b>Read the Edit ↗</b>
        </a>

        <div class="site-link">
          <span class="site-link-mark" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M9 10h4l4.5 21a3 3 0 0 0 2.9 2.3h14.1a3 3 0 0 0 2.9-2.3L41 17H16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 23h15M23 28h11" fill="none" stroke="#ef5368" stroke-width="2.5" stroke-linecap="round"/><circle cx="22" cy="39" r="2.7" fill="currentColor"/><circle cx="35" cy="39" r="2.7" fill="currentColor"/></svg></span>
          <div>
            <strong>BuyBetterFinds.com</strong>
            <span>Independent product research. Clearer choices.</span>
          </div>
          <a href="/" aria-label="Visit Buy Better Finds homepage">Visit site ↗</a>
        </div>

        <p class="disclosure">Disclosure: Buy Better Finds may earn a commission when you purchase through qualifying affiliate links, at no additional cost to you. This does not affect our editorial approach.</p>
        <div class="contact"><a href="/disclosure/">Affiliate Disclosure</a><span>·</span><a href="mailto:info@buybetterfinds.com">Contact</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .links-page{background:#f5f7fa;color:#182333}
  .links-wrap{width:min(100% - 32px,680px);margin:0 auto}
  .links-hero{position:relative;overflow:hidden;padding:48px 0 40px;text-align:center;background:linear-gradient(145deg,#edf2f8 0%,#fff 58%,#f8edf0 100%);border-bottom:1px solid #dfe5ec}
  .brand-lockup{display:flex;align-items:center;justify-content:center;gap:10px;color:#10233f;font-size:12px;font-weight:950;letter-spacing:.14em}
  .brand-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#10233f;color:#fff;box-shadow:0 8px 20px #10233f24}.brand-mark svg{display:block;width:29px;height:29px}
  .tagline{margin:13px 0 0;color:#c8102e;font-size:12px;font-weight:850;letter-spacing:.08em}
  .links-hero h1{max-width:590px;margin:15px auto 10px;color:#10233f;font-size:clamp(34px,7vw,49px);line-height:1.04;letter-spacing:-.045em}
  .intro{max-width:510px;margin:0 auto;color:#64748b;font-size:15px;line-height:1.7}
  .instagram-link{display:inline-flex;align-items:center;gap:8px;margin-top:19px;padding:10px 15px;border:1px solid #d8e0e9;border-radius:999px;background:#fff;color:#10233f;font-size:12px;font-weight:850}
  .instagram-link span{color:#c8102e;font-size:17px}
  .links-content{padding:30px 0 42px}
  .hero-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin:22px auto 0}
  .hero-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 18px;border-radius:9px;font-size:12px;font-weight:900;box-shadow:0 5px 14px #10233f16;transition:transform .18s ease,box-shadow .18s ease}
  .hero-button:hover{transform:translateY(-2px);box-shadow:0 9px 20px #10233f22}
  .hero-button.primary{background:#c8102e;color:#fff}
  .hero-button.secondary{background:#10233f;color:#fff}
  .hero-product-strip{display:flex;align-items:center;justify-content:center;gap:12px;margin:22px auto 0}
  .hero-product-strip img{width:54px;height:54px;padding:5px;border:1px solid #e2e8f0;border-radius:12px;background:#fff;object-fit:contain;box-shadow:0 5px 14px #10233f0d}
  .hero-product-strip span{color:#64748b;font-size:11px;font-weight:750}
  .quick-category-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:27px}
  .quick-category{display:flex;min-height:118px;flex-direction:column;align-items:flex-start;justify-content:center;gap:5px;padding:15px;border:1px solid #dce3eb;border-radius:13px;background:#fff;box-shadow:0 4px 12px #10233f08;transition:transform .18s ease,border-color .18s ease}
  .quick-category:hover{transform:translateY(-3px);border-color:#c8102e}
  .quick-category>span{display:grid;place-items:center;width:37px;height:37px;margin-bottom:3px;border-radius:11px;background:#fcebed;font-size:21px}
  .quick-category strong{color:#10233f;font-size:13px}
  .quick-category small{color:#64748b;font-size:10px}
  .quick-category.deal{border-color:#f0c3cb;background:linear-gradient(145deg,#fff,#fff4f5)}
  .destination-label{margin-top:6px}
  .section-label{display:flex;align-items:center;justify-content:center;gap:11px;margin:0 0 17px;color:#64748b;font-size:10px;font-weight:900;letter-spacing:.15em}
  .section-label span{width:25px;height:1px;background:#c8102e}
  .link-list{display:grid;gap:11px}
  .link-card{position:relative;display:flex;align-items:center;justify-content:flex-start;gap:15px;padding:16px 18px;border:1px solid #dce3eb;border-left:4px solid #10233f;border-radius:12px;background:#fff;color:inherit;box-shadow:0 3px 10px #10233f08;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
  .link-card:hover{transform:translateY(-2px);border-color:#bac8d8;box-shadow:0 9px 22px #10233f12}
  .link-card.featured{border-left-color:#c8102e;background:linear-gradient(110deg,#fff 0%,#fff 72%,#fff5f6 100%)}
  .link-visual{display:grid;place-items:center;flex:0 0 54px;width:54px;height:54px;border-radius:14px;background:linear-gradient(145deg,#eff4fa,#fcebed);font-size:27px}
  .link-copy{display:flex;min-width:0;flex:1;flex-direction:column;align-items:flex-start}
  .link-eyebrow{margin-bottom:4px;color:#c8102e;font-size:9px;font-weight:950;letter-spacing:.13em}
  .link-card strong{color:#10233f;font-size:17px;line-height:1.25}
  .link-description{margin-top:4px;color:#64748b;font-size:12px;line-height:1.5}
  .link-action{display:inline-flex;align-items:center;gap:6px;margin-top:9px;padding:8px 12px;border-radius:7px;background:#10233f;color:#fff;font-size:10px;font-weight:900}
  .link-card.featured .link-action{background:#c8102e}
  .link-arrow{flex:0 0 auto;margin-left:auto;color:#c8102e;font-size:22px;font-weight:800}
  .brand-shortcuts{margin-top:25px;padding:21px;border:1px solid #dce3eb;border-radius:14px;background:#fff}
  .brand-shortcuts-heading h2{margin:5px 0;color:#10233f;font-size:22px;line-height:1.2}
  .brand-shortcuts-heading p{margin:6px 0 15px;color:#64748b;font-size:12px;line-height:1.55}
  .brand-shortcut-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
  .brand-shortcut-list a{display:flex;min-height:142px;flex-direction:column;align-items:flex-start;gap:5px;padding:13px;border:1px solid #e1e7ef;border-radius:11px;background:linear-gradient(145deg,#fff,#f8fafc);color:#10233f;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
  .brand-shortcut-list a:hover{transform:translateY(-2px);border-color:#c8102e;box-shadow:0 7px 16px #10233f10}
  .brand-image{display:flex;align-items:center;justify-content:center;width:100%;height:94px;overflow:hidden;margin-bottom:3px;border-radius:8px;background:#f3f5f8}
  .brand-image img{display:block;width:100%;height:100%;object-fit:contain}
  .brand-shortcut-list a:nth-child(5) .brand-image img,.brand-shortcut-list a:nth-child(6) .brand-image img,.brand-shortcut-list a:nth-child(7) .brand-image img{object-fit:cover}
  .brand-shortcut-list a{min-height:184px}

  .brand-shortcut-list strong{font-size:13px}
  .brand-shortcut-list small{color:#64748b;font-size:10px}
  .brand-shortcut-list b{margin-top:auto;color:#c8102e;font-size:10px}
  .edit-link{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px;padding:15px 17px;border:1px solid #dce3eb;border-radius:12px;background:#fff}
  .edit-link>span{display:flex;flex-direction:column;gap:3px}
  .edit-link strong{color:#10233f;font-size:13px}
  .edit-link small{color:#64748b;font-size:10px}
  .edit-link>b{color:#1f5f9f;font-size:11px;white-space:nowrap}
  .site-link{display:flex;align-items:center;gap:12px;margin-top:22px;padding:15px;border-radius:12px;background:#10233f;color:#fff}
  .site-link-mark{display:grid;place-items:center;flex:0 0 36px;width:36px;height:36px;border:1px solid #ffffff55;border-radius:50%}.site-link-mark svg{display:block;width:27px;height:27px}
  .site-link>div{display:flex;min-width:0;flex:1;flex-direction:column}
  .site-link strong{font-size:13px}
  .site-link>div span{margin-top:2px;color:#cbd5e1;font-size:10px}
  .site-link>a{color:#fff;font-size:11px;font-weight:900;white-space:nowrap}
  .disclosure{margin:20px 4px 0;color:#778394;font-size:10px;line-height:1.65;text-align:center}
  .contact{display:flex;justify-content:center;gap:10px;margin-top:11px;color:#94a3b8;font-size:10px}
  .contact a{color:#52647b;font-weight:750}
  @media(max-width:640px){.quick-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quick-category{min-height:108px}.brand-shortcut-list{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-product-strip img{width:45px;height:45px}.hero-product-strip{gap:8px}.hero-product-strip span{max-width:95px;line-height:1.35}}
  @media(max-width:480px){.brand-shortcut-list a{min-height:170px}.brand-image{height:82px}.edit-link{align-items:flex-start;flex-direction:column;gap:7px}.links-hero{padding:38px 0 32px}.links-hero h1{font-size:36px}.intro{font-size:14px}.hero-actions{flex-direction:column;align-items:stretch;padding:0 8px}.hero-button{width:100%;box-sizing:border-box}.link-card{padding:14px 12px;gap:11px}.link-visual{flex-basis:43px;width:43px;height:43px;font-size:23px}.link-card strong{font-size:15px}.link-description{font-size:11px}.link-arrow{font-size:19px}.brand-shortcuts{padding:15px}.brand-shortcut-list{gap:7px}.brand-shortcut-list a{min-height:135px;padding:10px}.site-link{gap:9px;padding:12px}.site-link>div span{font-size:9px}.site-link>a{font-size:10px}}
  @media(prefers-reduced-motion:reduce){.link-card{transition:none}.link-card:hover{transform:none}}
</style>
