---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Product Search Coming Soon | Buy Better Finds" description="Amazon product search is coming soon to Buy Better Finds. Explore our products, categories, and buying guides while we prepare the search experience.">
  <section class="search-hero">
    <div class="container">
      <div class="eyebrow">PRODUCT SEARCH</div>
      <div class="coming-soon-badge">COMING SOON</div>
      <h1>Amazon Product Search is coming soon.</h1>
      <p>We’re building a product-search experience that will let you look up products, brands, and models and then use Buy Better Finds research to understand the important strengths, tradeoffs, and buying considerations before you shop.</p>
      <div class="coming-card">
        <div class="search-icon" aria-hidden="true">⌕</div>
        <div>
          <div class="card-kicker">AMAZON PRODUCT SEARCH</div>
          <h2>Search will be powered by Amazon’s Creators API.</h2>
          <p>Once the required Amazon API access is enabled for the Buy Better Finds Associates account, this page will connect visitors to live Amazon product search results.</p>
          <div class="status-line"><span class="status-dot"></span> Search setup in progress</div>
        </div>
      </div>
      <p class="disclosure">Buy Better Finds editorial recommendations are independently created. Amazon product information, availability, and prices will be retrieved through the applicable Amazon tools and should always be confirmed on Amazon before purchase.</p>
    </div>
  </section>

  <section class="section how-it-will-work">
    <div class="container">
      <div class="section-head centered">
        <div>
          <div class="eyebrow">THE PLAN</div>
          <h2>How the search experience will work.</h2>
          <p>The goal is simple: help shoppers move from a product idea to better information before making a purchase.</p>
        </div>
      </div>
      <div class="steps">
        <div class="step-card">
          <span>01</span>
          <h3>Search for a product</h3>
          <p>Enter a product name, brand, model, or general product type.</p>
        </div>
        <div class="step-card">
          <span>02</span>
          <h3>Review the research</h3>
          <p>When Buy Better Finds has editorial coverage, see our take, strengths, limitations, and who the product may be best for.</p>
        </div>
        <div class="step-card">
          <span>03</span>
          <h3>Check Amazon</h3>
          <p>Use the affiliate link to check the current Amazon listing, price, availability, and product details before buying.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section explore-now">
    <div class="container">
      <div class="explore-card">
        <div>
          <div class="eyebrow light">YOU CAN SHOP NOW</div>
          <h2>Explore Buy Better Finds while search is being prepared.</h2>
          <p>Browse our current products, categories, and buying guides for researched shopping ideas today.</p>
        </div>
        <div class="explore-actions">
          <a class="btn primary" href="/products/">Explore Products →</a>
          <a class="btn secondary" href="/categories/">Browse Categories</a>
          <a class="text-link" href="/guides/">Read Buying Guides →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.search-hero{padding:78px 0 64px;background:linear-gradient(135deg,#eef3f8,#fff)}
.search-hero .container{max-width:1000px;text-align:center}
.search-hero h1{font-size:clamp(38px,6vw,66px);line-height:1.03;color:var(--navy);margin:12px auto 18px;max-width:850px}
.search-hero> .container>p{max-width:780px;margin:0 auto;color:var(--muted);font-size:17px;line-height:1.65}
.coming-soon-badge{display:inline-block;margin-top:22px;background:#c8102e;color:#fff;padding:9px 14px;border-radius:5px;font-size:10px;font-weight:900;letter-spacing:.13em}
.coming-card{max-width:780px;margin:36px auto 0;padding:28px;text-align:left;display:flex;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 16px 38px rgba(16,35,63,.1)}
.search-icon{width:74px;height:74px;flex:0 0 74px;border-radius:50%;background:#10233f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:42px}
.card-kicker{font-size:9px;font-weight:900;letter-spacing:.14em;color:#c8102e}
.coming-card h2{font-size:24px;line-height:1.25;color:var(--navy);margin:7px 0 9px}
.coming-card p{color:var(--muted);font-size:13px;line-height:1.6;margin:0}
.status-line{display:inline-flex;align-items:center;gap:8px;margin-top:14px;padding:8px 10px;background:#f5f8fb;border-radius:6px;color:#475569;font-size:10px;font-weight:800}
.status-dot{width:7px;height:7px;border-radius:50%;background:#d6a84f;display:inline-block}
.disclosure{font-size:10px!important;line-height:1.5!important;color:#64748b!important;margin-top:17px!important;max-width:760px!important}
.how-it-will-work{background:#fff}
.centered{text-align:center;justify-content:center}
.centered>div{max-width:780px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}
.step-card{border:1px solid var(--line);border-radius:14px;padding:26px;background:#fff;box-shadow:0 8px 24px rgba(16,35,63,.05)}
.step-card>span{display:inline-flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:50%;background:#10233f;color:#fff;font-size:10px;font-weight:900}
.step-card h3{font-size:18px;color:var(--navy);margin:15px 0 8px}
.step-card p{font-size:12px;color:var(--muted);line-height:1.6;margin:0}
.explore-now{background:#f4f7fa}
.explore-card{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;background:#10233f;border-radius:18px;padding:38px}
.explore-card h2{color:#fff;font-size:30px;line-height:1.2;margin:8px 0 10px}
.explore-card p{color:#d5deea;line-height:1.6;margin:0}
.explore-actions{display:flex;flex-direction:column;gap:10px}
.explore-actions .btn{text-align:center}
.text-link{color:#fff;text-align:center;font-size:11px;font-weight:900;text-decoration:underline;padding:7px}
@media(max-width:800px){.steps,.explore-card{grid-template-columns:1fr}.explore-actions{max-width:420px;width:100%}}
@media(max-width:600px){.search-hero{padding:58px 0 48px}.coming-card{padding:22px;flex-direction:column;text-align:center}.search-icon{width:64px;height:64px;flex-basis:64px;font-size:36px}.coming-card h2{font-size:21px}.explore-card{padding:28px 22px}.explore-card h2{font-size:25px}}
</style>
