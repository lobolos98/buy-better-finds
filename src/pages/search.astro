---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search Products | Buy Better Finds" description="Search products and brands, review Buy Better Finds research, and check the matching Amazon listing.">
  <section class="search-hero">
    <div class="container">
      <div class="eyebrow">PRODUCT SEARCH</div>
      <h1>Search any product.</h1>
      <p>Find a product, brand, or model on Amazon, then use Buy Better Finds to understand what to look for before you buy.</p>
      <form id="product-search" class="search-form">
        <label for="query">What are you looking for?</label>
        <div class="search-row">
          <input id="query" name="q" type="search" placeholder="Try “Sony headphones”, “DeWalt drill”, or “air fryer”" autocomplete="off" required />
          <button class="btn primary" type="submit">Search</button>
        </div>
      </form>
      <p class="search-note">Search results are supplied through Amazon's Creators API when API access is configured. Buy Better Finds editorial content is separate from Amazon's product data.</p>
    </div>
  </section>

  <section class="section results-section">
    <div class="container">
      <div id="status" class="status" role="status" aria-live="polite">Enter a product above to begin.</div>
      <div id="results" class="results-grid"></div>
    </div>
  </section>

  <section class="section search-method">
    <div class="container">
      <div class="method-card">
        <div>
          <div class="eyebrow light">HOW THIS WORKS</div>
          <h2>Search first. Research second. Shop last.</h2>
          <p>Buy Better Finds is designed to add a practical research layer before you leave for Amazon. Products can be searched by keyword, brand, or model, while our editorial reviews and comparisons provide original buying guidance where we've evaluated the product.</p>
        </div>
        <div class="method-list">
          <span><b>01</b> Find the product</span>
          <span><b>02</b> Review the available information</span>
          <span><b>03</b> Check the current Amazon listing</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.search-hero{padding:76px 0 54px;background:linear-gradient(135deg,#eef3f8,#fff)}
.search-hero .container{max-width:980px;text-align:center}
.search-hero h1{font-size:clamp(38px,6vw,66px);line-height:1.02;color:var(--navy);margin:10px 0 16px}
.search-hero> .container>p{max-width:760px;margin:0 auto;color:var(--muted);font-size:18px;line-height:1.65}
.search-form{margin:34px auto 0;max-width:820px;text-align:left;background:#fff;padding:18px;border:1px solid var(--line);border-radius:16px;box-shadow:0 16px 40px rgba(16,35,63,.09)}
.search-form label{display:block;font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:#475569;margin-bottom:9px}
.search-row{display:flex;gap:10px}.search-row input{flex:1;min-width:0;padding:15px 16px;border:1px solid #cbd5e1;border-radius:9px;font-size:16px;color:#111827;outline:none}.search-row input:focus{border-color:#1d4ed8;box-shadow:0 0 0 3px rgba(29,78,216,.12)}
.search-row .btn{border:0;cursor:pointer}
.search-note{font-size:11px!important;margin-top:13px!important;color:#64748b!important}
.results-section{min-height:360px}.status{text-align:center;color:#64748b;margin-bottom:24px}.results-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.result-card{display:grid;grid-template-columns:180px 1fr;gap:18px;padding:18px;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}.result-image{height:180px;background:#f6f8fb;border-radius:11px;display:flex;align-items:center;justify-content:center}.result-image img{width:100%;height:100%;object-fit:contain;padding:14px}.result-copy h2{font-size:20px;line-height:1.3;color:var(--navy);margin:7px 0}.result-brand{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;color:#c8102e}.result-feature{font-size:12px;line-height:1.5;color:#64748b;margin:0 0 13px}.result-actions{display:flex;flex-wrap:wrap;gap:8px}.research-btn,.amazon-link{display:inline-flex;align-items:center;justify-content:center;padding:9px 11px;border-radius:7px;font-size:11px;font-weight:900;text-decoration:none}.research-btn{background:var(--navy);color:#fff}.amazon-link{background:#ffb000;color:#10233f}.method-card{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;background:#0f172a;color:#fff;border-radius:22px;padding:38px}.method-card h2{font-size:32px;margin:8px 0 12px;color:#fff}.method-card p{color:#cbd5e1;line-height:1.7}.method-list{display:grid;gap:12px;align-content:center}.method-list span{padding:15px;border:1px solid rgba(255,255,255,.14);border-radius:10px;color:#e2e8f0}.method-list b{color:#c8102e;margin-right:9px}
@media(max-width:800px){.results-grid,.method-card{grid-template-columns:1fr}.result-card{grid-template-columns:130px 1fr}.result-image{height:130px}}
@media(max-width:560px){.search-row{flex-direction:column}.search-row .btn{width:100%}.result-card{grid-template-columns:1fr}.result-image{height:220px}}
</style>

<script>
const form = document.querySelector('#product-search');
const input = document.querySelector('#query');
const status = document.querySelector('#status');
const results = document.querySelector('#results');

function text(value, fallback = '') {
  return typeof value === 'string' ? value : fallback;
}

function firstFeature(item) {
  return text(item?.itemInfo?.features?.displayValues?.[0], 'Product information is available on Amazon.');
}

function render(items) {
  results.innerHTML = '';
  if (!items?.length) {
    status.textContent = 'No matching products were returned. Try a more specific search.';
    return;
  }
  status.textContent = `Showing ${items.length} Amazon results. Select a product to research it or check the current listing.`;
  for (const item of items) {
    const title = text(item?.itemInfo?.title?.displayValue, 'Amazon product');
    const brand = text(item?.itemInfo?.byLineInfo?.brand?.displayValue, '');
    const image = text(item?.images?.primary?.large?.url || item?.images?.primary?.medium?.url, '');
    const amazonUrl = text(item?.detailPageURL, `https://www.amazon.com/dp/${item.asin}?tag=buybetterfi06-20`);
    const card = document.createElement('article');
    card.className = 'result-card';
    card.innerHTML = `
      <div class="result-image">${image ? `<img src="${image}" alt="">` : '<span>No image</span>'}</div>
      <div class="result-copy">
        <div class="result-brand">${brand || 'Amazon listing'}</div>
        <h2>${escapeHtml(title)}</h2>
        <p class="result-feature">${escapeHtml(firstFeature(item))}</p>
        <div class="result-actions">
          <a class="research-btn" href="/amazon-product/?asin=${encodeURIComponent(item.asin)}">Buy Better Finds Research →</a>
          <a class="amazon-link" href="${escapeAttribute(amazonUrl)}" target="_blank" rel="nofollow sponsored noopener">See on Amazon →</a>
        </div>
      </div>`;
    results.appendChild(card);
  }
}

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
}
function escapeAttribute(value) { return escapeHtml(value); }

async function runSearch(q) {
  if (q.length < 2) return;
  input.value = q;
  status.textContent = 'Searching Amazon…';
  results.innerHTML = '';
  try {
    const response = await fetch(`/api/amazon-search?q=${encodeURIComponent(q)}`);
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Search failed.');
    render(data.items || []);
  } catch (error) {
    status.textContent = error.message || 'Search is temporarily unavailable.';
  }
}

form?.addEventListener('submit', async (event) => {
  event.preventDefault();
  await runSearch(input.value.trim());
});

const initialQuery = new URLSearchParams(window.location.search).get('q')?.trim() || '';
if (initialQuery.length >= 2) {
  runSearch(initialQuery);
}
</script>
