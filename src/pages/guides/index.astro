.featured-tag{position:absolute;right:14px;top:14px;background:#fff;color:#c8102e;border-radius:999px;padding:7px 9px;font-size:9px;font-weight:900;box-shadow:0 5px 14px rgba(16,35,63,.1)}
.featured-body{padding:20px 21px 22px}
.featured-body h3{color:#10233f;font-size:22px;line-height:1.15;margin:0 0 9px}
.featured-body p{color:#64748b;font-size:13px;line-height:1.6;margin:0 0 17px}
.featured-body>span{color:#2366a8;font-size:12px;font-weight:900}.featured-body>span b{margin-left:5px}
.featured-1{grid-column:span 2}.featured-1 .featured-image{height:310px}
.decision-section{background:#10233f;color:#fff}.decision-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:center}.decision-section h2{font-size:clamp(30px,4vw,46px);line-height:1.05;margin:10px 0 15px}.decision-section p{color:#c7d5e4;line-height:1.7;max-width:560px}.decision-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.decision-grid a{padding:20px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:13px;text-decoration:none;color:#fff;display:grid;grid-template-columns:42px 1fr;column-gap:12px;align-items:center;transition:background .2s ease,transform .2s ease}.decision-grid a:hover{background:rgba(255,255,255,.12);transform:translateY(-3px)}.decision-icon{grid-row:span 2;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#c8102e;font-weight:950}.decision-grid strong{font-size:14px}.decision-grid small{color:#b9cbe0;font-size:11px;line-height:1.4;margin-top:3px}
.library-section{background:#f8fafc}.library-count{padding:8px 11px;border:1px solid #d9e2ec;border-radius:999px;background:#fff;color:#64748b;font-size:11px;font-weight:900}
.library-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.library-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px;display:flex;flex-direction:column;min-height:205px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.library-card:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(16,35,63,.08)}.library-category{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#c8102e;font-weight:900}.library-card h3{color:#10233f;font-size:17px;line-height:1.2;margin:10px 0 8px}.library-card p{color:#64748b;font-size:12px;line-height:1.55;margin:0}.library-arrow{margin-top:auto;padding-top:14px;color:#2366a8;font-size:11px;font-weight:900}.library-arrow b{margin-left:5px}
.next-section{background:#fff}.next-panel{border:1px solid #dce4ed;border-radius:22px;padding:34px;background:linear-gradient(135deg,#f7f9fc,#fff)}.next-panel h2{color:#10233f;font-size:34px;margin:8px 0 10px}.next-panel p{max-width:680px;color:#64748b;line-height:1.65}.next-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:22px}.next-grid a{display:flex;flex-direction:column;gap:6px;padding:17px;border:1px solid #dce4ed;border-radius:12px;background:#fff;text-decoration:none}.next-grid strong{color:#10233f;font-size:14px}.next-grid span{color:#64748b;font-size:11px;line-height:1.5}.next-grid b{color:#c8102e;font-size:14px}
.methodology{background:#f1f4f8}.methodology-inner{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px}.methodology h2{color:#10233f;font-size:38px;margin:8px 0}.methodology p{color:#64748b;line-height:1.75;max-width:720px}.method-link{display:inline-flex;gap:8px;color:#2366a8;font-size:13px;font-weight:900;text-decoration:none}
@media(max-width:1050px){.category-grid{grid-template-columns:repeat(3,1fr)}.library-grid{grid-template-columns:repeat(3,1fr)}.decision-layout,.methodology-inner{grid-template-columns:1fr}.decision-layout{gap:28px}}
@media(max-width:760px){.hero{padding:40px 0 44px}.hero h1{font-size:42px}.hero p{font-size:16px}.section{padding:58px 0}.section-heading{display:block}.section-heading p{margin-top:12px}.category-grid{grid-template-columns:repeat(2,1fr)}.featured-grid{grid-template-columns:1fr}.featured-1{grid-column:span 1}.featured-1 .featured-image{height:240px}.library-grid{grid-template-columns:repeat(2,1fr)}.next-grid{grid-template-columns:1fr 1fr}.decision-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.hero{padding:34px 0 38px}.hero h1{font-size:38px}.hero p{font-size:15px}.hero-proof{gap:8px}.category-grid{grid-template-columns:1fr}.category-card{min-height:320px}.library-grid{grid-template-columns:1fr}.next-grid,.decision-grid{grid-template-columns:1fr}.next-panel{padding:24px 19px}.brand-mark{font-size:9px}}
</style>
