---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

const guides = [
  ['Best Tech Products','best-tech','Tech','Headphones, tablets, mice, power, and everyday technology.'],
  ['Best Noise-Canceling Headphones','best-noise-canceling-headphones','Tech','A focused comparison for travelers, commuters, and listeners who want quieter surroundings.'],
  ['Best Home & Kitchen Products','best-home-kitchen','Home & Kitchen','Practical appliances, organization, and household upgrades.'],
  ['Best Air Fryers','best-air-fryers','Home & Kitchen','Compare countertop air fryers by capacity, everyday use, and who each model suits best.'],
  ['Best Cordless & Everyday Vacuums','best-vacuums','Home & Kitchen','A practical vacuum shortlist for quick cleanups and whole-home floor care.'],
  ['Best Tools for Homeowners','best-homeowner-drills','Tools & DIY','A straightforward drill-and-driver guide for repairs, projects, and general DIY work.'],
  ['Best Tools & DIY Products','best-tools-diy','Tools & DIY','Tools and project gear for homeowners and DIYers who want capable equipment and a clearer idea of what each product is best suited for.'],
  ['Best Outdoor Products','best-outdoor','Outdoor','Grills, patio gear, and products for getting more from outdoor spaces.'],
  ['Best Patio Heaters','best-patio-heaters','Outdoor','What to consider when choosing outdoor heat for patios, decks, and entertaining.'],
  ['Best Smart Home Products','best-smart-home','Smart Home','Simple connected products that can make home life easier.'],
  ['Best Smart Plugs','best-smart-plugs','Smart Home','A focused look at outdoor smart-plug use, scheduling, ecosystems, and convenience.'],
  ['Best Fitness Watches','best-fitness-watches','Fitness','A practical fitness-watch starting point for runners and structured training.'],
  ['Best Everyday Drinkware','best-everyday-drinkware','Lifestyle','Compare insulated drinkware choices for commuting, hydration, and outdoor use.'],
  ['Best Home Organization Products','best-home-organization','Home & Kitchen','Useful storage and organization ideas for everyday household clutter.'],
  ['Best Products Under $100','best-products-under-100','Value','A practical shortlist for shoppers focused on value and budget.'],
  ['Best Everyday Products','best-everyday-products','Everyday','Useful products selected for common daily needs.']
];

const guideImages = {
  'best-tech': 'Sony WH-1000XM5 Noise-Canceling Headphones',
  'best-noise-canceling-headphones': 'Sony WH-1000XM5 Noise-Canceling Headphones',
  'best-home-kitchen': 'KitchenAid Artisan Series 5-Quart Stand Mixer',
  'best-air-fryers': 'Ninja 4-Qt Air Fryer AF101',
  'best-vacuums': 'Dyson V8 Cordless Vacuum',
  'best-homeowner-drills': 'DEWALT 20V MAX Compact Drill/Driver Kit DCD771C2',
  'best-tools-diy': 'Dremel 3100-2/60 Variable Speed Rotary Tool Kit',
  'best-outdoor': 'Weber Spirit E-210 Gas Grill',
  'best-patio-heaters': 'Amazon Basics 46,000 BTU Portable Outdoor Propane Patio Heater',
  'best-smart-home': 'Amazon Echo Dot',
  'best-smart-plugs': 'TP-Link Kasa Smart Outdoor Plug EP40M',
  'best-fitness-watches': 'Apple Watch Series 10',
  'best-everyday-drinkware': 'YETI Rambler Drinkware',
  'best-home-organization': 'EUDELE Adhesive Shower Caddy',
  'best-products-under-100': 'LEGO Bonsai Tree Building Kit',
  'best-everyday-products': 'Stanley Quencher H2.0 Tumbler'
};

const guideImage = (slug, category) => {
  const preferredName = guideImages[slug];
  const preferred = preferredName && products.find((item) => item.name === preferredName && item.image);
  if (preferred?.image) return preferred.image;
  return products.find((item) => item.category === category && item.image)?.image || '';
};
---
<BaseLayout title="Buying Guides | Buy Better Finds" description="Original buying guides from Buy Better Finds covering useful products, tradeoffs, comparisons, and practical shopping decisions.">
  <section class="hero">
    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>
    <div class="container hero-inner">
      <div class="brand-mark"><span class="mark-b">B</span><span>BUY BETTER FINDS</span></div>
      <div class="eyebrow">BUYING GUIDES</div>
      <h1>Know what to look for <em>before</em> you buy.</h1>
      <p>Skip the endless scrolling. Our guides turn crowded product categories into practical decisions—what matters, who each option fits, and what to watch before you spend.</p>
      <div class="hero-actions">
        <a class="hero-btn primary" href="/guides/best-tech/">Explore our guides <span>→</span></a>
        <a class="hero-btn ghost" href="/comparisons/">Compare products</a>
      </div>
      <div class="hero-proof"><span>✓</span> Research-focused <span>✓</span> Practical tradeoffs <span>✓</span> No hype-first rankings</div>
    </div>
  </section>

  <section class="section library-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">ALL BUYING GUIDES</div>
          <h2>Every guide, all in one place.</h2>
        </div>
        <span class="library-count">{guides.length} guides</span>
      </div>
      <div class="library-grid">
        {guides.map(([title,slug,category,description]) => {
          const image = guideImage(slug, category);
          return (
            <a class="library-card" href={`/guides/${slug}/`}>
              <div class="library-image">
                {image ? <img src={image} alt={title} loading="lazy" referrerpolicy="no-referrer" /> : <span class="library-image-placeholder">BUY<br />BETTER<br />FINDS</span>}
              </div>
              <div class="library-body">
                <span class="library-category">{category}</span>
                <h3>{title}</h3>
                <p>{description}</p>
                <span class="library-arrow">Read guide <b>→</b></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section next-section">
    <div class="container">
      <div class="next-panel">
        <div>
          <div class="eyebrow">CONTINUE YOUR RESEARCH</div>
          <h2>From guidance to a specific decision.</h2>
          <p>Once you know what matters, keep the research moving with comparisons, individual product pages, trending signals, or dated Price Watch context.</p>
        </div>
        <div class="next-grid">
          <a href="/comparisons/"><strong>Compare Products</strong><span>See side-by-side tradeoffs.</span><b>→</b></a>
          <a href="/products/"><strong>Review Products</strong><span>Read individual strengths and limitations.</span><b>→</b></a>
          <a href="/trending/"><strong>What's Trending</strong><span>See current research signals.</span><b>→</b></a>
          <a href="/price-watch/"><strong>Price Watch</strong><span>Review dated price observations.</span><b>→</b></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section methodology">
    <div class="container methodology-inner">
      <div>
        <div class="eyebrow">OUR METHOD</div>
        <h2>Research. Compare. Recommend.</h2>
      </div>
      <div>
        <p>We organize product information into useful decisions rather than simply presenting a long list of products. Every guide is designed to help you understand strengths, limitations, intended use, and practical tradeoffs before you shop.</p>
        <a class="method-link" href="/why-we-recommend/">Learn how we choose <span>→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.hero{position:relative;overflow:hidden;background:#eef3f8;color:#10233f;padding:38px 0 42px;border-bottom:1px solid #dce5ef}
.hero-inner{max-width:980px;text-align:center;position:relative;z-index:2}
.brand-mark{display:inline-flex;align-items:center;justify-content:center;gap:9px;margin-bottom:18px;font-size:11px;font-weight:900;letter-spacing:.12em;color:#10233f}
.mark-b{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#10233f;color:#fff;font-size:17px;font-weight:950;box-shadow:0 7px 18px rgba(16,35,63,.14)}
.hero .eyebrow{color:#c8102e}
.hero h1{max-width:850px;margin:7px auto 14px;font-size:clamp(38px,5.2vw,64px);line-height:1.02;letter-spacing:-.045em}
.hero h1 em{font-style:normal;color:#10233f;border-bottom:4px solid #c8102e}
.hero p{max-width:700px;margin:0 auto;color:#53677f;font-size:16px;line-height:1.6}
.hero-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:20px}
.hero-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 19px;border-radius:7px;text-decoration:none;font-size:13px;font-weight:900}
.hero-btn.primary{background:#c8102e;color:#fff;box-shadow:0 9px 22px rgba(200,16,46,.18)}
.hero-btn.primary:hover{background:#a80d27}
.hero-btn.ghost{border:1px solid #cbd6e2;color:#10233f;background:#fff}
.hero-btn.ghost:hover{border-color:#9fb0c3;background:#f8fafc}
.hero-proof{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:15px;color:#718096;font-size:10px;font-weight:800;letter-spacing:.02em}
.hero-proof span{color:#c8102e}
.hero-glow{position:absolute;border-radius:50%;filter:blur(3px);opacity:.55;pointer-events:none}
.glow-one{width:220px;height:220px;right:-100px;top:-120px;background:#d8e8f7}
.glow-two{width:150px;height:150px;left:-80px;bottom:-110px;background:#f6dfe4}

.section{padding:62px 0}
.section-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:27px}
.eyebrow{font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;color:#c8102e}
.section-heading h2{color:#10233f;font-size:clamp(30px,4vw,44px);line-height:1.05;letter-spacing:-.025em;margin:8px 0 0}
.section-heading p{max-width:540px;color:#64748b;font-size:13px;line-height:1.65;margin:0}

.library-section{background:#f8fafc}
.library-count{padding:8px 11px;border:1px solid #d9e2ec;border-radius:999px;background:#fff;color:#64748b;font-size:11px;font-weight:900}
.library-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.library-card{display:flex;flex-direction:column;overflow:hidden;background:#fff;border:1px solid #dfe6ee;border-radius:16px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
.library-card:hover{transform:translateY(-5px);box-shadow:0 18px 36px rgba(16,35,63,.1);border-color:#c7d3e0}
.library-image{height:180px;background:#eef3f8;display:grid;place-items:center;overflow:hidden}
.library-image img{width:100%;height:100%;object-fit:contain;padding:18px;transition:transform .3s ease}
.library-card:hover .library-image img{transform:scale(1.05)}
.library-image-placeholder{color:#10233f;font-size:15px;line-height:1.05;font-weight:950;letter-spacing:.08em;text-align:center}
.library-body{padding:18px 19px 20px;display:flex;flex-direction:column;flex:1}
.library-category{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#c8102e;font-weight:900}
.library-card h3{color:#10233f;font-size:18px;line-height:1.2;margin:9px 0 8px}
.library-card p{color:#64748b;font-size:12px;line-height:1.55;margin:0}
.library-arrow{margin-top:auto;padding-top:15px;color:#2366a8;font-size:11px;font-weight:900}
.library-arrow b{margin-left:5px}

.next-section{background:#fff}
.next-panel{border:1px solid #dce4ed;border-radius:22px;padding:34px;background:linear-gradient(135deg,#f7f9fc,#fff)}
.next-panel h2{color:#10233f;font-size:34px;margin:8px 0 10px}
.next-panel p{max-width:680px;color:#64748b;line-height:1.65}
.next-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:22px}
.next-grid a{display:flex;flex-direction:column;gap:6px;padding:17px;border:1px solid #dce4ed;border-radius:12px;background:#fff;text-decoration:none}
.next-grid strong{color:#10233f;font-size:14px}
.next-grid span{color:#64748b;font-size:11px;line-height:1.5}
.next-grid b{color:#c8102e;font-size:14px}

.methodology{background:#f1f4f8}
.methodology-inner{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px}
.methodology h2{color:#10233f;font-size:38px;margin:8px 0}
.methodology p{color:#64748b;line-height:1.75;max-width:720px}
.method-link{display:inline-flex;gap:8px;color:#2366a8;font-size:13px;font-weight:900;text-decoration:none}

@media(max-width:1050px){
  .category-grid{grid-template-columns:repeat(3,1fr)}
  .library-grid{grid-template-columns:repeat(3,1fr)}
  .decision-layout,.methodology-inner{grid-template-columns:1fr}
  .decision-layout{gap:28px}
}
@media(max-width:760px){
  .hero{padding:32px 0 36px}
  .hero h1{font-size:42px}
  .hero p{font-size:16px}
  .section{padding:58px 0}
  .section-heading{display:block}
  .section-heading p{margin-top:12px}
  .category-grid{grid-template-columns:repeat(2,1fr)}
  .library-grid{grid-template-columns:repeat(2,1fr)}
  .next-grid{grid-template-columns:1fr 1fr}
  .decision-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
  .hero{padding:30px 0 34px}
  .hero h1{font-size:38px}
  .hero p{font-size:15px}
  .hero-proof{gap:8px}
  .category-grid{grid-template-columns:1fr}
  .category-card{min-height:320px}
  .library-grid{grid-template-columns:1fr}
  .next-grid,.decision-grid{grid-template-columns:1fr}
  .next-panel{padding:24px 19px}
  .brand-mark{font-size:9px}
}
</style>
