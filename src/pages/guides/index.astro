---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

const guides = [
  ['Best Tech Products','best-tech','Tech','Headphones, tablets, mice, power, and everyday technology.'],
  ['Best Noise-Canceling Headphones','best-noise-canceling-headphones','Tech','A focused comparison for travelers, commuters, and listeners who want quieter surroundings.'],
  ['Best Home & Kitchen Products','best-home-kitchen','Home & Kitchen','Practical appliances, organization, and household upgrades.'],
  ['Best Air Fryers','best-air-fryers','Home & Kitchen','Compare countertop air fryers by capacity, everyday use, and who each model suits best.'],
  ['Best Cordless & Everyday Vacuums','best-vacuums','Home & Kitchen','A practical vacuum shortlist for quick cleanups and whole-home floor care.'],
  ['Best Tools for Homeowners','best-homeowner-drills','Tools & DIY','A straightforward drill-and-driver guide for repairs, projects, and general DIY work.'],
  ['Best Tools & DIY Products','best-tools-diy','Tools & DIY','Tools and project gear for homeowners and DIYers who want capable equipment and a clearer idea of what each product is best suited for.'],
  ['Best Outdoor Products','best-outdoor','Outdoor','Grills, patio gear, and products for getting more from outdoor spaces.'],
  ['Best Patio Heaters','best-patio-heaters','Outdoor','What to consider when choosing outdoor heat for patios, decks, and entertaining.'],
  ['Best Smart Home Products','best-smart-home','Smart Home','Simple connected products that can make home life easier.'],
  ['Best Smart Plugs','best-smart-plugs','Smart Home','A focused look at outdoor smart-plug use, scheduling, ecosystems, and convenience.'],
  ['Best Fitness Watches','best-fitness-watches','Fitness','A practical fitness-watch starting point for runners and structured training.'],
  ['Best Everyday Drinkware','best-everyday-drinkware','Lifestyle','Compare insulated drinkware choices for commuting, hydration, and outdoor use.'],
  ['Best Home Organization Products','best-home-organization','Home & Kitchen','Useful storage and organization ideas for everyday household clutter.'],
  ['Best Products Under $100','best-products-under-100','Value','A practical shortlist for shoppers focused on value and budget.'],
  ['Best Everyday Products','best-everyday-products','Everyday','Useful products selected for common daily needs.']
];

const categories = [
  ['Tech','Tech','⚡','best-tech','Tech guides for headphones, devices, charging, and everyday digital life.'],
  ['Home & Kitchen','Home & Kitchen','⌂','best-home-kitchen','Practical guides for cooking, cleaning, organization, and home upgrades.'],
  ['Tools & DIY','Tools & DIY','⚙','best-tools-diy','Straightforward guidance for repairs, projects, tools, and workshop gear.'],
  ['Outdoor','Outdoor','☼','best-outdoor','Outdoor cooking, patio comfort, entertaining, and backyard gear.'],
  ['Smart Home','Smart Home','⌁','best-smart-home','Connected products, smart plugs, routines, and easier home control.'],
  ['Fitness','Fitness','◈','best-fitness-watches','Fitness gear and wearable guidance built around real-world use.'],
  ['Lifestyle','Lifestyle','◒','best-everyday-drinkware','Everyday carry, drinkware, travel, and products you use constantly.'],
  ['Gifts & Collectibles','Gifts & Collectibles','★','best-everyday-products','Giftable finds for fans, collectors, families, and special occasions.'],
  ['Toys & Games','Toys & Games','✦','best-everyday-products','Play, building, STEM, games, and family-friendly product guidance.'],
  ['Beauty & Personal Care','Beauty & Personal Care','✧','best-everyday-products','Beauty and personal-care picks with practical tradeoffs in focus.'],
  ['Seasonal & Holidays','Seasonal & Holidays','❄','best-products-under-100','Seasonal ideas, holiday shopping, and timely product inspiration.']
];

const categoryGuide = (slug) => guides.find((guide) => guide[1] === slug);

const categoryImage = (category) => {
  const product = products.find((item) => item.category === category && item.image);
  return product?.image || '';
};

const featured = [
  ['Best Tech Products','best-tech','Sony WH-1000XM5 Noise-Canceling Headphones'],
  ['Best Home & Kitchen Products','best-home-kitchen','Ninja 4-Qt Air Fryer AF101'],
  ['Best Tools & DIY Products','best-tools-diy','Dremel 4300 Rotary Tool'],
  ['Best Outdoor Products','best-outdoor','Amazon Basics 46,000 BTU Portable Outdoor Propane Patio Heater'],
  ['Best Smart Home Products','best-smart-home','TP-Link Kasa Smart Outdoor Plug EP40M'],
  ['Best Everyday Drinkware','best-everyday-drinkware','YETI Rambler Drinkware']
].map(([title,slug,productName]) => ({
  title,
  slug,
  product: products.find((item) => item.name === productName) || products.find((item) => item.category === title.replace('Best ','').replace(' Products','') && item.image)
}));
---

<BaseLayout title="Buying Guides | Buy Better Finds" description="Original buying guides from Buy Better Finds covering useful products, tradeoffs, comparisons, and practical shopping decisions.">
  <section class="hero">
    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>
    <div class="container hero-inner">
      <div class="brand-mark"><span class="mark-b">B</span><span>BUY BETTER FINDS</span></div>
      <div class="eyebrow">BUYING GUIDES</div>
      <h1>Know what to look for <em>before</em> you buy.</h1>
      <p>Skip the endless scrolling. Our guides turn crowded product categories into practical decisions—what matters, who each option fits, and what to watch before you spend.</p>
      <div class="hero-actions">
        <a class="hero-btn primary" href="/guides/best-tech/">Explore our guides <span>→</span></a>
        <a class="hero-btn ghost" href="/comparisons/">Compare products</a>
      </div>
      <div class="hero-proof"><span>✓</span> Research-focused <span>✓</span> Practical tradeoffs <span>✓</span> No hype-first rankings</div>
    </div>
  </section>

  <section class="section featured-section id="featured-guides">
    <div class="container">
      <div class="section-heading featured-heading">
        <div>
          <div class="eyebrow">FEATURED RESEARCH</div>
          <h2>Guides worth opening first.</h2>
        </div>
        <p>Start with a focused guide, then move into individual product pages and side-by-side comparisons.</p>
      </div>
      <div class="featured-grid">
        {featured.map(({title,slug,product}, index) => (
          <a class={`featured-card featured-${index + 1}`} href={`/guides/${slug}/`}>
            <div class="featured-image">
              {product?.image && <img src={product.image} alt={product.imageAlt || product.name} loading="lazy" referrerpolicy="no-referrer" />}
              <span class="featured-number">0{index + 1}</span>
              <span class="featured-tag">{product?.category || 'BUYING GUIDE'}</span>
            </div>
            <div class="featured-body">
              <h3>{title}</h3>
              <p>{guides.find((guide) => guide[1] === slug)?.[3]}</p>
              <span>Read the guide <b>→</b></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <section class="section category-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">EXPLORE BY CATEGORY</div>
          <h2>Start with what you’re shopping for.</h2>
        </div>
        <p>Eleven visual starting points make it easier to jump into the research that matters to you.</p>
      </div>
      <div class="category-grid">
        {categories.map(([name,category,icon,slug,description]) => { const guide = categoryGuide(slug); return (
          <a class="category-card" href={`/guides/${slug}/`}>
            <div class="category-image">
              {categoryImage(category) ? <img src={categoryImage(category)} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="category-icon">{icon}</span>}
              <span class="category-icon-overlay">{icon}</span>
            </div>
            <div class="category-content">
              <span class="category-kicker">{name}</span>
              <h3>{guide?.[0] || name}</h3>
              <p>{description}</p>
              <span class="category-link">Read the guide <b>→</b></span>
            </div>
          </a>
          );
        })}
      </div>
      <p class="category-note">Each category card now opens a live, dedicated buying guide from the current guide library.</p>
    </div>
  </section>



  <section class="section decision-section">
    <div class="container decision-layout">
      <div>
        <div class="eyebrow">FIND YOUR NEXT MOVE</div>
        <h2>Not sure which guide you need?</h2>
        <p>Think about the decision in front of you—not the entire category. These paths help you move from browsing to a useful shortlist.</p>
      </div>
      <div class="decision-grid">
        <a href="/guides/best-products-under-100/"><span class="decision-icon">$</span><strong>Shopping on a budget</strong><small>Start with value-focused picks.</small></a>
        <a href="/comparisons/"><span class="decision-icon">⇄</span><strong>Choosing between two</strong><small>See product tradeoffs side by side.</small></a>
        <a href="/products/"><span class="decision-icon">◉</span><strong>Want the details</strong><small>Read individual product strengths and watch-outs.</small></a>
        <a href="/trending/"><span class="decision-icon">↗</span><strong>Want what’s current</strong><small>See the latest research signals.</small></a>
      </div>
    </div>
  </section>

  <section class="section library-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">THE FULL LIBRARY</div>
          <h2>Every current buying guide.</h2>
        </div>
        <span class="library-count">{guides.length} guides</span>
      </div>
      <div class="library-grid">
        {guides.map(([title,slug,category,description]) => (
          <a class="library-card" href={`/guides/${slug}/`}>
            <span class="library-category">{category}</span>
            <h3>{title}</h3>
            <p>{description}</p>
            <span class="library-arrow">Read guide <b>→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section next-section">
    <div class="container">
      <div class="next-panel">
        <div>
          <div class="eyebrow">CONTINUE YOUR RESEARCH</div>
          <h2>From guidance to a specific decision.</h2>
          <p>Once you know what matters, keep the research moving with comparisons, individual product pages, trending signals, or dated Price Watch context.</p>
        </div>
        <div class="next-grid">
          <a href="/comparisons/"><strong>Compare Products</strong><span>See side-by-side tradeoffs.</span><b>→</b></a>
          <a href="/products/"><strong>Review Products</strong><span>Read individual strengths and limitations.</span><b>→</b></a>
          <a href="/trending/"><strong>What's Trending</strong><span>See current research signals.</span><b>→</b></a>
          <a href="/price-watch/"><strong>Price Watch</strong><span>Review dated price observations.</span><b>→</b></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section methodology">
    <div class="container methodology-inner">
      <div>
        <div class="eyebrow">OUR METHOD</div>
        <h2>Research. Compare. Recommend.</h2>
      </div>
      <div>
        <p>We organize product information into useful decisions rather than simply presenting a long list of products. Every guide is designed to help you understand strengths, limitations, intended use, and practical tradeoffs before you shop.</p>
        <a class="method-link" href="/why-we-recommend/">Learn how we choose <span>→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.hero{position:relative;overflow:hidden;background:linear-gradient(115deg,#0b1d35 0%,#102f55 55%,#173f6d 100%);color:#fff;padding:70px 0 82px}
.hero-inner{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:48px;align-items:center;position:relative;z-index:2}
.hero-copy{max-width:720px}
.brand-mark{display:inline-flex;align-items:center;gap:10px;margin-bottom:28px;font-size:12px;font-weight:900;letter-spacing:.12em}
.mark-b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#fff;color:#10233f;font-size:18px;font-weight:950;box-shadow:0 8px 25px rgba(0,0,0,.18)}
.hero .eyebrow{color:#f4c6ce}
.hero h1{max-width:760px;font-size:clamp.hero{position:relative;overflow:hidden;background:#f4f7fb;color:#10233f;padding:48px 0 52px;border-bottom:1px solid #e0e7ef}
.hero-inner{max-width:980px;text-align:center;position:relative;z-index:2}
.brand-mark{display:inline-flex;align-items:center;justify-content:center;gap:9px;margin-bottom:18px;font-size:11px;font-weight:900;letter-spacing:.12em;color:#10233f}
.mark-b{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#10233f;color:#fff;font-size:17px;font-weight:950;box-shadow:0 7px 18px rgba(16,35,63,.14)}
.hero .eyebrow{color:#c8102e}
.hero h1{max-width:850px;margin:7px auto 17px;font-size:clamp(40px,5.4vw,68px);line-height:1.02;letter-spacing:-.045em}
.hero h1 em{font-style:normal;color:#10233f;border-bottom:4px solid #c8102e}
.hero p{max-width:700px;margin:0 auto;color:#5f7187;font-size:17px;line-height:1.65}
.hero-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:24px}
.hero-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 19px;border-radius:7px;text-decoration:none;font-size:13px;font-weight:900}
.hero-btn.primary{background:#c8102e;color:#fff;box-shadow:0 9px 22px rgba(200,16,46,.18)}
.hero-btn.primary:hover{background:#a80d27}
.hero-btn.ghost{border:1px solid #cbd6e2;color:#10233f;background:#fff}
.hero-btn.ghost:hover{border-color:#9fb0c3;background:#f8fafc}
.hero-proof{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:18px;color:#718096;font-size:10px;font-weight:800;letter-spacing:.02em}
.hero-proof span{color:#c8102e}
.hero-glow{position:absolute;border-radius:50%;filter:blur(3px);opacity:.55;pointer-events:none}.glow-one{width:260px;height:260px;right:-90px;top:-120px;background:#dceafa}.glow-two{width:180px;height:180px;left:-80px;bottom:-110px;background:#f8dfe4}
lateY(-5px);box-shadow:0 18px 36px rgba(16,35,63,.1);border-color:#c7d3e0}
.category-image{height:160px;background:#eef3f8;position:relative;overflow:hidden}
.category-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
.category-card:hover .category-image img{transform:scale(1.06)}
.category-icon{height:100%;display:grid;place-items:center;font-size:58px;color:#1d4ed8}
.category-icon-overlay{position:absolute;top:12px;right:12px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#fff;color:#c8102e;font-size:16px;font-weight:900;box-shadow:0 5px 14px rgba(16,35,63,.12)}
.category-content{padding:19px 20px 21px;display:flex;flex-direction:column;flex:1}
.category-kicker{font-size:9px;text-transform:uppercase;letter-spacing:.13em;color:#c8102e;font-weight:900}
.category-content h3{font-size:20px;line-height:1.15;color:#10233f;margin:8px 0}
