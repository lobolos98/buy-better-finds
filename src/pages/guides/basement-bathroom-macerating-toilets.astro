<script>
  // Fetch the merchant's published Shopify product media at runtime; never substitute unrelated photos.
  document.querySelectorAll('[data-shopify-product]').forEach(async (slot) => {
    const handle = slot.getAttribute('data-shopify-product');
    const href = 'https://simpleprojectus.com/products/' + handle;
    try {
      const response = await fetch(href + '.js', { mode: 'cors' });
      if (!response.ok) throw new Error('Merchant media unavailable');
      const product = await response.json();
      const source = product?.featured_image || product?.images?.[0];
      if (!source || !/^https?:\/\//.test(source) && !source.startsWith('//')) throw new Error('No official photo');
      const image = document.createElement('img');
      image.src = source.startsWith('//') ? 'https:' + source : source;
      image.alt = product.title || 'Official Simple Project product photo';
      image.loading = 'lazy';
      image.referrerPolicy = 'no-referrer';
      image.onerror = () => { slot.replaceChildren(); const link=document.createElement('a');link.href=href;link.textContent='See official product photos →';slot.append(link); };
      slot.replaceChildren(image);
    } catch {
      slot.replaceChildren();
      const link = document.createElement('a');
      link.href = href;
      link.textContent = 'See official product photos →';
      slot.append(link);
    }
  });
</script>
