---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { getRecommendation } from '../../data/recommendations.js';
import { amazonProductUrl } from '../../utils/amazon.js';

const launchSlugs = ['sony-wh-1000xm5','ninja-af101','oxo-tub-tile-scrubber','bagsmart-packing-cubes','tubshroom-drain-protector'];
const launchProducts = launchSlugs.map((slug) => products.find((p) => p.slug === slug)).filter(Boolean);
---

<BaseLayout title="What We're Looking At Right Now | Buy Better Finds" description="A focused shortlist of practical products and product comparisons researched by Buy Better Finds.">
<section class="hero">
  <div class="container">
    <div class="eyebrow">BUY BETTER FINDS · CURRENT SHORTLIST</div>
    <h1>Start with the products worth a closer look.</h1>
    <p>We keep the launch shortlist focused: practical products, clear tradeoffs, and direct paths to the information you need before buying.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro">
      <div><div class="eyebrow">FIVE PRODUCTS</div><h2>Our current research shortlist.</h2></div>
      <p>These products have verified Amazon ASINs, so the Amazon links below go directly to the identified product listing. Prices and availability can change.</p>
    </div>
    <div class="grid">
      {launchProducts.map((product) => {
        const rec = getRecommendation(product);
        return <article class="card">
          <a class="image" href={`/products/${product.slug}/`}><img src={product.image} alt={product.imageAlt} loading="lazy" /></a>
          <div class="tag">{product.category}</div>
          <h3>{product.name}</h3>
          <div class="score"><strong>{rec.score}/10</strong><span>Buy Better Score</span></div>
          <p><strong>Best for:</strong> {rec.bestFor}</p>
          <p>{product.why}</p>
          <div class="actions"><a class="details" href={`/products/${product.slug}/`}>Read our take →</a><a class="amazon" href={amazonProductUrl(product.amazonAsin)} target="_blank" rel="nofollow sponsored noopener">Check on Amazon →</a></div>
        </article>;
      })}
    </div>
    <p class="disclosure">Affiliate disclosure: As an Amazon Associate I earn from qualifying purchases. Our recommendations are based on research and comparison; we do not present products as hands-on tested unless explicitly stated.</p>
  </div>
</section>

<section class="section comparisons">
  <div class="container">
    <div class="eyebrow">BUYING DECISIONS</div>
    <h2>Compare before you click.</h2>
    <p class="lead">If you are deciding between two products, start with the comparison rather than browsing a long list.</p>
    <div class="compare-grid">
      <a href="/comparisons/sony-wh-1000xm5-vs-airpods-4/"><span>TECH</span><h3>Sony WH-1000XM5 vs Apple AirPods 5</h3><b>See the comparison →</b></a>
      <a href="/comparisons/ninja-af101-vs-instant-vortex-plus/"><span>HOME & KITCHEN</span><h3>Ninja AF101 vs Instant Vortex Plus</h3><b>See the comparison →</b></a>
      <a href="/comparisons/dyson-v8-vs-shark-navigator/"><span>HOME & KITCHEN</span><h3>Dyson V8 vs Shark Navigator Lift-Away</h3><b>See the comparison →</b></a>
      <a href="/comparisons/yeti-rambler-vs-stanley-quencher/"><span>LIFESTYLE</span><h3>YETI Rambler vs Stanley Quencher</h3><b>See the comparison →</b></a>
    </div>
  </div>
</section>

<section class="section next">
  <div class="container">
    <div class="box">
      <div><div class="eyebrow">WHAT'S NEXT</div><h2>Product Search is coming soon.</h2><p>We're building an Amazon-connected search experience designed to help you find a product, understand it, compare alternatives, and then shop.</p></div>
      <div class="buttons"><a class="primary" href="/search/">Product Search →</a><a class="secondary" href="/categories/">Browse Categories →</a></div>
    </div>
  </div>
</section>
</BaseLayout>

<style>
.hero{background:linear-gradient(135deg,#10233f,#173c69);color:#fff;padding:76px 0}.hero h1{color:#fff;font-size:clamp(42px,6vw,68px);line-height:1.02;max-width:900px;margin:12px 0 20px}.hero p{color:#d9e4f1;max-width:760px;font-size:18px;line-height:1.7}.intro{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;margin-bottom:28px}.intro h2,.comparisons h2,.box h2{color:#10233f;font-size:34px;margin:8px 0}.intro p,.lead,.box p{color:#64748b;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{border:1px solid #d9e2ec;border-radius:16px;padding:14px;background:#fff;display:flex;flex-direction:column;box-shadow:0 10px 28px #10233f0d}.image{height:210px;border-radius:12px;background:#f3f5f8;display:block;overflow:hidden;margin-bottom:16px}.image img{width:100%;height:100%;object-fit:contain;padding:18px;box-sizing:border-box}.tag,.compare-grid span{font-size:10px;letter-spacing:.12em;font-weight:900;color:#c8102e}.card h3{font-size:19px;line-height:1.3;color:#10233f;margin:8px 0}.card p{font-size:13px;line-height:1.55;color:#475569}.score{display:flex;gap:7px;align-items:baseline;margin:5px 0 2px}.score strong{color:#10233f}.score span{font-size:10px;color:#64748b}.actions{margin-top:auto;display:grid;gap:8px;padding-top:12px}.actions a,.buttons a{display:block;text-align:center;padding:12px 16px;border-radius:7px;text-decoration:none;font-size:13px;font-weight:800}.details{background:#2366a8;color:#fff}.amazon,.primary{background:#c8102e;color:#fff}.disclosure{margin-top:24px;font-size:11px;line-height:1.6;color:#64748b}.comparisons{background:#f5f7fa}.compare-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:26px}.compare-grid a{background:#fff;border:1px solid #d9e2ec;border-radius:14px;padding:24px;text-decoration:none}.compare-grid h3{color:#10233f;font-size:21px;line-height:1.25;margin:10px 0 22px}.compare-grid b{color:#2366a8;font-size:13px}.box{background:#eef3f8;border-radius:18px;padding:34px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}.buttons{display:flex;gap:10px;flex-wrap:wrap}.buttons a{white-space:nowrap}.secondary{background:#fff;color:#2366a8;border:1px solid #b9c9da}@media(max-width:850px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.intro,.box{grid-template-columns:1fr}}@media(max-width:600px){.grid,.compare-grid{grid-template-columns:1fr}.hero{padding:58px 0}.hero p{font-size:16px}.intro h2,.comparisons h2,.box h2{font-size:28px}.image{height:220px}.box{padding:26px}.buttons a{width:100%}}
</style>